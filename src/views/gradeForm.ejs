<%- include('partials/head') %>

<style>
  /* ==========================================================================
     Page Formulaire Note - Style Glassmorphism
     ========================================================================== */
  
  .page-section {
    max-width: 700px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  
  /* Section header */
  .section-header {
    margin-bottom: 2rem;
    animation: header-fade 0.6s ease forwards !important;
    opacity: 0;
    transform: translateY(10px);
  }
  
  @keyframes header-fade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .section-header h1 {
    font-weight: 700;
    color: var(--text-color, #212529);
    margin: 0;
  }
  
  [data-theme="dark"] .section-header h1 {
    color: #ffffff;
  }
  
  /* Carte formulaire Glassmorphism */
  .form-card {
    background: rgba(255, 255, 255, 0.06) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    border-radius: 1.25rem !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06) !important;
    padding: 2rem !important;
    animation: card-fade-in 0.6s ease forwards !important;
    opacity: 0;
    transform: translateY(20px);
  }
  
  @keyframes card-fade-in {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  
  [data-theme="dark"] .form-card {
    background: rgba(255, 255, 255, 0.02) !important;
    border: 1px solid rgba(255, 255, 255, 0.06) !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3) !important;
  }
  
  /* Labels */
  .form-card label {
    display: block;
    font-weight: 500;
    margin-bottom: 0.4rem;
    color: var(--text-color, #212529);
    font-size: 0.9rem;
  }
  
  [data-theme="dark"] .form-card label {
    color: rgba(255, 255, 255, 0.8);
  }
  
  /* Champs de formulaire Glassmorphism */
  .form-card input,
  .form-card select,
  .form-card textarea {
    width: 100%;
    background: rgba(255, 255, 255, 0.06) !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    border-radius: 0.75rem !important;
    padding: 0.7rem 1rem !important;
    transition: all 0.3s ease !important;
    color: var(--text-color, #212529) !important;
    box-shadow: none !important;
    font-family: inherit;
    font-size: 1rem;
    margin-bottom: 1.25rem;
  }
  
  .form-card input:focus,
  .form-card select:focus,
  .form-card textarea:focus {
    background: rgba(255, 255, 255, 0.1) !important;
    border-color: var(--bs-primary, #0d6efd) !important;
    box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.12) !important;
    outline: none;
  }
  
  .form-card textarea {
    resize: vertical;
    min-height: 100px;
  }
  
  .form-card select {
    appearance: auto;
    cursor: pointer;
  }
  
  [data-theme="dark"] .form-card input,
  [data-theme="dark"] .form-card select,
  [data-theme="dark"] .form-card textarea {
    background: rgba(255, 255, 255, 0.04) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    color: #ffffff !important;
  }
  
  [data-theme="dark"] .form-card input::placeholder,
  [data-theme="dark"] .form-card textarea::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }
  
  [data-theme="dark"] .form-card input:focus,
  [data-theme="dark"] .form-card select:focus,
  [data-theme="dark"] .form-card textarea:focus {
    background: rgba(255, 255, 255, 0.08) !important;
    border-color: #ffffff !important;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.08) !important;
  }
  
  [data-theme="dark"] .form-card select {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23ffffff' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 0.75rem center;
    background-size: 16px 12px;
  }
  
  [data-theme="dark"] .form-card select option {
    background-color: #16213e;
    color: #ffffff;
  }
  
  /* Animation des champs */
  .form-group-animated {
    animation: form-fade 0.5s ease forwards !important;
    opacity: 0;
    transform: translateY(10px);
  }
  
  @keyframes form-fade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .form-group-animated:nth-child(1) { animation-delay: 0.05s; }
  .form-group-animated:nth-child(2) { animation-delay: 0.10s; }
  .form-group-animated:nth-child(3) { animation-delay: 0.15s; }
  .form-group-animated:nth-child(4) { animation-delay: 0.20s; }
  .form-group-animated:nth-child(5) { animation-delay: 0.25s; }
  
  /* Bouton principal Glassmorphism */
  .btn-primary {
    background: linear-gradient(135deg, rgba(13, 110, 253, 0.2), rgba(13, 202, 240, 0.2)) !important;
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
    border: 1px solid rgba(13, 110, 253, 0.25) !important;
    border-radius: 0.75rem !important;
    padding: 0.7rem 2rem !important;
    font-weight: 600 !important;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
    color: var(--bs-primary, #0d6efd) !important;
    width: 100%;
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  
  .btn-primary:hover {
    transform: translateY(-2px) scale(1.01) !important;
    box-shadow: 0 8px 30px rgba(13, 110, 253, 0.2) !important;
    background: linear-gradient(135deg, rgba(13, 110, 253, 0.3), rgba(13, 202, 240, 0.3)) !important;
    border-color: var(--bs-primary, #0d6efd) !important;
    color: var(--bs-primary, #0d6efd) !important;
  }
  
  [data-theme="dark"] .btn-primary {
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    background: rgba(255, 255, 255, 0.05) !important;
  }
  
  [data-theme="dark"] .btn-primary:hover {
    background: rgba(255, 255, 255, 0.1) !important;
    box-shadow: 0 8px 30px rgba(255, 255, 255, 0.08) !important;
    border-color: #ffffff !important;
    color: #ffffff !important;
  }
  
  /* Lien retour (optionnel) */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted, #6c757d);
    text-decoration: none;
    margin-bottom: 1rem;
    transition: all 0.3s ease;
    font-size: 0.9rem;
  }
  
  .back-link:hover {
    color: var(--bs-primary, #0d6efd);
    transform: translateX(-3px);
  }
  
  [data-theme="dark"] .back-link {
    color: rgba(255, 255, 255, 0.5);
  }
  
  [data-theme="dark"] .back-link:hover {
    color: #ffffff;
  }
  
  /* Adaptation mobile */
  @media (max-width: 768px) {
    .page-section {
      padding: 1rem 0.75rem;
    }
    
    .section-header h1 {
      font-size: 1.4rem;
    }
    
    .form-card {
      padding: 1.25rem !important;
      border-radius: 1rem !important;
    }
    
    .form-card input,
    .form-card select,
    .form-card textarea {
      font-size: 0.95rem;
      padding: 0.6rem 0.8rem !important;
    }
    
    .btn-primary {
      font-size: 0.95rem;
      padding: 0.6rem 1.5rem !important;
    }
  }
</style>

<div class="page-section">
  <div class="section-header">
    <h1>
      <i data-feather="edit-3" class="me-2" style="width: 28px; height: 28px;"></i>
      <%= grade ? 'Modifier une note' : 'Ajouter une note' %>
    </h1>
  </div>

  <form action="<%= grade ? `/students/grades/${grade.id}/edit` : '/students/grades/new' %>" method="POST" class="form-card">
    <div class="form-group-animated">
      <label for="student_id">
        <i data-feather="user" class="me-1" style="width: 14px; height: 14px;"></i>
        Élève
      </label>
      <select id="student_id" name="student_id" required>
        <% students.forEach((student) => { %>
          <option value="<%= student.id %>" <%= grade && grade.student_id === student.id ? 'selected' : '' %>>
            <%= student.first_name %> <%= student.last_name %> (<%= student.student_class %>)
          </option>
        <% }) %>
      </select>
    </div>

    <div class="form-group-animated">
      <label for="subject">
        <i data-feather="book-open" class="me-1" style="width: 14px; height: 14px;"></i>
        Matière
      </label>
      <input id="subject" type="text" name="subject" value="<%= grade ? grade.subject : '' %>" required placeholder="Ex: Mathématiques" />
    </div>

    <div class="form-group-animated">
      <label for="grade">
        <i data-feather="award" class="me-1" style="width: 14px; height: 14px;"></i>
        Note
      </label>
      <input id="grade" type="text" name="grade" value="<%= grade ? grade.grade : '' %>" required placeholder="Ex: 15.5" />
    </div>

    <div class="form-group-animated">
      <label for="comment">
        <i data-feather="message-square" class="me-1" style="width: 14px; height: 14px;"></i>
        Commentaire
      </label>
      <textarea id="comment" name="comment" rows="4" placeholder="Ajoutez un commentaire (facultatif)..."><%= grade ? grade.comment : '' %></textarea>
    </div>

    <button type="submit" class="btn-primary">
      <i data-feather="save" class="me-1" style="width: 18px; height: 18px;"></i>
      <%= grade ? 'Enregistrer les modifications' : 'Ajouter la note' %>
    </button>
  </form>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Remplacer les icônes Feather
    if (typeof feather !== 'undefined') {
      feather.replace();
    }
  });
</script>

<%- include('partials/footer') %>