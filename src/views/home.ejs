<!DOCTYPE html>
<html lang="fr">
  <head>
    <%- include('partials/head', { title: 'Accueil | EducOS-pro', excludeMainCss: true }) %>
    
    <style>
      /* ==========================================================================
         Page Accueil - Style Glassmorphism
         ========================================================================== */
      
      /* Reset et styles de base */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
        transition: background-color 0.3s ease, color 0.3s ease;
      }

      /* Mode clair */
      html[data-theme="light"] body {
        background-color: rgba(240, 242, 245, 0.8);
        color: #1a1a2e;
      }
      html[data-theme="light"] .bg-body-tertiary {
        background: rgba(255,255,255,0.2) !important;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
      }
      html[data-theme="light"] .nav-link {
        color: #4b5563 !important;
      }
      html[data-theme="light"] .nav-link:hover {
        color: #0d6efd !important;
      }
      html[data-theme="light"] .nav-link svg {
        color: #4b5563 !important;
      }
      html[data-theme="light"] .nav-link:hover svg {
        color: #0d6efd !important;
      }
      html[data-theme="light"] .nav-link .nav-text {
        color: #4b5563 !important;
      }
      html[data-theme="light"] .nav-link:hover .nav-text {
        color: #0d6efd !important;
      }
      html[data-theme="light"] .nav-divider {
        color: #d1d5db !important;
      }
      html[data-theme="light"] .nav-icon-btn {
        color: #4b5563 !important;
      }
      html[data-theme="light"] .nav-icon-btn:hover {
        color: #0d6efd !important;
        background-color: rgba(13, 110, 253, 0.08) !important;
      }
      html[data-theme="light"] .text-white-75 {
        color: rgba(0,0,0,0.75) !important;
      }
      html[data-theme="light"] .navbar-brand span {
        color: #1a1a2e !important;
      }
      html[data-theme="light"] .navbar-toggler svg {
        stroke: #1a1a2e !important;
      }
      html[data-theme="light"] .badge.bg-success {
        background: #198754 !important;
        color: white !important;
      }
      body[data-theme="light"] .btn-outline-light {
        border-color: rgba(0,0,0,0.2);
        color: #1a1a2e;
      }
      html[data-theme="light"] .btn-outline-light:hover {
        background: rgba(0,0,0,0.05);
        border-color: rgba(0,0,0,0.3);
      }
      html[data-theme="light"] h1, 
      html[data-theme="light"] h2, 
      html[data-theme="light"] h3,
      html[data-theme="light"] h4,
      html[data-theme="light"] h5 {
        color: #1a1a2e !important;
      }

      /* Mode sombre */
      html[data-theme="dark"] body {
        background-color: rgba(10, 10, 26, 0.8);
        color: #ffffff;
      }
      html[data-theme="dark"] .bg-body-tertiary {
        background: rgba(17, 24, 39, 0.2) !important;
        border: 1px solid rgba(255,255,255,0.05);
      }
      html[data-theme="dark"] .text-white-75 {
        color: rgba(255,255,255,0.75) !important;
      }
      html[data-theme="dark"] .navbar-brand span {
        color: #ffffff !important;
      }
      html[data-theme="dark"] .nav-link {
        color: #e0e0e0 !important;
      }
      html[data-theme="dark"] .nav-link:hover {
        color: #ffffff !important;
      }
      html[data-theme="dark"] .nav-link svg {
        color: #e0e0e0 !important;
      }
      html[data-theme="dark"] .nav-link:hover svg {
        color: #ffffff !important;
      }
      html[data-theme="dark"] .nav-link .nav-text {
        color: #e0e0e0 !important;
      }
      html[data-theme="dark"] .nav-link:hover .nav-text {
        color: #ffffff !important;
      }
      html[data-theme="dark"] .nav-divider {
        color: #3d3d5c !important;
      }
      html[data-theme="dark"] .nav-icon-btn {
        color: #e0e0e0 !important;
      }
      html[data-theme="dark"] .nav-icon-btn:hover {
        color: #ffffff !important;
        background-color: rgba(13, 110, 253, 0.15) !important;
      }
      html[data-theme="dark"] .navbar-toggler svg {
        stroke: #e0e0e0 !important;
      }

      /* Navbar Glassmorphism */
      .navbar {
        position: fixed;
        top: 1rem;
        left: 50%;
        transform: translateX(-50%);
        width: calc(100% - 40px);
        max-width: 1400px;
        z-index: 1030;
        transition: transform 0.4s ease-in-out, opacity 0.4s ease-in-out;
        background: rgba(255, 255, 255, 0.08) !important;
        backdrop-filter: blur(16px) !important;
        -webkit-backdrop-filter: blur(16px) !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        border-radius: 1.25rem !important;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06) !important;
      }

      [data-theme="dark"] .navbar {
        background: rgba(17, 24, 39, 0.6) !important;
        border: 1px solid rgba(255, 255, 255, 0.06) !important;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3) !important;
      }

      .navbar.hidden {
        transform: translate(-50%, -150%);
        opacity: 0;
        pointer-events: none;
      }

      /* Navbar items */
      .nav-item-spaced {
        margin: 0 12px !important;
      }
      .nav-icon-btn {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        background: transparent;
        border: none;
      }
      .nav-icon-btn:hover {
        transform: translateY(-2px) scale(1.05);
      }
      .nav-divider {
        font-size: 20px;
        font-weight: 300;
        padding: 0 8px;
        opacity: 0.5;
      }
      .navbar-toggler {
        border: none !important;
        padding: 8px !important;
      }
      .navbar-toggler:focus {
        box-shadow: none !important;
      }
      .navbar-toggler-icon {
        background-image: none !important;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .nav-link {
        transition: color 0.2s ease;
        text-decoration: none;
      }
      .nav-link .nav-text {
        font-size: 0.75rem;
      }
      .page-shell {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 20px 24px 20px;
      }

      /* Boutons Glassmorphism */
      .btn-success {
        background: linear-gradient(135deg, rgba(25, 135, 84, 0.2), rgba(25, 135, 84, 0.1)) !important;
        backdrop-filter: blur(8px) !important;
        -webkit-backdrop-filter: blur(8px) !important;
        border: 1px solid rgba(25, 135, 84, 0.3) !important;
        border-radius: 0.75rem !important;
        padding: 12px 32px !important;
        font-weight: 600 !important;
        color: #198754 !important;
        transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
      }
      .btn-success:hover {
        transform: translateY(-3px) scale(1.02) !important;
        box-shadow: 0 8px 30px rgba(25, 135, 84, 0.2) !important;
        background: linear-gradient(135deg, rgba(25, 135, 84, 0.3), rgba(25, 135, 84, 0.15)) !important;
      }
      [data-theme="dark"] .btn-success {
        color: #51cf66 !important;
        border-color: rgba(25, 135, 84, 0.2) !important;
      }
      [data-theme="dark"] .btn-success:hover {
        box-shadow: 0 8px 30px rgba(25, 135, 84, 0.15) !important;
      }

      .btn-outline-light {
        background: rgba(255, 255, 255, 0.05) !important;
        backdrop-filter: blur(8px) !important;
        -webkit-backdrop-filter: blur(8px) !important;
        border: 1px solid rgba(255, 255, 255, 0.15) !important;
        border-radius: 0.75rem !important;
        padding: 12px 32px !important;
        font-weight: 600 !important;
        color: #ffffff !important;
        transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
      }
      .btn-outline-light:hover {
        transform: translateY(-3px) scale(1.02) !important;
        background: rgba(255, 255, 255, 0.1) !important;
        box-shadow: 0 8px 30px rgba(255, 255, 255, 0.08) !important;
      }
      [data-theme="light"] .btn-outline-light {
        color: #1a1a2e !important;
        border-color: rgba(0,0,0,0.15) !important;
      }
      [data-theme="light"] .btn-outline-light:hover {
        background: rgba(0,0,0,0.05) !important;
      }

      /* Hero Section */
      .hero-section {
        position: relative;
        overflow: hidden;
        min-height: 100vh;
        padding-top: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
      }
      .hero-carousel {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
      }
      .hero-carousel .carousel-inner,
      .hero-carousel .carousel-item {
        height: 100%;
      }
      .hero-carousel .carousel-item img {
        object-fit: cover;
        height: 100%;
        width: 100%;
      }
      .hero-carousel::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(10, 10, 26, 0.7);
      }
      html[data-theme="light"] .hero-carousel::after {
        background-color: rgba(255, 255, 255, 0.5);
      }
      .hero-section > .container {
        position: relative;
        z-index: 1;
      }
      .hero-section .display-3 {
        font-weight: 800;
        letter-spacing: -1.5px;
        animation: fadeInUp 0.8s ease-out forwards;
        opacity: 0;
        animation-delay: 0.2s;
      }
      .hero-section .lead {
        max-width: 700px;
        margin: 1.5rem auto 2.5rem auto;
        animation: fadeInUp 0.8s ease-out forwards;
        opacity: 0;
        animation-delay: 0.4s;
      }
      html[data-theme="light"] .hero-section .lead {
        color: #4a5568 !important;
      }
      html[data-theme="dark"] .hero-section .lead {
        color: rgba(255,255,255,0.8) !important;
      }
      html[data-theme="dark"] .hero-section .display-3 {
        color: #ffffff !important;
      }
      .hero-section .badge {
        animation: fadeInUp 0.8s ease-out forwards;
        opacity: 0;
        animation-delay: 0.1s;
      }
      .hero-section .d-flex {
        animation: fadeInUp 0.8s ease-out forwards;
        opacity: 0;
        animation-delay: 0.6s;
      }

      .scroll-down-container {
        margin-top: 5rem;
        z-index: 2;
      }
      .scroll-down-link {
        color: white;
        text-decoration: none;
        animation: subtle-bounce 2.5s infinite;
      }
      html[data-theme="light"] .scroll-down-link {
        color: #1a1a2e;
      }

      @keyframes subtle-bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(8px); }
      }

      /* Stats Section */
      .stats-section {
        padding: 2rem;
        background: rgba(255, 255, 255, 0.04) !important;
        backdrop-filter: blur(8px) !important;
        -webkit-backdrop-filter: blur(8px) !important;
        border-radius: 1.25rem !important;
        border: 1px solid rgba(255, 255, 255, 0.06) !important;
      }
      [data-theme="dark"] .stats-section {
        background: rgba(255, 255, 255, 0.02) !important;
      }
      .stats-section .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      }
      .stats-section .stat-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--bs-primary, #0d6efd);
      }
      [data-theme="dark"] .stats-section .stat-number {
        color: #ffffff;
      }
      .stats-section .stat-label {
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted, #6c757d);
      }
      [data-theme="dark"] .stats-section .stat-label {
        color: rgba(255, 255, 255, 0.5);
      }

      /* Feature Showcase */
      .feature-showcase {
        padding: 4rem 0;
      }
      .feature-item {
        margin-bottom: 6rem;
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
      }
      .feature-item:last-child {
        margin-bottom: 0;
      }
      .feature-item.is-visible {
        opacity: 1;
        transform: translateY(0);
      }
      .feature-image {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
        transition: transform 0.3s ease;
      }
      .feature-image:hover {
        transform: scale(1.02);
      }
      html[data-theme="dark"] .feature-image {
        box-shadow: 0 15px 40px rgba(0,0,0,0.3);
      }
      .feature-text .feature-tag {
        display: inline-block;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 1rem;
      }
      .feature-text h2 {
        font-weight: 700;
        margin-bottom: 1rem;
      }
      .feature-text p {
        font-size: 1.1rem;
        line-height: 1.7;
      }
      html[data-theme="light"] .feature-text p {
        color: #4a5568 !important;
      }
      html[data-theme="dark"] .feature-text p {
        color: rgba(255,255,255,0.7) !important;
      }

      .tag-communication { background-color: rgba(59, 130, 246, 0.15); color: #60a5fa; }
      .tag-pedagogy { background-color: rgba(16, 185, 129, 0.15); color: #34d399; }
      .tag-organization { background-color: rgba(251, 191, 36, 0.15); color: #fbbf24; }
      html[data-theme="light"] .tag-communication { background-color: rgba(13, 110, 253, 0.1); color: #0d6efd; }
      html[data-theme="light"] .tag-pedagogy { background-color: rgba(25, 135, 84, 0.1); color: #198754; }
      html[data-theme="light"] .tag-organization { background-color: rgba(255, 193, 7, 0.15); color: #d4a800; }

      /* CTA Section */
      .cta-section {
        border-radius: 20px;
        padding: 4rem 2rem;
        background: rgba(255, 255, 255, 0.04) !important;
        backdrop-filter: blur(8px) !important;
        -webkit-backdrop-filter: blur(8px) !important;
        border: 1px solid rgba(255, 255, 255, 0.06) !important;
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
      }
      .cta-section.is-visible {
        opacity: 1;
        transform: translateY(0);
      }
      [data-theme="dark"] .cta-section {
        background: rgba(255, 255, 255, 0.02) !important;
      }
      .cta-section h2 {
        font-weight: 700;
      }

      /* About Section */
      .animated-section-on-scroll {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
      }
      .animated-section-on-scroll.is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* White BG Section */
      .white-bg-section {
        background: rgba(255, 255, 255, 0.04) !important;
        border-radius: 20px;
        padding: 2rem;
      }
      [data-theme="dark"] .white-bg-section {
        background: rgba(255, 255, 255, 0.02) !important;
      }
      .white-bg-section .stat-card {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0;
      }
      .white-bg-section .stat-card:hover {
        transform: none;
      }
      .white-bg-section, .white-bg-section h2, .white-bg-section .stat-number {
        color: var(--text-color, #1a1a2e) !important;
      }
      [data-theme="dark"] .white-bg-section, 
      [data-theme="dark"] .white-bg-section h2, 
      [data-theme="dark"] .white-bg-section .stat-number {
        color: #ffffff !important;
      }
      .white-bg-section .lead, .white-bg-section .stat-label, .white-bg-section p {
        color: var(--text-muted, #4a5568) !important;
      }
      [data-theme="dark"] .white-bg-section .lead, 
      [data-theme="dark"] .white-bg-section .stat-label, 
      [data-theme="dark"] .white-bg-section p {
        color: rgba(255, 255, 255, 0.6) !important;
      }

      /* Theme toggle button icons */
      #themeToggle .moon-icon { display: block; }
      #themeToggle .sun-icon { display: none; }
      html[data-theme="dark"] #themeToggle .moon-icon { display: none; }
      html[data-theme="dark"] #themeToggle .sun-icon { display: block; }

      /* Back to Top Button */
      .back-to-top-btn {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 50px;
        height: 50px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.08) !important;
        backdrop-filter: blur(12px) !important;
        -webkit-backdrop-filter: blur(12px) !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transform: translateY(20px);
        pointer-events: none;
        text-decoration: none;
        color: var(--text-color, #1a1a2e);
      }
      .back-to-top-btn.visible {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
      }
      .back-to-top-btn:hover {
        transform: scale(1.1) translateY(-3px);
        background: rgba(255, 255, 255, 0.15) !important;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
      }
      [data-theme="dark"] .back-to-top-btn {
        color: #e0e0e0;
        border-color: rgba(255, 255, 255, 0.06);
      }
      [data-theme="dark"] .back-to-top-btn:hover {
        color: #ffffff;
      }

      /* Animations */
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Avatar dans la barre de navigation */
      .navbar-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(255, 255, 255, 0.15);
        transition: all 0.3s ease;
      }
      .navbar-avatar:hover {
        transform: scale(1.08);
        border-color: var(--bs-primary, #0d6efd);
      }

      .navbar-avatar-placeholder {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        background: linear-gradient(135deg, var(--bs-primary, #0d6efd), var(--bs-info, #0dcaf0));
        color: white;
        font-size: 1rem;
        border: 2px solid rgba(255, 255, 255, 0.15);
        transition: all 0.3s ease;
      }
      .navbar-avatar-placeholder:hover {
        transform: scale(1.08);
      }

      /* Dropdown Glassmorphism */
      .dropdown-menu {
        background: rgba(255, 255, 255, 0.08) !important;
        backdrop-filter: blur(16px) !important;
        -webkit-backdrop-filter: blur(16px) !important;
        border: 1px solid rgba(255, 255, 255, 0.06) !important;
        border-radius: 0.75rem !important;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1) !important;
      }
      [data-theme="dark"] .dropdown-menu {
        background: rgba(17, 24, 39, 0.8) !important;
        border: 1px solid rgba(255, 255, 255, 0.04) !important;
      }
      .dropdown-menu .dropdown-item {
        color: var(--text-color, #1a1a2e) !important;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        transition: all 0.2s ease;
      }
      [data-theme="dark"] .dropdown-menu .dropdown-item {
        color: #e0e0e0 !important;
      }
      .dropdown-menu .dropdown-item:hover {
        background: rgba(13, 110, 253, 0.08) !important;
        color: var(--bs-primary, #0d6efd) !important;
      }
      [data-theme="dark"] .dropdown-menu .dropdown-item:hover {
        background: rgba(255, 255, 255, 0.05) !important;
        color: #ffffff !important;
      }
      .dropdown-menu .dropdown-item.text-danger:hover {
        background: rgba(220, 53, 69, 0.1) !important;
        color: #dc3545 !important;
      }
      .dropdown-menu .dropdown-divider {
        border-color: rgba(255, 255, 255, 0.06);
      }
      [data-theme="dark"] .dropdown-menu .dropdown-divider {
        border-color: rgba(255, 255, 255, 0.04);
      }

      /* Responsive */
      @media (max-width: 768px) {
        .hero-section .display-3 {
          font-size: 2.5rem;
        }
        .hero-section {
          padding-top: 80px;
          min-height: 90vh;
        }
        .stats-section .stat-number {
          font-size: 2rem;
        }
        .feature-item {
          margin-bottom: 3rem;
        }
        .feature-text h2 {
          font-size: 1.5rem;
        }
        .cta-section {
          padding: 2rem 1rem;
        }
        .navbar {
          top: 0.5rem;
          width: calc(100% - 16px);
          border-radius: 1rem !important;
          padding: 0.5rem 1rem !important;
        }
        .back-to-top-btn {
          bottom: 20px;
          right: 20px;
          width: 44px;
          height: 44px;
        }
        .btn-success, .btn-outline-light {
          padding: 10px 20px !important;
          font-size: 0.9rem !important;
        }
      }

      @media (max-width: 576px) {
        .hero-section .display-3 {
          font-size: 2rem;
        }
        .hero-section .lead {
          font-size: 1rem;
        }
        .stats-section .stat-number {
          font-size: 1.75rem;
        }
        .feature-text p {
          font-size: 0.95rem;
        }
        .navbar-avatar {
          width: 30px;
          height: 30px;
        }
        .navbar-avatar-placeholder {
          width: 30px;
          height: 30px;
          font-size: 0.8rem;
        }
      }
    </style>
  </head>
  <body>
