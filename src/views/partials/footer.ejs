<!-- Styles pour le widget de chat -->
<style>
/* ==========================================================================
   Widget Chat Flottant - Style Glassmorphism
   ========================================================================== */

/* Bouton flottant */
.chat-float-btn {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: none;
    background: linear-gradient(135deg, rgba(13, 110, 253, 0.85), rgba(13, 202, 240, 0.85)) !important;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 8px 32px rgba(13, 110, 253, 0.3);
    color: white;
    cursor: pointer;
    z-index: 1050;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: float-bounce 2s ease-in-out infinite;
}

.chat-float-btn:hover {
    transform: scale(1.1) translateY(-3px);
    box-shadow: 0 12px 40px rgba(13, 110, 253, 0.4);
}

.chat-float-btn:active {
    transform: scale(0.95);
}

@keyframes float-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
}

/* Badge de notification */
.chat-float-btn .icon-badge-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.chat-float-btn .chat-badge {
    position: absolute;
    top: -12px;
    right: -12px;
    background: #dc3545;
    color: white;
    border-radius: 50%;
    min-width: 20px;
    height: 20px;
    font-size: 0.6rem;
    font-weight: 700;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    animation: badge-pop 0.3s ease-out;
}

.chat-float-btn .chat-badge.show {
    display: flex;
}

@keyframes badge-pop {
    from { transform: scale(0); }
    to { transform: scale(1); }
}

/* Panneau de chat Glassmorphism */
.chat-panel {
    position: fixed;
    bottom: 100px;
    right: 30px;
    width: 360px;
    max-height: 500px;
    background: rgba(255, 255, 255, 0.08) !important;
    backdrop-filter: blur(16px) !important;
    -webkit-backdrop-filter: blur(16px) !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    border-radius: 1.25rem !important;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15) !important;
    overflow: hidden;
    z-index: 1051;
    display: none;
    flex-direction: column;
    animation: panel-slide-up 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

[data-theme="dark"] .chat-panel {
    background: rgba(17, 24, 39, 0.8) !important;
    border: 1px solid rgba(255, 255, 255, 0.06) !important;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5) !important;
}

.chat-panel.open {
    display: flex;
}

@keyframes panel-slide-up {
    from {
        opacity: 0;
        transform: translateY(20px) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* En-tête du panneau */
.chat-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    background: rgba(13, 110, 253, 0.06);
    border-bottom: 1px solid rgba(13, 110, 253, 0.08);
    flex-shrink: 0;
}

[data-theme="dark"] .chat-panel-header {
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

.chat-panel-header h6 {
    margin: 0;
    font-weight: 600;
    color: var(--text-color, #212529);
    display: flex;
    align-items: center;
}

[data-theme="dark"] .chat-panel-header h6 {
    color: #ffffff;
}

.chat-panel-header .chat-panel-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--text-muted, #6c757d);
    cursor: pointer;
    padding: 0 4px;
    transition: all 0.3s ease;
}

.chat-panel-header .chat-panel-close:hover {
    color: #dc3545;
    transform: rotate(90deg);
}

[data-theme="dark"] .chat-panel-header .chat-panel-close {
    color: rgba(255, 255, 255, 0.5);
}

[data-theme="dark"] .chat-panel-header .chat-panel-close:hover {
    color: #ff6b6b;
}

.chat-panel-back {
    background: none;
    border: none;
    color: var(--text-muted, #6c757d);
    cursor: pointer;
    padding: 0 8px 0 0;
    font-size: 1.2rem;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
}

.chat-panel-back:hover {
    color: var(--bs-primary, #0d6efd);
    transform: translateX(-3px);
}

[data-theme="dark"] .chat-panel-back {
    color: rgba(255, 255, 255, 0.5);
}

[data-theme="dark"] .chat-panel-back:hover {
    color: #ffffff;
}

/* Corps du panneau */
.chat-panel-body {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem;
    min-height: 200px;
    max-height: 300px;
}

.chat-panel-body::-webkit-scrollbar {
    width: 4px;
}

.chat-panel-body::-webkit-scrollbar-track {
    background: transparent;
}

.chat-panel-body::-webkit-scrollbar-thumb {
    background: rgba(13, 110, 253, 0.3);
    border-radius: 10px;
}

[data-theme="dark"] .chat-panel-body::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
}

/* Éléments de la liste des conversations */
.chat-conversation-item {
    display: flex;
    align-items: center;
    padding: 0.6rem 0.8rem;
    border-radius: 0.75rem;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    animation: list-item-fade 0.3s ease forwards;
    opacity: 0;
    transform: translateX(-10px);
}

@keyframes list-item-fade {
    from {
        opacity: 0;
        transform: translateX(-10px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

.chat-conversation-item:hover {
    background: rgba(13, 110, 253, 0.06);
}

[data-theme="dark"] .chat-conversation-item:hover {
    background: rgba(255, 255, 255, 0.04);
}

.chat-conversation-item .conv-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
