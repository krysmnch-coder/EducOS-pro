        transform: scale(0.9);
    }

    @keyframes message-pop {
        from {
            opacity: 0;
            transform: scale(0.9) translateY(5px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .chat-message.sent {
        background: rgba(13, 110, 253, 0.12) !important;
        margin-left: auto;
        border-bottom-right-radius: 0.25rem !important;
        border: 1px solid rgba(13, 110, 253, 0.08) !important;
    }

    .chat-message.received {
        background: rgba(255, 255, 255, 0.06) !important;
        margin-right: auto;
        border-bottom-left-radius: 0.25rem !important;
        border: 1px solid rgba(255, 255, 255, 0.04) !important;
    }

    [data-theme="dark"] .chat-message.sent {
        background: rgba(13, 110, 253, 0.2) !important;
        border: 1px solid rgba(13, 110, 253, 0.1) !important;
    }

    [data-theme="dark"] .chat-message.received {
        background: rgba(255, 255, 255, 0.04) !important;
        border: 1px solid rgba(255, 255, 255, 0.02) !important;
    }

    .chat-message .message-text {
        color: var(--text-color, #212529);
        font-size: 0.9rem;
    }

    [data-theme="dark"] .chat-message .message-text {
        color: #e0e0e0;
    }

    .chat-message .message-meta {
        font-size: 0.6rem;
        opacity: 0.5;
        margin-top: 0.2rem;
        color: var(--text-color, #212529);
    }

    [data-theme="dark"] .chat-message .message-meta {
        color: rgba(255, 255, 255, 0.4);
    }

    /* État vide */
    .chat-empty-state {
        text-align: center;
        padding: 2rem 0.5rem;
        color: var(--text-muted, #6c757d);
    }

    [data-theme="dark"] .chat-empty-state {
        color: rgba(255, 255, 255, 0.4);
    }

    .chat-empty-state svg {
        opacity: 0.4;
        margin-bottom: 0.5rem;
    }

    /* Adaptation mobile */
    @media (max-width: 768px) {
        .chat-panel {
            width: calc(100vw - 40px);
            max-height: 70vh;
            bottom: 90px;
            right: 20px;
        }

        .chat-float-btn {
            width: 54px;
            height: 54px;
            bottom: 20px;
            right: 20px;
        }

        .chat-float-btn svg {
            width: 22px;
            height: 22px;
        }

        .chat-panel-body {
            max-height: 250px;
            min-height: 150px;
        }

        .chat-user-item .chat-avatar {
            width: 36px;
            height: 36px;
        }
    }

    @media (max-width: 576px) {
        .chat-panel {
            width: calc(100vw - 20px);
            right: 10px;
            bottom: 80px;
            max-height: 60vh;
        }

        .chat-float-btn {
            width: 48px;
            height: 48px;
            bottom: 16px;
            right: 16px;
        }

        .chat-float-btn svg {
            width: 20px;
            height: 20px;
        }
    }
</style>

<!-- Scripts -->
<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/theme.js"></script>
<script src="/js/chat-widget.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Gestion du bouton flottant
        const floatBtn = document.getElementById('chatFloatBtn');
        const chatPanel = document.getElementById('chatPanel');
        const closeBtns = document.querySelectorAll('.chat-panel-close');

        if (floatBtn) {
            floatBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                if (chatPanel.classList.contains('open')) {
                    chatPanel.classList.remove('open');
                } else {
                    chatPanel.classList.add('open');
                    // Focus sur l'input si disponible
                    const input = document.getElementById('chat-widget-input');
                    if (input) setTimeout(() => input.focus(), 300);
                }
            });
        }

        closeBtns.forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                chatPanel.classList.remove('open');
            });
        });

        // Fermer le panneau en cliquant à l'extérieur
        document.addEventListener('click', function(e) {
            if (chatPanel && chatPanel.classList.contains('open')) {
                if (!chatPanel.contains(e.target) && !floatBtn.contains(e.target)) {
                    chatPanel.classList.remove('open');
                }
            }
        });

        // Remplacer les icônes Feather si disponibles
        if (typeof feather !== 'undefined') {
            feather.replace();
        }
    });
</script>