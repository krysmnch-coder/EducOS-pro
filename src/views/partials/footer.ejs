<!-- Bouton de chat flottant -->
<button class="chat-float-btn" id="chatFloatBtn">
    <div class="icon-badge-wrapper">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        <span class="chat-badge" id="chatBadge"></span>
    </div>
</button>

<!-- Panneau de chat flottant -->
<div class="chat-panel" id="chatPanel">
    <!-- Écran 1: Liste des conversations -->
    <div id="chat-widget-list-view" class="chat-widget-screen">
        <div class="chat-panel-header">
            <h6>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                Chat
            </h6>
            <button class="chat-panel-close" id="chatCloseBtn">&times;</button>
        </div>
        <div class="chat-panel-body" id="chat-widget-user-list">
            <!-- Les conversations seront chargées ici -->
            <div class="text-center p-4"><div class="spinner-border spinner-border-sm" role="status"></div></div>
        </div>
    </div>

    <!-- Écran 2: Fenêtre de chat active (cachée par défaut) -->
    <div id="chat-widget-conversation-view" class="chat-widget-screen" style="display: none;">
        <div class="chat-panel-header">
            <button class="chat-panel-back" id="chat-widget-back-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            </button>
            <h6 id="chat-widget-header-name"></h6>
            <button class="chat-panel-close" id="chat-widget-close-btn-alt">&times;</button>
        </div>
        <div class="chat-panel-body" id="chat-widget-messages">
            <!-- Les messages seront chargés ici -->
        </div>
        <div class="chat-panel-footer">
            <input type="text" id="chat-widget-input" placeholder="Écrivez un message..." autocomplete="off">
            <button id="chat-widget-send-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            </button>
        </div>
    </div>
</div>

<style>
    /* ==========================================================================
       Chat Widget - Style Glassmorphism
       ========================================================================== */
    
    /* Bouton flottant */
    .chat-float-btn {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        border: none;
        background: linear-gradient(135deg, rgba(13, 110, 253, 0.8), rgba(13, 202, 240, 0.8)) !important;
        backdrop-filter: blur(8px) !important;
        -webkit-backdrop-filter: blur(8px) !important;
        box-shadow: 0 4px 25px rgba(13, 110, 253, 0.3);
        color: #ffffff;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        z-index: 1040;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: float-btn-pop 0.5s ease forwards !important;
        opacity: 0;
        transform: scale(0.8);
    }

    @keyframes float-btn-pop {
        from {
            opacity: 0;
            transform: scale(0.8) translateY(20px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .chat-float-btn:hover {
        transform: scale(1.1) translateY(-3px);
        box-shadow: 0 8px 40px rgba(13, 110, 253, 0.4);
    }

    .chat-float-btn:active {
        transform: scale(0.95);
    }

    [data-theme="dark"] .chat-float-btn {
        background: linear-gradient(135deg, rgba(13, 110, 253, 0.9), rgba(13, 202, 240, 0.9)) !important;
        box-shadow: 0 4px 25px rgba(13, 110, 253, 0.2);
    }

    [data-theme="dark"] .chat-float-btn:hover {
        box-shadow: 0 8px 40px rgba(13, 110, 253, 0.3);
    }

    /* Badge de notification */
    .icon-badge-wrapper {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .chat-badge {
        position: absolute;
        top: -8px;
        right: -10px;
        background: #dc3545;
        color: #ffffff;
        border-radius: 50%;
        min-width: 20px;
        height: 20px;
        font-size: 0.6rem;
        font-weight: 700;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 0 5px;
        border: 2px solid #ffffff;
        animation: badge-pop 0.3s ease forwards;
    }

    @keyframes badge-pop {
        from {
            transform: scale(0.5);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .chat-badge.show {
        display: flex;
    }

    [data-theme="dark"] .chat-badge {
        border-color: #1a1a2e;
    }

    /* Panneau de chat Glassmorphism */
    .chat-panel {
        position: fixed;
        bottom: 100px;
        right: 30px;
        width: 380px;
        max-height: 500px;
        background: rgba(255, 255, 255, 0.08) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        border-radius: 1.25rem !important;
        box-shadow: 0 8px 40px rgba(0, 0, 0, 0.1) !important;
        overflow: hidden;
        display: none;
        flex-direction: column;
        z-index: 1041;
        animation: panel-slide-up 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards !important;
        transform-origin: bottom right;
        transition: all 0.3s ease;
    }

    @keyframes panel-slide-up {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .chat-panel.open {
        display: flex;
    }

    [data-theme="dark"] .chat-panel {
        background: rgba(22, 33, 62, 0.6) !important;
        border: 1px solid rgba(255, 255, 255, 0.06) !important;
        box-shadow: 0 8px 40px rgba(0, 0, 0, 0.4) !important;
    }

    /* En-tête du panneau */
    .chat-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.85rem 1.25rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        flex-shrink: 0;
        background: rgba(255, 255, 255, 0.02);
    }

    [data-theme="dark"] .chat-panel-header {
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .chat-panel-header h6 {
        margin: 0;
        font-weight: 600;
        color: var(--text-color, #212529);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    [data-theme="dark"] .chat-panel-header h6 {
        color: #ffffff;
    }

    .chat-panel-header h6 svg {
        color: var(--bs-primary, #0d6efd);
    }

    [data-theme="dark"] .chat-panel-header h6 svg {
        color: #8ab4f8;
    }

    /* Boutons d'en-tête */
    .chat-panel-close,
    .chat-panel-back {
        background: transparent;
        border: none;
        color: var(--text-muted, #6c757d);
        font-size: 1.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
        padding: 0.2rem 0.4rem;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .chat-panel-close:hover,
    .chat-panel-back:hover {
        background: rgba(220, 53, 69, 0.1);
        color: #dc3545;
        transform: rotate(90deg);
    }

    .chat-panel-back:hover {
        background: rgba(13, 110, 253, 0.1);
        color: var(--bs-primary, #0d6efd);
        transform: translateX(-3px);
    }

    [data-theme="dark"] .chat-panel-close:hover,
    [data-theme="dark"] .chat-panel-back:hover {
        color: #ffffff;
    }

    [data-theme="dark"] .chat-panel-close:hover {
        background: rgba(255, 107, 107, 0.15);
        color: #ff6b6b;
    }

    [data-theme="dark"] .chat-panel-back:hover {
        background: rgba(255, 255, 255, 0.05);
        color: #ffffff;
    }

    /* Corps du panneau */
    .chat-panel-body {
        flex: 1;
        overflow-y: auto;
        padding: 0.5rem 0.75rem;
        max-height: 350px;
        min-height: 200px;
    }

    .chat-panel-body::-webkit-scrollbar {
        width: 4px;
    }

    .chat-panel-body::-webkit-scrollbar-track {
        background: transparent;
    }

    .chat-panel-body::-webkit-scrollbar-thumb {
        background: rgba(13, 110, 253, 0.3);
        border-radius: 10px;
    }

    [data-theme="dark"] .chat-panel-body::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
    }

    /* Pied du panneau */
    .chat-panel-footer {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        flex-shrink: 0;
        background: rgba(255, 255, 255, 0.02);
    }

    [data-theme="dark"] .chat-panel-footer {
        border-top: 1px solid rgba(255, 255, 255, 0.04);
    }

    .chat-panel-footer input {
        flex: 1;
        background: rgba(255, 255, 255, 0.06) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 0.75rem !important;
        padding: 0.5rem 0.85rem !important;
        color: var(--text-color, #212529) !important;
        font-size: 0.9rem;
        transition: all 0.3s ease !important;
        outline: none;
    }

    .chat-panel-footer input:focus {
        background: rgba(255, 255, 255, 0.1) !important;
        border-color: var(--bs-primary, #0d6efd) !important;
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.08) !important;
    }

    [data-theme="dark"] .chat-panel-footer input {
        background: rgba(255, 255, 255, 0.04) !important;
        border: 1px solid rgba(255, 255, 255, 0.06) !important;
        color: #ffffff !important;
    }

    [data-theme="dark"] .chat-panel-footer input::placeholder {
        color: rgba(255, 255, 255, 0.4);
    }

    [data-theme="dark"] .chat-panel-footer input:focus {
        background: rgba(255, 255, 255, 0.08) !important;
        border-color: #ffffff !important;
        box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.06) !important;
    }

    /* Bouton d'envoi */
    #chat-widget-send-btn {
        background: linear-gradient(135deg, rgba(13, 110, 253, 0.2), rgba(13, 202, 240, 0.2)) !important;
        backdrop-filter: blur(8px) !important;
        -webkit-backdrop-filter: blur(8px) !important;
        border: 1px solid rgba(13, 110, 253, 0.15) !important;
        border-radius: 0.75rem !important;
        padding: 0.5rem 0.85rem !important;
        color: var(--bs-primary, #0d6efd) !important;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    #chat-widget-send-btn:hover:not(:disabled) {
        transform: translateY(-2px) scale(1.05) !important;
        box-shadow: 0 4px 20px rgba(13, 110, 253, 0.15) !important;
        background: linear-gradient(135deg, rgba(13, 110, 253, 0.3), rgba(13, 202, 240, 0.3)) !important;
    }

    #chat-widget-send-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    [data-theme="dark"] #chat-widget-send-btn {
        color: #ffffff !important;
        border-color: rgba(255, 255, 255, 0.1) !important;
        background: rgba(255, 255, 255, 0.05) !important;
    }

    [data-theme="dark"] #chat-widget-send-btn:hover:not(:disabled) {
        background: rgba(255, 255, 255, 0.1) !important;
        box-shadow: 0 4px 20px rgba(255, 255, 255, 0.05) !important;
        border-color: #ffffff !important;
    }

    /* Éléments de la liste des conversations */
    .chat-user-item {
        display: flex;
        align-items: center;
        padding: 0.6rem 0.75rem;
        border-radius: 0.75rem;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-bottom: 0.25rem;
        animation: list-item-fade 0.3s ease forwards !important;
        opacity: 0;
        transform: translateX(-10px);
    }

    @keyframes list-item-fade {
        from {
            opacity: 0;
            transform: translateX(-10px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .chat-user-item:hover {
        background: rgba(13, 110, 253, 0.06) !important;
        transform: translateX(3px);
    }

    [data-theme="dark"] .chat-user-item:hover {
        background: rgba(255, 255, 255, 0.04) !important;
    }

    .chat-user-item .chat-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(13, 110, 253, 0.1);
        margin-right: 0.75rem;
        transition: all 0.3s ease;
    }

    .chat-user-item:hover .chat-avatar {
        border-color: var(--bs-primary, #0d6efd);
        transform: scale(1.05);
    }

    [data-theme="dark"] .chat-user-item .chat-avatar {
        border-color: rgba(255, 255, 255, 0.1);
    }

    .chat-user-item .chat-user-info {
        flex: 1;
        min-width: 0;
    }

    .chat-user-item .chat-user-info .chat-user-name {
        font-weight: 500;
        color: var(--text-color, #212529);
        font-size: 0.9rem;
    }

    [data-theme="dark"] .chat-user-item .chat-user-info .chat-user-name {
        color: #e0e0e0;
    }

    .chat-user-item .chat-user-info .chat-last-message {
        font-size: 0.8rem;
        color: var(--text-muted, #6c757d);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    [data-theme="dark"] .chat-user-item .chat-user-info .chat-last-message {
        color: rgba(255, 255, 255, 0.4);
    }

    .chat-user-item .chat-user-time {
        font-size: 0.7rem;
        color: var(--text-muted, #6c757d);
        flex-shrink: 0;
        margin-left: 0.5rem;
    }

    [data-theme="dark"] .chat-user-item .chat-user-time {
        color: rgba(255, 255, 255, 0.3);
    }

    .chat-user-item .chat-unread-badge {
        background: var(--bs-primary, #0d6efd);
        color: #ffffff;
        font-size: 0.65rem;
        font-weight: 600;
        padding: 0.1rem 0.5rem;
        border-radius: 0.75rem;
        min-width: 20px;
        text-align: center;
        margin-left: 0.5rem;
    }

    [data-theme="dark"] .chat-user-item .chat-unread-badge {
        background: #8ab4f8;
        color: #1a1a2e;
    }

    /* Messages dans la conversation */
    .chat-message {
        max-width: 85%;
        margin-bottom: 0.5rem;
        padding: 0.5rem 0.85rem;
