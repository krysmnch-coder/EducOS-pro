    margin-top: 0.2rem;
    text-align: right;
}

[data-theme="dark"] .chat-widget-message .msg-time {
    color: rgba(255, 255, 255, 0.3);
}

/* Pied du panneau */
.chat-panel-footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
    background: rgba(255, 255, 255, 0.04);
    border-top: 1px solid rgba(13, 110, 253, 0.06);
    flex-shrink: 0;
}

[data-theme="dark"] .chat-panel-footer {
    background: rgba(255, 255, 255, 0.02);
    border-top: 1px solid rgba(255, 255, 255, 0.04);
}

.chat-panel-footer input {
    flex: 1;
    border: none;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 0.75rem;
    padding: 0.5rem 0.8rem;
    color: var(--text-color, #212529);
    outline: none;
    font-size: 0.9rem;
    transition: all 0.3s ease;
}

.chat-panel-footer input:focus {
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.15);
}

[data-theme="dark"] .chat-panel-footer input {
    background: rgba(255, 255, 255, 0.04);
