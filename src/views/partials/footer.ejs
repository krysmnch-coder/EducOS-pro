<!-- Bouton de chat flottant -->
<button class="chat-float-btn" id="chatFloatBtn">
    <div class="icon-badge-wrapper">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        <span class="chat-badge" id="chatBadge"></span>
    </div>
</button>

<!-- Panneau de chat flottant -->
<div class="chat-panel" id="chatPanel">
    <!-- Écran 1: Liste des conversations -->
    <div id="chat-widget-list-view" class="chat-widget-screen">
        <div class="chat-panel-header">
            <h6>Chat</h6>
            <button class="chat-panel-close" id="chatCloseBtn">&times;</button>
        </div>
        <div class="chat-panel-body" id="chat-widget-user-list">
            <!-- Les conversations seront chargées ici -->
            <div class="text-center p-4"><div class="spinner-border spinner-border-sm" role="status"></div></div>
        </div>
    </div>

    <!-- Écran 2: Fenêtre de chat active (cachée par défaut) -->
    <div id="chat-widget-conversation-view" class="chat-widget-screen" style="display: none;">
        <div class="chat-panel-header">
            <button class="chat-panel-back" id="chat-widget-back-btn">&larr;</button>
            <h6 id="chat-widget-header-name"></h6>
            <button class="chat-panel-close" id="chat-widget-close-btn-alt">&times;</button>
        </div>
        <div class="chat-panel-body" id="chat-widget-messages">
            <!-- Les messages seront chargés ici -->
        </div>
        <div class="chat-panel-footer">
            <input type="text" id="chat-widget-input" placeholder="Écrivez un message..." autocomplete="off">
            <button id="chat-widget-send-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            </button>
        </div>
    </div>
</div>

<style>
    /* ==========================================================================
       Chat Widget - Style Glassmorphism
       ========================================================================== */
    
    /* Bouton flottant */
    .chat-float-btn {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        border: none;
        background: linear-gradient(135deg, rgba(13, 110, 253, 0.25), rgba(13, 202, 240, 0.25)) !important;
        backdrop-filter: blur(12px) !important;
        -webkit-backdrop-filter: blur(12px) !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        box-shadow: 0 8px 32px rgba(13, 110, 253, 0.2) !important;
        color: var(--bs-primary, #0d6efd) !important;
        cursor: pointer;
        z-index: 1050;
        transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: float-btn-appear 0.6s ease forwards !important;
        opacity: 0;
        transform: scale(0.8) translateY(20px);
    }
    
    .chat-float-btn:hover {
        transform: scale(1.1) translateY(-3px) !important;
        box-shadow: 0 12px 48px rgba(13, 110, 253, 0.3) !important;
        background: linear-gradient(135deg, rgba(13, 110, 253, 0.35), rgba(13, 202, 240, 0.35)) !important;
    }
    
    .chat-float-btn:active {
        transform: scale(0.95) !important;
    }
    
    @keyframes float-btn-appear {
        from {
            opacity: 0;
            transform: scale(0.8) translateY(20px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }
    
    [data-theme="dark"] .chat-float-btn {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #ffffff !important;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3) !important;
    }
    
    [data-theme="dark"] .chat-float-btn:hover {
        background: rgba(255, 255, 255, 0.1) !important;
        box-shadow: 0 12px 48px rgba(0, 0, 0, 0.4) !important;
    }
    
    /* Badge sur le bouton */
    .chat-float-btn .icon-badge-wrapper {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    
    .chat-float-btn .chat-badge {
        position: absolute;
        top: -8px;
        right: -8px;
        background: #dc3545;
        color: #ffffff;
        border-radius: 50%;
        font-size: 0.6rem;
        font-weight: 600;
        min-width: 18px;
        height: 18px;
        display: none;
        align-items: center;
        justify-content: center;
        border: 2px solid rgba(255, 255, 255, 0.8);
        padding: 0 4px;
        animation: badge-pop 0.4s ease forwards !important;
    }
    
    .chat-float-btn .chat-badge.show {
        display: flex;
    }
    
    @keyframes badge-pop {
        from {
            opacity: 0;
            transform: scale(0.5);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }
    
    [data-theme="dark"] .chat-float-btn .chat-badge {
        border-color: rgba(255, 255, 255, 0.1);
    }
    
    /* Panneau de chat */
    .chat-panel {
        position: fixed;
        bottom: 100px;
        right: 30px;
        width: 380px;
        max-width: calc(100vw - 40px);
        max-height: 500px;
        height: 500px;
        background: rgba(255, 255, 255, 0.12) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        border: 1px solid rgba(255, 255, 255, 0.15) !important;
        border-radius: 1.25rem !important;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15) !important;
        z-index: 1060;
        display: none;
        flex-direction: column;
        overflow: hidden;
        animation: panel-slide-up 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards !important;
        opacity: 0;
        transform: translateY(20px) scale(0.95);
    }
    
    .chat-panel.open {
        display: flex;
    }
    
    @keyframes panel-slide-up {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
    
    @keyframes panel-slide-down {
        from {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
        to {
            opacity: 0;
            transform: translateY(20px) scale(0.95);
        }
    }
    
    .chat-panel.closing {
        animation: panel-slide-down 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards !important;
    }
    
    [data-theme="dark"] .chat-panel {
        background: rgba(18, 18, 30, 0.85) !important;
        border: 1px solid rgba(255, 255, 255, 0.06) !important;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5) !important;
    }
    
    /* En-tête du panneau */
    .chat-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        flex-shrink: 0;
    }
    
    .chat-panel-header h6 {
        margin: 0;
        font-weight: 600;
        color: var(--text-color, #212529);
        font-size: 0.95rem;
    }
    
    [data-theme="dark"] .chat-panel-header h6 {
        color: #ffffff;
    }
    
    .chat-panel-close,
    .chat-panel-back {
        background: rgba(255, 255, 255, 0.05);
        border: none;
        border-radius: 50%;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        color: var(--text-color, #212529);
        font-size: 1.2rem;
    }
    
    .chat-panel-close:hover,
    .chat-panel-back:hover {
        background: rgba(13, 110, 253, 0.1);
        transform: scale(1.1);
    }
    
    [data-theme="dark"] .chat-panel-close,
    [data-theme="dark"] .chat-panel-back {
        color: #e0e0e0;
        background: rgba(255, 255, 255, 0.03);
    }
    
    [data-theme="dark"] .chat-panel-close:hover,
    [data-theme="dark"] .chat-panel-back:hover {
        background: rgba(255, 255, 255, 0.08);
    }
    
    /* Corps du panneau */
    .chat-panel-body {
        flex: 1;
        overflow-y: auto;
        padding: 0.75rem 1rem;
        background: transparent;
    }
    
    /* Scrollbar personnalisée */
    .chat-panel-body::-webkit-scrollbar {
        width: 4px;
    }
    
    .chat-panel-body::-webkit-scrollbar-track {
        background: transparent;
    }
    
    .chat-panel-body::-webkit-scrollbar-thumb {
        background: rgba(13, 110, 253, 0.2);
        border-radius: 10px;
    }
    
    [data-theme="dark"] .chat-panel-body::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.15);
    }
    
    /* Liste des utilisateurs */
    .chat-widget-user-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.8rem;
        border-radius: 0.75rem;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        animation: user-item-fade 0.4s ease forwards !important;
        opacity: 0;
        transform: translateX(-10px);
        margin-bottom: 0.25rem;
    }
    
    @keyframes user-item-fade {
        from {
            opacity: 0;
            transform: translateX(-10px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
    
    .chat-widget-user-item:hover {
        background: rgba(13, 110, 253, 0.06);
        transform: translateX(3px);
    }
    
    [data-theme="dark"] .chat-widget-user-item:hover {
        background: rgba(255, 255, 255, 0.04);
    }
    
    .chat-widget-user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(13, 110, 253, 0.1);
        transition: all 0.3s ease;
    }
    
    .chat-widget-user-avatar:hover {
        transform: scale(1.05);
        border-color: var(--bs-primary, #0d6efd);
    }
    
    [data-theme="dark"] .chat-widget-user-avatar {
        border-color: rgba(255, 255, 255, 0.1);
    }
    
    .chat-widget-user-info {
        flex: 1;
        min-width: 0;
    }
    
    .chat-widget-user-name {
        font-weight: 500;
        font-size: 0.9rem;
        color: var(--text-color, #212529);
    }
    
    [data-theme="dark"] .chat-widget-user-name {
        color: #e0e0e0;
    }
    
    .chat-widget-user-last {
        font-size: 0.75rem;
        color: var(--text-muted, #6c757d);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    [data-theme="dark"] .chat-widget-user-last {
        color: rgba(255, 255, 255, 0.4);
    }
    
    .chat-widget-user-time {
        font-size: 0.65rem;
        color: var(--text-muted, #6c757d);
        white-space: nowrap;
        flex-shrink: 0;
    }
    
    [data-theme="dark"] .chat-widget-user-time {
        color: rgba(255, 255, 255, 0.3);
    }
    
    /* Messages */
    .chat-widget-message {
        max-width: 80%;
        margin-bottom: 0.5rem;
        padding: 0.5rem 0.8rem;
        border-radius: 0.75rem;
        word-wrap: break-word;
        animation: message-pop 0.3s ease forwards !important;
        opacity: 0;
        transform: scale(0.9);
    }
    
    @keyframes message-pop {
        from {
            opacity: 0;
            transform: scale(0.9) translateY(5px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }
    
    .chat-widget-message.sent {
        background: rgba(13, 110, 253, 0.12) !important;
        margin-left: auto;
        border-bottom-right-radius: 0.25rem !important;
        border: 1px solid rgba(13, 110, 253, 0.08) !important;
        color: var(--bs-primary, #0d6efd);
    }
    
    .chat-widget-message.received {
        background: rgba(255, 255, 255, 0.06) !important;
        margin-right: auto;
        border-bottom-left-radius: 0.25rem !important;
        border: 1px solid rgba(255, 255, 255, 0.04) !important;
        color: var(--text-color, #212529);
    }
    
    [data-theme="dark"] .chat-widget-message.sent {
        background: rgba(13, 110, 253, 0.15) !important;
        border: 1px solid rgba(13, 110, 253, 0.1) !important;
        color: #ffffff;
    }
    
    [data-theme="dark"] .chat-widget-message.received {
        background: rgba(255, 255, 255, 0.04) !important;
        color: #e0e0e0;
    }
    
    .chat-widget-message .message-time {
        font-size: 0.6rem;
        opacity: 0.5;
        display: block;
        margin-top: 0.2rem;
        text-align: right;
    }
    
    /* Pied de panneau */
    .chat-panel-footer {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        flex-shrink: 0;
    }
    
    .chat-panel-footer input {
        flex: 1;
        background: rgba(255, 255, 255, 0.04) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        border-radius: 0.75rem !important;
        padding: 0.5rem 0.8rem !important;
        color: var(--text-color, #212529) !important;
        font-size: 0.9rem;
        transition: all 0.3s ease !important;
    }
    
    .chat-panel-footer input:focus {
        background: rgba(255, 255, 255, 0.08) !important;
        border-color: var(--bs-primary, #0d6efd) !important;
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.08) !important;
        outline: none;
    }
    
    .chat-panel-footer input::placeholder {
        color: var(--text-muted, #6c757d);
    }
    
    [data-theme="dark"] .chat-panel-footer input {
        background: rgba(255, 255, 255, 0.02) !important;
        border: 1px solid rgba(255, 255, 255, 0.06) !important;
        color: #ffffff !important;
    }
    
    [data-theme="dark"] .chat-panel-footer input::placeholder {
        color: rgba(255, 255, 255, 0.3);
    }
    
    [data-theme="dark"] .chat-panel-footer input:focus {
        background: rgba(255, 255, 255, 0.06) !important;
        border-color: #ffffff !important;
        box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.06) !important;
    }
    
    .chat-panel-footer button {
        background: rgba(13, 110, 253, 0.12) !important;
        border: 1px solid rgba(13, 110, 253, 0.15) !important;
        border-radius: 0.75rem !important;
        padding: 0.45rem 0.8rem !important;
        color: var(--bs-primary, #0d6efd) !important;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .chat-panel-footer button:hover {
        background: rgba(13, 110, 253, 0.2) !important;
        transform: scale(1.05);
        box-shadow: 0 4px 15px rgba(13, 110, 253, 0.15);
    }
    
    [data-theme="dark"] .chat-panel-footer button {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.06) !important;
        color: #ffffff !important;
    }
    
    [data-theme="dark"] .chat-panel-footer button:hover {
        background: rgba(255, 255, 255, 0.1) !important;
    }
    
    /* Délais d'animation pour les éléments de la liste */
    .chat-widget-user-item:nth-child(1) { animation-delay: 0.05s; }
    .chat-widget-user-item:nth-child(2) { animation-delay: 0.10s; }
    .chat-widget-user-item:nth-child(3) { animation-delay: 0.15s; }
    .chat-widget-user-item:nth-child(4) { animation-delay: 0.20s; }
    .chat-widget-user-item:nth-child(5) { animation-delay: 0.25s; }
    .chat-widget-user-item:nth-child(6) { animation-delay: 0.30s; }
    .chat-widget-user-item:nth-child(7) { animation-delay: 0.35s; }
    .chat-widget-user-item:nth-child(8) { animation-delay: 0.40s; }
    .chat-widget-user-item:nth-child(9) { animation-delay: 0.45s; }
    .chat-widget-user-item:nth-child(10) { animation-delay: 0.50s; }
    
    /* Adaptations mobiles */
    @media (max-width: 576px) {
        .chat-float-btn {
            bottom: 20px;
            right: 20px;
            width: 54px;
            height: 54px;
        }
        
        .chat-float-btn svg {
            width: 22px;
            height: 22px;
        }
        
        .chat-panel {
            bottom: 80px;
            right: 10px;
            max-height: 80vh;
            height: 80vh;
            width: calc(100vw - 20px);
            border-radius: 1rem !important;
        }
    }
</style>

<!-- Scripts -->
<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/theme.js"></script>
<script src="/js/chat-widget.js"></script>