    margin-right: 0.75rem;
    border: 2px solid rgba(13, 110, 253, 0.1);
    transition: all 0.3s ease;
}

.chat-conversation-item:hover .conv-avatar {
    border-color: var(--bs-primary, #0d6efd);
    transform: scale(1.05);
}

[data-theme="dark"] .chat-conversation-item .conv-avatar {
    border-color: rgba(255, 255, 255, 0.1);
}

.chat-conversation-item .conv-info {
    flex: 1;
    min-width: 0;
}

.chat-conversation-item .conv-name {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-color, #212529);
}

[data-theme="dark"] .chat-conversation-item .conv-name {
    color: #ffffff;
}

.chat-conversation-item .conv-preview {
    font-size: 0.75rem;
    color: var(--text-muted, #6c757d);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

[data-theme="dark"] .chat-conversation-item .conv-preview {
    color: rgba(255, 255, 255, 0.4);
}

.chat-conversation-item .conv-time {
    font-size: 0.65rem;
    color: var(--text-muted, #6c757d);
    flex-shrink: 0;
    margin-left: 0.5rem;
}

[data-theme="dark"] .chat-conversation-item .conv-time {
    color: rgba(255, 255, 255, 0.3);
}

.chat-conversation-item .conv-badge {
    background: #dc3545;
    color: white;
    border-radius: 50%;
    min-width: 18px;
    height: 18px;
    font-size: 0.55rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    margin-left: 0.5rem;
    flex-shrink: 0;
}

/* Messages dans le chat */
.chat-widget-message {
    margin-bottom: 0.5rem;
    max-width: 85%;
    padding: 0.5rem 0.75rem;
    border-radius: 0.75rem;
    animation: message-pop 0.2s ease forwards;
    opacity: 0;
    transform: scale(0.95);
}

@keyframes message-pop {
    from {
        opacity: 0;
        transform: scale(0.95) translateY(5px);
    }
    to {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
}

.chat-widget-message.sent {
    background: rgba(13, 110, 253, 0.15);
    margin-left: auto;
    border-bottom-right-radius: 0.25rem;
    color: var(--text-color, #212529);
}

[data-theme="dark"] .chat-widget-message.sent {
    background: rgba(13, 110, 253, 0.2);
