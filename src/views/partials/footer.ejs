}

[data-theme="dark"] .chat-panel-footer button:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.1);
}

/* Indicateur de saisie */
.typing-indicator {
    font-size: 0.75rem;
    color: var(--text-muted, #6c757d);
