<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0" id="timetableTitle">Emploi du temps</h4>
    <% if (locals.showChildSelector && typeof children !== 'undefined' && children.length > 0) { %>
        <div class="d-flex align-items-center">
            <label class="form-label me-2 mb-0">Enfant :</label>
            <select class="form-select d-inline-block" style="width: auto;" id="childSelector"></select>
        </div>
    <% } %>
</div>
<div class="table-responsive">
    <table class="table table-bordered" id="timetableTable">
        <tbody id="timetableBody"></tbody>
    </table>
</div>