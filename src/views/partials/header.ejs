<!-- ========================================================================== -->
<!-- Script du Popup Notifications - CORRIGÉ -->
<!-- ========================================================================== -->
<script>
  (function() {
    var btn = document.getElementById('notificationBtn');
    var popup = document.getElementById('notificationPopup');
    var badge = document.getElementById('notification-badge');
    var isOpen = false;

    // Ouvrir/fermer le popup
    if (btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        if (isOpen) {
          closePopup();
        } else {
          openPopup();
        }
      });
    }

    // Fermer en cliquant ailleurs
    document.addEventListener('click', function(e) {
      if (isOpen && popup && !popup.contains(e.target) && e.target !== btn && !btn.contains(e.target)) {
        closePopup();
      }
    });

    // Fermer avec la touche Échap
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && isOpen) {
        closePopup();
      }
    });

    function openPopup() {
      if (popup) {
        popup.classList.add('show');
        isOpen = true;
        loadNotifications();
      }
    }

    function closePopup() {
      if (popup) {
        popup.classList.remove('show');
        isOpen = false;
      }
    }

    // Charger les notifications depuis l'API
    function loadNotifications() {
      var list = document.getElementById('notificationList');
      if (!list) return;

      list.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary" role="status"></div></div>';

      fetch('/api/notifications/recent')
        .then(function(response) {
          if (!response.ok) throw new Error('API non disponible');
          return response.json();
        })
        .then(function(data) {
          renderNotifications(data.notifications || [], data.unreadCount || 0);
        })
        .catch(function() {
          // Données de démonstration si API non disponible
          renderNotifications([
            { id: 1, title: 'Nouveau message', message: 'Message de test', type: 'info', time: 'Maintenant', unread: true, link: '/communications' }
          ], 1);
        });
    }

    // Rendre les notifications
    function renderNotifications(notifs, unreadCount) {
      var list = document.getElementById('notificationList');
      if (!list) return;

      // Mettre à jour le badge avec le VRAI nombre depuis l'API
      updateBadge(unreadCount);

      if (!notifs || notifs.length === 0) {
        list.innerHTML = '<div class="notification-empty">🔔<p class="small mt-1 mb-0">Aucune notification</p></div>';
        return;
      }

      var html = '';
      var icons = {
        success: '✅',
        warning: '⚠️',
        danger: '❌',
        info: '📢',
        message: '💬'
      };

      notifs.forEach(function(n) {
        html += '<a href="' + (n.link || '#') + '" class="notification-item' + (n.unread ? ' unread' : '') + '">';
        html += '<div class="notification-icon-circle ' + (n.type || 'info') + '">' + (icons[n.type] || '📢') + '</div>';
        html += '<div class="notification-content">';
        html += '<div class="notif-title">' + escapeHtml(n.title) + '</div>';
        html += '<div class="notif-msg">' + escapeHtml(n.message) + '</div>';
        html += '<div class="notif-time">' + escapeHtml(n.time) + '</div>';
        html += '</div>';
        if (n.unread) {
          html += '<div class="notification-dot"></div>';
        }
        html += '</a>';
      });

      list.innerHTML = html;
    }

    // Mettre à jour le badge
    function updateBadge(count) {
      if (badge) {
        if (count > 0) {
          badge.textContent = count > 99 ? '99+' : count;
          badge.style.display = 'flex';
        } else {
          badge.style.display = 'none';
          badge.textContent = '0';
        }
      }
    }

    // ========================================================================
    // MARQUER TOUT COMME LU - CORRIGÉ (avec appel API réel)
    // ========================================================================
    window.markAllAsRead = function() {
      // Appel API pour marquer tout comme lu dans la base de données
      fetch('/api/notifications/read-all', { 
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      })
      .then(function(response) {
        if (!response.ok) throw new Error('Erreur API');
        return response.json();
      })
      .then(function() {
        // Mettre à jour le badge
        updateBadge(0);
        // Recharger les notifications pour avoir l'état réel
        loadNotifications();
        console.log('✅ Toutes les notifications marquées comme lues');
      })
      .catch(function(error) {
        console.error('❌ Erreur markAllAsRead:', error);
        // Fallback : mise à jour visuelle même si l'API échoue
        var dots = document.querySelectorAll('.notification-dot');
        dots.forEach(function(dot) { dot.remove(); });
        var unreadItems = document.querySelectorAll('.notification-item.unread');
        unreadItems.forEach(function(item) { item.classList.remove('unread'); });
        updateBadge(0);
      });
    };

    // ========================================================================
    // SOCKET.IO - Mise à jour en temps réel
    // ========================================================================
    if (typeof io !== 'undefined') {
      try {
        var socket = io();
        socket.on('newNotification', function(data) {
          console.log('📩 Nouvelle notification reçue:', data);
          // Mettre à jour le badge
          if (data.unreadCount !== undefined) {
            updateBadge(data.unreadCount);
          }
          // Recharger si le popup est ouvert
          if (isOpen) {
            loadNotifications();
          }
        });
      } catch(e) {
        console.log('Socket.io non disponible pour les notifications');
      }
    }

    // Échapper HTML
    function escapeHtml(text) {
      if (!text) return '';
      var div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }
  })();
</script>