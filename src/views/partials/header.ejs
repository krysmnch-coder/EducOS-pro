<!-- ========================================================================== -->
<!-- Script : Thème + Popup Notifications -->
<!-- ========================================================================== -->
<script>
(function() {
  'use strict';
  
  // ========================================================================
  // POPUP NOTIFICATIONS
  // ========================================================================
  var btn = document.getElementById('notificationBtn');
  var popup = document.getElementById('notificationPopup');
  var badge = document.getElementById('notification-badge');
  var isOpen = false;

  if (btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      if (isOpen) { closePopup(); } else { openPopup(); }
    });
  }

  document.addEventListener('click', function(e) {
    if (isOpen && popup && !popup.contains(e.target) && e.target !== btn && !btn.contains(e.target)) {
      closePopup();
    }
  });

  function openPopup() {
    if (popup) { popup.classList.add('show'); isOpen = true; loadNotifications(); }
  }

  function closePopup() {
    if (popup) { popup.classList.remove('show'); isOpen = false; }
  }

  function loadNotifications() {
    var list = document.getElementById('notificationList');
    if (!list) return;
    list.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>';
    fetch('/notifications/api/recent')
      .then(function(r) { return r.json(); })
      .then(function(data) { renderNotifications(data.notifications || [], data.unreadCount || 0); })
      .catch(function() { renderNotifications([], 0); });
  }

  function renderNotifications(notifs, unreadCount) {
    var list = document.getElementById('notificationList');
    if (!list) return;
    updateBadge(unreadCount);
    if (!notifs || notifs.length === 0) {
      list.innerHTML = '<div class="notification-empty"><p class="small mt-1 mb-0">Aucune notification</p></div>';
      return;
    }
    list.innerHTML = notifs.map(function(n) {
      return '<a href="' + (n.link || '#') + '" class="notification-item' + (n.unread ? ' unread' : '') + '" data-notification-id="' + escapeHtml(n.id) + '" data-read="' + (n.unread ? 'false' : 'true') + '"><div class="notification-content"><div class="notif-title">' + escapeHtml(n.title) + '</div><div class="notif-msg">' + escapeHtml(n.message) + '</div><div class="notif-time">' + escapeHtml(n.time) + '</div></div>' + (n.unread ? '<div class="notification-dot"></div>' : '') + '</a>';
    }).join('');
  }

  function updateBadge(count) {
    count = Math.max(0, parseInt(count, 10) || 0);
    navigationCounts.notification = count;
    if (badge) {
      if (count > 0) { badge.textContent = count > 99 ? '99+' : count; badge.style.display = 'inline-block'; }
      else { badge.style.display = 'none'; }
    }
    updateMobileNavAlert();
  }

  var navigationCounts = { admin: 0, communication: 0, chat: 0, notification: 0 };
  function updateMobileNavAlert() {
    var alert = document.getElementById('mobile-nav-alert');
    if (!alert) return;
    var hasAlert = Object.keys(navigationCounts).some(function(key) { return navigationCounts[key] > 0; });
    alert.classList.toggle('has-alert', hasAlert);
  }
  window.updateMobileNavAlert = updateMobileNavAlert;

  window.updateNotificationBadge = updateBadge;
  window.refreshNotifications = loadNotifications;

  window.updateNavigationBadge = function(type, count) {
    var element = document.getElementById(type + '-badge');
    if (!element) return;
    var normalizedCount = Math.max(0, parseInt(count, 10) || 0);
    navigationCounts[type] = normalizedCount;
    element.textContent = normalizedCount > 99 ? '99+' : normalizedCount;
    element.style.display = normalizedCount > 0 ? 'inline-block' : 'none';
    updateMobileNavAlert();
  };

  function loadNavigationBadges() {
    fetch('/admin/api/pending-count')
      .then(function(response) { return response.json(); })
      .then(function(data) { window.updateNavigationBadge('admin', data.count); })
      .catch(function() {});
    fetch('/communications/api/unread-count')
      .then(function(response) { return response.json(); })
      .then(function(data) { window.updateNavigationBadge('communication', data.count); })
      .catch(function() {});
    fetch('/chat/api/unread')
      .then(function(response) { return response.json(); })
      .then(function(data) {
        window.updateNavigationBadge('chat', data.count);
      })
      .catch(function() {});
  }

  loadNavigationBadges();

  document.querySelector('[data-nav-badge-link="admin"]')?.addEventListener('click', function() {
    window.updateNavigationBadge('admin', 0);
  });
  document.querySelector('a[href="/communications"]')?.addEventListener('click', function() {
    fetch('/communications/api/read-all', { method: 'POST' })
      .then(function() { window.updateNavigationBadge('communication', 0); })
      .catch(function() {});
  });

  if (document.getElementById('notificationList')) {
    document.getElementById('notificationList').addEventListener('click', function(e) {
      var item = e.target.closest('[data-notification-id]');
      if (!item || item.dataset.read === 'true') return;
      e.preventDefault();
      var targetUrl = item.href;
      item.classList.add('is-updating');
      fetch('/notifications/api/' + encodeURIComponent(item.dataset.notificationId) + '/read', { method: 'POST' })
        .then(function(response) {
          if (!response.ok) throw new Error('Impossible de marquer la notification comme lue.');
          return response.json().then(function(data) {
            item.dataset.read = 'true';
            item.classList.remove('unread', 'is-updating');
            item.querySelector('.notification-dot')?.remove();
            updateBadge(data.unreadCount);
            window.location.href = targetUrl;
          });
        })
        .catch(function(error) {
          item.classList.remove('is-updating');
          console.error(error);
          window.location.href = targetUrl;
        });
    });
  }

  window.markAllAsRead = function() {
    fetch('/notifications/api/read-all', { method: 'POST' })
      .then(function() { updateBadge(0); loadNotifications(); })
      .catch(function() { updateBadge(0); });
  };

  function escapeHtml(t) { if (!t) return ''; var d = document.createElement('div'); d.textContent = t; return d.innerHTML; }

  // Charger le badge au démarrage
  fetch('/notifications/api/unread-count')
    .then(function(r) { return r.json(); })
    .then(function(data) { updateBadge(data.count || 0); })
    .catch(function() {});

})();
</script>