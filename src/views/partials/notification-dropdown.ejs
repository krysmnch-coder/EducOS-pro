<li class="nav-item dropdown">
  <a class="nav-link nav-icon" href="#" data-bs-toggle="dropdown" id="notification-icon-toggler">
    <i data-feather="bell"></i>
    <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
      <span class="badge bg-primary rounded-pill" id="notification-badge"><%= unreadCount %></span>
    <% } else { %>
      <span class="badge bg-primary rounded-pill" id="notification-badge" style="display: none;">0</span>
    <% } %>
  </a>

  <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow notifications" id="notification-dropdown-container">
    <li class="dropdown-header">
      Vous avez <span id="notification-header-count"><%= typeof unreadCount !== 'undefined' ? unreadCount : 0 %></span> nouvelles notifications
      <a href="#" id="mark-all-as-read-link"><span class="badge rounded-pill bg-primary p-2 ms-2">Tout marquer comme lu</span></a>
    </li>
    <li><hr class="dropdown-divider"></li>

    <div id="notification-list-items" class="notification-list-scroll">
        <div class="text-center p-3" id="notification-loader" style="display: none;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>

    <li><hr class="dropdown-divider"></li>
    <li class="dropdown-footer">
      <a href="/notifications">Voir toutes les notifications</a>
    </li>
  </ul>
</li>