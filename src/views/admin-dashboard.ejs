<%- include('partials/head') %>
<%- include('partials/header') %>

<div class="container page-shell py-4">
    <div class="themed-container">

        <%- include('partials/messages') %>

        <%# --- Section de bienvenue --- %>
        <div class="d-flex align-items-center mb-5 welcome-section">
            <div class="rounded-circle me-4 d-flex align-items-center justify-content-center bg-primary text-white avatar-glow" style="width: 80px; height: 80px; font-size: 2.5rem; font-weight: 500; background-image: url('<%= currentUser.avatar_url %>'); background-size: cover; background-position: center;">
                <% if (!currentUser.avatar_url) { %>
                    <%= currentUser.name.charAt(0).toUpperCase() %>
                <% } %>
            </div>
            <div>
                <h1 class="h2 mb-0">Bonjour, <%= currentUser.name %> !</h1>
                <p class="lead text-muted mb-0">Bienvenue sur votre tableau de bord d'administration.</p>
            </div>
        </div>

        <%# --- Section des Raccourcis (Widgets) --- %>
        <% 
        // Définir des widgets par défaut si non fournis
        const defaultWidgets = [
            { key: 'students', icon: 'users', title: 'Gestion des Élèves', link: '/students', description: 'Gérer les élèves' },
            { key: 'teachers', icon: 'user-check', title: 'Gestion des Professeurs', link: '/teachers', description: 'Gérer les professeurs' },
            { key: 'classes', icon: 'grid', title: 'Gestion des Classes', link: '/classes', description: 'Gérer les classes' },
            { key: 'admin', icon: 'settings', title: 'Paramètres', link: '/admin', description: 'Paramètres du système' }
        ];
        const displayWidgets = (typeof widgets !== 'undefined' && widgets && widgets.length > 0) ? widgets : defaultWidgets;
        %>
        
        <h2 class="mb-4 section-title">Raccourcis de gestion</h2>
        <div class="row">
            <% displayWidgets.forEach((widget, index) => { %>
            <div class="col-xl-3 col-md-6 mb-4">
                <a href="<%= widget.link || '#' %>" class="text-decoration-none shortcut-link" data-shortcut-key="<%= widget.key || 'widget-' + index %>" data-delay="<%= index * 0.15 %>">
                    <div class="card dashboard-stat h-100 glass-card">
                        <div class="card-body text-center">
                            <div class="stat-icon mb-3">
                                <i data-feather="<%= widget.icon || 'box' %>"></i>
                            </div>
                            <h5 class="card-title mb-2"><%= widget.title || 'Widget' %></h5>
                            <p class="card-text text-muted small"><%= widget.description || 'Description' %></p>
                        </div>
                    </div>
                </a>
            </div>
            <% }); %>
        </div>

        <%# --- Section des Statistiques avec Graphiques --- %>
        <% if (stats) { %>
            <h2 class="mb-4 mt-5 section-title">Statistiques</h2>
            <div class="row">
                <% if (currentUser.role === 'ADMINISTRATOR' || currentUser.role === 'administrateur') { %>
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card h-100 glass-stat-card"><div class="card-body text-center d-flex flex-column justify-content-center"><h5 class="card-title text-muted">Élèves</h5><p class="display-4 fw-bold my-2 stat-number" id="adminStudentCount"><%= stats.studentCount || 0 %></p></div></div>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card h-100 glass-stat-card"><div class="card-body text-center d-flex flex-column justify-content-center"><h5 class="card-title text-muted">Professeurs</h5><p class="display-4 fw-bold my-2 stat-number" id="adminProfessorCount"><%= stats.professorCount || 0 %></p></div></div>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card h-100 glass-stat-card"><div class="card-body text-center d-flex flex-column justify-content-center"><h5 class="card-title text-muted">Parents</h5><p class="display-4 fw-bold my-2 stat-number" id="adminParentCount"><%= stats.parentCount || 0 %></p></div></div>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card h-100 text-center glass-stat-card bg-warning bg-opacity-10 border-warning">
                            <div class="card-body d-flex flex-column justify-content-center">
                                <h5 class="card-title">Comptes en attente</h5>
                                <p class="display-4 fw-bold my-3 stat-number" id="adminPendingCount"><%= stats.pendingCount || 0 %></p>
                                <a href="/admin" class="btn btn-sm btn-warning glass-btn-small">Gérer</a>
                            </div>
                        </div>
                    </div>
                <% } else if (currentUser.role === 'SUPER_ADMIN' || currentUser.role === 'superadmin') { %>
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card h-100 glass-stat-card"><div class="card-body text-center d-flex flex-column justify-content-center"><h5 class="card-title text-muted">Utilisateurs (Total)</h5><p class="display-4 fw-bold my-2 stat-number" id="superAdminTotalUsers"><%= stats.totalUserCount || 0 %></p></div></div>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card h-100 glass-stat-card"><div class="card-body text-center d-flex flex-column justify-content-center"><h5 class="card-title text-muted">Admins Scolaires</h5><p class="display-4 fw-bold my-2 stat-number" id="superAdminAdminCount"><%= stats.adminCount || 0 %></p></div></div>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card h-100 glass-stat-card"><div class="card-body text-center d-flex flex-column justify-content-center"><h5 class="card-title text-muted">Établissements</h5><p class="display-4 fw-bold my-2 stat-number" id="superAdminEstablishmentCount"><%= stats.establishmentCount || 0 %></p></div></div>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card h-100 text-center glass-stat-card bg-warning bg-opacity-10 border-warning">
                            <div class="card-body d-flex flex-column justify-content-center">
                                <h5 class="card-title">Comptes en attente</h5>
                                <p class="display-4 fw-bold my-3 stat-number" id="superAdminPendingCount"><%= stats.pendingCount || 0 %></p>
                                <a href="/admin" class="btn btn-sm btn-warning glass-btn-small">Gérer</a>
                            </div>
                        </div>
                    </div>

                    <% if (stats.establishmentsWithCounts && stats.establishmentsWithCounts.length > 0) { %>
                        <div class="col-12">
                            <h3 class="mb-4 mt-5 section-title">Utilisateurs par Établissement</h3>
                            <div class="table-responsive glass-table-container">
                                <table class="table table-hover glass-table">
                                    <thead>
                                        <tr>
                                            <th>Établissement</th>
                                            <th class="text-end">Utilisateurs Approuvés</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% stats.establishmentsWithCounts.forEach(est => { %>
                                            <tr class="glass-row">
                                                <td><%= est.name %></td>
                                                <td class="text-end fw-bold stat-number" id="establishment-count-<%= est.id %>"><%= est.userCount || 0 %></td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    <% } %>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<style>
/* ==========================================================================
   Dashboard - Style Glassmorphism avec Animations
   ========================================================================== */

/* --- Section de bienvenue --- */
.welcome-section {
    animation: welcome-fade 0.8s ease forwards !important;
    opacity: 0;
    transform: translateY(20px);
}

@keyframes welcome-fade {
    from {
        opacity: 0;
        transform: translateY(20px) scale(0.98);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.avatar-glow {
    animation: avatar-glow 3s ease-in-out infinite;
    box-shadow: 0 0 20px rgba(13, 110, 253, 0.1);
}

@keyframes avatar-glow {
    0%, 100% { box-shadow: 0 0 20px rgba(13, 110, 253, 0.1); }
    50% { box-shadow: 0 0 40px rgba(13, 110, 253, 0.25); }
}

/* --- Titres de section --- */
.section-title {
    color: var(--text-color, #212529);
    font-weight: 700;
    animation: title-slide 0.6s ease forwards !important;
    opacity: 0;
    transform: translateX(-10px);
    animation-delay: 0.1s !important;
}

[data-theme="dark"] .section-title {
    color: #ffffff;
}

@keyframes title-slide {
    from {
        opacity: 0;
        transform: translateX(-10px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

/* --- Glass Card pour les widgets --- */
.glass-card {
    background: rgba(255, 255, 255, 0.15) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    border-radius: 1rem !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08) !important;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
    position: relative !important;
    overflow: hidden !important;
    cursor: pointer !important;
    animation: card-fade-in 0.6s ease forwards !important;
    opacity: 0 !important;
    transform: translateY(20px) !important;
}

[data-theme="dark"] .glass-card {
    background: rgba(255, 255, 255, 0.05) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3) !important;
}

@keyframes card-fade-in {
    from {
        opacity: 0;
        transform: translateY(30px) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.glass-card::before {
    content: '' !important;
    position: absolute !important;
    top: -50% !important;
    left: -50% !important;
    width: 200% !important;
    height: 200% !important;
    background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.1), transparent 70%) !important;
    opacity: 0 !important;
    transition: opacity 0.6s ease !important;
    pointer-events: none !important;
    z-index: 0 !important;
}

.glass-card .card-body {
    position: relative !important;
    z-index: 1 !important;
}

.glass-card:hover {
    transform: translateY(-10px) scale(1.02) !important;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15) !important;
    border-color: rgba(255, 255, 255, 0.4) !important;
}

[data-theme="dark"] .glass-card:hover {
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5) !important;
}

.glass-card:hover::before {
    opacity: 1 !important;
}

/* Icônes */
.glass-card .stat-icon {
    transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
    display: inline-block !important;
}

.glass-card .stat-icon svg {
    width: 48px !important;
    height: 48px !important;
    stroke-width: 1.5 !important;
    transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
    color: var(--bs-primary, #0d6efd) !important;
}

.glass-card:hover .stat-icon {
    transform: scale(1.2) rotate(-5deg) !important;
}

.glass-card:hover .stat-icon svg {
    color: var(--bs-primary, #0d6efd) !important;
    filter: drop-shadow(0 0 20px rgba(13, 110, 253, 0.3)) !important;
}

.glass-card:hover .stat-icon {
    animation: icon-pulse 1.2s ease-in-out infinite !important;
}

@keyframes icon-pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.15); }
    100% { transform: scale(1); }
}

/* Titre des cartes */
.glass-card .card-title {
    transition: all 0.4s ease !important;
    position: relative !important;
    display: inline-block !important;
}

.glass-card:hover .card-title {
    color: var(--bs-primary, #0d6efd) !important;
    transform: scale(1.05) !important;
}

.glass-card .card-title::after {
    content: '' !important;
    position: absolute !important;
    bottom: -2px !important;
    left: 0 !important;
    width: 0 !important;
    height: 2px !important;
    background: linear-gradient(90deg, var(--bs-primary, #0d6efd), var(--bs-info, #0dcaf0)) !important;
    transition: width 0.4s ease !important;
}

.glass-card:hover .card-title::after {
    width: 100% !important;
}

/* Effet de brillance flottante */
.glass-card::after {
    content: '' !important;
    position: absolute !important;
    top: -50% !important;
    left: -50% !important;
    width: 200% !important;
    height: 200% !important;
    background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255, 255, 255, 0.1) 0%, transparent 50%) !important;
    opacity: 0 !important;
    transition: opacity 0.3s ease !important;
    pointer-events: none !important;
    z-index: 0 !important;
}

.glass-card:hover::after {
    opacity: 1 !important;
}

/* --- Glass Stat Card --- */
.glass-stat-card {
    background: rgba(255, 255, 255, 0.10) !important;
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    border-radius: 1rem !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06) !important;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
    animation: stat-fade-in 0.6s ease forwards !important;
    opacity: 0 !important;
    transform: translateY(20px) !important;
}

.glass-stat-card:nth-child(1) { animation-delay: 0.1s !important; }
.glass-stat-card:nth-child(2) { animation-delay: 0.2s !important; }
.glass-stat-card:nth-child(3) { animation-delay: 0.3s !important; }
.glass-stat-card:nth-child(4) { animation-delay: 0.4s !important; }

[data-theme="dark"] .glass-stat-card {
    background: rgba(255, 255, 255, 0.03) !important;
    border: 1px solid rgba(255, 255, 255, 0.06) !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3) !important;
}

.glass-stat-card:hover {
    transform: translateY(-5px) !important;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.10) !important;
}

[data-theme="dark"] .glass-stat-card:hover {
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4) !important;
}

.stat-number {
    color: var(--bs-primary, #0d6efd) !important;
}

[data-theme="dark"] .stat-number {
    color: #ffffff !important;
}

@keyframes stat-fade-in {
    from {
        opacity: 0;
        transform: translateY(20px) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* --- Petit bouton Glassmorphism --- */
.glass-btn-small {
    background: rgba(255, 193, 7, 0.15) !important;
    backdrop-filter: blur(4px) !important;
    -webkit-backdrop-filter: blur(4px) !important;
    border: 1px solid rgba(255, 193, 7, 0.2) !important;
    border-radius: 0.5rem !important;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
    color: #d4a800 !important;
}

.glass-btn-small:hover {
    transform: translateY(-2px) scale(1.05) !important;
    background: rgba(255, 193, 7, 0.25) !important;
    box-shadow: 0 4px 15px rgba(255, 193, 7, 0.15) !important;
}

[data-theme="dark"] .glass-btn-small {
    color: #ffd43b !important;
    border-color: rgba(255, 193, 7, 0.15) !important;
}

[data-theme="dark"] .glass-btn-small:hover {
    background: rgba(255, 193, 7, 0.2) !important;
}

/* --- Tableau Glassmorphism --- */
.glass-table-container {
    background: rgba(255, 255, 255, 0.06) !important;
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
    border: 1px solid rgba(255, 255, 255, 0.10) !important;
    border-radius: 1rem !important;
    padding: 0.5rem !important;
    overflow: hidden !important;
    animation: table-fade-in 0.8s ease forwards !important;
    opacity: 0 !important;
    transform: translateY(20px) !important;
    animation-delay: 0.5s !important;
}

[data-theme="dark"] .glass-table-container {
    background: rgba(255, 255, 255, 0.02) !important;
    border: 1px solid rgba(255, 255, 255, 0.04) !important;
}

@keyframes table-fade-in {
    from {
        opacity: 0;
        transform: translateY(20px) scale(0.98);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.glass-table thead th {
    background: rgba(13, 110, 253, 0.06) !important;
    color: var(--text-color, #212529) !important;
    font-weight: 600 !important;
    border-bottom: 2px solid rgba(13, 110, 253, 0.08) !important;
}

[data-theme="dark"] .glass-table thead th {
    background: rgba(255, 255, 255, 0.03) !important;
    color: rgba(255, 255, 255, 0.8) !important;
    border-bottom: 2px solid rgba(255, 255, 255, 0.04) !important;
}

.glass-row {
    background: transparent !important;
    transition: all 0.3s ease !important;
    animation: row-fade-in 0.4s ease forwards !important;
    opacity: 0 !important;
    transform: translateX(-10px) !important;
}

.glass-row:nth-child(1) { animation-delay: 0.55s !important; }
.glass-row:nth-child(2) { animation-delay: 0.60s !important; }
.glass-row:nth-child(3) { animation-delay: 0.65s !important; }
.glass-row:nth-child(4) { animation-delay: 0.70s !important; }
.glass-row:nth-child(5) { animation-delay: 0.75s !important; }
.glass-row:nth-child(6) { animation-delay: 0.80s !important; }
.glass-row:nth-child(7) { animation-delay: 0.85s !important; }
.glass-row:nth-child(8) { animation-delay: 0.90s !important; }

@keyframes row-fade-in {
    from {
        opacity: 0;
        transform: translateX(-10px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

.glass-row:hover {
    background: rgba(13, 110, 253, 0.03) !important;
    transform: scale(1.002) !important;
}

[data-theme="dark"] .glass-row:hover {
    background: rgba(255, 255, 255, 0.02) !important;
}

.glass-row td {
    padding: 0.75rem 1rem !important;
    border-bottom: 1px solid rgba(0, 0, 0, 0.04) !important;
}

[data-theme="dark"] .glass-row td {
    border-bottom: 1px solid rgba(255, 255, 255, 0.03) !important;
}

/* --- Lien --- */
.shortcut-link {
    display: block !important;
    text-decoration: none !important;
}

.shortcut-link.disabled {
    opacity: 0.6 !important;
    cursor: not-allowed !important;
    pointer-events: none !important;
}

.shortcut-link.disabled .glass-card {
    filter: grayscale(0.5) !important;
}

/* --- Animation de pulsation --- */
.glass-card.is-pulsing {
    animation: card-pulse 0.8s ease !important;
}

@keyframes card-pulse {
    0% { transform: scale(1); box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08); }
    30% { transform: scale(1.05); box-shadow: 0 0 50px rgba(13, 110, 253, 0.3); }
    60% { transform: scale(0.98); }
    100% { transform: scale(1); box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08); }
}

/* --- Adaptation mobile --- */
@media (max-width: 768px) {
    .glass-card .stat-icon svg {
        width: 36px !important;
        height: 36px !important;
    }
    
    .glass-card {
        border-radius: 0.75rem !important;
    }
    
    .glass-card:hover {
        transform: translateY(-5px) scale(1.01) !important;
    }
    
    .stat-number {
        font-size: 2.5rem !important;
    }
}
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // --- Feather Icons ---
        if (typeof feather !== 'undefined') {
            feather.replace();
        }

        // --- Délais d'animation pour les cartes ---
        document.querySelectorAll('.glass-card').forEach(function(card) {
            var parentLink = card.closest('.shortcut-link');
            if (parentLink) {
                var delay = parentLink.getAttribute('data-delay');
                if (delay) {
                    card.style.animationDelay = delay + 's';
                }
            }
        });

        // --- Effet de brillance au survol ---
        document.querySelectorAll('.glass-card').forEach(function(card) {
            card.addEventListener('mousemove', function(e) {
                var rect = this.getBoundingClientRect();
                var x = ((e.clientX - rect.left) / rect.width) * 100;
                var y = ((e.clientY - rect.top) / rect.height) * 100;
                this.style.setProperty('--mouse-x', x + '%');
                this.style.setProperty('--mouse-y', y + '%');
            });
        });

        // --- Socket.io pour les raccourcis ---
        if (typeof io !== 'undefined') {
            var socket = io();
            socket.on('shortcutHighlight', function(data) {
                if (data.shortcutKey) {
                    var shortcut = document.querySelector('.shortcut-link[data-shortcut-key="' + data.shortcutKey + '"]');
                    if (shortcut) {
                        var card = shortcut.querySelector('.glass-card');
                        if (card) {
                            card.classList.add('is-pulsing');
                            setTimeout(function() { 
                                card.classList.remove('is-pulsing'); 
                            }, 1200);
                        }
                    }
                }
            });
        }
    });
</script>

<%- include('partials/page-end-scripts') %>
<%- include('partials/footer') %>