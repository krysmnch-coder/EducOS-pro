<%- include('partials/head') %>
<%- include('partials/header') %>

<div class="container page-shell py-4">
    <div class="themed-container">

        <%- include('partials/messages') %>

        <%# --- Section de bienvenue --- %>
        <div class="d-flex align-items-center mb-5">
            <div class="rounded-circle me-4 d-flex align-items-center justify-content-center bg-primary text-white" style="width: 80px; height: 80px; font-size: 2.5rem; font-weight: 500; background-image: url('<%= currentUser.avatar_url %>'); background-size: cover; background-position: center;">
                <% if (!currentUser.avatar_url) { %>
                    <%= currentUser.name.charAt(0).toUpperCase() %>
                <% } %>
            </div>
            <div>
                <h1 class="h2 mb-0">Bonjour, <%= currentUser.name %> !</h1>
                <p class="lead text-muted mb-0">Bienvenue sur votre tableau de bord d'administration.</p>
            </div>
        </div>

        <%# --- Section des Raccourcis (Widgets) - Version corrigée --- %>
        <h2 class="mb-4">Raccourcis de gestion</h2>
        <div class="row">
            <%
            // Utiliser var au lieu de const pour la compatibilité
            var hasWidgets = false;
            try {
                hasWidgets = (typeof widgets !== 'undefined' && widgets && widgets.length > 0);
            } catch(e) {
                hasWidgets = false;
            }
            
            if (hasWidgets) {
                // Afficher les widgets dynamiques
                for (var i = 0; i < widgets.length; i++) {
                    var widget = widgets[i];
                    var widgetLink = widget.link || '#';
                    var widgetKey = widget.key || 'widget-' + i;
                    var widgetIcon = widget.icon || 'box';
                    var widgetTitle = widget.title || 'Widget';
                    var widgetDesc = widget.description || 'Description';
            %>
            <div class="col-xl-3 col-md-6 mb-4">
                <a href="<%= widgetLink %>" class="text-decoration-none shortcut-link" data-shortcut-key="<%= widgetKey %>">
                    <div class="card dashboard-stat h-100 glass-card">
                        <div class="card-body text-center">
                            <div class="stat-icon mb-3">
                                <i data-feather="<%= widgetIcon %>"></i>
                            </div>
                            <h5 class="card-title mb-2"><%= widgetTitle %></h5>
                            <p class="card-text text-muted small"><%= widgetDesc %></p>
                        </div>
                    </div>
                </a>
            </div>
            <%
                }
            } else {
                // Afficher les widgets par défaut
            %>
            <div class="col-xl-3 col-md-6 mb-4">
                <a href="/students" class="text-decoration-none shortcut-link" data-shortcut-key="students">
                    <div class="card dashboard-stat h-100 glass-card">
                        <div class="card-body text-center">
                            <div class="stat-icon mb-3">
                                <i data-feather="users"></i>
                            </div>
                            <h5 class="card-title mb-2">Gestion des Élèves</h5>
                            <p class="card-text text-muted small">Gérer les élèves</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-xl-3 col-md-6 mb-4">
                <a href="/teachers" class="text-decoration-none shortcut-link" data-shortcut-key="teachers">
                    <div class="card dashboard-stat h-100 glass-card">
                        <div class="card-body text-center">
                            <div class="stat-icon mb-3">
                                <i data-feather="user-check"></i>
                            </div>
                            <h5 class="card-title mb-2">Gestion des Professeurs</h5>
                            <p class="card-text text-muted small">Gérer les professeurs</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-xl-3 col-md-6 mb-4">
                <a href="/classes" class="text-decoration-none shortcut-link" data-shortcut-key="classes">
                    <div class="card dashboard-stat h-100 glass-card">
                        <div class="card-body text-center">
                            <div class="stat-icon mb-3">
                                <i data-feather="grid"></i>
                            </div>
                            <h5 class="card-title mb-2">Gestion des Classes</h5>
                            <p class="card-text text-muted small">Gérer les classes</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-xl-3 col-md-6 mb-4">
                <a href="/admin" class="text-decoration-none shortcut-link" data-shortcut-key="admin">
                    <div class="card dashboard-stat h-100 glass-card">
                        <div class="card-body text-center">
                            <div class="stat-icon mb-3">
                                <i data-feather="settings"></i>
                            </div>
                            <h5 class="card-title mb-2">Paramètres</h5>
                            <p class="card-text text-muted small">Paramètres du système</p>
                        </div>
                    </div>
                </a>
            </div>
            <%
            }
            %>
        </div>

        <%# --- Section des Statistiques avec Graphiques --- %>
        <% if (stats) { %>
            <h2 class="mb-4 mt-5">Statistiques</h2>
            <div class="row">
                <% if (currentUser.role === 'ADMINISTRATOR' || currentUser.role === 'administrateur') { %>
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card h-100"><div class="card-body text-center d-flex flex-column justify-content-center"><h5 class="card-title text-muted">Élèves</h5><p class="display-4 fw-bold my-2" id="adminStudentCount"><%= stats.studentCount || 0 %></p></div></div>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card h-100"><div class="card-body text-center d-flex flex-column justify-content-center"><h5 class="card-title text-muted">Professeurs</h5><p class="display-4 fw-bold my-2" id="adminProfessorCount"><%= stats.professorCount || 0 %></p></div></div>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card h-100"><div class="card-body text-center d-flex flex-column justify-content-center"><h5 class="card-title text-muted">Parents</h5><p class="display-4 fw-bold my-2" id="adminParentCount"><%= stats.parentCount || 0 %></p></div></div>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card h-100 text-center bg-warning bg-opacity-10 border-warning">
                            <div class="card-body d-flex flex-column justify-content-center">
                                <h5 class="card-title">Comptes en attente</h5>
                                <p class="display-4 fw-bold my-3" id="adminPendingCount"><%= stats.pendingCount || 0 %></p>
                                <a href="/admin" class="btn btn-sm btn-warning">Gérer</a>
                            </div>
                        </div>
                    </div>
                <% } else if (currentUser.role === 'SUPER_ADMIN' || currentUser.role === 'superadmin') { %>
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card h-100"><div class="card-body text-center d-flex flex-column justify-content-center"><h5 class="card-title text-muted">Utilisateurs (Total)</h5><p class="display-4 fw-bold my-2" id="superAdminTotalUsers"><%= stats.totalUserCount || 0 %></p></div></div>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card h-100"><div class="card-body text-center d-flex flex-column justify-content-center"><h5 class="card-title text-muted">Admins Scolaires</h5><p class="display-4 fw-bold my-2" id="superAdminAdminCount"><%= stats.adminCount || 0 %></p></div></div>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card h-100"><div class="card-body text-center d-flex flex-column justify-content-center"><h5 class="card-title text-muted">Établissements</h5><p class="display-4 fw-bold my-2" id="superAdminEstablishmentCount"><%= stats.establishmentCount || 0 %></p></div></div>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card h-100 text-center bg-warning bg-opacity-10 border-warning">
                            <div class="card-body d-flex flex-column justify-content-center">
                                <h5 class="card-title">Comptes en attente</h5>
                                <p class="display-4 fw-bold my-3" id="superAdminPendingCount"><%= stats.pendingCount || 0 %></p>
                                <a href="/admin" class="btn btn-sm btn-warning">Gérer</a>
                            </div>
                        </div>
                    </div>

                    <% if (stats.establishmentsWithCounts && stats.establishmentsWithCounts.length > 0) { %>
                        <div class="col-12">
                            <h3 class="mb-4 mt-5">Utilisateurs par Établissement</h3>
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Établissement</th>
                                            <th class="text-end">Utilisateurs Approuvés</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% for (var j = 0; j < stats.establishmentsWithCounts.length; j++) { 
                                            var est = stats.establishmentsWithCounts[j];
                                        %>
                                            <tr>
                                                <td><%= est.name %></td>
                                                <td class="text-end fw-bold" id="establishment-count-<%= est.id %>"><%= est.userCount || 0 %></td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    <% } %>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<style>
/* Votre CSS reste inchangé */
/* ... */
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof feather !== 'undefined') {
            feather.replace();
        }

        // Ajout des délais d'animation pour chaque carte
        var cards = document.querySelectorAll('.glass-card');
        for (var i = 0; i < cards.length; i++) {
            var delay = i + 1;
            if (delay <= 8) {
                cards[i].classList.add('delay-' + delay);
            }
        }

        // Animation des raccourcis
        if (typeof io !== 'undefined') {
            var socket = io();
            socket.on('shortcutHighlight', function(data) {
                if (data.shortcutKey) {
                    var shortcut = document.querySelector('.shortcut-link[data-shortcut-key="' + data.shortcutKey + '"]');
                    if (shortcut) {
                        var card = shortcut.querySelector('.glass-card');
                        if (card) {
                            card.classList.add('is-pulsing');
                            setTimeout(function() { 
                                card.classList.remove('is-pulsing'); 
                            }, 1200);
                        }
                    }
                }
            });
        }
    });
</script>

<%- include('partials/page-end-scripts') %>
<%- include('partials/footer') %>