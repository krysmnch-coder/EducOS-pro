<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container-fluid page-shell py-4">
    <div class="themed-container" style="max-width: 100%; padding: 0 20px;">
        <h2 class="mb-4">Documents Scolaires</h2>
        <%- include('../partials/messages') %>

        <!-- Sélecteur Classe + Élève -->
        <div class="card glass-card mb-4 p-3" style="border-radius:16px;">
            <div class="row align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Classe</label>
                    <select class="form-select" id="filterClass" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                        <option value="">-- Toutes les classes --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Élève</label>
                    <select class="form-select" id="filterStudent" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                        <option value="">-- Tous les élèves --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" id="btnFilter">
                        <i data-feather="filter"></i> Filtrer
                    </button>
                </div>
                <div class="col-md-3">
                    <span id="selectedStudentInfo" style="color: #0dcaf0; font-size: 0.9rem;"></span>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Certificat de Scolarité -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4 text-center" style="border-radius:16px; min-height:250px;">
                    <div style="font-size:50px; margin-bottom:15px;">📜</div>
                    <h5>Certificat de Scolarité</h5>
                    <p style="color:#888; font-size:0.9rem;">Générer un certificat de scolarité pour un élève.</p>
                    <button class="btn btn-primary mt-3" onclick="openDocModal('certificate')">
                        <i data-feather="file-text"></i> Générer
                    </button>
                </div>
            </div>

            <!-- Bulletin de Notes -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4 text-center" style="border-radius:16px; min-height:250px;">
                    <div style="font-size:50px; margin-bottom:15px;">📊</div>
                    <h5>Bulletin de Notes</h5>
                    <p style="color:#888; font-size:0.9rem;">Générer les bulletins de notes par classe ou par élève.</p>
                    <button class="btn btn-primary mt-3" onclick="openDocModal('bulletin')">
                        <i data-feather="bar-chart-2"></i> Générer
                    </button>
                </div>
            </div>

            <!-- Attestation de Réussite -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4 text-center" style="border-radius:16px; min-height:250px;">
                    <div style="font-size:50px; margin-bottom:15px;">🏆</div>
                    <h5>Attestation de Réussite</h5>
                    <p style="color:#888; font-size:0.9rem;">Délivrer une attestation de réussite ou de passage.</p>
                    <button class="btn btn-primary mt-3" onclick="openDocModal('attestation')">
                        <i data-feather="award"></i> Générer
                    </button>
                </div>
            </div>

            <!-- Fiche d'Inscription / Réinscription -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4 text-center" style="border-radius:16px; min-height:250px;">
                    <div style="font-size:50px; margin-bottom:15px;">📝</div>
                    <h5>Fiche d'Inscription</h5>
                    <p style="color:#888; font-size:0.9rem;">Fiche d'inscription ou de réinscription pour un élève.</p>
                    <button class="btn btn-primary mt-3" onclick="openDocModal('inscription')">
                        <i data-feather="edit-3"></i> Générer
                    </button>
                </div>
            </div>

            <!-- Certificat de Sortie / Radiation -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4 text-center" style="border-radius:16px; min-height:250px;">
                    <div style="font-size:50px; margin-bottom:15px;">🚪</div>
                    <h5>Certificat de Sortie</h5>
                    <p style="color:#888; font-size:0.9rem;">Certificat de radiation pour changement d'école.</p>
                    <button class="btn btn-primary mt-3" onclick="openDocModal('sortie')">
                        <i data-feather="log-out"></i> Générer
                    </button>
                </div>
            </div>

            <!-- Livret Scolaire -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4 text-center" style="border-radius:16px; min-height:250px;">
                    <div style="font-size:50px; margin-bottom:15px;">📖</div>
                    <h5>Livret Scolaire</h5>
                    <p style="color:#888; font-size:0.9rem;">Livret qui suit l'élève et résume ses compétences.</p>
                    <button class="btn btn-primary mt-3" onclick="openDocModal('livret')">
                        <i data-feather="book-open"></i> Générer
                    </button>
                </div>
            </div>

            <!-- Relevé de Notes -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4 text-center" style="border-radius:16px; min-height:250px;">
                    <div style="font-size:50px; margin-bottom:15px;">📋</div>
                    <h5>Relevé de Notes</h5>
                    <p style="color:#888; font-size:0.9rem;">Relevé détaillé des notes par période.</p>
                    <button class="btn btn-primary mt-3" onclick="openDocModal('releve')">
                        <i data-feather="list"></i> Générer
                    </button>
                </div>
            </div>

            <!-- Convocation -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4 text-center" style="border-radius:16px; min-height:250px;">
                    <div style="font-size:50px; margin-bottom:15px;">📨</div>
                    <h5>Convocation</h5>
                    <p style="color:#888; font-size:0.9rem;">Générer des convocations pour les parents.</p>
                    <button class="btn btn-primary mt-3" onclick="openDocModal('convocation')">
                        <i data-feather="send"></i> Générer
                    </button>
                </div>
            </div>

            <!-- Archives -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4 text-center" style="border-radius:16px; min-height:250px;">
                    <div style="font-size:50px; margin-bottom:15px;">🗄️</div>
                    <h5>Archives</h5>
                    <p style="color:#888; font-size:0.9rem;">Consulter les documents déjà générés.</p>
                    <button class="btn btn-primary mt-3" onclick="loadArchives()">
                        <i data-feather="archive"></i> Consulter
                    </button>
                </div>
            </div>
        </div>

        <!-- Section Archives -->
        <div class="card glass-card mt-4 p-4" style="border-radius:16px; display:none;" id="archivesSection">
            <h4 class="mb-3">📁 Documents Archivés</h4>
            <div class="table-responsive">
                <table class="table table-hover" id="archivesTable">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Élève</th>
                            <th>Classe</th>
                            <th>Généré par</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="archivesBody">
                        <tr><td colspan="6" class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Générique pour tous les documents -->
<div class="modal fade" id="docModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background:rgba(30,30,50,0.95); color:white; border-radius:16px; border:1px solid rgba(255,255,255,0.1);">
            <div class="modal-header" style="border-bottom:1px solid rgba(255,255,255,0.1);">
                <h5 class="modal-title" id="docModalTitle">📜 Document</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="docModalBody">
                <!-- Rempli dynamiquement -->
            </div>
            <div class="modal-footer" style="border-top:1px solid rgba(255,255,255,0.1);">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary" id="btnGenerateDoc">
                    <i data-feather="printer"></i> Imprimer
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    var allStudents = [];
    var allClasses = [];
    var selectedStudentId = null;
    var selectedClassName = null;
    var currentDocType = '';

    document.addEventListener('DOMContentLoaded', function() {
        if (typeof feather !== 'undefined') feather.replace();
        loadClassesAndStudents();
        
        document.getElementById('filterClass').addEventListener('change', function() {
            selectedClassName = this.value;
            filterStudentsByClass(this.value);
        });
        
        document.getElementById('filterStudent').addEventListener('change', function() {
            selectedStudentId = this.value;
            updateSelectedInfo();
        });
        
        document.getElementById('btnFilter').addEventListener('click', function() {
            updateSelectedInfo();
        });

        document.getElementById('btnGenerateDoc').addEventListener('click', function() {
            generateDocument(currentDocType);
        });
    });

    function loadClassesAndStudents() {
    // Charger les élèves (API qui fonctionne)
    fetch('/api/all-students')
        .then(function(r) { return r.json(); })
        .then(function(students) {
            allStudents = students;
            populateStudentSelect(students);
            
            // Extraire les classes des élèves (puisque l'API all-classes ne marche pas)
            var classSet = {};
            students.forEach(function(s) {
                if (s.student_class && s.student_class.trim() !== '') {
                    classSet[s.student_class] = true;
                }
            });
            allClasses = Object.keys(classSet).sort();
            
            // Remplir le sélecteur de classes
            var classSelect = document.getElementById('filterClass');
            classSelect.innerHTML = '<option value="">-- Toutes les classes --</option>';
            allClasses.forEach(function(c) {
                classSelect.innerHTML += '<option value="' + c + '" style="background:#1a1a2e;">' + c + '</option>';
            });
            
            console.log('📋 Classes extraites:', allClasses);
        })
        .catch(function(error) {
            console.error('Erreur chargement élèves:', error);
        });
}

    function populateStudentSelect(students) {
        var studentSelect = document.getElementById('filterStudent');
        studentSelect.innerHTML = '<option value="">-- Tous les élèves --</option>';
        students.forEach(function(s) {
            studentSelect.innerHTML += '<option value="' + s.id + '" style="background:#1a1a2e;">' + s.name + ' (' + (s.student_class || 'N/A') + ')</option>';
        });
    }

    function filterStudentsByClass(className) {
        var studentSelect = document.getElementById('filterStudent');
        
        if (!className) {
            populateStudentSelect(allStudents);
            return;
        }
        
        var filtered = allStudents.filter(function(s) { return s.student_class === className; });
        studentSelect.innerHTML = '<option value="">-- Tous les élèves de ' + className + ' --</option>';
        filtered.forEach(function(s) {
            studentSelect.innerHTML += '<option value="' + s.id + '" style="background:#1a1a2e;">' + s.name + '</option>';
        });
        
        selectedStudentId = null;
        updateSelectedInfo();
    }

    function updateSelectedInfo() {
        var info = document.getElementById('selectedStudentInfo');
        selectedStudentId = document.getElementById('filterStudent').value;
        selectedClassName = document.getElementById('filterClass').value;
        
        if (selectedStudentId) {
            var student = allStudents.find(function(s) { return s.id == selectedStudentId; });
            if (student) {
                info.textContent = '✓ Élève : ' + student.name + ' (' + (student.student_class || 'N/A') + ')';
            }
        } else if (selectedClassName) {
            info.textContent = '✓ Classe : ' + selectedClassName + ' (tous les élèves)';
        } else {
            info.textContent = '';
        }
    }

    function openDocModal(type) {
        currentDocType = type;
        
        if (!selectedStudentId && !selectedClassName) {
            alert('Veuillez sélectionner une classe ou un élève dans le filtre ci-dessus.');
            return;
        }
        
        var title = '';
        var body = '';
        
        switch(type) {
            case 'certificate':
                title = '📜 Certificat de Scolarité';
                body = getCertificateBody();
                break;
            case 'bulletin':
                title = '📊 Bulletin de Notes';
                body = getBulletinBody();
                break;
            case 'attestation':
                title = '🏆 Attestation de Réussite';
                body = getAttestationBody();
                break;
            case 'inscription':
                title = '📝 Fiche d\'Inscription';
                body = getInscriptionBody();
                break;
            case 'sortie':
                title = '🚪 Certificat de Sortie';
                body = getSortieBody();
                break;
            case 'livret':
                title = '📖 Livret Scolaire';
                body = getLivretBody();
                break;
            default:
                title = '📄 Document';
                body = '<p style="color:#888;">Fonctionnalité en cours de développement.</p>';
        }
        
        document.getElementById('docModalTitle').textContent = title;
        document.getElementById('docModalBody').innerHTML = body;
        
        new bootstrap.Modal(document.getElementById('docModal')).show();
    }

    function getCertificateBody() {
        return '<div class="mb-3"><label class="form-label">Année Scolaire</label><input type="text" class="form-control" id="certYear" value="2024-2025" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);"></div>' +
            '<div class="mb-3"><label class="form-label">Établissement</label><input type="text" class="form-control" id="certSchool" placeholder="Nom de l\'établissement" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);"></div>' +
            '<div style="background:rgba(13,202,240,0.1); padding:10px; border-radius:8px; color:#0dcaf0;">📌 Document pour : <strong>' + (selectedStudentId ? '1 élève sélectionné' : 'Classe ' + selectedClassName) + '</strong></div>';
    }

    function getBulletinBody() {
        return '<div class="mb-3"><label class="form-label">Période</label><select class="form-select" id="bulletinPeriod" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);"><option value="1">1er Trimestre</option><option value="2">2ème Trimestre</option><option value="3">3ème Trimestre</option></select></div>' +
            '<div style="background:rgba(13,202,240,0.1); padding:10px; border-radius:8px; color:#0dcaf0;">📌 Document pour : <strong>' + (selectedStudentId ? '1 élève sélectionné' : 'Classe ' + selectedClassName) + '</strong></div>';
    }

    function getAttestationBody() {
        return '<div class="mb-3"><label class="form-label">Type</label><select class="form-select" id="attestType" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);"><option value="passage">Attestation de Passage</option><option value="reussite">Attestation de Réussite</option><option value="fin_cycle">Attestation de Fin de Cycle</option></select></div>' +
            '<div style="background:rgba(13,202,240,0.1); padding:10px; border-radius:8px; color:#0dcaf0;">📌 Document pour : <strong>' + (selectedStudentId ? '1 élève sélectionné' : 'Classe ' + selectedClassName) + '</strong></div>';
    }

    function getInscriptionBody() {
        return '<div class="row"><div class="col-md-6 mb-3"><label class="form-label">Type</label><select class="form-select" id="inscType" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);"><option value="inscription">Nouvelle Inscription</option><option value="reinscription">Réinscription</option></select></div><div class="col-md-6 mb-3"><label class="form-label">Année Scolaire</label><input type="text" class="form-control" id="inscYear" value="2024-2025" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);"></div></div>' +
            '<div style="background:rgba(13,202,240,0.1); padding:10px; border-radius:8px; color:#0dcaf0;">📌 Document pour : <strong>' + (selectedStudentId ? '1 élève sélectionné' : 'Classe ' + selectedClassName) + '</strong></div>';
    }

    function getSortieBody() {
        return '<div class="mb-3"><label class="form-label">Motif de départ</label><select class="form-select" id="sortieMotif" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);"><option value="demangement">Déménagement</option><option value="changement_ecole">Changement d\'école</option><option value="fin_cycle">Fin de cycle</option><option value="autre">Autre</option></select></div>' +
            '<div class="mb-3"><label class="form-label">Date de sortie</label><input type="date" class="form-control" id="sortieDate" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);"></div>' +
            '<div class="mb-3"><label class="form-label">Nouvel établissement</label><input type="text" class="form-control" id="sortieNewSchool" placeholder="Nom du nouvel établissement" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);"></div>' +
            '<div style="background:rgba(13,202,240,0.1); padding:10px; border-radius:8px; color:#0dcaf0;">📌 Document pour : <strong>' + (selectedStudentId ? '1 élève sélectionné' : 'Classe ' + selectedClassName) + '</strong></div>';
    }

    function getLivretBody() {
        return '<div class="row"><div class="col-md-6 mb-3"><label class="form-label">Année Scolaire</label><input type="text" class="form-control" id="livretYear" value="2024-2025" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);"></div><div class="col-md-6 mb-3"><label class="form-label">Période</label><select class="form-select" id="livretPeriod" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);"><option value="1">1er Trimestre</option><option value="2">2ème Trimestre</option><option value="3">3ème Trimestre</option><option value="annuel">Annuel</option></select></div></div>' +
            '<div style="background:rgba(13,202,240,0.1); padding:10px; border-radius:8px; color:#0dcaf0;">📌 Document pour : <strong>' + (selectedStudentId ? '1 élève sélectionné' : 'Classe ' + selectedClassName) + '</strong></div>';
    }

    // ========================================================================
    // GÉNÉRATION DE DOCUMENTS AVEC DÉTAILS ÉLÈVE
    // ========================================================================
    
    function generateDocument(type) {
        if (!selectedStudentId && !selectedClassName) {
            alert('Veuillez sélectionner une classe ou un élève.');
            return;
        }
        
        var docNames = {
            'certificate': 'Certificat de scolarité',
            'bulletin': 'Bulletin de notes',
            'attestation': 'Attestation de réussite',
            'inscription': 'Fiche d\'inscription',
            'sortie': 'Certificat de sortie',
            'livret': 'Livret scolaire'
        };
        
        if (selectedStudentId) {
            fetch('/api/student-details/' + selectedStudentId)
                .then(function(r) { return r.json(); })
                .then(function(student) {
                    console.log('📋 Détails élève:', student);
                    
                    var docData = {
                        student_name: student.name,
                        student_class: student.student_class,
                        matricule: student.matricule,
                        date_of_birth: student.date_of_birth,
                        place_of_birth: student.place_of_birth,
                        address: student.address,
                        parents: student.linkedParents || [],
                        manual_parents: student.manualParents || []
                    };
                    
                    return fetch('/api/documents/generate', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            type: type,
                            student_id: selectedStudentId,
                            class_name: selectedClassName,
                            data: docData
                        })
                    });
                })
                .then(function(r) { return r.json(); })
                .then(function(result) {
                    if (result.success) {
                        openPrintWindow(type, selectedStudentId);
                    }
                })
                .catch(function(error) {
                    console.error('❌ Erreur:', error);
                    alert('✅ ' + (docNames[type] || 'Document') + ' généré avec succès !');
                });
        } else {
            alert('✅ ' + (docNames[type] || 'Document') + ' généré pour la classe ' + selectedClassName + ' !');
        }
        
        var modal = bootstrap.Modal.getInstance(document.getElementById('docModal'));
        if (modal) modal.hide();
    }

    function openPrintWindow(type, studentId) {
    fetch('/api/student-details/' + studentId)
        .then(function(r) { return r.json(); })
        .then(function(student) {
            var docBody = '';
            
            switch(type) {
                case 'certificate': docBody = generateCertificateHTML(student); break;
                case 'inscription': docBody = generateInscriptionHTML(student); break;
                case 'sortie': docBody = generateSortieHTML(student); break;
                case 'livret': docBody = generateLivretHTML(student); break;
                case 'attestation': docBody = generateAttestationHTML(student); break;
                default: docBody = generateGenericHTML(student);
            }
            
            // Afficher dans une modale avec bouton imprimer
            var printModal = document.createElement('div');
            printModal.innerHTML = '<div class="modal fade" id="printModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content" style="background:white; color:#333; border-radius:16px;"><div class="modal-header"><h5 class="modal-title">Aperçu avant impression</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" style="max-height:70vh; overflow-y:auto;">' + docBody + '</div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button><button class="btn btn-primary" onclick="window.print()"><i data-feather="printer"></i> Imprimer</button></div></div></div></div>';
            
            document.body.appendChild(printModal);
            var modal = new bootstrap.Modal(document.getElementById('printModal'));
            modal.show();
            
            document.getElementById('printModal').addEventListener('hidden.bs.modal', function() {
                this.remove();
            });
        });
}

    function generateCertificateHTML(student) {
        var date = new Date().toLocaleDateString('fr-FR');
        var year = document.getElementById('certYear') ? document.getElementById('certYear').value : '2024-2025';
        var school = document.getElementById('certSchool') ? document.getElementById('certSchool').value : 'Établissement';
        
        return '<div class="header"><h1>CERTIFICAT DE SCOLARITÉ</h1><h2>Année Scolaire ' + year + '</h2></div>' +
            '<div class="section"><p>Je soussigné, Directeur de l\'établissement <strong>' + school + '</strong>, certifie que :</p></div>' +
            '<table><tr><td>Nom et Prénom</td><td><strong>' + student.name + '</strong></td></tr>' +
            '<tr><td>Né(e) le</td><td>' + (student.date_of_birth ? new Date(student.date_of_birth).toLocaleDateString('fr-FR') : 'Non renseigné') + '</td></tr>' +
            '<tr><td>À</td><td>' + (student.place_of_birth || 'Non renseigné') + '</td></tr>' +
            '<tr><td>Matricule</td><td>' + (student.matricule || 'N/A') + '</td></tr>' +
            '<tr><td>Classe</td><td>' + (student.student_class || 'N/A') + '</td></tr>' +
            '<tr><td>Adresse</td><td>' + (student.address || 'Non renseignée') + '</td></tr></table>' +
            '<div class="section"><p>Est régulièrement inscrit(e) dans notre établissement pour l\'année scolaire en cours.</p></div>' +
            '<div class="footer"><p>Fait à _______________, le ' + date + '</p><p>Le Directeur</p></div>';
    }

    function generateInscriptionHTML(student) {
        var date = new Date().toLocaleDateString('fr-FR');
        var year = document.getElementById('inscYear') ? document.getElementById('inscYear').value : '2024-2025';
        var parents = student.linkedParents || [];
        var manualParents = student.manualParents || [];
        var allParents = parents.concat(manualParents);
        
        var parentsHTML = '';
        if (allParents.length > 0) {
            parentsHTML = '<table>';
            allParents.forEach(function(p) {
                parentsHTML += '<tr><td>' + p.name + '</td><td>' + (p.phone || p.phone_number || 'Non renseigné') + '</td></tr>';
            });
            parentsHTML += '</table>';
        } else {
            parentsHTML = '<p>Aucun parent enregistré.</p>';
        }
        
        return '<div class="header"><h1>FICHE D\'INSCRIPTION / RÉINSCRIPTION</h1><h2>Année Scolaire ' + year + '</h2></div>' +
            '<div class="section"><h3>Informations de l\'élève</h3></div>' +
            '<table><tr><td>Nom et Prénom</td><td><strong>' + student.name + '</strong></td></tr>' +
            '<tr><td>Date de naissance</td><td>' + (student.date_of_birth ? new Date(student.date_of_birth).toLocaleDateString('fr-FR') : 'Non renseigné') + '</td></tr>' +
            '<tr><td>Lieu de naissance</td><td>' + (student.place_of_birth || 'Non renseigné') + '</td></tr>' +
            '<tr><td>Matricule</td><td>' + (student.matricule || 'N/A') + '</td></tr>' +
            '<tr><td>Classe</td><td>' + (student.student_class || 'N/A') + '</td></tr>' +
            '<tr><td>Adresse</td><td>' + (student.address || 'Non renseignée') + '</td></tr></table>' +
            '<div class="section"><h3>Parents / Tuteurs</h3></div>' + parentsHTML +
            '<div class="footer"><p>Fait à _______________, le ' + date + '</p><p>Signature du parent/tuteur : _________________</p></div>';
    }

    function generateSortieHTML(student) {
        var date = new Date().toLocaleDateString('fr-FR');
        var sortieDateEl = document.getElementById('sortieDate');
        var sortieDate = sortieDateEl && sortieDateEl.value ? new Date(sortieDateEl.value).toLocaleDateString('fr-FR') : date;
        var motifEl = document.getElementById('sortieMotif');
        var motif = motifEl ? motifEl.value : 'autre';
        var motifs = { 'demangement': 'Déménagement', 'changement_ecole': "Changement d'école", 'fin_cycle': 'Fin de cycle', 'autre': 'Autre' };
        var newSchoolEl = document.getElementById('sortieNewSchool');
        var newSchool = newSchoolEl ? newSchoolEl.value : 'Non précisé';
        
        return '<div class="header"><h1>CERTIFICAT DE SORTIE (RADIATION)</h1></div>' +
            '<div class="section"><p>Je soussigné, Directeur de l\'établissement, certifie que :</p></div>' +
            '<table><tr><td>Nom et Prénom</td><td><strong>' + student.name + '</strong></td></tr>' +
            '<tr><td>Né(e) le</td><td>' + (student.date_of_birth ? new Date(student.date_of_birth).toLocaleDateString('fr-FR') : 'Non renseigné') + '</td></tr>' +
            '<tr><td>Matricule</td><td>' + (student.matricule || 'N/A') + '</td></tr>' +
            '<tr><td>Dernière classe fréquentée</td><td>' + (student.student_class || 'N/A') + '</td></tr>' +
            '<tr><td>Date de sortie</td><td>' + sortieDate + '</td></tr>' +
            '<tr><td>Motif</td><td>' + (motifs[motif] || motif) + '</td></tr>' +
            '<tr><td>Nouvel établissement</td><td>' + newSchool + '</td></tr></table>' +
            '<div class="section"><p>Est libéré(e) de toute obligation envers notre établissement à compter de la date indiquée.</p></div>' +
            '<div class="footer"><p>Fait à _______________, le ' + date + '</p><p>Le Directeur</p></div>';
    }

    function generateLivretHTML(student) {
        var date = new Date().toLocaleDateString('fr-FR');
        var yearEl = document.getElementById('livretYear');
        var year = yearEl ? yearEl.value : '2024-2025';
        var periodEl = document.getElementById('livretPeriod');
        var periodVal = periodEl ? periodEl.value : '1';
        var period = periodVal === 'annuel' ? 'Annuel' : periodVal + 'er Trimestre';
        
        return '<div class="header"><h1>LIVRET SCOLAIRE</h1><h2>Année Scolaire ' + year + '</h2></div>' +
            '<div class="section"><h3>Informations de l\'élève</h3></div>' +
            '<table><tr><td>Nom et Prénom</td><td><strong>' + student.name + '</strong></td></tr>' +
            '<tr><td>Date de naissance</td><td>' + (student.date_of_birth ? new Date(student.date_of_birth).toLocaleDateString('fr-FR') : 'Non renseigné') + '</td></tr>' +
            '<tr><td>Lieu de naissance</td><td>' + (student.place_of_birth || 'Non renseigné') + '</td></tr>' +
            '<tr><td>Matricule</td><td>' + (student.matricule || 'N/A') + '</td></tr>' +
            '<tr><td>Classe</td><td>' + (student.student_class || 'N/A') + '</td></tr>' +
            '<tr><td>Année Scolaire</td><td>' + year + '</td></tr>' +
            '<tr><td>Période</td><td>' + period + '</td></tr></table>' +
            '<div class="section"><h3>Compétences et Appréciations</h3></div>' +
            '<table><tr><td>Français</td><td>_______________________________</td></tr>' +
            '<tr><td>Mathématiques</td><td>_______________________________</td></tr>' +
            '<tr><td>Sciences</td><td>_______________________________</td></tr>' +
            '<tr><td>Histoire-Géographie</td><td>_______________________________</td></tr>' +
            '<tr><td>Langues</td><td>_______________________________</td></tr>' +
            '<tr><td>EPS</td><td>_______________________________</td></tr></table>' +
            '<div class="footer"><p>Fait à _______________, le ' + date + '</p><p>Le Directeur / Professeur Principal</p></div>';
    }

    function generateAttestationHTML(student) {
        var date = new Date().toLocaleDateString('fr-FR');
        var typeEl = document.getElementById('attestType');
        var type = typeEl ? typeEl.value : 'passage';
        var types = { 'passage': 'PASSAGE EN CLASSE SUPÉRIEURE', 'reussite': 'RÉUSSITE', 'fin_cycle': 'FIN DE CYCLE' };
        
        return '<div class="header"><h1>ATTESTATION DE ' + (types[type] || 'RÉUSSITE') + '</h1></div>' +
            '<table><tr><td>Nom et Prénom</td><td><strong>' + student.name + '</strong></td></tr>' +
            '<tr><td>Matricule</td><td>' + (student.matricule || 'N/A') + '</td></tr>' +
            '<tr><td>Classe</td><td>' + (student.student_class || 'N/A') + '</td></tr>' +
            '<tr><td>Année Scolaire</td><td>2024-2025</td></tr></table>' +
            '<div class="section"><p>Est admis(e) en classe supérieure pour l\'année scolaire suivante.</p></div>' +
            '<div class="footer"><p>Fait à _______________, le ' + date + '</p><p>Le Directeur</p></div>';
    }

    function generateGenericHTML(student) {
        var date = new Date().toLocaleDateString('fr-FR');
        return '<div class="header"><h1>DOCUMENT SCOLAIRE</h1></div>' +
            '<table><tr><td>Nom</td><td><strong>' + student.name + '</strong></td></tr>' +
            '<tr><td>Classe</td><td>' + (student.student_class || 'N/A') + '</td></tr>' +
            '<tr><td>Matricule</td><td>' + (student.matricule || 'N/A') + '</td></tr></table>' +
            '<div class="footer"><p>Fait le ' + date + '</p></div>';
    }

    // ========================================================================
    // ARCHIVES
    // ========================================================================
    
    function loadArchives() {
        var section = document.getElementById('archivesSection');
        section.style.display = 'block';
        
        fetch('/api/documents/archives')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var tbody = document.getElementById('archivesBody');
                if (!data || data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-3 text-muted">Aucun document archivé.</td></tr>';
                    return;
                }
                tbody.innerHTML = data.map(function(d) {
                    return '<tr>' +
                        '<td>' + new Date(d.created_at).toLocaleDateString('fr-FR') + '</td>' +
                        '<td>' + d.type + '</td>' +
                        '<td>' + (d.student_name || '-') + '</td>' +
                        '<td>' + (d.student_class || '-') + '</td>' +
                        '<td>' + (d.created_by_name || '-') + '</td>' +
                        '<td><button class="btn btn-sm btn-outline-primary" onclick="window.open(\'/uploads/documents/' + (d.file_url || '') + '\')">📥</button></td>' +
                    '</tr>';
                }).join('');
            })
            .catch(function() {
                document.getElementById('archivesBody').innerHTML = '<tr><td colspan="6" class="text-center py-3 text-muted">Erreur de chargement.</td></tr>';
            });
    }
</script>

