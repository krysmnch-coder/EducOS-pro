<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container-fluid page-shell py-4">
    <div class="themed-container" style="max-width: 100%; padding: 0 20px;">
        <h2 class="mb-4">Documents Scolaires</h2>
        <%- include('../partials/messages') %>

        <!-- Sélecteur Classe + Élève -->
        <div class="card glass-card mb-4 p-3" style="border-radius:16px;">
            <div class="row align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Classe</label>
                    <select class="form-select" id="filterClass" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                        <option value="">-- Toutes les classes --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Élève</label>
                    <select class="form-select" id="filterStudent" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                        <option value="">-- Tous les élèves --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" id="btnFilter">Filtrer</button>
                </div>
                <div class="col-md-3">
                    <span id="selectedStudentInfo" style="color: #0dcaf0; font-size: 0.9rem;"></span>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Certificat de Scolarité -->
            <div class="col-md-6 col-lg-4 d-flex">
                <div class="card glass-card p-4 w-100" style="border-radius:16px; min-height:280px; display:flex; flex-direction:column; justify-content:space-between;">
                    <div>
                        <h5>Certificat de Scolarité</h5>
                        <p style="color:#888; font-size:0.9rem;">Générer un certificat de scolarité pour un élève.</p>
                        <div class="mb-3">
                            <label class="form-label">Année Scolaire</label>
                            <select class="form-select" id="certYear" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                                <option value="2026-2027">2026-2027</option>
                                <option value="2027-2028">2027-2028</option>
                                <option value="2028-2029">2028-2029</option>
                                <option value="2029-2030">2029-2030</option>
                                <option value="2030-2031">2030-2031</option>
                                <option value="2031-2032">2031-2032</option>
                                <option value="2032-2033">2032-2033</option>
                                <option value="2033-2034">2033-2034</option>
                                <option value="2034-2035">2034-2035</option>
                                <option value="2035-2036">2035-2036</option>
                                <option value="2036-2037">2036-2037</option>
                                <option value="2037-2038">2037-2038</option>
                                <option value="2038-2039">2038-2039</option>
                                <option value="2039-2040">2039-2040</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Ville / Région</label>
                            <select class="form-select" id="certCity" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                                <option value="">-- Choisir --</option>
                                <option value="Antananarivo">Antananarivo</option>
                                <option value="Antsirabe">Antsirabe</option>
                                <option value="Fianarantsoa">Fianarantsoa</option>
                                <option value="Toamasina">Toamasina</option>
                                <option value="Mahajanga">Mahajanga</option>
                                <option value="Toliara">Toliara</option>
                                <option value="Antsiranana">Antsiranana</option>
                            </select>
                        </div>
                    </div>
                    <button class="btn btn-primary w-100 mt-2" onclick="generateDocument('certificate')">
                         Générer PDF (A5)
                    </button>
                </div>
            </div>

            <!-- Certificat de Sortie / Radiation -->
            <div class="col-md-6 col-lg-4 d-flex">
                <div class="card glass-card p-4 w-100" style="border-radius:16px; min-height:280px; display:flex; flex-direction:column; justify-content:space-between;">
                    <div>
                        <h5>Certificat de Sortie</h5>
                        <p style="color:#888; font-size:0.9rem;">Certificat de radiation pour changement d'école.</p>
                        <div class="mb-3">
                            <label class="form-label">Motif de départ</label>
                            <select class="form-select" id="sortieMotif" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                                <option value="demangement">Déménagement</option>
                                <option value="changement_ecole">Changement d'école</option>
                                <option value="fin_cycle">Fin de cycle</option>
                                <option value="autre">Autre</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Ville / Région</label>
                            <select class="form-select" id="sortieCity" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                                <option value="">-- Choisir --</option>
                                <option value="Antananarivo">Antananarivo</option>
                                <option value="Antsirabe">Antsirabe</option>
                                <option value="Fianarantsoa">Fianarantsoa</option>
                                <option value="Toamasina">Toamasina</option>
                                <option value="Mahajanga">Mahajanga</option>
                                <option value="Toliara">Toliara</option>
                                <option value="Antsiranana">Antsiranana</option>
                            </select>
                        </div>
                    </div>
                    <button class="btn btn-primary w-100 mt-2" onclick="generateDocument('sortie')">
                         Générer PDF (A5)
                    </button>
                </div>
            </div>

            <!-- Archives -->
            <div class="col-md-6 col-lg-4 d-flex">
                <div class="card glass-card p-4 w-100" style="border-radius:16px; min-height:280px; display:flex; flex-direction:column; justify-content:space-between;">
                    <div>
                        <h5>Archives</h5>
                        <p style="color:#888; font-size:0.9rem;">Consulter les documents déjà générés.</p>
                    </div>
                    <button class="btn btn-primary w-100 mt-2" onclick="loadArchives()">
                         Consulter les archives
                    </button>
                </div>
            </div>
        </div>

        <!-- Section Archives -->
        <div class="card glass-card mt-4 p-4" style="border-radius:16px; display:none;" id="archivesSection">
            <h4 class="mb-3">Documents Archivés</h4>
            <div class="table-responsive">
                <table class="table table-hover" id="archivesTable">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Élève</th>
                            <th>Classe</th>
                            <th>Généré par</th>
                        </tr>
                    </thead>
                    <tbody id="archivesBody">
                        <tr><td colspan="5" class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<script>
    var allStudents = [];
    var allClasses = [];
    var selectedStudentId = null;
    var selectedClassName = null;
    var currentUser = { 
        name: '<%= user.name %>', 
        role: '<%= user.role %>',
        establishmentName: '<%= typeof establishmentName !== "undefined" ? establishmentName : "Établissement" %>',
        adminName: '<%= typeof adminName !== "undefined" ? adminName : user.name %>'
    };

    document.addEventListener('DOMContentLoaded', function() {
        loadClassesAndStudents();
        document.getElementById('filterClass').addEventListener('change', function() {
            selectedClassName = this.value;
            filterStudentsByClass(this.value);
        });
        document.getElementById('filterStudent').addEventListener('change', function() {
            selectedStudentId = this.value;
            updateSelectedInfo();
        });
        document.getElementById('btnFilter').addEventListener('click', function() { updateSelectedInfo(); });
    });

    function loadClassesAndStudents() {
        fetch('/api/all-students')
            .then(function(r) { return r.json(); })
            .then(function(students) {
                allStudents = students;
                populateStudentSelect(students);
                var classSet = {};
                students.forEach(function(s) {
                    if (s.student_class && s.student_class.trim() !== '') classSet[s.student_class] = true;
                });
                allClasses = Object.keys(classSet).sort();
                var classSelect = document.getElementById('filterClass');
                classSelect.innerHTML = '<option value="">-- Toutes les classes --</option>';
                allClasses.forEach(function(c) {
                    classSelect.innerHTML += '<option value="' + c + '">' + c + '</option>';
                });
            })
            .catch(function(error) { console.error('Erreur:', error); });
    }

    function populateStudentSelect(students) {
        var studentSelect = document.getElementById('filterStudent');
        studentSelect.innerHTML = '<option value="">-- Tous les élèves --</option>';
        students.forEach(function(s) {
            studentSelect.innerHTML += '<option value="' + s.id + '">' + s.name + ' (' + (s.student_class || 'N/A') + ')</option>';
        });
    }

    function filterStudentsByClass(className) {
        var studentSelect = document.getElementById('filterStudent');
        if (!className) { populateStudentSelect(allStudents); return; }
        var filtered = allStudents.filter(function(s) { return s.student_class === className; });
        studentSelect.innerHTML = '<option value="">-- Tous les élèves de ' + className + ' --</option>';
        filtered.forEach(function(s) { studentSelect.innerHTML += '<option value="' + s.id + '">' + s.name + '</option>'; });
        selectedStudentId = null;
        updateSelectedInfo();
    }

    function updateSelectedInfo() {
        var info = document.getElementById('selectedStudentInfo');
        selectedStudentId = document.getElementById('filterStudent').value;
        selectedClassName = document.getElementById('filterClass').value;
        if (selectedStudentId) {
            var student = allStudents.find(function(s) { return s.id == selectedStudentId; });
            if (student) info.textContent = '✓ ' + student.name + ' (' + (student.student_class || 'N/A') + ')';
        } else if (selectedClassName) {
            info.textContent = '✓ Classe : ' + selectedClassName;
        } else { info.textContent = ''; }
    }

    function generateDocument(type) {
        if (!selectedStudentId) { alert('Veuillez sélectionner un élève.'); return; }
        var student = allStudents.find(function(s) { return s.id == selectedStudentId; });
        if (!student) return;

        fetch('/api/student-details/' + selectedStudentId)
            .then(function(r) { return r.json(); })
            .then(function(details) {
                var studentData = details;
                if (!studentData.name) studentData.name = student.name;
                if (!studentData.student_class) studentData.student_class = student.student_class;

                fetch('/api/documents/generate', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ type: type, student_id: selectedStudentId, class_name: studentData.student_class || selectedClassName, data: { student_name: studentData.name, student_class: studentData.student_class } })
                });

                if (type === 'certificate') generateCertificatePDF(studentData);
                else if (type === 'sortie') generateSortiePDF(studentData);
            })
            .catch(function(error) { console.error('Erreur:', error); alert('Erreur lors de la génération.'); });
    }

  function generateCertificatePDF(student) {
    var year = document.getElementById('certYear').value || '2025-2026';
    var city = document.getElementById('certCity').value || '_______________';
    var date = new Date().toLocaleDateString('fr-FR');
    var school = currentUser.establishmentName;
    var directorTitle = 'Le/La Directeur(rice)';
    var directorName = currentUser.adminName;

    var allParents = [];
    if (student.linkedParents) allParents = allParents.concat(student.linkedParents);
    if (student.manualParents) allParents = allParents.concat(student.manualParents);

    var { jsPDF } = window.jspdf;
    var doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: [210, 148] });

    var pageWidth = 210;
    var centerX = pageWidth / 2;
    var leftMargin = 25;
    var labelX = leftMargin;
    var valueX = leftMargin + 45;

    // === EN-TÊTE ===
    doc.setFontSize(14);
    doc.setFont('helvetica', 'bold');
    doc.text('CERTIFICAT DE SCOLARITÉ', centerX, 15, { align: 'center' });
    
    doc.setFontSize(10);
    doc.setFont('helvetica', 'normal');
    doc.text('Année Scolaire : ' + year, centerX, 23, { align: 'center' });
    doc.text('Établissement : ' + school, centerX, 30, { align: 'center' });
    
    doc.setDrawColor(13, 110, 253);
    doc.line(leftMargin, 36, pageWidth - leftMargin, 36);

    // === CORPS ===
    doc.setFontSize(10);
    doc.text('Je soussigné, ' + directorName + ', ' + directorTitle + ' de ' + school + ', certifie que :', leftMargin, 45);

    var y = 55;                  // début légèrement remonté
    var lineHeight = 7;          // interligne réduit (au lieu de 8)
    
    var lines = [
        { label: 'Nom et Prénom :', value: student.name || '' },
        { label: 'Né(e) le :', value: student.date_of_birth ? new Date(student.date_of_birth).toLocaleDateString('fr-FR') : 'Non renseigné' },
        { label: 'Lieu de naissance :', value: student.place_of_birth || 'Non renseigné' },
        { label: 'Matricule :', value: student.matricule || 'N/A' },
        { label: 'Classe :', value: student.student_class || 'N/A' },
        { label: 'Adresse :', value: student.address || 'Non renseignée' }
    ];

    lines.forEach(function(line) {
        doc.setFont('helvetica', 'bold');
        doc.text(line.label, labelX, y);
        doc.setFont('helvetica', 'normal');
        doc.text(line.value, valueX, y);
        y += lineHeight;
    });

    // Parents
    if (allParents.length > 0) {
        doc.setFont('helvetica', 'bold');
        doc.text('Parent(s) :', labelX, y + 1);
        doc.setFont('helvetica', 'normal');
        doc.text(allParents.map(function(p) { return p.name; }).join(' | '), valueX, y + 1, { maxWidth: pageWidth - valueX - leftMargin });
        y += 10;   // un peu moins d'espace
    }

    // Texte de certification
    y += 2;   // réduit
    doc.setFont('helvetica', 'normal');
    doc.text('Est régulièrement inscrit(e) dans notre établissement pour l\'année scolaire ' + year + '.', leftMargin, y);

    // === SIGNATURE ===
    var sigY = 115;   // remonté (au lieu de 115)
    doc.setFont('helvetica', 'normal');
    doc.text('Fait à ' + city + ', le ' + date, pageWidth - leftMargin, sigY, { align: 'right' });
    doc.setFont('helvetica', 'bold');
    doc.text(directorTitle, pageWidth - leftMargin, sigY + 7, { align: 'right' });
    doc.setFont('helvetica', 'normal');
    doc.text(directorName, pageWidth - leftMargin, sigY + 12, { align: 'right' });

    doc.save('Certificat_Scolarite_' + (student.name || 'eleve').replace(/ /g, '_') + '.pdf');
}

function generateSortiePDF(student) {
    var date = new Date().toLocaleDateString('fr-FR');
    var sortieDate = new Date().toLocaleDateString('fr-FR');
    var motif = document.getElementById('sortieMotif').value || 'autre';
    var city = document.getElementById('sortieCity').value || '_______________';
    var motifs = { 'demangement': 'Déménagement', 'changement_ecole': "Changement d'école", 'fin_cycle': 'Fin de cycle', 'autre': 'Autre' };
    var school = currentUser.establishmentName;
    var directorTitle = 'Le/La Directeur(rice)';
    var directorName = currentUser.adminName;

    var { jsPDF } = window.jspdf;
    var doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: [210, 148] });

    var pageWidth = 210;
    var centerX = pageWidth / 2;
    var leftMargin = 25;
    var labelX = leftMargin;
    var valueX = leftMargin + 45;

    // === EN-TÊTE ===
    doc.setFontSize(14);
    doc.setFont('helvetica', 'bold');
    doc.text('CERTIFICAT DE SORTIE', centerX, 15, { align: 'center' });
    doc.setFontSize(9);
    doc.setFont('helvetica', 'normal');
    doc.text('(RADIATION)', centerX, 22, { align: 'center' });
    doc.setFontSize(10);
    doc.text('Établissement : ' + school, centerX, 30, { align: 'center' });
    
    doc.setDrawColor(220, 53, 69);
    doc.line(leftMargin, 36, pageWidth - leftMargin, 36);

    // === CORPS ===
    doc.setFontSize(10);
    doc.text('Je soussigné, ' + directorName + ', ' + directorTitle + ' de ' + school + ', certifie que :', leftMargin, 45);

    var y = 55;
    var lineHeight = 7;   // réduit
    
    var lines = [
        { label: 'Nom et Prénom :', value: student.name || '' },
        { label: 'Né(e) le :', value: student.date_of_birth ? new Date(student.date_of_birth).toLocaleDateString('fr-FR') : 'Non renseigné' },
        { label: 'Matricule :', value: student.matricule || 'N/A' },
        { label: 'Dernière classe :', value: student.student_class || 'N/A' },
        { label: 'Date de sortie :', value: sortieDate },
        { label: 'Motif :', value: motifs[motif] || motif }
    ];

    lines.forEach(function(line) {
        doc.setFont('helvetica', 'bold');
        doc.text(line.label, labelX, y);
        doc.setFont('helvetica', 'normal');
        doc.text(line.value, valueX, y);
        y += lineHeight;
    });

    // Texte
    y += 2;
    doc.setFont('helvetica', 'normal');
    doc.text('Est libéré(e) de toute obligation envers notre établissement à compter de la date indiquée.', leftMargin, y);

    // === SIGNATURE ===
    var sigY = 115;   // remonté
    doc.setFont('helvetica', 'normal');
    doc.text('Fait à ' + city + ', le ' + date, pageWidth - leftMargin, sigY, { align: 'right' });
    doc.setFont('helvetica', 'bold');
    doc.text(directorTitle, pageWidth - leftMargin, sigY + 7, { align: 'right' });
    doc.setFont('helvetica', 'normal');
    doc.text(directorName, pageWidth - leftMargin, sigY + 12, { align: 'right' });

    doc.save('Certificat_Sortie_' + (student.name || 'eleve').replace(/ /g, '_') + '.pdf');
}
    function loadArchives() {
        var section = document.getElementById('archivesSection');
        section.style.display = 'block';
        fetch('/api/documents/archives')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var tbody = document.getElementById('archivesBody');
                if (!data || data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted">Aucun document archivé.</td></tr>';
                    return;
                }
                tbody.innerHTML = data.map(function(d) {
                    return '<tr><td>' + new Date(d.created_at).toLocaleDateString('fr-FR') + '</td>' +
                        '<td>' + d.type + '</td><td>' + (d.student_name || '-') + '</td>' +
                        '<td>' + (d.student_class || '-') + '</td><td>' + (d.created_by_name || '-') + '</td></tr>';
                }).join('');
            })
            .catch(function() {
                document.getElementById('archivesBody').innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted">Erreur.</td></tr>';
            });
    }
</script>

<style>
    .glass-card {
        background: rgba(255,255,255,0.05) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        border: 1px solid rgba(255,255,255,0.08) !important;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3) !important;
        transition: all 0.3s ease;
    }
    .glass-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.4) !important;
        border-color: rgba(13,110,253,0.3) !important;
    }
    #archivesTable th, #archivesTable td { border-color: rgba(128,128,128,0.15); vertical-align: middle; }
    #archivesTable th { background: rgba(13,110,253,0.08); font-weight: 600; color: #0d6efd; }
    [data-theme="dark"] #archivesTable th { background: rgba(255,255,255,0.05); color: #fff; }
    .form-label { color: rgba(255,255,255,0.8); font-weight: 500; }
</style>

<%- include('../partials/footer') %>