<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container-fluid page-shell py-4">
    <div class="themed-container" style="max-width: 100%; padding: 0 20px;">
        <h2 class="mb-4">Documents Scolaires</h2>
        <%- include('../partials/messages') %>

        <!-- Sélecteur Classe + Élève -->
        <div class="card glass-card mb-4 p-3" style="border-radius:16px;">
            <div class="row align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Classe</label>
                    <select class="form-select" id="filterClass" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                        <option value="">-- Toutes les classes --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Élève</label>
                    <select class="form-select" id="filterStudent" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                        <option value="">-- Tous les élèves --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" id="btnFilter">
                        <i data-feather="filter"></i> Filtrer
                    </button>
                </div>
                <div class="col-md-3">
                    <span id="selectedStudentInfo" style="color: #0dcaf0; font-size: 0.9rem;"></span>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Certificat de Scolarité -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4 text-center" style="border-radius:16px; min-height:250px;">
                    <div style="font-size:50px; margin-bottom:15px;">📜</div>
                    <h5>Certificat de Scolarité</h5>
                    <p style="color:#888; font-size:0.9rem;">Générer un certificat de scolarité pour un élève.</p>
                    <button class="btn btn-primary mt-3" onclick="openDocModal('certificate')">
                        <i data-feather="file-text"></i> Générer
                    </button>
                </div>
            </div>

            <!-- Bulletin de Notes -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4 text-center" style="border-radius:16px; min-height:250px;">
                    <div style="font-size:50px; margin-bottom:15px;">📊</div>
                    <h5>Bulletin de Notes</h5>
                    <p style="color:#888; font-size:0.9rem;">Générer les bulletins de notes par classe ou par élève.</p>
                    <button class="btn btn-primary mt-3" onclick="openDocModal('bulletin')">
                        <i data-feather="bar-chart-2"></i> Générer
                    </button>
                </div>
            </div>

            <!-- Attestation de Réussite -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4 text-center" style="border-radius:16px; min-height:250px;">
                    <div style="font-size:50px; margin-bottom:15px;">🏆</div>
                    <h5>Attestation de Réussite</h5>
                    <p style="color:#888; font-size:0.9rem;">Délivrer une attestation de réussite ou de passage.</p>
                    <button class="btn btn-primary mt-3" onclick="openDocModal('attestation')">
                        <i data-feather="award"></i> Générer
                    </button>
                </div>
            </div>

            <!-- Fiche d'Inscription / Réinscription -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4 text-center" style="border-radius:16px; min-height:250px;">
                    <div style="font-size:50px; margin-bottom:15px;">📝</div>
                    <h5>Fiche d'Inscription</h5>
                    <p style="color:#888; font-size:0.9rem;">Fiche d'inscription ou de réinscription pour un élève.</p>
                    <button class="btn btn-primary mt-3" onclick="openDocModal('inscription')">
                        <i data-feather="edit-3"></i> Générer
                    </button>
                </div>
            </div>

            <!-- Certificat de Sortie / Radiation -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4 text-center" style="border-radius:16px; min-height:250px;">
                    <div style="font-size:50px; margin-bottom:15px;">🚪</div>
                    <h5>Certificat de Sortie</h5>
                    <p style="color:#888; font-size:0.9rem;">Certificat de radiation pour changement d'école.</p>
                    <button class="btn btn-primary mt-3" onclick="openDocModal('sortie')">
                        <i data-feather="log-out"></i> Générer
                    </button>
                </div>
            </div>

            <!-- Livret Scolaire -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4 text-center" style="border-radius:16px; min-height:250px;">
                    <div style="font-size:50px; margin-bottom:15px;">📖</div>
                    <h5>Livret Scolaire</h5>
                    <p style="color:#888; font-size:0.9rem;">Livret qui suit l'élève et résume ses compétences.</p>
                    <button class="btn btn-primary mt-3" onclick="openDocModal('livret')">
                        <i data-feather="book-open"></i> Générer
                    </button>
                </div>
            </div>

            <!-- Relevé de Notes -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4 text-center" style="border-radius:16px; min-height:250px;">
                    <div style="font-size:50px; margin-bottom:15px;">📋</div>
                    <h5>Relevé de Notes</h5>
                    <p style="color:#888; font-size:0.9rem;">Relevé détaillé des notes par période.</p>
                    <button class="btn btn-primary mt-3" onclick="openDocModal('releve')">
                        <i data-feather="list"></i> Générer
                    </button>
                </div>
            </div>

            <!-- Convocation -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4 text-center" style="border-radius:16px; min-height:250px;">
                    <div style="font-size:50px; margin-bottom:15px;">📨</div>
                    <h5>Convocation</h5>
                    <p style="color:#888; font-size:0.9rem;">Générer des convocations pour les parents.</p>
                    <button class="btn btn-primary mt-3" onclick="openDocModal('convocation')">
                        <i data-feather="send"></i> Générer
                    </button>
                </div>
            </div>

            <!-- Archives -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4 text-center" style="border-radius:16px; min-height:250px;">
                    <div style="font-size:50px; margin-bottom:15px;">🗄️</div>
                    <h5>Archives</h5>
                    <p style="color:#888; font-size:0.9rem;">Consulter les documents déjà générés.</p>
                    <button class="btn btn-primary mt-3" onclick="loadArchives()">
                        <i data-feather="archive"></i> Consulter
                    </button>
                </div>
            </div>
        </div>

        <!-- Section Archives -->
        <div class="card glass-card mt-4 p-4" style="border-radius:16px; display:none;" id="archivesSection">
            <h4 class="mb-3">📁 Documents Archivés</h4>
            <div class="table-responsive">
                <table class="table table-hover" id="archivesTable">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Élève</th>
                            <th>Classe</th>
                            <th>Généré par</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="archivesBody">
                        <tr><td colspan="6" class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Générique pour tous les documents -->
<div class="modal fade" id="docModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background:rgba(30,30,50,0.95); color:white; border-radius:16px; border:1px solid rgba(255,255,255,0.1);">
            <div class="modal-header" style="border-bottom:1px solid rgba(255,255,255,0.1);">
                <h5 class="modal-title" id="docModalTitle">📜 Document</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="docModalBody">
                <!-- Rempli dynamiquement -->
            </div>
            <div class="modal-footer" style="border-top:1px solid rgba(255,255,255,0.1);">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary" id="btnGenerateDoc">
                    <i data-feather="printer"></i> Imprimer
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    var allStudents = [];
    var allClasses = [];
    var selectedStudentId = null;
    var selectedClassName = null;
    var currentDocType = '';

    document.addEventListener('DOMContentLoaded', function() {
        if (typeof feather !== 'undefined') feather.replace();
        loadClassesAndStudents();
        
        // Événements
        document.getElementById('filterClass').addEventListener('change', function() {
            selectedClassName = this.value;
            filterStudentsByClass(this.value);
        });
        
        document.getElementById('filterStudent').addEventListener('change', function() {
            selectedStudentId = this.value;
            updateSelectedInfo();
        });
        
        document.getElementById('btnFilter').addEventListener('click', function() {
            updateSelectedInfo();
        });

        document.getElementById('btnGenerateDoc').addEventListener('click', function() {
            generateDocument(currentDocType);
        });
    });

    function loadClassesAndStudents() {
        // Charger les classes
        fetch('/api/all-classes')
            .then(function(r) { return r.json(); })
            .then(function(classes) {
                allClasses = classes;
                var classSelect = document.getElementById('filterClass');
                classes.forEach(function(c) {
                    classSelect.innerHTML += '<option value="' + c + '" style="background:#1a1a2e;">' + c + '</option>';
                });
            })
            .catch(function() {});

        // Charger tous les élèves
        fetch('/api/all-students')
            .then(function(r) { return r.json(); })
            .then(function(students) {
                allStudents = students;
                populateStudentSelect(students);
            })
            .catch(function() {});
    }

    function populateStudentSelect(students) {
        var studentSelect = document.getElementById('filterStudent');
        studentSelect.innerHTML = '<option value="">-- Tous les élèves --</option>';
        students.forEach(function(s) {
            studentSelect.innerHTML += '<option value="' + s.id + '" style="background:#1a1a2e;">' + s.name + ' (' + (s.student_class || 'N/A') + ')</option>';
        });
    }

    function filterStudentsByClass(className) {
        var studentSelect = document.getElementById('filterStudent');
        
        if (!className) {
            populateStudentSelect(allStudents);
            return;
        }
        
        var filtered = allStudents.filter(function(s) { return s.student_class === className; });
        studentSelect.innerHTML = '<option value="">-- Tous les élèves de ' + className + ' --</option>';
        filtered.forEach(function(s) {
            studentSelect.innerHTML += '<option value="' + s.id + '" style="background:#1a1a2e;">' + s.name + '</option>';
        });
        
        selectedStudentId = null;
        updateSelectedInfo();
    }

    function updateSelectedInfo() {
        var info = document.getElementById('selectedStudentInfo');
        selectedStudentId = document.getElementById('filterStudent').value;
        selectedClassName = document.getElementById('filterClass').value;
        
        if (selectedStudentId) {
            var student = allStudents.find(function(s) { return s.id == selectedStudentId; });
            if (student) {
                info.textContent = '✓ Élève : ' + student.name + ' (' + (student.student_class || 'N/A') + ')';
            }
        } else if (selectedClassName) {
            info.textContent = '✓ Classe : ' + selectedClassName + ' (tous les élèves)';
        } else {
            info.textContent = '';
        }
    }

    function openDocModal(type) {
        currentDocType = type;
        
        if (!selectedStudentId && !selectedClassName) {
            alert('Veuillez sélectionner une classe ou un élève dans le filtre ci-dessus.');
            return;
        }
        
        var title = '';
        var body = '';
        
        switch(type) {
            case 'certificate':
                title = '📜 Certificat de Scolarité';
                body = getCertificateBody();
                break;
            case 'bulletin':
                title = '📊 Bulletin de Notes';
                body = getBulletinBody();
                break;
            case 'attestation':
                title = '🏆 Attestation de Réussite';
                body = getAttestationBody();
                break;
            case 'inscription':
                title = '📝 Fiche d\'Inscription';
                body = getInscriptionBody();
                break;
            case 'sortie':
                title = '🚪 Certificat de Sortie';
                body = getSortieBody();
                break;
            case 'livret':
                title = '📖 Livret Scolaire';
                body = getLivretBody();
                break;
            default:
                title = '📄 Document';
                body = '<p style="color:#888;">Fonctionnalité en cours de développement.</p>';
        }
        
        document.getElementById('docModalTitle').textContent = title;
        document.getElementById('docModalBody').innerHTML = body;
        
        new bootstrap.Modal(document.getElementById('docModal')).show();
    }

    function getCertificateBody() {
        return `
            <div class="mb-3">
                <label class="form-label">Année Scolaire</label>
                <input type="text" class="form-control" id="certYear" value="2024-2025" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
            </div>
            <div class="mb-3">
                <label class="form-label">Établissement</label>
                <input type="text" class="form-control" id="certSchool" placeholder="Nom de l'établissement" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
            </div>
            <div style="background:rgba(13,202,240,0.1); padding:10px; border-radius:8px; color:#0dcaf0;">
                📌 Document pour : <strong>${selectedStudentId ? '1 élève sélectionné' : 'Classe ' + selectedClassName}</strong>
            </div>
        `;
    }

    function getBulletinBody() {
        return `
            <div class="mb-3">
                <label class="form-label">Période</label>
                <select class="form-select" id="bulletinPeriod" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                    <option value="1">1er Trimestre</option>
                    <option value="2">2ème Trimestre</option>
                    <option value="3">3ème Trimestre</option>
                </select>
            </div>
            <div style="background:rgba(13,202,240,0.1); padding:10px; border-radius:8px; color:#0dcaf0;">
                📌 Document pour : <strong>${selectedStudentId ? '1 élève sélectionné' : 'Classe ' + selectedClassName}</strong>
            </div>
        `;
    }

    function getAttestationBody() {
        return `
            <div class="mb-3">
                <label class="form-label">Type</label>
                <select class="form-select" id="attestType" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                    <option value="passage">Attestation de Passage</option>
                    <option value="reussite">Attestation de Réussite</option>
                    <option value="fin_cycle">Attestation de Fin de Cycle</option>
                </select>
            </div>
            <div style="background:rgba(13,202,240,0.1); padding:10px; border-radius:8px; color:#0dcaf0;">
                📌 Document pour : <strong>${selectedStudentId ? '1 élève sélectionné' : 'Classe ' + selectedClassName}</strong>
            </div>
        `;
    }

    function getInscriptionBody() {
        return `
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Type</label>
                    <select class="form-select" id="inscType" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                        <option value="inscription">Nouvelle Inscription</option>
                        <option value="reinscription">Réinscription</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Année Scolaire</label>
                    <input type="text" class="form-control" id="inscYear" value="2024-2025" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                </div>
            </div>
            <div style="background:rgba(13,202,240,0.1); padding:10px; border-radius:8px; color:#0dcaf0;">
                📌 Document pour : <strong>${selectedStudentId ? '1 élève sélectionné' : 'Classe ' + selectedClassName}</strong>
            </div>
        `;
    }

    function getSortieBody() {
        return `
            <div class="mb-3">
                <label class="form-label">Motif de départ</label>
                <select class="form-select" id="sortieMotif" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                    <option value="demangement">Déménagement</option>
                    <option value="changement_ecole">Changement d'école</option>
                    <option value="fin_cycle">Fin de cycle</option>
                    <option value="autre">Autre</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Date de sortie</label>
                <input type="date" class="form-control" id="sortieDate" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
            </div>
            <div class="mb-3">
                <label class="form-label">Nouvel établissement</label>
                <input type="text" class="form-control" id="sortieNewSchool" placeholder="Nom du nouvel établissement" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
            </div>
            <div style="background:rgba(13,202,240,0.1); padding:10px; border-radius:8px; color:#0dcaf0;">
                📌 Document pour : <strong>${selectedStudentId ? '1 élève sélectionné' : 'Classe ' + selectedClassName}</strong>
            </div>
        `;
    }

    function getLivretBody() {
        return `
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Année Scolaire</label>
                    <input type="text" class="form-control" id="livretYear" value="2024-2025" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Période</label>
                    <select class="form-select" id="livretPeriod" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                        <option value="1">1er Trimestre</option>
                        <option value="2">2ème Trimestre</option>
                        <option value="3">3ème Trimestre</option>
                        <option value="annuel">Annuel</option>
                    </select>
                </div>
            </div>
            <div style="background:rgba(13,202,240,0.1); padding:10px; border-radius:8px; color:#0dcaf0;">
                📌 Document pour : <strong>${selectedStudentId ? '1 élève sélectionné' : 'Classe ' + selectedClassName}</strong>
            </div>
        `;
    }

    function generateDocument(type) {
        if (!selectedStudentId && !selectedClassName) {
            alert('Veuillez sélectionner une classe ou un élève.');
            return;
        }
        
        var docNames = {
            'certificate': 'Certificat de scolarité',
            'bulletin': 'Bulletin de notes',
            'attestation': 'Attestation de réussite',
            'inscription': 'Fiche d\'inscription',
            'sortie': 'Certificat de sortie',
            'livret': 'Livret scolaire'
        };
        
        alert('✅ ' + (docNames[type] || 'Document') + ' généré avec succès !\nPour : ' + (selectedStudentId ? '1 élève' : 'Classe ' + selectedClassName));
        
        var modal = bootstrap.Modal.getInstance(document.getElementById('docModal'));
        if (modal) modal.hide();
    }

    function loadArchives() {
        var section = document.getElementById('archivesSection');
        section.style.display = 'block';
        
        fetch('/api/documents/archives')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var tbody = document.getElementById('archivesBody');
                if (!data || data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-3 text-muted">Aucun document archivé.</td></tr>';
                    return;
                }
                tbody.innerHTML = data.map(function(d) {
                    return '<tr>' +
                        '<td>' + new Date(d.created_at).toLocaleDateString('fr-FR') + '</td>' +
                        '<td>' + d.type + '</td>' +
                        '<td>' + d.student_name + '</td>' +
                        '<td>' + d.student_class + '</td>' +
                        '<td>' + d.created_by_name + '</td>' +
                        '<td><button class="btn btn-sm btn-outline-primary" onclick="window.open(\'/uploads/documents/' + d.file_url + '\')">📥</button></td>' +
                    '</tr>';
                }).join('');
            })
            .catch(function() {
                document.getElementById('archivesBody').innerHTML = '<tr><td colspan="6" class="text-center py-3 text-muted">Erreur de chargement.</td></tr>';
            });
    }
</script>

<style>
    .glass-card {
        background: rgba(255,255,255,0.05) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        border: 1px solid rgba(255,255,255,0.08) !important;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3) !important;
        transition: all 0.3s ease;
    }
    .glass-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.4) !important;
        border-color: rgba(13,110,253,0.3) !important;
    }
    #archivesTable th, #archivesTable td {
        border-color: rgba(128,128,128,0.15);
        vertical-align: middle;
    }
    #archivesTable th {
        background: rgba(13,110,253,0.08);
        font-weight: 600;
        color: #0d6efd;
    }
    [data-theme="dark"] #archivesTable th {
        background: rgba(255,255,255,0.05);
        color: #fff;
    }
    .form-label {
        color: rgba(255,255,255,0.8);
        font-weight: 500;
    }
</style>

<%- include('../partials/footer') %>