<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container-fluid page-shell py-4">
    <div class="themed-container" style="max-width: 100%; padding: 0 20px;">
        <h2 class="mb-4">Documents Scolaires</h2>
        <%- include('../partials/messages') %>

        <!-- Sélecteur Classe + Élève -->
        <div class="card glass-card mb-4 p-3" style="border-radius:16px;">
            <div class="row align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Classe</label>
                    <select class="form-select" id="filterClass" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                        <option value="">-- Toutes les classes --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Élève</label>
                    <select class="form-select" id="filterStudent" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                        <option value="">-- Tous les élèves --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" id="btnFilter">
                        Filtrer
                    </button>
                </div>
                <div class="col-md-3">
                    <span id="selectedStudentInfo" style="color: #0dcaf0; font-size: 0.9rem;"></span>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Certificat de Scolarité -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4" style="border-radius:16px; min-height:200px;">
                    <h5>Certificat de Scolarité</h5>
                    <p style="color:#888; font-size:0.9rem;">Générer un certificat de scolarité pour un élève.</p>
                    <div class="mb-3">
                        <label class="form-label">Année Scolaire</label>
                        <input type="text" class="form-control" id="certYear" value="2025-2026" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                    </div>
                    <button class="btn btn-primary w-100" onclick="generateDocument('certificate')">
                        Générer et Télécharger PDF
                    </button>
                </div>
            </div>

            <!-- Certificat de Sortie / Radiation -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4" style="border-radius:16px; min-height:200px;">
                    <h5>Certificat de Sortie (Radiation)</h5>
                    <p style="color:#888; font-size:0.9rem;">Certificat de radiation pour changement d'école.</p>
                    <div class="mb-3">
                        <label class="form-label">Motif de départ</label>
                        <select class="form-select" id="sortieMotif" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                            <option value="demangement">Déménagement</option>
                            <option value="changement_ecole">Changement d'école</option>
                            <option value="fin_cycle">Fin de cycle</option>
                            <option value="autre">Autre</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Date de sortie</label>
                        <input type="date" class="form-control" id="sortieDate" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                    </div>
                    <button class="btn btn-primary w-100" onclick="generateDocument('sortie')">
                        Générer et Télécharger PDF
                    </button>
                </div>
            </div>

            <!-- Archives -->
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card p-4" style="border-radius:16px; min-height:200px;">
                    <h5>Archives</h5>
                    <p style="color:#888; font-size:0.9rem;">Consulter les documents déjà générés.</p>
                    <button class="btn btn-primary w-100 mt-3" onclick="loadArchives()">
                        Consulter les archives
                    </button>
                </div>
            </div>
        </div>

        <!-- Section Archives -->
        <div class="card glass-card mt-4 p-4" style="border-radius:16px; display:none;" id="archivesSection">
            <h4 class="mb-3">Documents Archivés</h4>
            <div class="table-responsive">
                <table class="table table-hover" id="archivesTable">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Élève</th>
                            <th>Classe</th>
                            <th>Généré par</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="archivesBody">
                        <tr><td colspan="6" class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<script>
    var allStudents = [];
    var allClasses = [];
    var selectedStudentId = null;
    var selectedClassName = null;
    var currentUser = { name: '<%= user.name %>', establishment: '<%= user.establishment_name || "Établissement" %>' };

    document.addEventListener('DOMContentLoaded', function() {
        loadClassesAndStudents();
        
        document.getElementById('filterClass').addEventListener('change', function() {
            selectedClassName = this.value;
            filterStudentsByClass(this.value);
        });
        
        document.getElementById('filterStudent').addEventListener('change', function() {
            selectedStudentId = this.value;
            updateSelectedInfo();
        });
        
        document.getElementById('btnFilter').addEventListener('click', function() {
            updateSelectedInfo();
        });
    });

    function loadClassesAndStudents() {
        fetch('/api/all-students')
            .then(function(r) { return r.json(); })
            .then(function(students) {
                allStudents = students;
                populateStudentSelect(students);
                
                var classSet = {};
                students.forEach(function(s) {
                    if (s.student_class && s.student_class.trim() !== '') {
                        classSet[s.student_class] = true;
                    }
                });
                allClasses = Object.keys(classSet).sort();
                
                var classSelect = document.getElementById('filterClass');
                classSelect.innerHTML = '<option value="">-- Toutes les classes --</option>';
                allClasses.forEach(function(c) {
                    classSelect.innerHTML += '<option value="' + c + '">' + c + '</option>';
                });
            })
            .catch(function(error) {
                console.error('Erreur chargement élèves:', error);
            });
    }

    function populateStudentSelect(students) {
        var studentSelect = document.getElementById('filterStudent');
        studentSelect.innerHTML = '<option value="">-- Tous les élèves --</option>';
        students.forEach(function(s) {
            studentSelect.innerHTML += '<option value="' + s.id + '">' + s.name + ' (' + (s.student_class || 'N/A') + ')</option>';
        });
    }

    function filterStudentsByClass(className) {
        var studentSelect = document.getElementById('filterStudent');
        if (!className) {
            populateStudentSelect(allStudents);
            return;
        }
        var filtered = allStudents.filter(function(s) { return s.student_class === className; });
        studentSelect.innerHTML = '<option value="">-- Tous les élèves de ' + className + ' --</option>';
        filtered.forEach(function(s) {
            studentSelect.innerHTML += '<option value="' + s.id + '">' + s.name + '</option>';
        });
        selectedStudentId = null;
        updateSelectedInfo();
    }

    function updateSelectedInfo() {
        var info = document.getElementById('selectedStudentInfo');
        selectedStudentId = document.getElementById('filterStudent').value;
        selectedClassName = document.getElementById('filterClass').value;
        if (selectedStudentId) {
            var student = allStudents.find(function(s) { return s.id == selectedStudentId; });
            if (student) {
                info.textContent = '✓ ' + student.name + ' (' + (student.student_class || 'N/A') + ')';
            }
        } else if (selectedClassName) {
            info.textContent = '✓ Classe : ' + selectedClassName;
        } else {
            info.textContent = '';
        }
    }

    function generateDocument(type) {
        if (!selectedStudentId) {
            alert('Veuillez sélectionner un élève.');
            return;
        }

        var student = allStudents.find(function(s) { return s.id == selectedStudentId; });
        if (!student) return;

        fetch('/api/student-details/' + selectedStudentId)
            .then(function(r) { return r.json(); })
            .then(function(details) {
                var studentData = details;
                if (!studentData.name) studentData.name = student.name;
                if (!studentData.student_class) studentData.student_class = student.student_class;
                
                // Archiver
                fetch('/api/documents/generate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        type: type,
                        student_id: selectedStudentId,
                        class_name: studentData.student_class || selectedClassName,
                        data: { student_name: studentData.name, student_class: studentData.student_class }
                    })
                });
                
                // Générer PDF
                if (type === 'certificate') {
                    generateCertificatePDF(studentData);
                } else if (type === 'sortie') {
                    generateSortiePDF(studentData);
                }
            })
            .catch(function(error) {
                console.error('Erreur:', error);
                alert('Erreur lors de la génération.');
            });
    }

    function generateCertificatePDF(student) {
    var year = document.getElementById('certYear').value || '2025-2026';
    var date = new Date().toLocaleDateString('fr-FR');
    var school = currentUser.establishment;
    var adminName = currentUser.name;

    // Récupérer seulement les noms des parents (max 2)
    var allParents = [];
    if (student.linkedParents) allParents = allParents.concat(student.linkedParents);
    if (student.manualParents) allParents = allParents.concat(student.manualParents);

    var parentsText = '';
    if (allParents.length > 0) {
        var names = allParents.slice(0, 2).map(function(p) { return p.name || ''; }).filter(Boolean);
        if (names.length > 0) {
            parentsText = 'Parents : ' + names.join(' et ');
        }
    }

    var { jsPDF } = window.jspdf;
    var doc = new jsPDF();
    doc.setFontSize(16);
    doc.text('CERTIFICAT DE SCOLARITE', 105, 20, { align: 'center' });
    doc.setFontSize(11);
    doc.text('Année Scolaire : ' + year, 105, 28, { align: 'center' });
    doc.text('Etablissement : ' + school, 105, 36, { align: 'center' });
    doc.text('_'.repeat(60), 25, 44);
    doc.setFontSize(10);
    doc.text('Je soussigné, ' + adminName + ', Directeur de ' + school + ', certifie que :', 25, 54);
    doc.text('Nom et Prénom : ' + (student.name || ''), 30, 64);
    doc.text('Né(e) le : ' + (student.date_of_birth ? new Date(student.date_of_birth).toLocaleDateString('fr-FR') : 'Non renseigné'), 30, 72);
    doc.text('Lieu de naissance : ' + (student.place_of_birth || 'Non renseigné'), 30, 80);
    doc.text('Matricule : ' + (student.matricule || 'N/A'), 30, 88);
    doc.text('Classe : ' + (student.student_class || 'N/A'), 30, 96);
    doc.text('Adresse : ' + (student.address || 'Non renseignée'), 30, 104);
    if (parentsText) doc.text(parentsText, 30, 112);
    doc.text('Est régulièrement inscrit(e) dans notre établissement pour l\'année scolaire en cours.', 25, 124);
    doc.text('Fait à ' + school + ', le ' + date, 140, 140, { align: 'right' });
    doc.text(adminName, 140, 148, { align: 'right' });
    doc.text('Directeur', 140, 156, { align: 'right' });
    doc.save('Certificat_Scolarite_' + (student.name || 'eleve').replace(/ /g, '_') + '.pdf');
}
    function generateSortiePDF(student) {
        var date = new Date().toLocaleDateString('fr-FR');
        var sortieDate = document.getElementById('sortieDate').value || date;
        var motif = document.getElementById('sortieMotif').value || 'autre';
        var motifs = { 'demangement': 'Déménagement', 'changement_ecole': "Changement d'école", 'fin_cycle': 'Fin de cycle', 'autre': 'Autre' };
        var school = currentUser.establishment;
        var adminName = currentUser.name;

        var { jsPDF } = window.jspdf;
        var doc = new jsPDF();
        doc.setFontSize(16);
        doc.text('CERTIFICAT DE SORTIE (RADIATION)', 105, 20, { align: 'center' });
        doc.setFontSize(11);
        doc.text('Etablissement : ' + school, 105, 30, { align: 'center' });
        doc.text('_'.repeat(60), 25, 38);
        doc.setFontSize(10);
        doc.text('Je soussigné, ' + adminName + ', Directeur de ' + school + ', certifie que :', 25, 48);
        doc.text('Nom et Prénom : ' + (student.name || ''), 30, 58);
        doc.text('Né(e) le : ' + (student.date_of_birth ? new Date(student.date_of_birth).toLocaleDateString('fr-FR') : 'Non renseigné'), 30, 66);
        doc.text('Matricule : ' + (student.matricule || 'N/A'), 30, 74);
        doc.text('Dernière classe fréquentée : ' + (student.student_class || 'N/A'), 30, 82);
        doc.text('Date de sortie : ' + new Date(sortieDate).toLocaleDateString('fr-FR'), 30, 90);
        doc.text('Motif : ' + (motifs[motif] || motif), 30, 98);
        doc.text('Est libéré(e) de toute obligation envers notre établissement.', 25, 110);
        doc.text('Fait à ' + school + ', le ' + date, 140, 130, { align: 'right' });
        doc.text(adminName, 140, 138, { align: 'right' });
        doc.text('Directeur', 140, 146, { align: 'right' });
        doc.save('Certificat_Sortie_' + (student.name || 'eleve').replace(/ /g, '_') + '.pdf');
    }

    function loadArchives() {
        var section = document.getElementById('archivesSection');
        section.style.display = 'block';
        fetch('/api/documents/archives')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var tbody = document.getElementById('archivesBody');
                if (!data || data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-3 text-muted">Aucun document archivé.</td></tr>';
                    return;
                }
                tbody.innerHTML = data.map(function(d) {
                    return '<tr>' +
                        '<td>' + new Date(d.created_at).toLocaleDateString('fr-FR') + '</td>' +
                        '<td>' + d.type + '</td>' +
                        '<td>' + (d.student_name || '-') + '</td>' +
                        '<td>' + (d.student_class || '-') + '</td>' +
                        '<td>' + (d.created_by_name || '-') + '</td>' +
                        '<td><button class="btn btn-sm btn-outline-primary">📥</button></td>' +
                    '</tr>';
                }).join('');
            })
            .catch(function() {
                document.getElementById('archivesBody').innerHTML = '<tr><td colspan="6" class="text-center py-3 text-muted">Erreur de chargement.</td></tr>';
            });
    }
</script>

<style>
    .glass-card {
        background: rgba(255,255,255,0.05) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        border: 1px solid rgba(255,255,255,0.08) !important;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3) !important;
        transition: all 0.3s ease;
    }
    .glass-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.4) !important;
        border-color: rgba(13,110,253,0.3) !important;
    }
    #archivesTable th, #archivesTable td {
        border-color: rgba(128,128,128,0.15);
        vertical-align: middle;
    }
    #archivesTable th {
        background: rgba(13,110,253,0.08);
        font-weight: 600;
        color: #0d6efd;
    }
    [data-theme="dark"] #archivesTable th {
        background: rgba(255,255,255,0.05);
        color: #fff;
    }
    .form-label {
        color: rgba(255,255,255,0.8);
        font-weight: 500;
    }
</style>

<%- include('../partials/footer') %>