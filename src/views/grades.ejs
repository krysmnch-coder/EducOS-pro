<%- include('partials/head') %>

<style>
  /* ==========================================================================
     Page Notes - Style Glassmorphism
     ========================================================================== */
  
  .page-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  
  /* Section header */
  .section-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    gap: 1rem;
    animation: header-fade 0.6s ease forwards !important;
    opacity: 0;
    transform: translateY(10px);
  }
  
  @keyframes header-fade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .section-header h1 {
    font-weight: 700;
    color: var(--text-color, #212529);
    margin: 0;
  }
  
  [data-theme="dark"] .section-header h1 {
    color: #ffffff;
  }
  
  /* Table shell Glassmorphism */
  .table-shell {
    background: rgba(255, 255, 255, 0.06) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    border-radius: 1.25rem !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06) !important;
    overflow: hidden;
    padding: 0.5rem;
    animation: card-fade-in 0.6s ease forwards !important;
    opacity: 0;
    transform: translateY(20px);
  }
  
  @keyframes card-fade-in {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  
  [data-theme="dark"] .table-shell {
    background: rgba(255, 255, 255, 0.02) !important;
    border: 1px solid rgba(255, 255, 255, 0.06) !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3) !important;
  }
  
  /* Data Table */
  .data-table {
    width: 100%;
    border-collapse: collapse;
    border-radius: 0.75rem;
    overflow: hidden;
  }
  
  .data-table thead th {
    background: rgba(13, 110, 253, 0.06) !important;
    color: var(--text-color, #212529) !important;
    font-weight: 600;
    padding: 0.85rem 1rem;
    text-align: left;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 2px solid rgba(13, 110, 253, 0.08) !important;
  }
  
  [data-theme="dark"] .data-table thead th {
    background: rgba(255, 255, 255, 0.04) !important;
    border-bottom: 2px solid rgba(255, 255, 255, 0.06) !important;
    color: rgba(255, 255, 255, 0.8) !important;
  }
  
  .data-table tbody tr {
    background: transparent !important;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
    animation: row-fade-in 0.4s ease forwards !important;
    opacity: 0;
    transform: translateX(-10px);
  }
  
  @keyframes row-fade-in {
    from {
      opacity: 0;
      transform: translateX(-10px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }
  
  /* Délais pour les lignes - appliqués via JavaScript */
  
  .data-table tbody tr:hover {
    background: rgba(13, 110, 253, 0.04) !important;
    transform: scale(1.002) !important;
  }
  
  [data-theme="dark"] .data-table tbody tr:hover {
    background: rgba(255, 255, 255, 0.04) !important;
  }
  
  .data-table tbody td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.04) !important;
    color: var(--text-color, #212529);
    vertical-align: middle;
  }
  
  [data-theme="dark"] .data-table tbody td {
    border-bottom: 1px solid rgba(255, 255, 255, 0.04) !important;
    color: rgba(255, 255, 255, 0.9);
  }
  
  /* Note stylée */
  .grade-badge {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.9rem;
    min-width: 40px;
    text-align: center;
    background: rgba(13, 110, 253, 0.08) !important;
    border: 1px solid rgba(13, 110, 253, 0.1) !important;
    color: var(--bs-primary, #0d6efd) !important;
  }
  
  .grade-badge.excellent {
    background: rgba(25, 135, 84, 0.12) !important;
    border-color: rgba(25, 135, 84, 0.2) !important;
    color: #198754 !important;
  }
  
  .grade-badge.good {
    background: rgba(13, 202, 240, 0.12) !important;
    border-color: rgba(13, 202, 240, 0.2) !important;
    color: #0dcaf0 !important;
  }
  
  .grade-badge.average {
    background: rgba(255, 193, 7, 0.12) !important;
    border-color: rgba(255, 193, 7, 0.2) !important;
    color: #d4a800 !important;
  }
  
  .grade-badge.poor {
    background: rgba(220, 53, 69, 0.12) !important;
    border-color: rgba(220, 53, 69, 0.2) !important;
    color: #dc3545 !important;
  }
  
  [data-theme="dark"] .grade-badge {
    background: rgba(255, 255, 255, 0.05) !important;
    border-color: rgba(255, 255, 255, 0.08) !important;
    color: #e0e0e0 !important;
  }
  
  [data-theme="dark"] .grade-badge.excellent {
    background: rgba(25, 135, 84, 0.15) !important;
    border-color: rgba(25, 135, 84, 0.25) !important;
    color: #51cf66 !important;
  }
  
  [data-theme="dark"] .grade-badge.good {
    background: rgba(13, 202, 240, 0.15) !important;
    border-color: rgba(13, 202, 240, 0.25) !important;
    color: #66d9f7 !important;
  }
  
  [data-theme="dark"] .grade-badge.average {
    background: rgba(255, 193, 7, 0.15) !important;
    border-color: rgba(255, 193, 7, 0.25) !important;
    color: #ffd43b !important;
  }
  
  [data-theme="dark"] .grade-badge.poor {
    background: rgba(220, 53, 69, 0.15) !important;
    border-color: rgba(220, 53, 69, 0.25) !important;
    color: #ff6b6b !important;
  }
  
  /* Bouton Ajouter Glassmorphism */
  .btn-primary {
    background: linear-gradient(135deg, rgba(13, 110, 253, 0.2), rgba(13, 202, 240, 0.2)) !important;
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
    border: 1px solid rgba(13, 110, 253, 0.25) !important;
    border-radius: 0.75rem !important;
    padding: 0.6rem 1.5rem !important;
    font-weight: 600 !important;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
    color: var(--bs-primary, #0d6efd) !important;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .btn-primary:hover {
    transform: translateY(-2px) scale(1.02) !important;
    box-shadow: 0 8px 30px rgba(13, 110, 253, 0.2) !important;
    background: linear-gradient(135deg, rgba(13, 110, 253, 0.3), rgba(13, 202, 240, 0.3)) !important;
    border-color: var(--bs-primary, #0d6efd) !important;
    color: var(--bs-primary, #0d6efd) !important;
  }
  
  [data-theme="dark"] .btn-primary {
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    background: rgba(255, 255, 255, 0.05) !important;
  }
  
  [data-theme="dark"] .btn-primary:hover {
    background: rgba(255, 255, 255, 0.1) !important;
    box-shadow: 0 8px 30px rgba(255, 255, 255, 0.08) !important;
    border-color: #ffffff !important;
    color: #ffffff !important;
  }
  
  /* Petits boutons d'action Glassmorphism */
  .btn-small {
    background: rgba(13, 110, 253, 0.05) !important;
    backdrop-filter: blur(4px) !important;
    -webkit-backdrop-filter: blur(4px) !important;
    border: 1px solid rgba(13, 110, 253, 0.1) !important;
    border-radius: 0.5rem !important;
    padding: 0.25rem 0.7rem !important;
    font-size: 0.8rem !important;
    font-weight: 500 !important;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
    color: var(--bs-primary, #0d6efd) !important;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  
  .btn-small:hover {
    transform: translateY(-2px) scale(1.05) !important;
    background: rgba(13, 110, 253, 0.15) !important;
    box-shadow: 0 4px 15px rgba(13, 110, 253, 0.1) !important;
  }
  
  [data-theme="dark"] .btn-small {
    color: #e0e0e0 !important;
    border-color: rgba(255, 255, 255, 0.08) !important;
    background: rgba(255, 255, 255, 0.03) !important;
  }
  
  [data-theme="dark"] .btn-small:hover {
    background: rgba(255, 255, 255, 0.08) !important;
    color: #ffffff !important;
  }
  
  /* Bouton Danger */
  .btn-danger {
    background: rgba(220, 53, 69, 0.05) !important;
    backdrop-filter: blur(4px) !important;
    -webkit-backdrop-filter: blur(4px) !important;
    border: 1px solid rgba(220, 53, 69, 0.1) !important;
    border-radius: 0.5rem !important;
    padding: 0.25rem 0.7rem !important;
    font-size: 0.8rem !important;
    font-weight: 500 !important;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
    color: #dc3545 !important;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    border: none;
  }
  
  .btn-danger:hover {
    transform: translateY(-2px) scale(1.05) !important;
    background: rgba(220, 53, 69, 0.15) !important;
    box-shadow: 0 4px 15px rgba(220, 53, 69, 0.1) !important;
  }
  
  [data-theme="dark"] .btn-danger {
    color: #ff6b6b !important;
    background: rgba(255, 107, 107, 0.05) !important;
    border-color: rgba(255, 107, 107, 0.1) !important;
  }
  
  [data-theme="dark"] .btn-danger:hover {
    background: rgba(255, 107, 107, 0.15) !important;
  }
  
  /* Formulaire inline */
  .inline-form {
    display: inline-block;
    margin: 0;
  }
  
  /* Cellule des actions */
  .actions-cell {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }
  
  /* Commentaire tronqué */
  .comment-cell {
    max-width: 200px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  /* Aucune donnée */
  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted, #6c757d);
  }
  
  [data-theme="dark"] .empty-state {
    color: rgba(255, 255, 255, 0.5);
  }
  
  .empty-state svg {
    opacity: 0.5;
    margin-bottom: 1rem;
  }
  
  /* Adaptation mobile */
  @media (max-width: 768px) {
    .page-section {
      padding: 1rem 0.75rem;
    }
    
    .section-header {
      flex-direction: column;
      align-items: stretch;
    }
    
    .section-header h1 {
      font-size: 1.4rem;
    }
    
    .btn-primary {
      width: 100%;
      justify-content: center;
    }
    
    .table-shell {
      border-radius: 1rem !important;
      padding: 0.25rem;
      overflow-x: auto;
    }
    
    .data-table {
      min-width: 600px;
    }
    
    .data-table thead th,
    .data-table tbody td {
      padding: 0.5rem 0.6rem;
      font-size: 0.85rem;
    }
    
    .data-table tbody td:last-child {
      min-width: 120px;
    }
    
    .actions-cell {
      flex-direction: column;
      gap: 0.25rem;
    }
    
    .btn-small,
    .btn-danger {
      font-size: 0.7rem !important;
      padding: 0.2rem 0.5rem !important;
    }
    
    .comment-cell {
      max-width: 100px;
    }
  }
  
  @media (max-width: 576px) {
    .data-table {
      min-width: 500px;
    }
    
    .data-table thead th,
    .data-table tbody td {
      padding: 0.4rem 0.4rem;
      font-size: 0.8rem;
    }
    
    .grade-badge {
      font-size: 0.75rem;
      padding: 0.2rem 0.5rem;
      min-width: 30px;
    }
  }
</style>

<div class="page-section">
  <div class="section-header">
    <h1>
      <i data-feather="book-open" class="me-2" style="width: 28px; height: 28px;"></i>
      Notes
    </h1>
    <% if (user.role === 'professeur' || user.role === 'administrateur') { %>
      <a href="/students/grades/new" class="btn btn-primary">
        <i data-feather="plus" class="me-1" style="width: 16px; height: 16px;"></i>
        Ajouter une note
      </a>
    <% } %>
  </div>

  <div class="table-shell">
    <table class="data-table">
      <thead>
        <tr>
          <th>Élève</th>
          <th>Matière</th>
          <th>Note</th>
          <th>Commentaire</th>
          <th>Date</th>
          <% if (user.role === 'professeur' || user.role === 'administrateur') { %>
            <th>Actions</th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% if (grades && grades.length > 0) { %>
          <% grades.forEach((grade, index) => { 
            // Déterminer la classe CSS pour la note
            let gradeClass = '';
            const gradeValue = parseFloat(grade.grade);
            if (gradeValue >= 16) gradeClass = 'excellent';
            else if (gradeValue >= 14) gradeClass = 'good';
            else if (gradeValue >= 10) gradeClass = 'average';
            else gradeClass = 'poor';
          %>
          <tr data-delay="<%= index * 0.05 %>">
            <td><%= grade.first_name %> <%= grade.last_name %></td>
            <td><%= grade.subject %></td>
            <td>
              <span class="grade-badge <%= gradeClass %>">
                <%= grade.grade %>
              </span>
            </td>
            <td class="comment-cell" title="<%= grade.comment || '' %>">
              <%= grade.comment || '-' %>
            </td>
            <td><%= new Date(grade.created_at).toLocaleDateString('fr-FR') %></td>
            <% if (user.role === 'professeur' || user.role === 'administrateur') { %>
              <td>
                <div class="actions-cell">
                  <a href="/students/grades/<%= grade.id %>/edit" class="btn btn-small">
                    <i data-feather="edit-2" style="width: 14px; height: 14px;"></i>
                    Modifier
                  </a>
                  <form action="/students/grades/<%= grade.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette note ?');">
                    <button type="submit" class="btn-danger">
                      <i data-feather="trash-2" style="width: 14px; height: 14px;"></i>
                      Supprimer
                    </button>
                  </form>
                </div>
              </td>
            <% } %>
          </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="<%= (user.role === 'professeur' || user.role === 'administrateur') ? 6 : 5 %>" class="empty-state">
              <i data-feather="book-open" style="width: 48px; height: 48px; stroke-width: 1; display: block; margin: 0 auto;"></i>
              <p class="mt-3">Aucune note n'a été enregistrée pour le moment.</p>
              <% if (user.role === 'professeur' || user.role === 'administrateur') { %>
                <a href="/students/grades/new" class="btn btn-primary mt-2">
                  <i data-feather="plus" class="me-1" style="width: 16px; height: 16px;"></i>
                  Ajouter la première note
                </a>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Remplacer les icônes Feather
    if (typeof feather !== 'undefined') {
      feather.replace();
    }

    // Appliquer les délais d'animation aux lignes
    document.querySelectorAll('.data-table tbody tr[data-delay]').forEach(function(row) {
      var delay = row.getAttribute('data-delay');
      if (delay) {
        row.style.animationDelay = delay + 's';
      }
    });
  });
</script>

<%- include('partials/footer') %>