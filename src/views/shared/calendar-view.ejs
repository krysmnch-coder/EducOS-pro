<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container py-4">
    <h2 class="mb-4">Calendrier Scolaire</h2>
    <%- include('../partials/messages') %>
    
    <div style="margin-bottom:15px;">
        <select id="typeFilter" style="padding:8px 15px; border-radius:8px; width:200px; background:rgba(255,255,255,0.1); color:inherit; border:1px solid rgba(128,128,128,0.3);">
            <option value="all">📅 Tous les types</option>
            <option value="Rentrée des classes">🎓 Rentrée des classes</option>
            <option value="Période scolaire">📚 Période scolaire</option>
            <option value="Vacances scolaires">🏖️ Vacances scolaires</option>
            <option value="Jours fériés">🎉 Jours fériés</option>
            <option value="Événements">⭐ Événements</option>
        </select>
    </div>
    
    <div id="eventsList" style="background:rgba(255,255,255,0.05); border-radius:16px; padding:20px; min-height:200px;">
        <p style="text-align:center; color:#888;">Chargement des événements...</p>
    </div>
</div>

<script>
    function loadEvents() {
        var type = document.getElementById('typeFilter').value;
        var url = '/api/calendar/events';
        if (type !== 'all') url += '?type=' + encodeURIComponent(type);
        
        document.getElementById('eventsList').innerHTML = '<p style="text-align:center;color:#888;">Chargement...</p>';
        
        fetch(url)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var container = document.getElementById('eventsList');
                
                if (!data || data.length === 0) {
                    container.innerHTML = '<p style="text-align:center;color:#888;padding:40px;">Aucun événement trouvé</p>';
                    return;
                }
                
                // Grouper par mois
                var grouped = {};
                data.forEach(function(e) {
                    var date = new Date(e.start);
                    var monthKey = date.getFullYear() + '-' + String(date.getMonth() + 1).padStart(2, '0');
                    var monthName = date.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });
                    if (!grouped[monthKey]) {
                        grouped[monthKey] = { name: monthName, events: [] };
                    }
                    grouped[monthKey].events.push(e);
                });
                
                var html = '';
                var colors = {
                    'Rentrée des classes': '#198754',
                    'Période scolaire': '#0d6efd',
                    'Vacances scolaires': '#fd7e14',
                    'Jours fériés': '#dc3545',
                    'Événements': '#6f42c1'
                };
                
                Object.keys(grouped).sort().forEach(function(key) {
                    var group = grouped[key];
                    html += '<h4 style="margin-top:20px; margin-bottom:10px; color:#0d6efd;">' + group.name + '</h4>';
                    
                    group.events.forEach(function(e) {
                        var start = new Date(e.start).toLocaleDateString('fr-FR');
                        var end = new Date(e.end).toLocaleDateString('fr-FR');
                        var dateDisplay = (e.start === e.end) ? start : start + ' → ' + end;
                        var type = e.extendedProps.type || 'Événements';
                        var color = e.backgroundColor || colors[type] || '#0d6efd';
                        
                        html += '<div style="display:flex; align-items:center; margin-bottom:8px; padding:10px 15px; background:rgba(255,255,255,0.05); border-radius:10px; border-left:4px solid ' + color + ';">';
                        html += '<span style="display:inline-block; width:12px; height:12px; border-radius:3px; background:' + color + '; margin-right:12px; flex-shrink:0;"></span>';
                        html += '<div style="flex:1;">';
                        html += '<strong>' + e.title + '</strong>';
                        html += '<br><small style="color:#888;">' + dateDisplay + ' • ' + type + '</small>';
                        if (e.extendedProps.description) {
                            html += '<br><small style="color:#aaa;">' + e.extendedProps.description + '</small>';
                        }
                        html += '</div>';
                        html += '</div>';
                    });
                });
                
                container.innerHTML = html;
            })
            .catch(function(err) {
                document.getElementById('eventsList').innerHTML = '<p style="text-align:center;color:#dc3545;padding:40px;">Erreur de chargement: ' + err.message + '</p>';
            });
    }
    
    document.getElementById('typeFilter').addEventListener('change', loadEvents);
    
    // Charger au démarrage
    loadEvents();
</script>

<%- include('../partials/footer') %>