<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container-fluid page-shell py-4">
    <div class="themed-container" style="max-width: 100%; padding: 0 20px;">
        <h2 class="mb-4">
            <% if (user.role === 'STUDENT' || user.role === 'eleve') { %>
                Mes Absences & Retards
            <% } else if (user.role === 'PARENT') { %>
                Absences & Retards de mon enfant
            <% } else { %>
                Consultation des Absences & Retards
            <% } %>
        </h2>
        <%- include('../partials/messages') %>
        
        <%# Sélecteur d'enfant pour les parents %>
        <% if (user.role === 'PARENT' && typeof children !== 'undefined' && children.length > 0) { %>
        <div class="card glass-card mb-4 p-3" style="border-radius:16px;">
            <div class="row align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Sélectionner un enfant</label>
                    <select class="form-select" id="childSelector">
                        <option value="">-- Choisir un enfant --</option>
                        <% children.forEach(function(child) { %>
                            <option value="<%= child.id %>" <%= (selectedChildId && selectedChildId == child.id) ? 'selected' : '' %>>
                                <%= child.name %> (<%= child.student_class || 'Sans classe' %>)
                            </option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" id="btnLoadChild">Afficher</button>
                </div>
            </div>
        </div>
        <% } %>
        
        <%# Message si parent sans enfant sélectionné %>
        <% if (user.role === 'PARENT' && (!selectedChildId || typeof children === 'undefined' || children.length === 0)) { %>
        <div class="alert alert-info" style="border-radius:12px;">
            <i data-feather="info" style="width: 16px; height: 16px;"></i>
            <% if (typeof children === 'undefined' || children.length === 0) { %>
                Aucun enfant n'est lié à votre compte.
            <% } else { %>
                Veuillez sélectionner un enfant ci-dessus pour voir ses absences.
            <% } %>
        </div>
        <% } %>
        
        <div class="card glass-card p-3" style="border-radius:16px;">
            <div class="table-responsive">
                <table class="table table-hover" id="absencesTable">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Nom</th>
                            <th>Classe</th>
                            <th>Type</th>
                            <th>Statut</th>
                            <th>Motif</th>
                        </tr>
                    </thead>
                    <tbody id="absencesBody">
                        <tr><td colspan="6" class="text-center py-4"><div class="spinner-border text-primary"></div></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    var userRole = '<%= user.role %>';
    var userId = '<%= userId || "" %>';
    var selectedChildId = '<%= selectedChildId || "" %>';
    var parentChildren = <%- JSON.stringify(typeof children !== 'undefined' ? children : []) %>;
    
    document.addEventListener('DOMContentLoaded', function() {
        // ÉLÈVE : charger directement
        if (userRole === 'STUDENT' || userRole === 'eleve') {
            loadAbsences(userId);
            return;
        }
        
        // PARENT : charger si un enfant est déjà sélectionné
        if (userRole === 'PARENT' || userRole === 'parent') {
            if (selectedChildId) {
                loadAbsences(selectedChildId);
            }
            
            // Écouter le bouton
            var btnLoadChild = document.getElementById('btnLoadChild');
            if (btnLoadChild) {
                btnLoadChild.addEventListener('click', function() {
                    var childId = document.getElementById('childSelector').value;
                    if (childId) {
                        loadAbsences(childId);
                    } else {
                        alert('Veuillez sélectionner un enfant.');
                    }
                });
            }
            
            // Écouter le changement de sélection
            var childSelector = document.getElementById('childSelector');
            if (childSelector) {
                childSelector.addEventListener('change', function() {
                    var childId = this.value;
                    if (childId) {
                        loadAbsences(childId);
                    }
                });
            }
            return;
        }
        
        // AUTRES : charger toutes les absences
        loadAbsences(null);
    });
    
    function loadAbsences(filterUserId) {
        var url = '/api/absences?';
        
        if (filterUserId) {
            url += 'user_id=' + filterUserId;
        } else if (userRole !== 'STUDENT' && userRole !== 'eleve' && userRole !== 'PARENT' && userRole !== 'parent') {
            url += 'user_type=student';
        }
        
        console.log('📊 Chargement absences:', url);
        
        fetch(url)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var tbody = document.getElementById('absencesBody');
                
                if (!data || data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">✅ Aucune absence ou retard enregistré.</td></tr>';
                    return;
                }
                
                tbody.innerHTML = data.map(function(a) {
                    var dateStr = a.date ? new Date(a.date).toLocaleDateString('fr-FR', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) : '-';
                    var typeBadge = a.type === 'absence' 
                        ? '<span class="badge" style="background:#dc3545;">Absence</span>' 
                        : '<span class="badge" style="background:#fd7e14;">Retard</span>';
                    var statusBadge = a.status === 'justifiee' 
                        ? '<span class="badge" style="background:#198754;">Justifiée</span>' 
                        : '<span class="badge" style="background:#dc3545;">Non justifiée</span>';
                    
                    return '<tr>' +
                        '<td>' + dateStr + '</td>' +
                        '<td><strong>' + escapeHtml(a.user_name || '-') + '</strong></td>' +
                        '<td>' + escapeHtml(a.student_class || '-') + '</td>' +
                        '<td>' + typeBadge + '</td>' +
                        '<td>' + statusBadge + '</td>' +
                        '<td><small>' + escapeHtml(a.motif || '-') + '</small></td>' +
                    '</tr>';
                }).join('');
            })
            .catch(function(error) {
                console.error('❌ Erreur:', error);
                document.getElementById('absencesBody').innerHTML = 
                    '<tr><td colspan="6" class="text-center py-4 text-danger">❌ Erreur de chargement</td></tr>';
            });
    }
    
    function escapeHtml(text) {
        if (!text) return '';
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>

<style>
    .glass-card { 
        background: rgba(255,255,255,0.08); 
        backdrop-filter: blur(20px); 
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(0,0,0,0.08); 
    }
    [data-theme="dark"] .glass-card { 
        background: rgba(255,255,255,0.05); 
        border-color: rgba(255,255,255,0.08); 
    }
    #absencesTable th, #absencesTable td { 
        border-color: rgba(128,128,128,0.15); 
        vertical-align: middle; 
    }
    #absencesTable th { 
        background: rgba(13,110,253,0.08); 
        font-weight: 600;
        color: #0d6efd;
    }
    [data-theme="dark"] #absencesTable th { 
        background: rgba(255,255,255,0.05); 
        color: #fff;
    }
    #absencesTable tbody tr:hover {
        background: rgba(13,110,253,0.03);
    }
</style>

<%- include('../partials/footer') %>