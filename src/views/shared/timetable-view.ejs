<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container-fluid page-shell py-4">
    <div class="themed-container" style="max-width: 100%; padding: 0 20px;">
        <h2 class="mb-4">Emploi du Temps</h2>
        <%- include('../partials/messages.ejs') %>
        
        <% if (user.role !== 'STUDENT' && user.role !== 'eleve') { %>
        <div class="card glass-card mb-4 p-3" style="border-radius:16px;">
            <div class="row align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Classe</label>
                    <select class="form-select" id="classSelector">
                        <option value="">-- Choisir --</option>
                        <% if (typeof classes !== 'undefined') { %>
                            <% classes.forEach(function(cls) { %>
                                <option value="<%= cls %>" <%= cls === defaultClass ? 'selected' : '' %>><%= cls %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" id="btnLoad">Afficher</button>
                </div>
            </div>
        </div>
        <% } %>
        
        <div class="card glass-card p-3" style="border-radius:16px; display:none;" id="timetableContainer">
            <%- include('../partials/_timetable-grid.ejs', { showChildSelector: true }) %>
        </div>

        <div class="text-center py-5" id="emptyState" style="display: none;">
            <i data-feather="clock" style="width: 64px; height: 64px; color: #666; margin-bottom: 20px;"></i>
            <h4 style="color: #fff;">Aucun emploi du temps</h4>
            <p style="color: #888;" id="emptyStateMessage">Sélectionnez une classe pour commencer.</p>
        </div>
    </div>
</div>

<script>
    // ✅ Horaires étendus pour correspondre à l'éditeur (7h-18h)
    const timeSlots = ['07:00-08:00', '08:00-09:00', '09:00-10:00', '10:00-11:00', '11:00-12:00', '12:00-13:00', '13:00-14:00', '14:00-15:00', '15:00-16:00', '16:00-17:00', '17:00-18:00'];
    const days = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi'];
    const userRole = '<%= user.role %>';
    const studentClass = '<%= user.student_class || "" %>';
    const defaultClass = '<%= defaultClass || "" %>';
    const parentChildren = <%- JSON.stringify(typeof children !== 'undefined' ? children : []) %>;
    
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof feather !== 'undefined') feather.replace();

        // ÉLÈVE : afficher directement son emploi du temps
        if (userRole === 'STUDENT' || userRole === 'eleve') {
            if (studentClass) {
                loadTimetable(studentClass);
            }
            return;
        }
        
        // PARENT : afficher l'emploi du temps du premier enfant
        if (userRole === 'PARENT') {
            const childSelector = document.getElementById('childSelector');
            if (parentChildren.length > 0) {
                parentChildren.forEach(child => {
                    const option = document.createElement('option');
                    option.value = child.student_class;
                    option.textContent = `${child.name} (${child.student_class})`;
                    childSelector.appendChild(option);
                });
                loadTimetable(childSelector.value);
            }
            // Écouter le changement d'enfant
            if (childSelector) {
                childSelector.addEventListener('change', function() {
                    const selectedClass = this.value;
                    loadTimetable(selectedClass);
                });
            }
            return;
        }
        
        // AUTRES RÔLES (Prof, Admin, etc.)
        const classSelector = document.getElementById('classSelector');
        if (classSelector && classSelector.options.length <= 1) {
            showEmptyState('Aucune classe avec un emploi du temps n\'a été trouvée.');
        }
        if (defaultClass) { 
            loadTimetable(defaultClass); 
        }
        
        // Bouton pour charger
        var btnLoad = document.getElementById('btnLoad');
        if (btnLoad) {
            btnLoad.addEventListener('click', function() {
                const cls = classSelector.value;
                if (cls) loadTimetable(cls);
            });
        }
    });
    
    function loadTimetable(className) {
        if (!className) {
            showEmptyState('Veuillez sélectionner une classe pour afficher son emploi du temps.');
            return;
        }

        document.getElementById('emptyState').style.display = 'none';
        document.getElementById('timetableContainer').style.display = 'block';
        document.getElementById('timetableTitle').textContent = 'Emploi du temps - ' + className;
        const tbody = document.getElementById('timetableBody');
        tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:30px;"><div class="spinner-border text-primary"></div></td></tr>';
        
        fetch('/api/timetables/' + encodeURIComponent(className), { credentials: 'same-origin' })
            .then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(data => {
                if (data.length === 0) {
                    showEmptyState(`L'emploi du temps pour la classe <strong>${className}</strong> n'a pas encore été configuré.`);
                    return;
                }

                let html = '<thead><tr><th style="width:100px;">Heures</th>';
                days.forEach(day => html += `<th>${day}</th>`);
                html += '</tr></thead>';

                timeSlots.forEach(function(slot) {
                    html += `<tr><td style="font-weight:600;font-size:0.85rem;">${slot}</td>`;
                    days.forEach(function(day) {
                        const entry = data.find(e => e.day === day && e.time_slot === slot);
                        if (entry) {
                            const teacher = entry.teacher ? `<br><small>${escapeHtml(entry.teacher)}</small>` : '';
                            const room = entry.room ? `<br><small style="opacity: 0.7;">Salle ${escapeHtml(entry.room)}</small>` : '';
                            html += `<td style="background:${entry.color || '#0d6efd'}22; border-left:4px solid ${entry.color || '#0d6efd'}; padding:8px;">
                                        <strong style="font-size:0.9rem;">${escapeHtml(entry.subject)}</strong>
                                        ${teacher}
                                        ${room}
                                     </td>`;
                        } else {
                            html += '<td style="color:#888;">-</td>';
                        }
                    });
                    html += '</tr>';
                });
                document.getElementById('timetableTable').innerHTML = html;
            })
            .catch(function(err) {
                console.error(err);
                showEmptyState('Une erreur est survenue lors du chargement de l\'emploi du temps.');
            });
    }

    function showEmptyState(message) {
        document.getElementById('timetableContainer').style.display = 'none';
        document.getElementById('emptyState').style.display = 'block';
        document.getElementById('emptyStateMessage').innerHTML = message;
    }

    function escapeHtml(text) {
        if (!text) return '';
        const d = document.createElement('div');
        d.textContent = text;
        return d.innerHTML;
    }
</script>

<style>
    .glass-card { background: rgba(255,255,255,0.08); backdrop-filter: blur(20px); border: 1px solid rgba(0,0,0,0.08); }
    [data-theme="dark"] .glass-card { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.08); }
    #timetableTable th, #timetableTable td { border-color: rgba(128,128,128,0.15); text-align: center; }
    #timetableTable th { background: rgba(13,110,253,0.08); }
    #timetableTable td { vertical-align: middle; }
</style>

<%- include('../partials/footer') %>