<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container-fluid page-shell py-4">
    <div class="themed-container" style="max-width: 100%; padding: 0 20px;">
        <h2 class="mb-4">Emploi du Temps</h2>
        <%- include('../partials/messages') %>
        
        <%# Sélecteur de classe (caché pour les élèves) %>
        <% if (user.role !== 'STUDENT' && user.role !== 'eleve') { %>
        <div class="card glass-card mb-4 p-3" style="border-radius:16px;">
            <div class="row align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Classe</label>
                    <select class="form-select" id="classSelector">
                        <option value="">-- Choisir une classe --</option>
                        <% if (typeof classes !== 'undefined' && classes.length > 0) { %>
                            <% classes.forEach(function(cls) { %>
                                <option value="<%= cls %>" <%= cls === defaultClass ? 'selected' : '' %>><%= cls %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" id="btnLoad">Afficher</button>
                </div>
            </div>
        </div>
        <% } %>

        <%# Sélecteur d'enfant pour les parents %>
        <% if (user.role === 'PARENT' && typeof children !== 'undefined' && children.length > 0) { %>
        <div class="card glass-card mb-4 p-3" style="border-radius:16px;">
            <div class="row align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Enfant</label>
                    <select class="form-select" id="childSelector">
                        <% children.forEach(function(child) { %>
                            <option value="<%= child.student_class %>" <%= child.student_class === defaultClass ? 'selected' : '' %>>
                                <%= child.name %> (<%= child.student_class || 'Sans classe' %>)
                            </option>
                        <% }); %>
                    </select>
                </div>
            </div>
        </div>
        <% } %>
        
        <%# Tableau de l'emploi du temps %>
        <div class="card glass-card p-3" style="border-radius:16px; display:none;" id="timetableContainer">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0" id="timetableTitle">Emploi du temps</h4>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered timetable-grid" id="timetableTable">
                    <thead>
                        <tr>
                            <th style="width: 100px;">Heures</th>
                            <th>Lundi</th>
                            <th>Mardi</th>
                            <th>Mercredi</th>
                            <th>Jeudi</th>
                            <th>Vendredi</th>
                        </tr>
                    </thead>
                    <tbody id="timetableBody">
                        <!-- Rempli par JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    // Mêmes créneaux que timetables.ejs
    var timeSlots = [
        '07:00-08:00', '08:00-09:00', '09:00-10:00', '10:00-11:00',
        '11:00-12:00', '12:00-13:00', '13:00-14:00', '14:00-15:00',
        '15:00-16:00', '16:00-17:00', '17:00-18:00'
    ];
    var days = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi'];
    var userRole = '<%= user.role %>';
    var studentClass = '<%= user.student_class || "" %>';
    var defaultClass = '<%= defaultClass || "" %>';
    var parentChildren = <%- JSON.stringify(typeof children !== 'undefined' ? children : []) %>;
    
    // Table de correspondance noms longs → noms courts
    var classNameMap = {
        'Sixième': '6ème', 'Cinquième': '5ème', 'Quatrième': '4ème', 'Troisième': '3ème',
        'Seconde': '2nde', 'Première': '1ère', 'Terminale': 'Tle'
    };
    
    function normalizeClassName(name) {
        if (!name) return '';
        if (/^\d/.test(name)) return name;
        var normalized = classNameMap[name];
        if (normalized) return normalized;
        var lower = name.toLowerCase().trim();
        for (var key in classNameMap) {
            if (key.toLowerCase() === lower) return classNameMap[key];
        }
        return name;
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        if (userRole === 'STUDENT' || userRole === 'eleve') {
            if (studentClass) {
                loadTimetable(studentClass);
            } else {
                document.getElementById('timetableContainer').style.display = 'block';
                document.getElementById('timetableBody').innerHTML = 
                    '<tr><td colspan="6" class="empty-cell">Aucune classe assignée à votre compte.</td></tr>';
            }
            return;
        }
        
        if (userRole === 'PARENT') {
            if (defaultClass) loadTimetable(defaultClass);
            var childSelector = document.getElementById('childSelector');
            if (childSelector) {
                childSelector.addEventListener('change', function() {
                    loadTimetable(this.value);
                });
            }
            return;
        }
        
        if (defaultClass) loadTimetable(defaultClass);
        
        var btnLoad = document.getElementById('btnLoad');
        if (btnLoad) {
            btnLoad.addEventListener('click', function() {
                var cls = document.getElementById('classSelector').value;
                if (cls) loadTimetable(cls);
                else alert('Veuillez sélectionner une classe.');
            });
        }
    });
    
    function loadTimetable(className) {
        if (!className) return;
        
        var normalized = normalizeClassName(className);
        console.log('📅 Chargement:', className, '→', normalized);
        
        var container = document.getElementById('timetableContainer');
        var title = document.getElementById('timetableTitle');
        var tbody = document.getElementById('timetableBody');
        
        container.style.display = 'block';
        title.textContent = 'Emploi du temps - ' + className;
        tbody.innerHTML = '<tr><td colspan="6" class="loading-cell"><div class="spinner-border text-primary"></div><p class="mt-2">Chargement...</p></td></tr>';
        
        // Essayer avec le nom normalisé
        fetch('/api/timetables/' + encodeURIComponent(normalized))
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.length === 0 && normalized !== className) {
                    return fetch('/api/timetables/' + encodeURIComponent(className)).then(function(r) { return r.json(); });
                }
                return data;
            })
            .then(function(data) {
                console.log('📅 Entrées:', data.length);
                
                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="empty-cell">Aucun emploi du temps pour cette classe.<br><small>Contactez la vie scolaire.</small></td></tr>';
                    return;
                }
                
                var html = '';
                timeSlots.forEach(function(slot) {
                    html += '<tr>';
                    html += '<td class="time-slot-cell">' + slot + '</td>';
                    
                    days.forEach(function(day) {
                        var entry = data.find(function(e) { return e.day === day && e.time_slot === slot; });
                        
                        if (entry) {
                            var color = entry.color || '#0d6efd';
                            html += '<td class="subject-cell" style="background:' + color + '15; border-left:4px solid ' + color + ';" data-color="' + color + '">';
                            html += '<div class="subject-name">' + escapeHtml(entry.subject) + '</div>';
                            if (entry.teacher) {
                                html += '<div class="subject-teacher">👨‍🏫 ' + escapeHtml(entry.teacher) + '</div>';
                            }
                            if (entry.room) {
                                html += '<div class="subject-room">🏫 ' + escapeHtml(entry.room) + '</div>';
                            }
                            html += '</td>';
                        } else {
                            html += '<td class="empty-slot">-</td>';
                        }
                    });
                    
                    html += '</tr>';
                });
                
                tbody.innerHTML = html;
            })
            .catch(function(error) {
                console.error('❌ Erreur:', error);
                tbody.innerHTML = '<tr><td colspan="6" class="error-cell">❌ Erreur de chargement<br><small>' + escapeHtml(error.message) + '</small><br><button class="btn btn-sm btn-outline-primary mt-2" onclick="loadTimetable(\'' + className + '\')">Réessayer</button></td></tr>';
            });
    }
    
    function escapeHtml(text) {
        if (!text) return '';
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>

<style>
    /* Style identique à timetables.ejs */
    .glass-card { 
        background: rgba(255,255,255,0.08); 
        backdrop-filter: blur(20px); 
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(0,0,0,0.08); 
    }
    [data-theme="dark"] .glass-card { 
        background: rgba(255,255,255,0.05); 
        border-color: rgba(255,255,255,0.08); 
    }
    
    .timetable-grid {
        border-collapse: collapse;
        width: 100%;
        background: transparent;
    }
    .timetable-grid th {
        background: rgba(13,110,253,0.1);
        color: #0d6efd;
        font-weight: 700;
        text-align: center;
        padding: 12px 8px;
        border: 1px solid rgba(13,110,253,0.15);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .timetable-grid td {
        border: 1px solid rgba(128,128,128,0.1);
        padding: 10px 8px;
        vertical-align: middle;
        transition: all 0.2s ease;
    }
    .time-slot-cell {
        text-align: center;
        font-weight: 600;
        background: rgba(13,110,253,0.03);
        color: #495057;
        font-size: 0.8rem;
        min-width: 100px;
    }
    .subject-cell {
        text-align: center;
        padding: 8px !important;
        cursor: default;
        transition: all 0.2s ease;
    }
    .subject-cell:hover {
        transform: scale(1.03);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        z-index: 1;
        position: relative;
    }
    .subject-name {
        font-weight: 700;
        font-size: 0.85rem;
        margin-bottom: 2px;
    }
    .subject-teacher {
        font-size: 0.7rem;
        color: #666;
        margin-top: 2px;
    }
    .subject-room {
        font-size: 0.7rem;
        color: #888;
        margin-top: 1px;
    }
    .empty-slot {
        text-align: center;
        color: #ccc;
        font-size: 0.8rem;
    }
    .empty-cell {
        text-align: center;
        padding: 30px !important;
        color: #888;
    }
    .loading-cell {
        text-align: center;
        padding: 30px !important;
    }
    .error-cell {
        text-align: center;
        padding: 30px !important;
        color: #dc3545;
    }
    
    [data-theme="dark"] .timetable-grid th {
        background: rgba(255,255,255,0.05);
        color: #fff;
        border-color: rgba(255,255,255,0.1);
    }
    [data-theme="dark"] .timetable-grid td {
        border-color: rgba(255,255,255,0.05);
    }
    [data-theme="dark"] .time-slot-cell {
        background: rgba(255,255,255,0.02);
        color: rgba(255,255,255,0.7);
    }
    [data-theme="dark"] .subject-teacher { color: rgba(255,255,255,0.6); }
    [data-theme="dark"] .subject-room { color: rgba(255,255,255,0.4); }
    [data-theme="dark"] .empty-slot { color: rgba(255,255,255,0.2); }
    
    @media (max-width: 768px) {
        .timetable-grid th,
        .timetable-grid td {
            padding: 6px 4px;
            font-size: 0.7rem;
        }
        .time-slot-cell {
            font-size: 0.65rem;
            min-width: 70px;
        }
        .subject-name { font-size: 0.7rem; }
        .subject-teacher, .subject-room { font-size: 0.6rem; }
    }
</style>

<%- include('../partials/footer') %>