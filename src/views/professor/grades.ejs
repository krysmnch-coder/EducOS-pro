<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container-fluid page-shell py-4">
    <div class="themed-container" style="max-width: 100%; padding: 0 20px;">
        <h2 style="display:flex;align-items:center;gap:10px;margin-bottom:20px; color: #0d6efd;">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#002FA7" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            Grille de notes - <span id="matiereProf"></span>
        </h2>

        <div class="card glass-card mb-4 p-3" style="border-radius:16px;">
            <div class="row align-items-end">
                <div class="col-md-2 mb-2">
                    <label class="form-label">Classe</label>
                    <select class="form-select" id="filtreClasse" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                        <option value="">-- Choisir --</option>
                    </select>
                </div>
                <div class="col-md-3 mb-2">
                    <label class="form-label">Matière</label>
                    <select class="form-select" id="filtreMatiere" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                        <option value="">-- Choisir --</option>
                    </select>
                </div>
                <div class="col-md-2 mb-2">
                    <label class="form-label">Trimestre</label>
                    <select class="form-select" id="filtreTrimestre" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                        <option value="1">Trimestre 1</option>
                        <option value="2">Trimestre 2</option>
                        <option value="3">Trimestre 3</option>
                    </select>
                </div>
                <div class="col-md-2 mb-2">
                    <label class="form-label">Coef Examen</label>
                    <select class="form-select" id="coefExamen" style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.15);">
                        <option value="1">1</option>
                        <option value="2" selected>2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                    </select>
                </div>
                <div class="col-md-2 mb-2">
                    <button class="btn btn-primary w-100" onclick="loadNotes()">📋 Charger</button>
                </div>
                <div class="col-md-1 mb-2">
                    <button class="btn btn-success w-100" onclick="saveAllNotes()">💾</button>
                </div>
            </div>
        </div>

        <div class="formula-info glass-card mb-3 p-2" style="border-radius:12px; display:flex; align-items:center; gap:8px; font-size:0.85rem; font-weight:500;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#002FA7" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <span>Formule : <strong>((NJ1 + NJ2) ÷ 2 + Examen sur <span id="noteMaxLabel">40</span>) ÷ (<span id="diviseur">3</span>)</strong></span>
        </div>

        <div class="card glass-card p-3" style="border-radius:16px; display:none;" id="tableContainer">
            <div style="overflow-x:auto;">
                <table class="table data-table" id="notesTable">
                    <thead>
                        <tr>
                            <th>N°</th>
                            <th>Élève</th>
                            <th>NJ1 /20</th>
                            <th>NJ2 /20</th>
                            <th>Moy NJ /20</th>
                            <th>Examen <span id="examHeader">/40</span></th>
                            <th>Total</th>
                            <th>Moyenne /20</th>
                            <th>Appréciation</th>
                            <th>Rang</th>
                        </tr>
                    </thead>
                    <tbody id="notesBody">
                        <tr><td colspan="10" style="text-align:center;padding:30px;">Sélectionnez une classe et une matière</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    var currentStudents = [];
    var existingGrades = {};
    var currentClass = '';
    var currentSubject = '';
    var currentPeriod = '1';
    var coefExamen = 2;

    function updateFormula() {
        coefExamen = parseInt(document.getElementById('coefExamen').value) || 2;
        var maxNote = coefExamen * 20;
        document.getElementById('noteMaxLabel').textContent = maxNote;
        document.getElementById('examHeader').textContent = '/' + maxNote;
        document.getElementById('diviseur').textContent = (1 + coefExamen);
    }

    // ==========================================================================
    // CHARGEMENT DES CLASSES
    // ==========================================================================
    function loadClasses() {
        fetch('/api/professor/classes')
            .then(function(r) { return r.json(); })
            .then(function(classes) {
                var select = document.getElementById('filtreClasse');
                select.innerHTML = '<option value="">-- Choisir une classe --</option>';
                if (classes.length === 0) {
                    select.innerHTML += '<option value="" disabled>Aucune classe trouvée</option>';
                } else {
                    classes.forEach(function(c) {
                        select.innerHTML += '<option value="' + c + '">' + c + '</option>';
                    });
                }
                console.log('📋 Classes chargées:', classes.length);
            })
            .catch(function(err) {
                console.error('❌ Erreur chargement classes:', err);
            });
    }

    // ==========================================================================
    // CHARGEMENT DES MATIÈRES
    // ==========================================================================
    function loadProfessorSubjects() {
        fetch('/api/professor/subjects')
            .then(function(r) { return r.json(); })
            .then(function(subjects) {
                var select = document.getElementById('filtreMatiere');
                select.innerHTML = '<option value="">-- Choisir une matière --</option>';
                if (subjects.length === 0) {
                    select.innerHTML += '<option value="" disabled>Aucune matière trouvée</option>';
                } else {
                    subjects.forEach(function(s) {
                        select.innerHTML += '<option value="' + s + '">' + s + '</option>';
                    });
                }
                console.log('📚 Matières chargées:', subjects.length);
            })
            .catch(function(err) {
                console.error('❌ Erreur chargement matières:', err);
            });
    }

    // ==========================================================================
    // CHARGEMENT DES NOTES
    // ==========================================================================
    function loadNotes() {
        var className = document.getElementById('filtreClasse').value;
        var subject = document.getElementById('filtreMatiere').value;

        if (!className) { alert('Veuillez sélectionner une classe.'); return; }
        if (!subject) { alert('Veuillez sélectionner une matière.'); return; }

        currentClass = className;
        currentSubject = subject;
        currentPeriod = document.getElementById('filtreTrimestre').value;
        
        var periodLabel = currentPeriod == 1 ? '1er Trimestre' : currentPeriod == 2 ? '2ème Trimestre' : '3ème Trimestre';
        document.getElementById('matiereProf').textContent = subject + ' (' + periodLabel + ')';
        document.getElementById('tableContainer').style.display = 'block';

        fetch('/api/grades/students/' + encodeURIComponent(className))
            .then(function(r) { return r.json(); })
            .then(function(students) {
                currentStudents = students;
                return fetch('/api/grades/' + encodeURIComponent(className) + '/' + encodeURIComponent(subject) + '?period=' + currentPeriod);
            })
            .then(function(r) { return r.json(); })
            .then(function(grades) {
                existingGrades = {};
                if (grades && Array.isArray(grades)) {
                    grades.forEach(function(g) { existingGrades[g.student_id] = g; });
                }
                renderTable();
            })
            .catch(function(err) {
                console.error('Erreur:', err);
                existingGrades = {};
                renderTable();
            });
    }

    function renderTable() {
        var tbody = document.getElementById('notesBody');
        if (!currentStudents.length) {
            tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;padding:30px;">Aucun élève dans cette classe.</td></tr>';
            return;
        }

        tbody.innerHTML = currentStudents.map(function(s, idx) {
            var g = existingGrades[s.id] || {};
            var nj1 = g.nj1 != null ? parseFloat(g.nj1) : '';
            var nj2 = g.nj2 != null ? parseFloat(g.nj2) : '';
            var examen = g.examen != null ? parseFloat(g.examen) : '';
            var comment = g.comment || '';
            var moyNJ = (nj1 !== '' && nj2 !== '') ? ((parseFloat(nj1) + parseFloat(nj2)) / 2).toFixed(1) : '';
            var total = '';
            var moyenne = '';
            if (moyNJ !== '' && examen !== '') {
                total = (parseFloat(moyNJ) + parseFloat(examen)).toFixed(1);
                moyenne = (parseFloat(total) / (2 + coefExamen)).toFixed(2);
            }
            return '<tr>' +
                '<td>' + (idx + 1) + '</td>' +
                '<td style="text-align:left;">' + s.name + '</td>' +
                '<td><input type="number" class="form-control nj1-input" data-student="' + s.id + '" value="' + nj1 + '" min="0" max="20" step="0.5" onchange="recalcRow(this)" style="width:70px;"></td>' +
                '<td><input type="number" class="form-control nj2-input" data-student="' + s.id + '" value="' + nj2 + '" min="0" max="20" step="0.5" onchange="recalcRow(this)" style="width:70px;"></td>' +
                '<td class="moyNJ-cell">' + (moyNJ || '-') + '</td>' +
                '<td><input type="number" class="form-control examen-input" data-student="' + s.id + '" value="' + examen + '" min="0" max="' + (coefExamen * 20) + '" step="0.5" onchange="recalcRow(this)" style="width:70px;"></td>' +
                '<td class="total-cell">' + (total || '-') + '</td>' +
                '<td class="moyenne-cell"><strong>' + (moyenne || '-') + '</strong></td>' +
                '<td><input type="text" class="form-control comment-input" data-student="' + s.id + '" value="' + comment + '" placeholder="..." style="min-width:100px;"></td>' +
                '<td class="rang-cell">-</td>' +
            '</tr>';
        }).join('');

        recalcRanks();
    }

    function recalcRow(input) {
        var row = input.closest('tr');
        var nj1 = parseFloat(row.querySelector('.nj1-input').value) || 0;
        var nj2 = parseFloat(row.querySelector('.nj2-input').value) || 0;
        var examen = parseFloat(row.querySelector('.examen-input').value) || 0;
        var moyNJ = (nj1 + nj2) / 2;
        row.querySelector('.moyNJ-cell').textContent = moyNJ.toFixed(1);
        var total = moyNJ + examen;
        row.querySelector('.total-cell').textContent = total.toFixed(1);
        var moyenne = total / (2 + coefExamen);
        row.querySelector('.moyenne-cell').innerHTML = '<strong>' + moyenne.toFixed(2) + '</strong>';
        recalcRanks();
    }

    function recalcAll() {
        document.querySelectorAll('#notesBody tr').forEach(function(row) {
            var nj1 = parseFloat(row.querySelector('.nj1-input')?.value) || 0;
            var nj2 = parseFloat(row.querySelector('.nj2-input')?.value) || 0;
            var examen = parseFloat(row.querySelector('.examen-input')?.value) || 0;
            var moyNJ = (nj1 + nj2) / 2;
            row.querySelector('.moyNJ-cell').textContent = moyNJ.toFixed(1);
            var total = moyNJ + examen;
            row.querySelector('.total-cell').textContent = total.toFixed(1);
            var moyenne = total / (2 + coefExamen);
            row.querySelector('.moyenne-cell').innerHTML = '<strong>' + moyenne.toFixed(2) + '</strong>';
        });
        recalcRanks();
    }

    function recalcRanks() {
        var rows = document.querySelectorAll('#notesBody tr');
        var moyennes = [];
        rows.forEach(function(row, idx) {
            var moy = parseFloat(row.querySelector('.moyenne-cell')?.textContent) || -1;
            moyennes.push({ idx: idx, moy: moy });
        });
        moyennes.sort(function(a, b) { return b.moy - a.moy; });
        var rank = 1, prevMoy = null, skip = 0;
        moyennes.forEach(function(item) {
            if (item.moy === -1) { rows[item.idx].querySelector('.rang-cell').textContent = '-'; return; }
            if (prevMoy !== null && item.moy === prevMoy) { skip++; }
            else { rank += skip; skip = 0; }
            rows[item.idx].querySelector('.rang-cell').textContent = rank;
            prevMoy = item.moy;
        });
    }

    function saveAllNotes() {
        if (!currentClass || !currentSubject) { alert('Veuillez charger une classe et une matière.'); return; }
        var grades = [];
        document.querySelectorAll('#notesBody tr').forEach(function(row) {
            var studentId = row.querySelector('.nj1-input')?.getAttribute('data-student');
            if (!studentId) return;
            grades.push({
                student_id: studentId,
                nj1: parseFloat(row.querySelector('.nj1-input').value) || null,
                nj2: parseFloat(row.querySelector('.nj2-input').value) || null,
                examen: parseFloat(row.querySelector('.examen-input').value) || null,
                comment: row.querySelector('.comment-input')?.value || ''
            });
        });
        if (grades.length === 0) return;
        fetch('/api/grades/bulk', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ class_name: currentClass, subject: currentSubject, period: currentPeriod, grades: grades })
        })
        .then(function(r) { return r.json(); })
        .then(function(result) {
            alert(result.success ? '✅ Notes sauvegardées !' : 'Erreur : ' + (result.error || 'inconnue'));
        })
        .catch(function() { alert('Erreur réseau.'); });
    }

    // ==========================================================================
    // INITIALISATION
    // ==========================================================================
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof feather !== 'undefined') feather.replace();
        updateFormula();
        loadClasses();
        loadProfessorSubjects();
        document.getElementById('coefExamen').addEventListener('change', function() {
            updateFormula();
            if (currentStudents.length > 0) recalcAll();
        });
    });
</script>

<style>
    .glass-card {
        background: rgba(255,255,255,0.05) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        border: 1px solid rgba(255,255,255,0.08) !important;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3) !important;
        transition: all 0.3s ease;
    }
    .glass-card:hover { transform: translateY(-5px); box-shadow: 0 15px 40px rgba(0,0,0,0.4) !important; border-color: rgba(13,110,253,0.3) !important; }
    .data-table { width: 100%; border-collapse: collapse; color: #fff; }
    .data-table th, .data-table td { border: 1px solid rgba(255,255,255,0.08); padding: 8px 6px; text-align: center; vertical-align: middle; font-size: 0.85rem; }
    .data-table th { background: rgba(13,110,253,0.08); font-weight: 600; color: #0d6efd; }
    .data-table input { background: rgba(255,255,255,0.08) !important; border: 1px solid rgba(255,255,255,0.15) !important; color: white !important; text-align: center; border-radius: 6px; padding: 5px; font-size: 0.85rem; }
    .formula-info { background: rgba(13,110,253,0.08); color: #0d6efd; border: 1px solid rgba(13,110,253,0.15); }
    .form-label { color: rgba(255,255,255,0.8); font-weight: 500; font-size: 0.85rem; }
</style>

<%- include('../partials/footer') %>