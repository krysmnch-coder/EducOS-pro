<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('partials/head') %>
  <style>
    :root {
      --chat-primary: #0d6efd;
      --chat-success: #22c55e;
      --chat-glass-bg: rgba(255, 255, 255, 0.08);
      --chat-glass-border: rgba(255, 255, 255, 0.15);
      --chat-glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
    }

    [data-theme="dark"] {
      --chat-glass-bg: rgba(255, 255, 255, 0.03);
      --chat-glass-border: rgba(255, 255, 255, 0.06);
      --chat-glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }
    
    .chat-page-container {
      display: flex;
      gap: 1.5rem;
      height: calc(100vh - 140px);
      min-height: 500px;
    }
    
    .chat-sidebar {
      flex: 0 0 340px;
      background: var(--chat-glass-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--chat-glass-border);
      border-radius: 1.25rem;
      box-shadow: var(--chat-glass-shadow);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    
    .chat-main {
      flex: 1;
      background: var(--chat-glass-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--chat-glass-border);
      border-radius: 1.25rem;
      box-shadow: var(--chat-glass-shadow);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    
    .sidebar-header {
      background: rgba(13, 110, 253, 0.04);
      border-bottom: 1px solid rgba(13, 110, 253, 0.08);
      padding: 1rem 1.25rem;
      flex-shrink: 0;
    }
    
    .conversation-list {
      flex: 1;
      overflow-y: auto;
      padding: 0.5rem;
    }
    
    .conversation-item {
      background: transparent;
      border: none;
      border-radius: 0.75rem;
      padding: 0.75rem;
      margin-bottom: 0.25rem;
      transition: all 0.3s ease;
      cursor: pointer;
    }
    
    .conversation-item:hover {
      background: rgba(13, 110, 253, 0.05);
    }
    
    .conversation-item.active {
      background: rgba(13, 110, 253, 0.08);
      border-left: 3px solid var(--chat-primary);
    }
    
    .conversation-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(13, 110, 253, 0.15);
    }
    
    .conversation-name {
      font-weight: 600;
      font-size: 0.95rem;
    }
    
    .conversation-last-message {
      font-size: 0.8rem;
      color: #6c757d;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    
    .unread-badge {
      background: var(--chat-primary);
      color: white;
      border-radius: 50%;
      min-width: 20px;
      height: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
      font-weight: 700;
    }
    
    .messages-container {
      flex: 1;
      overflow-y: auto;
      padding: 1.5rem;
    }
    
    .message-bubble {
      max-width: 70%;
      padding: 0.7rem 1rem;
      border-radius: 1rem;
      word-wrap: break-word;
    }
    
    .message-sent .message-bubble {
      background: linear-gradient(135deg, var(--chat-primary), #0a58ca);
      color: white;
      border-bottom-right-radius: 0.25rem;
    }
    
    .message-received .message-bubble {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-bottom-left-radius: 0.25rem;
    }
    
    .chat-footer {
      background: rgba(255, 255, 255, 0.04);
      border-top: 1px solid rgba(13, 110, 253, 0.06);
      padding: 0.75rem 1.25rem;
      flex-shrink: 0;
    }
    
    .message-input-group {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 1rem;
      padding: 0.25rem;
    }
    
    .message-input {
      flex: 1;
      background: transparent;
      border: none;
      padding: 0.6rem 0.75rem;
      font-size: 0.95rem;
      outline: none;
    }
    
    .btn-send {
      background: linear-gradient(135deg, var(--chat-primary), #0a58ca);
      border: none;
      border-radius: 0.75rem;
      padding: 0.5rem 1rem;
      color: white;
    }
    
    .btn-new-chat {
      background: linear-gradient(135deg, var(--chat-primary), #0a58ca);
      border: none;
      border-radius: 0.75rem;
      padding: 0.5rem 1rem;
      color: white;
      font-weight: 600;
    }
    
    @media (max-width: 992px) {
      .chat-page-container {
        flex-direction: column;
        height: calc(100vh - 120px);
      }
      
      .chat-main {
        display: none;
      }
      
      .chat-page-container.show-chat .chat-sidebar {
        display: none;
      }
      
      .chat-page-container.show-chat .chat-main {
        display: flex;
      }
    }
  </style>
</head>
<body data-user-id="<%= user ? user.id : '' %>">
  <div class="page-shell container-xl py-4">
    <%- include('partials/header') %>

    <main class="page-main">
      <div class="chat-page-container" id="chatContainer">
        <!-- Sidebar -->
        <div class="chat-sidebar" id="chatSidebar">
          <div class="sidebar-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
              <i data-feather="message-square" style="width: 20px; height: 20px;"></i>
              Conversations
            </h5>
            <button class="btn btn-new-chat btn-sm" data-bs-toggle="modal" data-bs-target="#new-chat-modal">
              <i data-feather="plus" style="width: 16px; height: 16px;"></i>
              <span class="ms-1">Nouveau</span>
            </button>
          </div>
          
          <div class="conversation-list" id="user-list">
            <div class="text-center py-5" id="loading-indicator">
              <div class="spinner-border text-primary" role="status"></div>
              <p class="text-muted small mt-2">Chargement des conversations...</p>
            </div>
            
            <div class="text-center py-5" id="empty-state" style="display: none;">
              <i data-feather="inbox" style="width: 40px; height: 40px; color: #adb5bd;"></i>
              <p class="text-muted mt-2">Aucune conversation</p>
            </div>
          </div>
        </div>

        <!-- Chat Main -->
        <div class="chat-main" id="chatMain">
          <div class="d-flex flex-column h-100" id="chat-window" style="display: none;">
            <div class="sidebar-header d-flex align-items-center">
              <button class="btn btn-sm btn-outline-secondary me-2 d-lg-none" id="back-to-list-btn">
                <i data-feather="arrow-left" style="width: 18px; height: 18px;"></i>
              </button>
              <div>
                <strong id="chat-header-name">Utilisateur</strong>
                <small class="d-block text-muted" id="chat-header-status">Hors ligne</small>
              </div>
            </div>
            
            <div class="messages-container" id="message-container"></div>
            
            <div class="chat-footer">
              <form id="message-form">
                <div class="message-input-group">
                  <input type="text" class="message-input" id="message-input" 
                         placeholder="Écrivez votre message..." autocomplete="off" disabled>
                  <button class="btn btn-send" type="submit" disabled>
                    <i data-feather="send" style="width: 18px; height: 18px;"></i>
                  </button>
                </div>
              </form>
            </div>
          </div>

          <div class="d-flex align-items-center justify-content-center h-100" id="chat-placeholder">
            <div class="text-center">
              <i data-feather="message-circle" style="width: 64px; height: 64px; color: #adb5bd;"></i>
              <h5 class="text-muted mt-3">Sélectionnez une conversation</h5>
              <p class="text-muted small">Choisissez une conversation ou démarrez-en une nouvelle</p>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <%- include('partials/footer') %>

  <!-- Modal Nouvelle conversation -->
  <div class="modal fade" id="new-chat-modal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Nouvelle conversation</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <% if (typeof otherUsers !== 'undefined' && otherUsers.length > 0) { %>
            <% otherUsers.forEach(function(otherUser) { %>
              <div class="new-chat-user d-flex align-items-center p-2 rounded cursor-pointer" 
                   data-user-id="<%= otherUser.id %>" 
                   data-user-name="<%= otherUser.name %>"
                   style="cursor: pointer; transition: background 0.2s;"
                   onmouseover="this.style.background='rgba(13,110,253,0.05)'"
                   onmouseout="this.style.background='transparent'">
                <img src="<%= otherUser.avatar_url || '/img/user.png' %>" 
                     alt="<%= otherUser.name %>" 
                     class="rounded-circle me-3"
                     style="width: 40px; height: 40px; object-fit: cover;"
                     onerror="this.src='/img/user.png'">
                <span><%= otherUser.name %></span>
              </div>
            <% }); %>
          <% } else { %>
            <p class="text-muted text-center py-3">Aucun utilisateur disponible</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="/socket.io/socket.io.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof feather !== 'undefined') feather.replace();

      const socket = io();
      
      let activeUserId = null;
      const currentUserId = document.body.dataset.userId;
      let onlineUserIds = new Set(); // Ajout de l'état des utilisateurs en ligne
      
      const userList = document.getElementById('user-list');
      const messageContainer = document.getElementById('message-container');
      const messageForm = document.getElementById('message-form');
      const messageInput = document.getElementById('message-input');
      const chatWindow = document.getElementById('chat-window');
      const chatPlaceholder = document.getElementById('chat-placeholder');
      const chatHeaderName = document.getElementById('chat-header-name');
      const chatHeaderStatus = document.getElementById('chat-header-status');
      const loadingIndicator = document.getElementById('loading-indicator');
      const emptyState = document.getElementById('empty-state');
      const backToListBtn = document.getElementById('back-to-list-btn');
      const chatContainer = document.getElementById('chatContainer');

      console.log('🚀 Chat initialisé - User ID:', currentUserId);

      // ========================================================================
      // CHARGEMENT DES CONVERSATIONS
      // ========================================================================
      async function loadConversations() {
        console.log('🔄 Chargement des conversations...');
        
        try {
          const response = await fetch('/api/conversations', {
            headers: { 'Accept': 'application/json' },
            credentials: 'same-origin'
          });

          if (!response.ok) throw new Error('Erreur HTTP ' + response.status);

          const conversations = await response.json();
          console.log('✅ Conversations reçues:', conversations?.length || 0);

          if (loadingIndicator) loadingIndicator.style.display = 'none';

          // Nettoyer la liste
          const items = userList.querySelectorAll('.conversation-item');
          items.forEach(el => el.remove());

          if (!conversations || conversations.length === 0) {
            if (emptyState) emptyState.style.display = 'block';
            return;
          }

          if (emptyState) emptyState.style.display = 'none';

          conversations.forEach(convo => {
            const isOnline = onlineUserIds.has(convo.id.toString()); // Vérifie le statut en ligne
            const div = document.createElement('div');
            div.className = 'conversation-item d-flex align-items-center';
            div.dataset.userId = convo.id;
            div.innerHTML = `
              <img src="${escapeHtml(convo.avatar_url || '/img/user.png')}" 
                   alt="" class="conversation-avatar me-3"
              <div class="avatar-container me-3 ${isOnline ? 'online' : ''}">
                <img src="${escapeHtml(convo.avatar_url || '/img/user.png')}" 
                   alt="${escapeHtml(convo.name || 'Utilisateur')}" class="conversation-avatar"
                   onerror="this.src='/img/user.png'">
              </div>
              <div class="flex-grow-1 min-width-0">
                <div class="d-flex justify-content-between">
                  <span class="conversation-name">${escapeHtml(convo.name || 'Utilisateur')}</span>
                  ${convo.unread_count > 0 ? `<span class="unread-badge">${convo.unread_count}</span>` : ''}
                </div>
                <div class="conversation-last-message">${escapeHtml(convo.last_message || 'Aucun message')}</div>
              </div>
            `;
            
            div.addEventListener('click', () => {
              openConversation(convo.id, convo.name, convo.avatar_url);
            });
            
            userList.appendChild(div);
          });

        } catch (error) {
          console.error('❌ Erreur loadConversations:', error);
          if (loadingIndicator) {
            loadingIndicator.innerHTML = `
              <div class="text-danger">
                <i data-feather="alert-triangle"></i>
                <p class="mt-2">Erreur de chargement</p>
                <button class="btn btn-sm btn-outline-danger" onclick="location.reload()">Réessayer</button>
              </div>
            `;
          }
        }
      }

      // ========================================================================
      // OUVERTURE D'UNE CONVERSATION
      // ========================================================================
      async function openConversation(userId, userName, userAvatar) {
        console.log('💬 Ouverture conversation - UserID:', userId, 'Nom:', userName);
        
        activeUserId = userId;
        
        chatPlaceholder.style.display = 'none';
        chatWindow.style.display = 'flex';
        chatHeaderName.textContent = userName || 'Utilisateur';
        chatHeaderName.textContent = userName || 'Utilisateur'; // Nom de l'utilisateur
        const isOnline = onlineUserIds.has(userId.toString()); // Vérifie le statut en ligne
        chatHeaderStatus.textContent = isOnline ? 'En ligne' : 'Hors ligne'; // Met à jour le statut
        
        // Activer l'input
        messageInput.disabled = false;
        messageForm.querySelector('button').disabled = false;
        
        // Charger les messages
        await loadMessages(userId);
        
        // Mobile : afficher le chat
        if (window.innerWidth <= 992) {
          chatContainer.classList.add('show-chat');
        }
        
        messageInput.focus();
      }

      // ========================================================================
      // CHARGEMENT DES MESSAGES
      // ========================================================================
      async function loadMessages(userId) {
        console.log('📥 Chargement messages pour userId:', userId);
        
        messageContainer.innerHTML = `
          <div class="text-center py-3">
            <div class="spinner-border spinner-border-sm text-primary"></div>
            <p class="text-muted small mt-2">Chargement...</p>
          </div>
        `;
        
        try {
          const response = await fetch('/api/messages/' + userId, {
            headers: { 'Accept': 'application/json' },
            credentials: 'same-origin'
          });

          console.log('📡 Status:', response.status);

          if (!response.ok) {
            const errorData = await response.json().catch(() => ({}));
            throw new Error(errorData.error || 'Erreur HTTP ' + response.status);
          }

          const messages = await response.json();
          console.log('✅ Messages reçus:', messages?.length || 0);

          renderMessages(messages || []);

        } catch (error) {
          console.error('❌ Erreur loadMessages:', error);
          messageContainer.innerHTML = `
            <div class="text-center text-danger py-4">
              <i data-feather="alert-triangle" style="width: 32px; height: 32px;"></i>
              <p class="mt-2">Erreur de chargement des messages</p>
              <p class="small text-muted">${escapeHtml(error.message)}</p>
              <button class="btn btn-sm btn-outline-danger mt-2" onclick="loadMessages(${userId})">Réessayer</button>
            </div>
          `;
        }
      }

      // ========================================================================
      // RENDU DES MESSAGES
      // ========================================================================
      function renderMessages(messages) {
        messageContainer.innerHTML = '';
        
        if (!messages || messages.length === 0) {
          messageContainer.innerHTML = `
            <div class="text-center text-muted py-5">
              <i data-feather="message-circle" style="width: 48px; height: 48px;"></i>
              <p class="mt-3">Aucun message</p>
              <p class="small">Commencez la conversation !</p>
            </div>
          `;
          return;
        }

        messages.forEach(msg => {
          const isSent = parseInt(msg.sender_id) === parseInt(currentUserId);
          const time = msg.created_at ? new Date(msg.created_at).toLocaleTimeString('fr-FR', {
            hour: '2-digit', minute: '2-digit'
          }) : '';
          
          const wrapper = document.createElement('div');
          wrapper.className = `d-flex mb-2 ${isSent ? 'justify-content-end message-sent' : 'justify-content-start message-received'}`;
          wrapper.innerHTML = `
            <div class="message-bubble">
              <div>${escapeHtml(msg.content || msg.message || '')}</div>
              <div class="text-end">
                <small style="opacity: 0.7; font-size: 0.7rem;">${time}</small>
              </div>
            </div>
          `;
          
          messageContainer.appendChild(wrapper);
        });

        // Scroll vers le bas
        setTimeout(() => {
          messageContainer.scrollTop = messageContainer.scrollHeight;
        }, 50);
      }

      // ========================================================================
      // ENVOI DE MESSAGE
      // ========================================================================
      messageForm.addEventListener('submit', (e) => {
        e.preventDefault();
        
        const content = messageInput.value.trim();
        if (!content || !activeUserId) return;
        
        console.log('📤 Envoi message:', content);
        
        socket.emit('sendMessage', {
          receiverId: parseInt(activeUserId),
          senderId: parseInt(currentUserId),
          content: content
        });
        
        // Ajouter le message localement
        const wrapper = document.createElement('div');
        wrapper.className = 'd-flex mb-2 justify-content-end message-sent';
        wrapper.innerHTML = `
          <div class="message-bubble">
            <div>${escapeHtml(content)}</div>
            <div class="text-end">
              <small style="opacity: 0.7; font-size: 0.7rem;">${new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}</small>
            </div>
          </div>
        `;
        messageContainer.appendChild(wrapper);
        
        messageInput.value = '';
        messageInput.focus();
        
        setTimeout(() => {
          messageContainer.scrollTop = messageContainer.scrollHeight;
        }, 50);
      });

      // ========================================================================
      // SOCKET.IO
      // ========================================================================
      socket.on('connect', () => {
        console.log('✅ Connecté au serveur de chat');
      });

      // Réception de la liste des utilisateurs en ligne
      socket.on('onlineUsersUpdate', (users) => {
        console.log('🔄 Utilisateurs en ligne mis à jour:', users);
        onlineUserIds = new Set(users.map(String)); // Met à jour la liste des IDs en ligne
        loadConversations(); // Recharge les conversations pour mettre à jour les statuts dans la liste

        // Met à jour le statut dans l'en-tête du chat actif si une conversation est ouverte
        if (activeUserId) {
          const isOnline = onlineUserIds.has(activeUserId.toString());
          chatHeaderStatus.textContent = isOnline ? 'En ligne' : 'Hors ligne';
        }
      });

      socket.on('newMessage', (data) => {
        console.log('📩 Nouveau message reçu:', data);
        
        const senderId = data.senderId || data.sender_id;
        
        if (parseInt(senderId) === parseInt(activeUserId)) {
          const wrapper = document.createElement('div');
          wrapper.className = 'd-flex mb-2 justify-content-start message-received';
          wrapper.innerHTML = `
            <div class="message-bubble">
              <div>${escapeHtml(data.content || data.message || '')}</div>
              <div class="text-end">
                <small style="opacity: 0.7; font-size: 0.7rem;">${new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}</small>
              </div>
            </div>
          `;
          messageContainer.appendChild(wrapper);
          
          setTimeout(() => {
            messageContainer.scrollTop = messageContainer.scrollHeight;
          }, 50);
        }
        
        // Recharger les conversations
        loadConversations();
      });

      // ========================================================================
      // BOUTON RETOUR (MOBILE)
      // ========================================================================
      if (backToListBtn) {
        backToListBtn.addEventListener('click', () => {
          chatContainer.classList.remove('show-chat');
        });
      }

      // ========================================================================
      // MODAL NOUVELLE CONVERSATION
      // ========================================================================
      document.addEventListener('click', (e) => {
        const userEl = e.target.closest('.new-chat-user');
        if (userEl) {
          const userId = userEl.dataset.userId;
          const userName = userEl.dataset.userName;
          
          console.log('✨ Nouvelle conversation avec:', userName, '(ID:', userId, ')');
          
          // Fermer le modal
          const modal = bootstrap.Modal.getInstance(document.getElementById('new-chat-modal'));
          if (modal) modal.hide();
          
          openConversation(userId, userName);
        }
      });

      // ========================================================================
      // UTILITAIRES
      // ========================================================================
      function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }

      // ========================================================================
      // INITIALISATION
      // ========================================================================
      loadConversations();
    });
  </script>
</body>
</html>