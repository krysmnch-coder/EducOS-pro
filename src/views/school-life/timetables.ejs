<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container-fluid page-shell py-4">
    <div class="themed-container" style="max-width: 100%; padding: 0 20px;">
        <h2 class="mb-4">Emploi du Temps</h2>
        <%- include('../partials/messages') %>
        
        <%# Sélecteur de classe (caché pour les élèves) %>
        <% if (user.role !== 'STUDENT' && user.role !== 'eleve') { %>
        <div class="card glass-card mb-4 p-3" style="border-radius:16px;">
            <div class="row align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Classe</label>
                    <select class="form-select" id="classSelector">
                        <option value="">-- Choisir une classe --</option>
                        <% if (typeof classes !== 'undefined' && classes.length > 0) { %>
                            <% classes.forEach(function(cls) { %>
                                <option value="<%= cls %>" <%= cls === defaultClass ? 'selected' : '' %>><%= cls %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" id="btnLoad">Afficher</button>
                </div>
            </div>
        </div>
        <% } %>

        <%# Sélecteur d'enfant pour les parents %>
        <% if (user.role === 'PARENT' && typeof children !== 'undefined' && children.length > 0) { %>
        <div class="card glass-card mb-4 p-3" style="border-radius:16px;">
            <div class="row align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Enfant</label>
                    <select class="form-select" id="childSelector">
                        <% children.forEach(function(child) { %>
                            <option value="<%= child.student_class %>" <%= child.student_class === defaultClass ? 'selected' : '' %>>
                                <%= child.name %> (<%= child.student_class || 'Sans classe' %>)
                            </option>
                        <% }); %>
                    </select>
                </div>
            </div>
        </div>
        <% } %>
        
        <%# Tableau de l'emploi du temps %>
        <div class="card glass-card p-3" style="border-radius:16px; display:none;" id="timetableContainer">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0" id="timetableTitle">Emploi du temps</h4>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered" id="timetableTable">
                    <thead>
                        <tr>
                            <th style="width: 120px;">Heures</th>
                            <th>Lundi</th>
                            <th>Mardi</th>
                            <th>Mercredi</th>
                            <th>Jeudi</th>
                            <th>Vendredi</th>
                        </tr>
                    </thead>
                    <tbody id="timetableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    var timeSlots = [
        '07:00-08:00', '08:00-09:00', '09:00-10:00', '10:00-11:00', 
        '11:00-12:00', '12:00-13:00', '13:00-14:00', '14:00-15:00', 
        '15:00-16:00', '16:00-17:00', '17:00-18:00'
    ];
    var days = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi'];
    var userRole = '<%= user.role %>';
    var studentClass = '<%= user.student_class || "" %>';
    var defaultClass = '<%= defaultClass || "" %>';
    var parentChildren = <%- JSON.stringify(typeof children !== 'undefined' ? children : []) %>;
    
    // Table de correspondance : noms longs -> noms courts (utilisés dans users.student_class)
    var classNameMap = {
        'Sixième': '6ème', 'sixieme': '6ème', '6eme': '6ème', '6e': '6ème',
        'Cinquième': '5ème', 'cinquieme': '5ème', '5eme': '5ème', '5e': '5ème',
        'Quatrième': '4ème', 'quatrieme': '4ème', '4eme': '4ème', '4e': '4ème',
        'Troisième': '3ème', 'troisieme': '3ème', '3eme': '3ème', '3e': '3ème',
        'Seconde': '2nde', 'seconde': '2nde', '2nd': '2nde',
        'Première': '1ère', 'premiere': '1ère', '1ere': '1ère', '1re': '1ère',
        'Terminale': 'Tle', 'terminale': 'Tle', 'tle': 'Tle'
    };
    
    // Normaliser le nom de classe
    function normalizeClassName(name) {
        if (!name) return '';
        // Si c'est déjà un nom court (ex: '4ème'), le retourner tel quel
        if (/^\d/.test(name)) return name;
        // Chercher dans la table de correspondance
        var normalized = classNameMap[name];
        if (normalized) return normalized;
        // Chercher insensiblement
        var lowerName = name.toLowerCase().trim();
        for (var key in classNameMap) {
            if (key.toLowerCase() === lowerName) return classNameMap[key];
        }
        // Retourner le nom original si pas de correspondance
        return name;
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        // ÉLÈVE : afficher directement son emploi du temps
        if (userRole === 'STUDENT' || userRole === 'eleve') {
            if (studentClass) {
                loadTimetable(studentClass);
            } else {
                document.getElementById('timetableContainer').style.display = 'block';
                document.getElementById('timetableBody').innerHTML = 
                    '<tr><td colspan="6" style="text-align:center;padding:30px;color:#888;">Aucune classe assignée à votre compte.</td></tr>';
            }
            return;
        }
        
        // PARENT : afficher et écouter le changement d'enfant
        if (userRole === 'PARENT') {
            if (defaultClass) {
                loadTimetable(defaultClass);
            }
            var childSelector = document.getElementById('childSelector');
            if (childSelector) {
                childSelector.addEventListener('change', function() {
                    loadTimetable(this.value);
                });
            }
            return;
        }
        
        // AUTRES : charger la classe par défaut
        if (defaultClass) { 
            loadTimetable(defaultClass); 
        }
        
        // Bouton pour charger une classe
        var btnLoad = document.getElementById('btnLoad');
        if (btnLoad) {
            btnLoad.addEventListener('click', function() {
                var cls = document.getElementById('classSelector').value;
                if (cls) {
                    loadTimetable(cls);
                } else {
                    alert('Veuillez sélectionner une classe.');
                }
            });
        }
    });
    
    function loadTimetable(className) {
        if (!className) return;
        
        // Normaliser le nom de classe pour correspondre à la DB
        var normalizedName = normalizeClassName(className);
        
        console.log('📅 Chargement emploi du temps pour:', className, '→ Normalisé:', normalizedName);
        
        var container = document.getElementById('timetableContainer');
        var title = document.getElementById('timetableTitle');
        var tbody = document.getElementById('timetableBody');
        
        container.style.display = 'block';
        title.textContent = 'Emploi du temps - ' + className;
        tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:30px;"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Chargement...</p></td></tr>';
        
        // Essayer avec le nom normalisé d'abord, puis avec le nom original
        fetchTimetable(normalizedName, className);
    }
    
    function fetchTimetable(normalizedName, originalName) {
        fetch('/api/timetables/' + encodeURIComponent(normalizedName))
            .then(function(response) {
                if (!response.ok) throw new Error('Erreur réseau (' + response.status + ')');
                return response.json();
            })
            .then(function(data) {
                // Si aucune donnée avec le nom normalisé, essayer avec le nom original
                if (data.length === 0 && normalizedName !== originalName) {
                    console.log('⚠️ Aucune donnée avec nom normalisé, essai avec nom original:', originalName);
                    return fetch('/api/timetables/' + encodeURIComponent(originalName))
                        .then(function(r) { return r.json(); });
                }
                return data;
            })
            .then(function(data) {
                renderTimetable(data, originalName);
            })
            .catch(function(error) {
                console.error('❌ Erreur:', error);
                var tbody = document.getElementById('timetableBody');
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:30px;color:#dc3545;">❌ Erreur de chargement<br><small>' + escapeHtml(error.message) + '</small><br><button class="btn btn-sm btn-outline-primary mt-2" onclick="loadTimetable(\'' + originalName + '\')">Réessayer</button></td></tr>';
            });
    }
    
    function renderTimetable(data, className) {
        var tbody = document.getElementById('timetableBody');
        
        console.log('📅 Données reçues:', data.length, 'entrées');
        
        if (data.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:30px;color:#888;">Aucun emploi du temps pour cette classe.<br><small>Contactez la vie scolaire.</small></td></tr>';
            return;
        }
        
        var html = '';
        timeSlots.forEach(function(slot) {
            html += '<tr>';
            html += '<td style="text-align:center;font-weight:600;background:rgba(13,110,253,0.05);padding:10px;">' + slot + '</td>';
            
            days.forEach(function(day) {
                var entry = data.find(function(e) { 
                    return e.day === day && e.time_slot === slot; 
                });
                
                if (entry) {
                    var bgColor = (entry.color || '#0d6efd') + '18';
                    var borderColor = entry.color || '#0d6efd';
                    html += '<td style="background:' + bgColor + '; text-align:center; border-left:4px solid ' + borderColor + '; padding:10px; transition: all 0.2s ease; cursor:default;" onmouseover="this.style.transform=\'scale(1.02)\';this.style.boxShadow=\'0 4px 15px rgba(0,0,0,0.1)\';" onmouseout="this.style.transform=\'\';this.style.boxShadow=\'\';">';
                    html += '<strong style="color:' + borderColor + ';font-size:0.9rem;">' + escapeHtml(entry.subject) + '</strong>';
                    if (entry.teacher) {
                        html += '<br><small style="color:#666;">👨‍🏫 ' + escapeHtml(entry.teacher) + '</small>';
                    }
                    if (entry.room) {
                        html += '<br><small style="color:#888;">🏫 ' + escapeHtml(entry.room) + '</small>';
                    }
                    html += '</td>';
                } else {
                    html += '<td style="text-align:center;color:#ccc;padding:10px;">-</td>';
                }
            });
            
            html += '</tr>';
        });
        
        tbody.innerHTML = html;
    }
    
    function escapeHtml(text) {
        if (!text) return '';
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>

<style>
    .glass-card { 
        background: rgba(255,255,255,0.08); 
        backdrop-filter: blur(20px); 
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(0,0,0,0.08); 
    }
    [data-theme="dark"] .glass-card { 
        background: rgba(255,255,255,0.05); 
        border-color: rgba(255,255,255,0.08); 
    }
    #timetableTable { 
        border-collapse: separate; 
        border-spacing: 0;
        width: 100%;
    }
    #timetableTable th { 
        background: rgba(13,110,253,0.08); 
        border: 1px solid rgba(128,128,128,0.15); 
        text-align: center; 
        padding: 12px 8px;
        font-weight: 600;
        color: #0d6efd;
        font-size: 0.9rem;
    }
    #timetableTable td { 
        border: 1px solid rgba(128,128,128,0.1); 
        vertical-align: middle;
    }
    [data-theme="dark"] #timetableTable th { 
        background: rgba(255,255,255,0.05); 
        color: #fff;
    }
    [data-theme="dark"] #timetableTable td { 
        border-color: rgba(255,255,255,0.05); 
    }
    @media (max-width: 768px) {
        #timetableTable th, #timetableTable td {
            padding: 6px 4px;
            font-size: 0.75rem;
        }
    }
</style>

<%- include('../partials/footer') %>