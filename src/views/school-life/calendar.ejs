<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container page-shell py-4">
    <div class="themed-container">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i data-feather="calendar"></i> Calendrier Scolaire</h2>
            <button class="btn btn-primary" id="btnAddEvent">
                <i data-feather="plus"></i> Ajouter un événement
            </button>
        </div>

        <%- include('../partials/messages') %>

        <div class="card" style="background: rgba(255,255,255,0.05); border-radius: 16px; padding: 20px;">
            <div id="calendar"></div>
        </div>

    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="eventModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background: rgba(30,30,50,0.95); color: white; border-radius: 16px;">
            <div class="modal-header" style="border-bottom: 1px solid rgba(255,255,255,0.1);">
                <h5 class="modal-title" id="modalTitle">Ajouter un événement</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="eventId">
                <div class="mb-3">
                    <label class="form-label">Titre *</label>
                    <input type="text" class="form-control" id="eventTitle" required style="background: rgba(255,255,255,0.1); color: white; border: 1px solid rgba(255,255,255,0.2);">
                </div>
                <div class="mb-3">
                    <label class="form-label">Type</label>
                    <select class="form-select" id="eventType" style="background: rgba(255,255,255,0.1); color: white; border: 1px solid rgba(255,255,255,0.2);">
                        <option value="event" style="background:#1a1a2e;">Événement</option>
                        <option value="holiday" style="background:#1a1a2e;">Vacances/Jour férié</option>
                        <option value="exam" style="background:#1a1a2e;">Examen</option>
                        <option value="meeting" style="background:#1a1a2e;">Réunion</option>
                        <option value="other" style="background:#1a1a2e;">Autre</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" id="eventDesc" rows="2" style="background: rgba(255,255,255,0.1); color: white; border: 1px solid rgba(255,255,255,0.2);"></textarea>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label">Date début *</label>
                        <input type="date" class="form-control" id="eventStart" required style="background: rgba(255,255,255,0.1); color: white; border: 1px solid rgba(255,255,255,0.2);">
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label">Date fin *</label>
                        <input type="date" class="form-control" id="eventEnd" required style="background: rgba(255,255,255,0.1); color: white; border: 1px solid rgba(255,255,255,0.2);">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Couleur</label>
                    <input type="color" id="eventColor" value="#0d6efd" style="width: 60px; height: 40px; border: none; cursor: pointer;">
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid rgba(255,255,255,0.1);">
                <button type="button" class="btn btn-danger me-auto" id="btnDelete" style="display:none;">Supprimer</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary" id="btnSave">Enregistrer</button>
            </div>
        </div>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

<script>
    let calendar;
    let currentEventId = null;

    document.addEventListener('DOMContentLoaded', function() {
        if (typeof feather !== 'undefined') feather.replace();

        var calendarEl = document.getElementById('calendar');
        calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            locale: 'fr',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,listMonth'
            },
            buttonText: { today: 'Aujourd\'hui', month: 'Mois', week: 'Semaine', list: 'Liste' },
            editable: true,
            selectable: true,
            events: '/api/calendar/events',
            eventClick: function(info) { openEditModal(info.event); },
            select: function(info) {
                clearForm();
                document.getElementById('eventStart').value = info.startStr;
                document.getElementById('eventEnd').value = info.endStr || info.startStr;
                new bootstrap.Modal(document.getElementById('eventModal')).show();
            },
            eventDrop: function(info) { updateEvent(info.event); },
            eventResize: function(info) { updateEvent(info.event); }
        });
        calendar.render();

        // Bouton Ajouter
        document.getElementById('btnAddEvent').addEventListener('click', function() {
            clearForm();
            new bootstrap.Modal(document.getElementById('eventModal')).show();
        });

        // Bouton Enregistrer
        document.getElementById('btnSave').addEventListener('click', saveEvent);

        // Bouton Supprimer
        document.getElementById('btnDelete').addEventListener('click', function() {
            if (!currentEventId || !confirm('Supprimer cet événement ?')) return;
            fetch('/api/calendar/events/' + currentEventId, { method: 'DELETE' })
                .then(function() {
                    calendar.refetchEvents();
                    bootstrap.Modal.getInstance(document.getElementById('eventModal')).hide();
                });
        });
    });

    function clearForm() {
        currentEventId = null;
        document.getElementById('eventId').value = '';
        document.getElementById('eventTitle').value = '';
        document.getElementById('eventType').value = 'event';
        document.getElementById('eventDesc').value = '';
        document.getElementById('eventStart').value = '';
        document.getElementById('eventEnd').value = '';
        document.getElementById('eventColor').value = '#0d6efd';
        document.getElementById('btnDelete').style.display = 'none';
        document.getElementById('modalTitle').textContent = 'Ajouter un événement';
    }

    function openEditModal(event) {
        currentEventId = event.id;
        document.getElementById('eventId').value = event.id;
        document.getElementById('eventTitle').value = event.title;
        document.getElementById('eventType').value = event.extendedProps.type || 'event';
        document.getElementById('eventDesc').value = event.extendedProps.description || '';
        document.getElementById('eventStart').value = event.startStr;
        document.getElementById('eventEnd').value = event.endStr || event.startStr;
        document.getElementById('eventColor').value = event.backgroundColor || '#0d6efd';
        document.getElementById('btnDelete').style.display = 'block';
        document.getElementById('modalTitle').textContent = 'Modifier';
        new bootstrap.Modal(document.getElementById('eventModal')).show();
    }

    function saveEvent() {
        var title = document.getElementById('eventTitle').value.trim();
        var start = document.getElementById('eventStart').value;
        var end = document.getElementById('eventEnd').value;
        if (!title || !start || !end) return alert('Titre et dates requis.');

        var data = {
            title: title,
            event_type: document.getElementById('eventType').value,
            description: document.getElementById('eventDesc').value.trim(),
            start_date: start,
            end_date: end,
            color: document.getElementById('eventColor').value
        };

        var url = '/api/calendar/events';
        var method = 'POST';
        if (currentEventId) {
            url += '/' + currentEventId;
            method = 'PUT';
        }

        fetch(url, {
            method: method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(function(r) { return r.json(); })
        .then(function() {
            calendar.refetchEvents();
            bootstrap.Modal.getInstance(document.getElementById('eventModal')).hide();
        })
        .catch(function(err) {
            alert('Erreur: ' + err.message);
        });
    }

    function updateEvent(event) {
        fetch('/api/calendar/events/' + event.id, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                title: event.title,
                start_date: event.startStr,
                end_date: event.endStr || event.startStr,
                event_type: event.extendedProps.type || 'event',
                description: event.extendedProps.description || '',
                color: event.backgroundColor
            })
        });
    }
</script>

<style>
    .fc { color: #e4e4e4; }
    .fc .fc-toolbar-title { color: #fff; font-size: 1.3rem; }
    .fc .fc-button { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #fff; text-transform: capitalize; }
    .fc .fc-button:hover { background: rgba(255,255,255,0.15); }
    .fc .fc-button-active { background: #0d6efd !important; border-color: #0d6efd !important; }
    .fc-theme-standard td, .fc-theme-standard th { border-color: rgba(255,255,255,0.06); }
    .fc .fc-daygrid-day-number { color: #ccc; }
    .fc .fc-col-header-cell-cushion { color: #ccc; }
    .fc .fc-day-today { background: rgba(13,110,253,0.1) !important; }
    .fc .fc-highlight { background: rgba(13,110,253,0.2) !important; }
</style>

<%- include('../partials/footer') %>