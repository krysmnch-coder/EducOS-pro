<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container-fluid page-shell py-4">
    <div class="themed-container" style="max-width: 100%; padding: 0 20px;">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i data-feather="calendar"></i> Calendrier Scolaire</h2>
        </div>

        <%- include('../partials/messages') %>

        <div class="card glass-card" style="border-radius: 16px; padding: 20px;">
            <div class="row" style="margin: 0; gap: 0;">
                <!-- Légende à gauche -->
                <div class="col-md-3" style="padding: 0; padding-right: 15px;">
                    <div class="legend-container glass-panel" style="border-radius: 12px; padding: 20px; height: 100%;">
                        <h5 style="color: #fff; margin-bottom: 20px; font-weight: 600;">
                            <i data-feather="info" style="width: 18px; height: 18px; margin-right: 8px;"></i>
                            Légende
                        </h5>
                        <div class="legend-item" data-type="Rentrée des classes" style="display: flex; align-items: center; margin-bottom: 12px; cursor: pointer; padding: 8px 12px; border-radius: 8px; transition: all 0.3s ease;">
                            <span style="display: inline-block; width: 24px; height: 24px; border-radius: 6px; background: #198754; margin-right: 12px; box-shadow: 0 2px 8px rgba(25, 135, 84, 0.3);"></span>
                            <span style="color: #e4e4e4; font-size: 0.95rem;">Rentrée des classes</span>
                        </div>
                        <div class="legend-item" data-type="Période scolaire" style="display: flex; align-items: center; margin-bottom: 12px; cursor: pointer; padding: 8px 12px; border-radius: 8px; transition: all 0.3s ease;">
                            <span style="display: inline-block; width: 24px; height: 24px; border-radius: 6px; background: #0d6efd; margin-right: 12px; box-shadow: 0 2px 8px rgba(13, 110, 253, 0.3);"></span>
                            <span style="color: #e4e4e4; font-size: 0.95rem;">Période scolaire</span>
                        </div>
                        <div class="legend-item" data-type="Vacances scolaires" style="display: flex; align-items: center; margin-bottom: 12px; cursor: pointer; padding: 8px 12px; border-radius: 8px; transition: all 0.3s ease;">
                            <span style="display: inline-block; width: 24px; height: 24px; border-radius: 6px; background: #fd7e14; margin-right: 12px; box-shadow: 0 2px 8px rgba(253, 126, 20, 0.3);"></span>
                            <span style="color: #e4e4e4; font-size: 0.95rem;">Vacances scolaires</span>
                        </div>
                        <div class="legend-item" data-type="Jours fériés" style="display: flex; align-items: center; margin-bottom: 12px; cursor: pointer; padding: 8px 12px; border-radius: 8px; transition: all 0.3s ease;">
                            <span style="display: inline-block; width: 24px; height: 24px; border-radius: 6px; background: #dc3545; margin-right: 12px; box-shadow: 0 2px 8px rgba(220, 53, 69, 0.3);"></span>
                            <span style="color: #e4e4e4; font-size: 0.95rem;">Jours fériés</span>
                        </div>
                        <div class="legend-item" data-type="Événements" style="display: flex; align-items: center; margin-bottom: 12px; cursor: pointer; padding: 8px 12px; border-radius: 8px; transition: all 0.3s ease;">
                            <span style="display: inline-block; width: 24px; height: 24px; border-radius: 6px; background: #6f42c1; margin-right: 12px; box-shadow: 0 2px 8px rgba(111, 66, 193, 0.3);"></span>
                            <span style="color: #e4e4e4; font-size: 0.95rem;">Événements</span>
                        </div>
                        <hr style="border-color: rgba(255,255,255,0.1); margin: 20px 0;">
                        <div style="color: #888; font-size: 0.85rem;">
                            <p style="margin: 8px 0; display: flex; align-items: center;">
                                <i data-feather="mouse-pointer" style="width: 16px; height: 16px; margin-right: 8px;"></i>
                                Cliquez sur une date pour ajouter
                            </p>
                            <p style="margin: 8px 0; display: flex; align-items: center;">
                                <i data-feather="edit-2" style="width: 16px; height: 16px; margin-right: 8px;"></i>
                                Cliquez sur un événement pour modifier
                            </p>
                            <p style="margin: 8px 0; display: flex; align-items: center;">
                                <i data-feather="filter" style="width: 16px; height: 16px; margin-right: 8px;"></i>
                                Filtrez par type ci-dessus
                            </p>
                        </div>
                    </div>
                </div>
                
                <!-- Calendrier -->
                <div class="col-md-9" style="padding: 0; padding-left: 15px;">
                    <div class="mb-3">
                        <select class="form-select" id="typeFilter" style="width: 200px; background: rgba(255,255,255,0.1); color: white; border: 1px solid rgba(255,255,255,0.15); backdrop-filter: blur(10px);">
                            <option value="all" style="background:#1a1a2e;">📅 Tous les types</option>
                            <option value="Rentrée des classes" style="background:#1a1a2e;">🎓 Rentrée des classes</option>
                            <option value="Période scolaire" style="background:#1a1a2e;">📚 Période scolaire</option>
                            <option value="Vacances scolaires" style="background:#1a1a2e;">🏖️ Vacances scolaires</option>
                            <option value="Jours fériés" style="background:#1a1a2e;">🎉 Jours fériés</option>
                            <option value="Événements" style="background:#1a1a2e;">⭐ Événements</option>
                        </select>
                    </div>
                    <div id="calendar"></div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="eventModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content glass-modal" style="background: rgba(30,30,50,0.92); color: white; border-radius: 16px; backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.1);">
            <div class="modal-header" style="border-bottom: 1px solid rgba(255,255,255,0.1);">
                <h5 class="modal-title" id="modalTitle">
                    <i data-feather="plus-circle" style="width: 20px; height: 20px; margin-right: 8px;"></i>
                    Ajouter un événement
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="eventId">
                
                <div class="mb-3">
                    <label class="form-label" style="font-weight: 500;">Titre *</label>
                    <input type="text" class="form-control" id="eventTitle" placeholder="Ex: Rentrée des classes" required style="background: rgba(255,255,255,0.08); color: white; border: 1px solid rgba(255,255,255,0.15); backdrop-filter: blur(10px); border-radius: 10px; padding: 12px;">
                </div>
                
                <div class="mb-4">
                    <label class="form-label" style="font-weight: 500; display: block; margin-bottom: 10px;">Type d'événement</label>
                    <div class="row" style="gap: 8px;">
                        <div class="col-md-4 col-6" style="padding: 0 4px;">
                            <button type="button" class="btn btn-type w-100" data-type="Rentrée des classes" data-color="#198754" style="background: rgba(25, 135, 84, 0.2); border: 2px solid #198754; color: #fff; border-radius: 10px; padding: 8px 12px; transition: all 0.3s ease;">
                                <span style="display: inline-block; width: 12px; height: 12px; border-radius: 3px; background: #198754; margin-right: 8px;"></span>
                                Rentrée
                            </button>
                        </div>
                        <div class="col-md-4 col-6" style="padding: 0 4px;">
                            <button type="button" class="btn btn-type w-100" data-type="Période scolaire" data-color="#0d6efd" style="background: rgba(13, 110, 253, 0.2); border: 2px solid #0d6efd; color: #fff; border-radius: 10px; padding: 8px 12px; transition: all 0.3s ease;">
                                <span style="display: inline-block; width: 12px; height: 12px; border-radius: 3px; background: #0d6efd; margin-right: 8px;"></span>
                                Période scolaire
                            </button>
                        </div>
                        <div class="col-md-4 col-6" style="padding: 0 4px;">
                            <button type="button" class="btn btn-type w-100" data-type="Vacances scolaires" data-color="#fd7e14" style="background: rgba(253, 126, 20, 0.2); border: 2px solid #fd7e14; color: #fff; border-radius: 10px; padding: 8px 12px; transition: all 0.3s ease;">
                                <span style="display: inline-block; width: 12px; height: 12px; border-radius: 3px; background: #fd7e14; margin-right: 8px;"></span>
                                Vacances
                            </button>
                        </div>
                        <div class="col-md-4 col-6" style="padding: 0 4px;">
                            <button type="button" class="btn btn-type w-100" data-type="Jours fériés" data-color="#dc3545" style="background: rgba(220, 53, 69, 0.2); border: 2px solid #dc3545; color: #fff; border-radius: 10px; padding: 8px 12px; transition: all 0.3s ease;">
                                <span style="display: inline-block; width: 12px; height: 12px; border-radius: 3px; background: #dc3545; margin-right: 8px;"></span>
                                Jours fériés
                            </button>
                        </div>
                        <div class="col-md-4 col-6" style="padding: 0 4px;">
                            <button type="button" class="btn btn-type w-100" data-type="Événements" data-color="#6f42c1" style="background: rgba(111, 66, 193, 0.2); border: 2px solid #6f42c1; color: #fff; border-radius: 10px; padding: 8px 12px; transition: all 0.3s ease;">
                                <span style="display: inline-block; width: 12px; height: 12px; border-radius: 3px; background: #6f42c1; margin-right: 8px;"></span>
                                Événements
                            </button>
                        </div>
                    </div>
                    <input type="hidden" id="eventType" value="Période scolaire">
                    <input type="hidden" id="eventColor" value="#0d6efd">
                </div>
                
                <div class="mb-3">
                    <label class="form-label" style="font-weight: 500;">Description</label>
                    <textarea class="form-control" id="eventDesc" rows="2" placeholder="Description de l'événement..." style="background: rgba(255,255,255,0.08); color: white; border: 1px solid rgba(255,255,255,0.15); backdrop-filter: blur(10px); border-radius: 10px; padding: 12px;"></textarea>
                </div>
                
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label" style="font-weight: 500;">Date début *</label>
                        <input type="date" class="form-control" id="eventStart" required style="background: rgba(255,255,255,0.08); color: white; border: 1px solid rgba(255,255,255,0.15); backdrop-filter: blur(10px); border-radius: 10px; padding: 12px;">
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label" style="font-weight: 500;">Date fin *</label>
                        <input type="date" class="form-control" id="eventEnd" required style="background: rgba(255,255,255,0.08); color: white; border: 1px solid rgba(255,255,255,0.15); backdrop-filter: blur(10px); border-radius: 10px; padding: 12px;">
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid rgba(255,255,255,0.1); padding: 16px 24px;">
                <button type="button" class="btn btn-danger me-auto" id="btnDelete" style="display:none; border-radius: 10px; padding: 10px 24px;">
                    <i data-feather="trash-2" style="width: 16px; height: 16px; margin-right: 6px;"></i>
                    Supprimer
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius: 10px; padding: 10px 24px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.15);">
                    Annuler
                </button>
                <button type="button" class="btn btn-primary" id="btnSave" style="border-radius: 10px; padding: 10px 32px;">
                    <i data-feather="save" style="width: 16px; height: 16px; margin-right: 6px;"></i>
                    Enregistrer
                </button>
            </div>
        </div>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

<script>
    let calendar;
    let currentEventId = null;

    document.addEventListener('DOMContentLoaded', function() {
        if (typeof feather !== 'undefined') feather.replace();

        document.querySelectorAll('.btn-type').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.btn-type').forEach(b => {
                    b.style.background = b.dataset.color + '33';
                    b.style.borderColor = b.dataset.color;
                    b.style.boxShadow = 'none';
                });
                this.style.background = this.dataset.color + '66';
                this.style.borderColor = this.dataset.color;
                this.style.boxShadow = '0 0 20px ' + this.dataset.color + '44';
                document.getElementById('eventType').value = this.dataset.type;
                document.getElementById('eventColor').value = this.dataset.color;
            });
        });

        document.querySelectorAll('.legend-item').forEach(item => {
            item.addEventListener('mouseenter', function() {
                this.style.background = 'rgba(255,255,255,0.08)';
                this.style.transform = 'translateX(5px)';
            });
            item.addEventListener('mouseleave', function() {
                this.style.background = 'transparent';
                this.style.transform = 'translateX(0)';
            });
            item.addEventListener('click', function() {
                document.getElementById('typeFilter').value = this.dataset.type;
                calendar.refetchEvents();
            });
        });

        var calendarEl = document.getElementById('calendar');
        calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            locale: 'fr',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,listMonth'
            },
            buttonText: { today: 'Aujourd\'hui', month: 'Mois', week: 'Semaine', list: 'Liste' },
            editable: true,
            selectable: true,
            displayEventTime: false,
            events: function(fetchInfo, successCallback, failureCallback) {
                const type = document.getElementById('typeFilter').value;
                let url = '/api/calendar/events';
                if (type !== 'all') url += '?type=' + encodeURIComponent(type);
                fetch(url)
                    .then(r => r.json())
                    .then(data => {
                        // ✅ Regrouper les événements multi-jours dans la vue liste
                        if (calendar.view.type === 'listMonth') {
                            data = groupMultiDayEvents(data);
                        }
                        successCallback(data);
                    })
                    .catch(err => failureCallback(err));
            },
            eventClick: function(info) { openEditModal(info.event); },
            select: function(info) {
                clearForm();
                document.getElementById('eventStart').value = info.startStr;
                document.getElementById('eventEnd').value = info.endStr || info.startStr;
                new bootstrap.Modal(document.getElementById('eventModal')).show();
            },
            eventDrop: function(info) { updateEvent(info.event); },
            eventResize: function(info) { updateEvent(info.event); },
            eventDidMount: function(info) {
                const type = info.event.extendedProps.type || '';
                info.el.style.fontSize = '0.8rem';
                info.el.style.padding = '5px 8px';
                info.el.style.margin = '2px 0';
                info.el.style.borderRadius = '6px';
                info.el.style.border = 'none';
                info.el.style.color = '#fff';
                info.el.style.fontWeight = '500';
                info.el.style.boxShadow = '0 2px 8px rgba(0,0,0,0.25)';
                info.el.style.minHeight = '22px';
                info.el.style.display = 'flex';
                info.el.style.alignItems = 'center';
                info.el.style.overflow = 'hidden';
                info.el.style.textOverflow = 'ellipsis';
                info.el.style.whiteSpace = 'nowrap';

                if (calendar.view.type === 'timeGridWeek') {
                    info.el.style.justifyContent = 'center';
                    info.el.style.textAlign = 'center';
                    info.el.style.whiteSpace = 'normal';
                    info.el.style.fontSize = '0.75rem';
                    info.el.style.padding = '2px 4px';
                }

                if (!info.event.backgroundColor) {
                    const colors = {
                        'Rentrée des classes': '#198754',
                        'Période scolaire': '#0d6efd',
                        'Vacances scolaires': '#fd7e14',
                        'Jours fériés': '#dc3545',
                        'Événements': '#6f42c1'
                    };
                    info.el.style.backgroundColor = colors[type] || '#0d6efd';
                }

                const start = info.event.start;
                const end = info.event.end;
                if (end && (end - start) > 86400000) {
                    info.el.style.borderLeft = '5px solid ' + (info.event.backgroundColor || '#0d6efd');
                    info.el.style.borderRadius = '0 6px 6px 0';
                    info.el.style.paddingLeft = '10px';
                }
            }
        });
        calendar.render();

        document.getElementById('typeFilter').addEventListener('change', function() {
            calendar.refetchEvents();
        });

        document.getElementById('btnSave').addEventListener('click', saveEvent);

        document.getElementById('btnDelete').addEventListener('click', function() {
            if (!currentEventId || !confirm('Supprimer cet événement ?')) return;
            fetch('/api/calendar/events/' + currentEventId, { method: 'DELETE' })
                .then(function() {
                    calendar.refetchEvents();
                    bootstrap.Modal.getInstance(document.getElementById('eventModal')).hide();
                });
        });
    });

    // ✅ Regrouper les événements multi-jours en une seule ligne dans la vue liste
    function groupMultiDayEvents(events) {
        const grouped = [];
        const processed = new Set();

        events.forEach(event => {
            if (processed.has(event.id)) return;
            
            const start = new Date(event.start);
            const end = new Date(event.end);
            const diffDays = Math.ceil((end - start) / (1000 * 60 * 60 * 24));
            
            // Si c'est un événement multi-jours (> 1 jour)
            if (diffDays > 1) {
                // Chercher tous les événements du même groupe (même titre + dates consécutives)
                const groupEvents = events.filter(e => 
                    e.title === event.title && 
                    e.extendedProps.type === event.extendedProps.type &&
                    !processed.has(e.id)
                );
                
                // Trouver la date de début la plus ancienne et la date de fin la plus récente
                let minStart = start;
                let maxEnd = end;
                groupEvents.forEach(e => {
                    processed.add(e.id);
                    const eStart = new Date(e.start);
                    const eEnd = new Date(e.end);
                    if (eStart < minStart) minStart = eStart;
                    if (eEnd > maxEnd) maxEnd = eEnd;
                });

                // Créer un événement groupé
                grouped.push({
                    ...event,
                    title: event.title,
                    start: minStart.toISOString().split('T')[0],
                    end: maxEnd.toISOString().split('T')[0]
                });
            } else {
                processed.add(event.id);
                grouped.push(event);
            }
        });

        return grouped;
    }

    function clearForm() {
        currentEventId = null;
        document.getElementById('eventId').value = '';
        document.getElementById('eventTitle').value = '';
        document.getElementById('eventType').value = 'Période scolaire';
        document.getElementById('eventColor').value = '#0d6efd';
        document.getElementById('eventDesc').value = '';
        document.getElementById('eventStart').value = '';
        document.getElementById('eventEnd').value = '';
        document.getElementById('btnDelete').style.display = 'none';
        document.getElementById('modalTitle').innerHTML = '<i data-feather="plus-circle" style="width:20px;height:20px;margin-right:8px;"></i> Ajouter un événement';
        
        document.querySelectorAll('.btn-type').forEach(b => {
            b.style.background = b.dataset.color + '33';
            b.style.borderColor = b.dataset.color;
            b.style.boxShadow = 'none';
            if (b.dataset.type === 'Période scolaire') {
                b.style.background = b.dataset.color + '66';
                b.style.boxShadow = '0 0 20px ' + b.dataset.color + '44';
            }
        });
        if (typeof feather !== 'undefined') feather.replace();
    }

    function openEditModal(event) {
        currentEventId = event.id;
        document.getElementById('eventId').value = event.id;
        document.getElementById('eventTitle').value = event.title;
        document.getElementById('eventType').value = event.extendedProps.type || 'Période scolaire';
        document.getElementById('eventColor').value = event.backgroundColor || '#0d6efd';
        document.getElementById('eventDesc').value = event.extendedProps.description || '';
        document.getElementById('eventStart').value = event.startStr;
        document.getElementById('eventEnd').value = event.endStr || event.startStr;
        document.getElementById('btnDelete').style.display = 'block';
        document.getElementById('modalTitle').innerHTML = '<i data-feather="edit-2" style="width:20px;height:20px;margin-right:8px;"></i> Modifier l\'événement';
        
        const type = event.extendedProps.type || 'Période scolaire';
        document.querySelectorAll('.btn-type').forEach(b => {
            b.style.background = b.dataset.color + '33';
            b.style.borderColor = b.dataset.color;
            b.style.boxShadow = 'none';
            if (b.dataset.type === type) {
                b.style.background = b.dataset.color + '66';
                b.style.boxShadow = '0 0 20px ' + b.dataset.color + '44';
            }
        });
        
        new bootstrap.Modal(document.getElementById('eventModal')).show();
        if (typeof feather !== 'undefined') feather.replace();
    }

    function saveEvent() {
        var title = document.getElementById('eventTitle').value.trim();
        var start = document.getElementById('eventStart').value;
        var end = document.getElementById('eventEnd').value;
        var type = document.getElementById('eventType').value;
        
        if (!title || !start || !end) return alert('Titre et dates requis.');

        if (type === 'Période scolaire') {
            var startDate = new Date(start + 'T00:00:00');
            var endDate = new Date(end + 'T00:00:00');
            if (startDate.getDay() === 6) startDate.setDate(startDate.getDate() + 2);
            if (startDate.getDay() === 0) startDate.setDate(startDate.getDate() + 1);
            if (endDate.getDay() === 6) endDate.setDate(endDate.getDate() - 1);
            if (endDate.getDay() === 0) endDate.setDate(endDate.getDate() - 2);
            start = startDate.toISOString().split('T')[0];
            end = endDate.toISOString().split('T')[0];
        }

        var data = {
            title: title,
            event_type: type,
            description: document.getElementById('eventDesc').value.trim(),
            start_date: start,
            end_date: end,
            color: document.getElementById('eventColor').value
        };

        var url = '/api/calendar/events';
        var method = 'POST';
        if (currentEventId) {
            url += '/' + currentEventId;
            method = 'PUT';
        }

        fetch(url, {
            method: method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(function(r) { return r.json(); })
        .then(function() {
            calendar.refetchEvents();
            bootstrap.Modal.getInstance(document.getElementById('eventModal')).hide();
        })
        .catch(function(err) { alert('Erreur: ' + err.message); });
    }

    function updateEvent(event) {
        fetch('/api/calendar/events/' + event.id, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                title: event.title,
                start_date: event.startStr,
                end_date: event.endStr || event.startStr,
                event_type: event.extendedProps.type || 'Période scolaire',
                description: event.extendedProps.description || '',
                color: event.backgroundColor
            })
        });
    }
</script>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.05) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3) !important;
    }
    
    .glass-panel {
        background: rgba(255, 255, 255, 0.05) !important;
        backdrop-filter: blur(15px) !important;
        -webkit-backdrop-filter: blur(15px) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2) !important;
    }
    
    .glass-modal {
