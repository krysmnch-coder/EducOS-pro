<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container-fluid page-shell py-4">
    <div class="themed-container" style="max-width: 100%; padding: 0 20px;">
        
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <h2 style="font-size: clamp(1.2rem, 4vw, 2rem);"><i data-feather="calendar"></i> Calendrier Scolaire</h2>
        </div>

        <%- include('../partials/messages') %>

        <div class="card glass-card" style="border-radius: 16px; padding: clamp(12px, 2vw, 20px);">
            <div class="row" style="margin: 0; gap: 0;">
                <!-- Légende à gauche -->
                <div class="col-lg-3 col-md-12" style="padding: 0; padding-right: 15px;">
                    <div class="legend-container glass-panel" style="border-radius: 12px; padding: clamp(15px, 2vw, 20px); height: 100%; max-height: 500px; overflow-y: auto;">
                        <h5 style="color: #fff; margin-bottom: 20px; font-weight: 600; font-size: clamp(1rem, 1.5vw, 1.25rem);">
                            <i data-feather="info" style="width: 18px; height: 18px; margin-right: 8px;"></i>
                            Légende
                        </h5>
                        <div class="legend-item" data-type="Rentrée des classes" style="display: flex; align-items: center; margin-bottom: 10px; cursor: pointer; padding: 8px 12px; border-radius: 8px; transition: all 0.3s ease;">
                            <span style="display: inline-block; width: clamp(18px, 2vw, 24px); height: clamp(18px, 2vw, 24px); border-radius: 6px; background: #198754; margin-right: 12px; flex-shrink: 0; box-shadow: 0 2px 8px rgba(25, 135, 84, 0.3);"></span>
                            <span style="color: #e4e4e4; font-size: clamp(0.8rem, 1.2vw, 0.95rem);">Rentrée des classes</span>
                        </div>
                        <div class="legend-item" data-type="Période scolaire" style="display: flex; align-items: center; margin-bottom: 10px; cursor: pointer; padding: 8px 12px; border-radius: 8px; transition: all 0.3s ease;">
                            <span style="display: inline-block; width: clamp(18px, 2vw, 24px); height: clamp(18px, 2vw, 24px); border-radius: 6px; background: #0d6efd; margin-right: 12px; flex-shrink: 0; box-shadow: 0 2px 8px rgba(13, 110, 253, 0.3);"></span>
                            <span style="color: #e4e4e4; font-size: clamp(0.8rem, 1.2vw, 0.95rem);">Période scolaire</span>
                        </div>
                        <div class="legend-item" data-type="Vacances scolaires" style="display: flex; align-items: center; margin-bottom: 10px; cursor: pointer; padding: 8px 12px; border-radius: 8px; transition: all 0.3s ease;">
                            <span style="display: inline-block; width: clamp(18px, 2vw, 24px); height: clamp(18px, 2vw, 24px); border-radius: 6px; background: #fd7e14; margin-right: 12px; flex-shrink: 0; box-shadow: 0 2px 8px rgba(253, 126, 20, 0.3);"></span>
                            <span style="color: #e4e4e4; font-size: clamp(0.8rem, 1.2vw, 0.95rem);">Vacances scolaires</span>
                        </div>
                        <div class="legend-item" data-type="Jours fériés" style="display: flex; align-items: center; margin-bottom: 10px; cursor: pointer; padding: 8px 12px; border-radius: 8px; transition: all 0.3s ease;">
                            <span style="display: inline-block; width: clamp(18px, 2vw, 24px); height: clamp(18px, 2vw, 24px); border-radius: 6px; background: #dc3545; margin-right: 12px; flex-shrink: 0; box-shadow: 0 2px 8px rgba(220, 53, 69, 0.3);"></span>
                            <span style="color: #e4e4e4; font-size: clamp(0.8rem, 1.2vw, 0.95rem);">Jours fériés</span>
                        </div>
                        <div class="legend-item" data-type="Événements" style="display: flex; align-items: center; margin-bottom: 10px; cursor: pointer; padding: 8px 12px; border-radius: 8px; transition: all 0.3s ease;">
                            <span style="display: inline-block; width: clamp(18px, 2vw, 24px); height: clamp(18px, 2vw, 24px); border-radius: 6px; background: #6f42c1; margin-right: 12px; flex-shrink: 0; box-shadow: 0 2px 8px rgba(111, 66, 193, 0.3);"></span>
                            <span style="color: #e4e4e4; font-size: clamp(0.8rem, 1.2vw, 0.95rem);">Événements</span>
                        </div>
                        <div class="legend-item" data-type="Examens trimestriels" style="display: flex; align-items: center; margin-bottom: 10px; cursor: pointer; padding: 8px 12px; border-radius: 8px; transition: all 0.3s ease;">
                            <span style="display: inline-block; width: clamp(18px, 2vw, 24px); height: clamp(18px, 2vw, 24px); border-radius: 6px; background: #ffc107; margin-right: 12px; flex-shrink: 0; box-shadow: 0 2px 8px rgba(255, 193, 7, 0.3);"></span>
                            <span style="color: #e4e4e4; font-size: clamp(0.8rem, 1.2vw, 0.95rem);">Examens trimestriels</span>
                        </div>
                        <hr style="border-color: rgba(255,255,255,0.1); margin: 20px 0;">
                        <div style="color: #888; font-size: clamp(0.75rem, 1vw, 0.85rem);">
                            <p style="margin: 8px 0; display: flex; align-items: center;">
                                <i data-feather="mouse-pointer" style="width: clamp(14px, 1.2vw, 16px); height: clamp(14px, 1.2vw, 16px); margin-right: 8px; flex-shrink: 0;"></i>
                                Cliquez sur une date pour ajouter
                            </p>
                            <p style="margin: 8px 0; display: flex; align-items: center;">
                                <i data-feather="edit-2" style="width: clamp(14px, 1.2vw, 16px); height: clamp(14px, 1.2vw, 16px); margin-right: 8px; flex-shrink: 0;"></i>
                                Cliquez sur un événement pour modifier
                            </p>
                            <p style="margin: 8px 0; display: flex; align-items: center;">
                                <i data-feather="filter" style="width: clamp(14px, 1.2vw, 16px); height: clamp(14px, 1.2vw, 16px); margin-right: 8px; flex-shrink: 0;"></i>
                                Filtrez par type ci-dessus
                            </p>
                        </div>
                    </div>
                </div>
                
                <!-- Calendrier -->
                <div class="col-lg-9 col-md-12" style="padding: 0; padding-left: 15px; overflow-x: auto;">
                    <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
                        <select class="form-select" id="typeFilter" style="width: clamp(180px, 30vw, 200px); background: rgba(255,255,255,0.1); color: white; border: 1px solid rgba(255,255,255,0.15); backdrop-filter: blur(10px); font-size: clamp(0.8rem, 1vw, 0.95rem);">
                            <option value="all" style="background:#1a1a2e;">📅 Tous les types</option>
                            <option value="Rentrée des classes" style="background:#1a1a2e;">🎓 Rentrée des classes</option>
                            <option value="Période scolaire" style="background:#1a1a2e;">📚 Période scolaire</option>
                            <option value="Vacances scolaires" style="background:#1a1a2e;">🏖️ Vacances scolaires</option>
                            <option value="Jours fériés" style="background:#1a1a2e;">🎉 Jours fériés</option>
                            <option value="Événements" style="background:#1a1a2e;">⭐ Événements</option>
                            <option value="Examens trimestriels" style="background:#1a1a2e;">📝 Examens trimestriels</option>
                        </select>
                    </div>
                    <div id="calendar" style="min-height: 400px; overflow-x: auto; -webkit-overflow-scrolling: touch;"></div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="eventModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content glass-modal" style="background: rgba(30,30,50,0.92); color: white; border-radius: 16px; backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.1); max-height: 90vh;">
            <div class="modal-header" style="border-bottom: 1px solid rgba(255,255,255,0.1); flex-wrap: wrap; gap: 8px;">
                <h5 class="modal-title" id="modalTitle" style="font-size: clamp(1rem, 1.5vw, 1.25rem);">
                    <i data-feather="plus-circle" style="width: 20px; height: 20px; margin-right: 8px;"></i>
                    Ajouter un événement
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding: clamp(16px, 2vw, 24px); overflow-y: auto;">
                <input type="hidden" id="eventId">
                
                <div class="mb-3">
                    <label class="form-label" style="font-weight: 500; font-size: clamp(0.9rem, 1.1vw, 1rem);">Titre *</label>
                    <input type="text" class="form-control" id="eventTitle" placeholder="Ex: Rentrée des classes" required style="background: rgba(255,255,255,0.08); color: white; border: 1px solid rgba(255,255,255,0.15); backdrop-filter: blur(10px); border-radius: 10px; padding: clamp(10px, 1.2vw, 12px); font-size: clamp(0.9rem, 1vw, 1rem);">
                </div>
                
                <div class="mb-4">
                    <label class="form-label" style="font-weight: 500; display: block; margin-bottom: 10px; font-size: clamp(0.9rem, 1.1vw, 1rem);">Type d'événement</label>
                    <div class="row" style="gap: 8px; margin: 0;">
                        <div class="col-6 col-md-4" style="padding: 0 4px; margin-bottom: 8px;">
                            <button type="button" class="btn btn-type w-100" data-type="Rentrée des classes" data-color="#198754" style="background: rgba(25, 135, 84, 0.2); border: 2px solid #198754; color: #fff; border-radius: 10px; padding: clamp(6px, 1vw, 10px) clamp(8px, 1.2vw, 12px); transition: all 0.3s ease; font-size: clamp(0.7rem, 0.9vw, 0.85rem); min-height: clamp(32px, 4vw, 44px);">
                                <span style="display: inline-block; width: clamp(8px, 1vw, 12px); height: clamp(8px, 1vw, 12px); border-radius: 3px; background: #198754; margin-right: 6px; flex-shrink: 0;"></span>
                                Rentrée
                            </button>
                        </div>
                        <div class="col-6 col-md-4" style="padding: 0 4px; margin-bottom: 8px;">
                            <button type="button" class="btn btn-type w-100" data-type="Période scolaire" data-color="#0d6efd" style="background: rgba(13, 110, 253, 0.2); border: 2px solid #0d6efd; color: #fff; border-radius: 10px; padding: clamp(6px, 1vw, 10px) clamp(8px, 1.2vw, 12px); transition: all 0.3s ease; font-size: clamp(0.7rem, 0.9vw, 0.85rem); min-height: clamp(32px, 4vw, 44px);">
                                <span style="display: inline-block; width: clamp(8px, 1vw, 12px); height: clamp(8px, 1vw, 12px); border-radius: 3px; background: #0d6efd; margin-right: 6px; flex-shrink: 0;"></span>
                                Période scolaire
                            </button>
                        </div>
                        <div class="col-6 col-md-4" style="padding: 0 4px; margin-bottom: 8px;">
                            <button type="button" class="btn btn-type w-100" data-type="Vacances scolaires" data-color="#fd7e14" style="background: rgba(253, 126, 20, 0.2); border: 2px solid #fd7e14; color: #fff; border-radius: 10px; padding: clamp(6px, 1vw, 10px) clamp(8px, 1.2vw, 12px); transition: all 0.3s ease; font-size: clamp(0.7rem, 0.9vw, 0.85rem); min-height: clamp(32px, 4vw, 44px);">
                                <span style="display: inline-block; width: clamp(8px, 1vw, 12px); height: clamp(8px, 1vw, 12px); border-radius: 3px; background: #fd7e14; margin-right: 6px; flex-shrink: 0;"></span>
                                Vacances
                            </button>
                        </div>
                        <div class="col-6 col-md-4" style="padding: 0 4px; margin-bottom: 8px;">
                            <button type="button" class="btn btn-type w-100" data-type="Jours fériés" data-color="#dc3545" style="background: rgba(220, 53, 69, 0.2); border: 2px solid #dc3545; color: #fff; border-radius: 10px; padding: clamp(6px, 1vw, 10px) clamp(8px, 1.2vw, 12px); transition: all 0.3s ease; font-size: clamp(0.7rem, 0.9vw, 0.85rem); min-height: clamp(32px, 4vw, 44px);">
                                <span style="display: inline-block; width: clamp(8px, 1vw, 12px); height: clamp(8px, 1vw, 12px); border-radius: 3px; background: #dc3545; margin-right: 6px; flex-shrink: 0;"></span>
                                Jours fériés
                            </button>
                        </div>
                        <div class="col-6 col-md-4" style="padding: 0 4px; margin-bottom: 8px;">
                            <button type="button" class="btn btn-type w-100" data-type="Événements" data-color="#6f42c1" style="background: rgba(111, 66, 193, 0.2); border: 2px solid #6f42c1; color: #fff; border-radius: 10px; padding: clamp(6px, 1vw, 10px) clamp(8px, 1.2vw, 12px); transition: all 0.3s ease; font-size: clamp(0.7rem, 0.9vw, 0.85rem); min-height: clamp(32px, 4vw, 44px);">
                                <span style="display: inline-block; width: clamp(8px, 1vw, 12px); height: clamp(8px, 1vw, 12px); border-radius: 3px; background: #6f42c1; margin-right: 6px; flex-shrink: 0;"></span>
                                Événements
                            </button>
                        </div>
                        <div class="col-6 col-md-4" style="padding: 0 4px; margin-bottom: 8px;">
                            <button type="button" class="btn btn-type w-100" data-type="Examens trimestriels" data-color="#ffc107" style="background: rgba(255, 193, 7, 0.2); border: 2px solid #ffc107; color: #fff; border-radius: 10px; padding: clamp(6px, 1vw, 10px) clamp(8px, 1.2vw, 12px); transition: all 0.3s ease; font-size: clamp(0.7rem, 0.9vw, 0.85rem); min-height: clamp(32px, 4vw, 44px);">
                                <span style="display: inline-block; width: clamp(8px, 1vw, 12px); height: clamp(8px, 1vw, 12px); border-radius: 3px; background: #ffc107; margin-right: 6px; flex-shrink: 0;"></span>
                                Examens
                            </button>
                        </div>
                    </div>
                    <input type="hidden" id="eventType" value="Période scolaire">
                    <input type="hidden" id="eventColor" value="#0d6efd">
                </div>
                
                <div class="mb-3">
                    <label class="form-label" style="font-weight: 500; font-size: clamp(0.9rem, 1.1vw, 1rem);">Description</label>
                    <textarea class="form-control" id="eventDesc" rows="2" placeholder="Description de l'événement..." style="background: rgba(255,255,255,0.08); color: white; border: 1px solid rgba(255,255,255,0.15); backdrop-filter: blur(10px); border-radius: 10px; padding: clamp(10px, 1.2vw, 12px); font-size: clamp(0.9rem, 1vw, 1rem);"></textarea>
                </div>
                
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label" style="font-weight: 500; font-size: clamp(0.9rem, 1.1vw, 1rem);">Date début *</label>
                        <input type="date" class="form-control" id="eventStart" required style="background: rgba(255,255,255,0.08); color: white; border: 1px solid rgba(255,255,255,0.15); backdrop-filter: blur(10px); border-radius: 10px; padding: clamp(10px, 1.2vw, 12px); font-size: clamp(0.9rem, 1vw, 1rem);">
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label" style="font-weight: 500; font-size: clamp(0.9rem, 1.1vw, 1rem);">Date fin *</label>
                        <input type="date" class="form-control" id="eventEnd" required style="background: rgba(255,255,255,0.08); color: white; border: 1px solid rgba(255,255,255,0.15); backdrop-filter: blur(10px); border-radius: 10px; padding: clamp(10px, 1.2vw, 12px); font-size: clamp(0.9rem, 1vw, 1rem);">
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid rgba(255,255,255,0.1); padding: clamp(12px, 1.5vw, 16px) clamp(16px, 2vw, 24px); flex-wrap: wrap; gap: 8px;">
                <button type="button" class="btn btn-danger me-auto" id="btnDelete" style="display:none; border-radius: 10px; padding: clamp(8px, 1vw, 10px) clamp(16px, 2vw, 24px); font-size: clamp(0.85rem, 1vw, 0.95rem);">
                    <i data-feather="trash-2" style="width: 16px; height: 16px; margin-right: 6px;"></i>
                    Supprimer
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius: 10px; padding: clamp(8px, 1vw, 10px) clamp(16px, 2vw, 24px); background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.15); font-size: clamp(0.85rem, 1vw, 0.95rem);">
                    Annuler
                </button>
                <button type="button" class="btn btn-primary" id="btnSave" style="border-radius: 10px; padding: clamp(8px, 1vw, 10px) clamp(20px, 2.5vw, 32px); font-size: clamp(0.85rem, 1vw, 0.95rem);">
                    <i data-feather="save" style="width: 16px; height: 16px; margin-right: 6px;"></i>
                    Enregistrer
                </button>
            </div>
        </div>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

<script>
    let calendar;
    let currentEventId = null;

    document.addEventListener('DOMContentLoaded', function() {
        if (typeof feather !== 'undefined') feather.replace();

        document.querySelectorAll('.btn-type').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.btn-type').forEach(b => {
                    b.style.background = b.dataset.color + '33';
                    b.style.borderColor = b.dataset.color;
                    b.style.boxShadow = 'none';
                });
                this.style.background = this.dataset.color + '66';
                this.style.borderColor = this.dataset.color;
                this.style.boxShadow = '0 0 20px ' + this.dataset.color + '44';
                document.getElementById('eventType').value = this.dataset.type;
                document.getElementById('eventColor').value = this.dataset.color;
            });
        });

        document.querySelectorAll('.legend-item').forEach(item => {
            item.addEventListener('mouseenter', function() {
                this.style.background = 'rgba(255,255,255,0.08)';
                this.style.transform = 'translateX(5px)';
            });
            item.addEventListener('mouseleave', function() {
                this.style.background = 'transparent';
                this.style.transform = 'translateX(0)';
            });
            item.addEventListener('click', function() {
                document.getElementById('typeFilter').value = this.dataset.type;
                calendar.refetchEvents();
            });
        });

        var calendarEl = document.getElementById('calendar');
        calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            locale: 'fr',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,listMonth'
            },
            buttonText: { today: 'Aujourd\'hui', month: 'Mois', week: 'Semaine', list: 'Liste' },
            editable: true,
            selectable: true,
            displayEventTime: false,
            events: function(fetchInfo, successCallback, failureCallback) {
                const type = document.getElementById('typeFilter').value;
                let url = '/api/calendar/events';
                if (type !== 'all') url += '?type=' + encodeURIComponent(type);
                fetch(url)
                    .then(r => r.json())
                    .then(data => {
                        if (calendar.view.type === 'listMonth') {
                            data = groupMultiDayEvents(data);
                        }
                        successCallback(data);
                    })
                    .catch(err => failureCallback(err));
            },
            eventClick: function(info) { openEditModal(info.event); },
            select: function(info) {
                clearForm();
                document.getElementById('eventStart').value = info.startStr;
                document.getElementById('eventEnd').value = info.endStr || info.startStr;
                new bootstrap.Modal(document.getElementById('eventModal')).show();
            },
            eventDrop: function(info) { updateEvent(info.event); },
            eventResize: function(info) { updateEvent(info.event); },
            eventDidMount: function(info) {
                const type = info.event.extendedProps.type || '';
                info.el.style.fontSize = 'clamp(0.6rem, 0.9vw, 0.75rem)';
                info.el.style.padding = 'clamp(2px, 0.4vw, 5px) clamp(4px, 0.6vw, 8px)';
                info.el.style.margin = '1px 0';
                info.el.style.borderRadius = '4px';
                info.el.style.border = 'none';
                info.el.style.color = '#fff';
                info.el.style.fontWeight = '500';
                info.el.style.boxShadow = '0 1px 4px rgba(0,0,0,0.2)';
                info.el.style.minHeight = 'clamp(14px, 2vw, 18px)';
                info.el.style.display = 'flex';
                info.el.style.alignItems = 'center';
                info.el.style.overflow = 'hidden';
                info.el.style.textOverflow = 'ellipsis';
                info.el.style.whiteSpace = 'nowrap';
                info.el.style.position = 'relative';
                info.el.style.width = '100%';
                info.el.style.cursor = 'pointer';

                const typeIndicator = document.createElement('span');
                typeIndicator.style.display = 'inline-block';
                typeIndicator.style.width = 'clamp(4px, 0.6vw, 6px)';
                typeIndicator.style.height = 'clamp(4px, 0.6vw, 6px)';
                typeIndicator.style.borderRadius = '50%';
                typeIndicator.style.marginRight = '4px';
                typeIndicator.style.flexShrink = '0';
                const colors = {
                    'Rentrée des classes': '#198754',
                    'Période scolaire': '#0d6efd',
                    'Vacances scolaires': '#fd7e14',
                    'Jours fériés': '#dc3545',
                    'Événements': '#6f42c1',
                    'Examens trimestriels': '#ffc107'
                };
                typeIndicator.style.backgroundColor = colors[type] || '#0d6efd';
                info.el.prepend(typeIndicator);

                if (!info.event.backgroundColor) {
                    info.el.style.backgroundColor = colors[type] || '#0d6efd';
                }

                if (calendar.view.type === 'timeGridWeek') {
                    info.el.style.justifyContent = 'center';
                    info.el.style.textAlign = 'center';
                    info.el.style.whiteSpace = 'normal';
                    info.el.style.fontSize = 'clamp(0.55rem, 0.7vw, 0.65rem)';
                    info.el.style.padding = 'clamp(1px, 0.3vw, 3px) clamp(2px, 0.4vw, 4px)';
                    info.el.style.minHeight = 'clamp(12px, 1.5vw, 16px)';
                }

                const start = info.event.start;
                const end = info.event.end;
                if (end && (end - start) > 86400000) {
                    info.el.style.borderLeft = '3px solid ' + (info.event.backgroundColor || '#0d6efd');
                    info.el.style.borderRadius = '0 4px 4px 0';
                    info.el.style.paddingLeft = '6px';
                }

                const dayCell = info.el.closest('.fc-daygrid-day');
                if (dayCell) {
                    const eventsInDay = dayCell.querySelectorAll('.fc-daygrid-event');
                    if (eventsInDay.length > 3) {
                        info.el.style.fontSize = 'clamp(0.5rem, 0.7vw, 0.65rem)';
                        info.el.style.padding = 'clamp(1px, 0.3vw, 3px) clamp(2px, 0.4vw, 4px)';
                        info.el.style.minHeight = 'clamp(10px, 1.2vw, 14px)';
                    }
                    if (eventsInDay.length > 5) {
                        info.el.style.fontSize = 'clamp(0.45rem, 0.6vw, 0.6rem)';
                        info.el.style.padding = 'clamp(1px, 0.2vw, 2px) clamp(2px, 0.3vw, 3px)';
                        info.el.style.minHeight = 'clamp(8px, 1vw, 12px)';
                    }
                }
            },
            eventOrder: function(a, b) {
                return 0;
            },
            dayMaxEvents: 6,
            moreLinkText: function(num) {
                return '+' + num + ' autre' + (num > 1 ? 's' : '');
            },
            moreLinkClick: function(info) {
                // Permet d'afficher tous les événements d'un jour dans une popup
            },
            // Configuration responsive
            views: {
                dayGridMonth: {
                    titleFormat: { year: 'numeric', month: 'long' },
                    dayHeaderFormat: { weekday: 'short' },
                    dayCellContent: function(info) {
                        return info.dayNumberText.replace('日', '');
                    }
                },
                timeGridWeek: {
                    titleFormat: { year: 'numeric', month: 'short', day: 'numeric' }
                },
                listMonth: {
                    titleFormat: { year: 'numeric', month: 'long' }
                }
            },
            // Gestion du responsive pour les événements
            handleWindowResize: true,
            windowResize: function(view) {
                // Ajustement automatique
            }
        });
        calendar.render();

        // Forcer le re-render après le chargement pour un meilleur affichage
        setTimeout(function() {
            calendar.refetchEvents();
        }, 100);

        document.getElementById('typeFilter').addEventListener('change', function() {
            calendar.refetchEvents();
        });

        document.getElementById('btnSave').addEventListener('click', saveEvent);

        document.getElementById('btnDelete').addEventListener('click', function() {
            if (!currentEventId || !confirm('Supprimer cet événement ?')) return;
            fetch('/api/calendar/events/' + currentEventId, { method: 'DELETE' })
                .then(function() {
                    calendar.refetchEvents();
                    bootstrap.Modal.getInstance(document.getElementById('eventModal')).hide();
                });
        });
    });

    function groupMultiDayEvents(events) {
        const grouped = [];
        const processed = new Set();
        events.forEach(event => {
            if (processed.has(event.id)) return;
            const start = new Date(event.start);
            const end = new Date(event.end);
            const diffDays = Math.ceil((end - start) / (1000 * 60 * 60 * 24));
            if (diffDays > 1) {
                const groupEvents = events.filter(e => e.title === event.title && e.extendedProps.type === event.extendedProps.type && !processed.has(e.id));
                let minStart = start;
                let maxEnd = end;
                groupEvents.forEach(e => {
                    processed.add(e.id);
                    const eStart = new Date(e.start);
                    const eEnd = new Date(e.end);
                    if (eStart < minStart) minStart = eStart;
                    if (eEnd > maxEnd) maxEnd = eEnd;
                });
                grouped.push({...event, title: event.title, start: minStart.toISOString().split('T')[0], end: maxEnd.toISOString().split('T')[0]});
            } else {
                processed.add(event.id);
                grouped.push(event);
            }
        });
        return grouped;
    }

    function clearForm() {
        currentEventId = null;
        document.getElementById('eventId').value = '';
        document.getElementById('eventTitle').value = '';
        document.getElementById('eventType').value = 'Période scolaire';
        document.getElementById('eventColor').value = '#0d6efd';
        document.getElementById('eventDesc').value = '';
        document.getElementById('eventStart').value = '';
        document.getElementById('eventEnd').value = '';
        document.getElementById('btnDelete').style.display = 'none';
        document.getElementById('modalTitle').innerHTML = '<i data-feather="plus-circle" style="width:20px;height:20px;margin-right:8px;"></i> Ajouter un événement';
        document.querySelectorAll('.btn-type').forEach(b => {
            b.style.background = b.dataset.color + '33';
            b.style.borderColor = b.dataset.color;
            b.style.boxShadow = 'none';
            if (b.dataset.type === 'Période scolaire') {
                b.style.background = b.dataset.color + '66';
                b.style.boxShadow = '0 0 20px ' + b.dataset.color + '44';
            }
        });
        if (typeof feather !== 'undefined') feather.replace();
    }

    function openEditModal(event) {
        currentEventId = event.id;
        document.getElementById('eventId').value = event.id;
        document.getElementById('eventTitle').value = event.title;
        document.getElementById('eventType').value = event.extendedProps.type || 'Période scolaire';
        document.getElementById('eventColor').value = event.backgroundColor || '#0d6efd';
        document.getElementById('eventDesc').value = event.extendedProps.description || '';
        document.getElementById('eventStart').value = event.startStr;
        document.getElementById('eventEnd').value = event.endStr || event.startStr;
        document.getElementById('btnDelete').style.display = 'block';
        document.getElementById('modalTitle').innerHTML = '<i data-feather="edit-2" style="width:20px;height:20px;margin-right:8px;"></i> Modifier l\'événement';
        const type = event.extendedProps.type || 'Période scolaire';
        document.querySelectorAll('.btn-type').forEach(b => {
            b.style.background = b.dataset.color + '33';
            b.style.borderColor = b.dataset.color;
            b.style.boxShadow = 'none';
            if (b.dataset.type === type) {
                b.style.background = b.dataset.color + '66';
                b.style.boxShadow = '0 0 20px ' + b.dataset.color + '44';
            }
        });
        new bootstrap.Modal(document.getElementById('eventModal')).show();
        if (typeof feather !== 'undefined') feather.replace();
    }

    function saveEvent() {
        var title = document.getElementById('eventTitle').value.trim();
        var start = document.getElementById('eventStart').value;
        var end = document.getElementById('eventEnd').value;
        var type = document.getElementById('eventType').value;
        if (!title || !start || !end) return alert('Titre et dates requis.');
        if (type === 'Période scolaire') {
            var startDate = new Date(start + 'T00:00:00');
            var endDate = new Date(end + 'T00:00:00');
            if (startDate.getDay() === 6) startDate.setDate(startDate.getDate() + 2);
            if (startDate.getDay() === 0) startDate.setDate(startDate.getDate() + 1);
            if (endDate.getDay() === 6) endDate.setDate(endDate.getDate() - 1);
            if (endDate.getDay() === 0) endDate.setDate(endDate.getDate() - 2);
            start = startDate.toISOString().split('T')[0];
            end = endDate.toISOString().split('T')[0];
        }
        var data = {
            title: title,
            event_type: type,
            description: document.getElementById('eventDesc').value.trim(),
            start_date: start,
            end_date: end,
            color: document.getElementById('eventColor').value
        };
        var url = '/api/calendar/events';
        var method = 'POST';
        if (currentEventId) { url += '/' + currentEventId; method = 'PUT'; }
        fetch(url, { method: method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
            .then(function(r) { return r.json(); })
            .then(function() { calendar.refetchEvents(); bootstrap.Modal.getInstance(document.getElementById('eventModal')).hide(); })
            .catch(function(err) { alert('Erreur: ' + err.message); });
    }

    function updateEvent(event) {
        fetch('/api/calendar/events/' + event.id, {
            method: 'PUT', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ title: event.title, start_date: event.startStr, end_date: event.endStr || event.startStr, event_type: event.extendedProps.type || 'Période scolaire', description: event.extendedProps.description || '', color: event.backgroundColor })
        });
    }
</script>

