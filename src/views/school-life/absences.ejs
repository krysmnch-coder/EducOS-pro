<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container py-4">
    <h2>Gestion des Absences & Retards</h2>
    <p>Page chargée avec succès.</p>
    <button class="btn btn-primary" id="testBtn">Tester</button>
    <div id="result"></div>
</div>

<script>
    document.getElementById('testBtn').addEventListener('click', function() {
        fetch('/api/all-classes')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                document.getElementById('result').innerHTML = 'Classes trouvées : ' + data.length;
            })
            .catch(function(err) {
                document.getElementById('result').innerHTML = 'Erreur : ' + err.message;
            });
    });
</script>

