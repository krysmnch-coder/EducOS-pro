<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container-fluid page-shell py-4">
    <div class="themed-container" style="max-width: 100%; padding: 0 20px;">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Gestion des Absences & Retards</h2>
            <button class="btn btn-primary" id="btnAddAbsence">
                Signaler une absence/retard
            </button>
        </div>

        <%- include('../partials/messages') %>

        <!-- Message de succès -->
        <div id="successMessage" class="alert alert-success" style="display:none; position:fixed; top:80px; left:20px; z-index:9999; min-width:300px; border-radius:10px; box-shadow:0 8px 25px rgba(0,0,0,0.3);">
            <span id="successText"></span>
        </div>

        <!-- Filtres -->
        <div class="card glass-card mb-4" style="border-radius: 16px; padding: 20px;">
            <div class="row align-items-end">
                <div class="col-md-2">
                    <label class="form-label">Type</label>
                    <select class="form-select" id="filterType">
                        <option value="student">Élèves</option>
                        <option value="professor">Professeurs</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Classe</label>
                    <select class="form-select" id="filterClass">
                        <option value="">Toutes</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Statut</label>
                    <select class="form-select" id="filterStatus">
                        <option value="">Tous</option>
                        <option value="non_justifiee">Non justifiée</option>
                        <option value="justifiee">Justifiée</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Date début</label>
                    <input type="date" class="form-control" id="filterDateDebut">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Date fin</label>
                    <input type="date" class="form-control" id="filterDateFin">
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" id="btnFilter" style="height:42px;">Filtrer</button>
                </div>
            </div>
        </div>

        <!-- Tableau -->
        <div class="card glass-card" style="border-radius: 16px; padding: 20px;">
            <div class="table-responsive">
                <table class="table table-hover" id="absencesTable">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Nom</th>
                            <th>Classe</th>
                            <th>Type</th>
                            <th>Heure arrivée</th>
                            <th>Justifié</th>
                            <th>Motif</th>
                            <th style="width:110px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="absencesBody">
                        <tr><td colspan="8" class="text-center py-4">Chargement...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<!-- Modal Ajouter -->
<div class="modal fade" id="absenceModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Signaler une absence/retard</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Type de personne</label>
                    <select class="form-select" id="absenceUserType">
                        <option value="student">Élève</option>
                        <option value="professor">Professeur</option>
                    </select>
                </div>
                <div id="classSelectDiv">
                    <label class="form-label">Classe</label>
                    <div class="row mb-3">
                        <div class="col-5">
                            <select class="form-select" id="modalClassLevel">
                                <option value="">-- Niveau --</option>
                                <option value="Terminale">Terminale</option><option value="Première">Première</option><option value="Seconde">Seconde</option>
                                <option value="3ème">3ème</option><option value="4ème">4ème</option><option value="5ème">5ème</option><option value="6ème">6ème</option>
                                <option value="CM2">CM2</option><option value="CM1">CM1</option><option value="CE2">CE2</option><option value="CE1">CE1</option><option value="CP">CP</option>
                                <option value="Grande Section">Grande Section</option><option value="Moyenne Section">Moyenne Section</option><option value="Petite Section">Petite Section</option><option value="Toute Petite Section">Toute Petite Section</option>
                            </select>
                        </div>
                        <div class="col-2">
                            <select class="form-select" id="modalClassLetter"><option value="">-</option></select>
                        </div>
                        <div class="col-2">
                            <select class="form-select" id="modalClassNumber"><option value="">-</option></select>
                        </div>
                        <div class="col-3">
                            <button class="btn btn-outline-secondary w-100" id="btnLoadStudents">Charger</button>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Personne *</label>
                    <select class="form-select" id="absenceUser" required>
                        <option value="">-- Sélectionnez --</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Type *</label>
                    <select class="form-select" id="absenceType">
                        <option value="absence">Absence</option>
                        <option value="retard">Retard</option>
                    </select>
                </div>
                <div class="mb-3" id="heureArriveeDiv" style="display:none;">
                    <label class="form-label">Heure d'arrivée</label>
                    <input type="time" class="form-control" id="absenceHeure">
                </div>
                <div class="mb-3">
                    <label class="form-label">Date *</label>
                    <input type="date" class="form-control" id="absenceDate" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Motif</label>
                    <input type="text" class="form-control" id="absenceMotif" placeholder="Maladie, rendez-vous...">
                </div>
                <div class="mb-3">
                    <label class="form-label">Commentaire</label>
                    <textarea class="form-control" id="absenceCommentaire" rows="2"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Justifié</label>
                    <select class="form-select" id="absenceJustified">
                        <option value="non_justifiee">Non justifiée</option>
                        <option value="justifiee">Justifiée</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary" id="btnSaveAbsence">Enregistrer</button>
            </div>
        </div>
    </div>
</div>

<script>
    if (typeof feather !== 'undefined') feather.replace();

    var today = new Date().toISOString().split('T')[0];
    document.getElementById('absenceDate').value = today;
    document.getElementById('filterDateDebut').value = today;

    // Initialiser lettres et N°
    var letterSel = document.getElementById('modalClassLetter');
    var numberSel = document.getElementById('modalClassNumber');
    for (var i = 0; i < 26; i++) {
        var opt = document.createElement('option');
        opt.value = String.fromCharCode(65 + i); opt.textContent = String.fromCharCode(65 + i); letterSel.appendChild(opt);
    }
    for (var j = 1; j <= 20; j++) {
        var opt2 = document.createElement('option');
        opt2.value = j; opt2.textContent = j; numberSel.appendChild(opt2);
    }

    // Message de succès
    function showSuccess(msg) {
        var el = document.getElementById('successMessage');
        var txt = document.getElementById('successText');
        if (!el || !txt) return;
        txt.textContent = msg;
        el.style.display = 'block';
        setTimeout(function() { el.style.display = 'none'; }, 3000);
    }

    // Charger classes filtre
    function loadFilterClasses() {
        var xhr = new XMLHttpRequest();
        xhr.open('GET', '/api/all-classes');
        xhr.onload = function() {
            if (xhr.status === 200) {
                try {
                    var data = JSON.parse(xhr.responseText);
                    var sel = document.getElementById('filterClass');
                    if (data && Array.isArray(data)) {
                        for (var i = 0; i < data.length; i++) {
                            var opt = document.createElement('option');
                            opt.value = data[i]; opt.textContent = data[i]; sel.appendChild(opt);
                        }
                    }
                } catch(e) {}
            }
        };
        xhr.send();
    }
    loadFilterClasses();

    // Type personne
    document.getElementById('absenceUserType').addEventListener('change', function() {
        document.getElementById('classSelectDiv').style.display = (this.value === 'student') ? 'block' : 'none';
        if (this.value === 'professor') {
            var xhr = new XMLHttpRequest();
            xhr.open('GET', '/api/professors-list');
            xhr.onload = function() {
                if (xhr.status === 200) {
                    try {
                        var data = JSON.parse(xhr.responseText);
                        var sel = document.getElementById('absenceUser');
                        sel.innerHTML = '<option value="">-- Choisir --</option>';
                        if (data && Array.isArray(data)) {
                            for (var i = 0; i < data.length; i++) {
                                var opt = document.createElement('option');
                                opt.value = data[i].id; opt.textContent = data[i].name; sel.appendChild(opt);
                            }
                        }
                    } catch(e) {}
                }
            };
            xhr.send();
        }
    });

    // Type absence/retard
    document.getElementById('absenceType').addEventListener('change', function() {
        document.getElementById('heureArriveeDiv').style.display = (this.value === 'retard') ? 'block' : 'none';
    });

    // Charger élèves
    document.getElementById('btnLoadStudents').addEventListener('click', function() {
        var level = document.getElementById('modalClassLevel').value;
        if (!level) { alert('Sélectionnez un niveau'); return; }
        var letter = document.getElementById('modalClassLetter').value;
        var number = document.getElementById('modalClassNumber').value;
        var cn = level + (letter ? ' ' + letter : '') + (number ? ' ' + number : '');
        var xhr = new XMLHttpRequest();
        xhr.open('GET', '/api/students-by-class/' + encodeURIComponent(cn.trim()));
        xhr.onload = function() {
            if (xhr.status === 200) {
                try {
                    var data = JSON.parse(xhr.responseText);
                    var sel = document.getElementById('absenceUser');
                    sel.innerHTML = '<option value="">-- Choisir --</option>';
                    if (data && Array.isArray(data)) {
                        for (var i = 0; i < data.length; i++) {
                            var opt = document.createElement('option');
                            opt.value = data[i].id;
                            opt.textContent = data[i].name + ' (' + (data[i].matricule || 'N/A') + ')';
                            sel.appendChild(opt);
                        }
                    }
                } catch(e) {}
            }
        };
        xhr.send();
    });

    // FILTRER
    document.getElementById('btnFilter').addEventListener('click', loadAbsences);

    function loadAbsences() {
        var type = document.getElementById('filterType').value;
        var cls = document.getElementById('filterClass').value;
        var st = document.getElementById('filterStatus').value;
        var d1 = document.getElementById('filterDateDebut').value;
        var d2 = document.getElementById('filterDateFin').value;
        
        var url = '/api/absences?user_type=' + type;
        if (cls && cls !== '') url += '&class_name=' + encodeURIComponent(cls);
        if (st && st !== '') url += '&status=' + encodeURIComponent(st);
        if (d1 && d1 !== '') url += '&date_debut=' + d1;
        if (d2 && d2 !== '') url += '&date_fin=' + d2;

        console.log('🔍 Chargement:', url);

        var xhr = new XMLHttpRequest();
        xhr.open('GET', url);
        xhr.onload = function() {
            var tbody = document.getElementById('absencesBody');
            if (xhr.status === 200) {
                try {
                    var data = JSON.parse(xhr.responseText);
                    console.log('📊 Résultats:', Array.isArray(data) ? data.length : 0, 'entrées');
                    tbody.innerHTML = '';

                    if (!data || !Array.isArray(data) || data.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4">Aucun résultat</td></tr>';
                        return;
                    }

                    for (var i = 0; i < data.length; i++) {
                        var a = data[i];
                        var typeLabel = (a.type === 'absence') ? 'Absence' : 'Retard';
                        var typeColor = (a.type === 'absence') ? '#dc3545' : '#fd7e14';
                        var heureArrivee = (a.type === 'retard' && a.heure_arrivee) ? a.heure_arrivee.substring(0, 5) : '-';
                        var justifiedChecked = (a.status === 'justifiee') ? 'checked' : '';
                        var statusLabel = (a.status === 'justifiee') ? 'Justifiée' : 'Non justifiée';
                        var displayDate = a.date ? a.date.split('T')[0].split('-').reverse().join('/') : '-';
                        var tr = document.createElement('tr');
                        tr.innerHTML =
                            '<td>' + displayDate + '</td>' +
                            '<td>' + (a.user_name || '-') + '</td>' +
                            '<td>' + (a.student_class || '-') + '</td>' +
                            '<td><span class="badge" style="background:' + typeColor + '">' + typeLabel + '</span></td>' +
                            '<td>' + heureArrivee + '</td>' +
                            '<td><label style="cursor:pointer;display:flex;align-items:center;gap:6px;"><input type="checkbox" ' + justifiedChecked + ' onchange="toggleJustify(' + a.id + ', this.checked)"><span style="font-size:0.75rem;">' + statusLabel + '</span></label></td>' +
                            '<td>' + (a.motif || '-') + '</td>' +
                            '<td><button class="btn btn-sm btn-outline-danger" onclick="deleteAbsence(' + a.id + ')">Supprimer</button></td>';
                        tbody.appendChild(tr);
                    }
                } catch(e) {
                    console.error('Erreur parsing:', e);
                    tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-danger">Erreur de chargement</td></tr>';
                }
            } else {
                console.error('API error', xhr.status, xhr.responseText);
                tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-danger">Erreur API ' + xhr.status + (xhr.responseText ? (': ' + xhr.responseText) : '') + '</td></tr>';
            }
        };
        xhr.onerror = function() { console.error('Erreur réseau'); var tbody = document.getElementById('absencesBody'); tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-danger">Erreur réseau</td></tr>'; };
        xhr.send();
    }

    // Cocher justifié
    function toggleJustify(id, checked) {
        var xhr = new XMLHttpRequest();
        xhr.open('PUT', '/api/absences/' + id);
        xhr.setRequestHeader('Content-Type', 'application/json');
        xhr.onload = function() {
            if (xhr.status === 200) {
                try {
                    var result = JSON.parse(xhr.responseText);
                    if (result.success) {
                        showSuccess(checked ? 'Absence/retard justifié(e)' : 'Absence/retard non justifié(e)');
                        loadAbsences();
                    }
                } catch(e) {}
            }
        };
        xhr.send(JSON.stringify({ status: checked ? 'justifiee' : 'non_justifiee', motif: '', commentaire: '' }));
    }

    // Ajouter
    document.getElementById('btnAddAbsence').addEventListener('click', function() {
        document.getElementById('absenceUserType').value = 'student';
        document.getElementById('classSelectDiv').style.display = 'block';
        document.getElementById('absenceUser').innerHTML = '<option value="">-- Sélectionnez --</option>';
        document.getElementById('absenceType').value = 'absence';
        document.getElementById('heureArriveeDiv').style.display = 'none';
        document.getElementById('absenceMotif').value = '';
        document.getElementById('absenceCommentaire').value = '';
        document.getElementById('absenceJustified').value = 'non_justifiee';
        var modal = new bootstrap.Modal(document.getElementById('absenceModal'));
        modal.show();
    });

    // Enregistrer
    document.getElementById('btnSaveAbsence').addEventListener('click', function() {
        var uid = document.getElementById('absenceUser').value;
        if (!uid) { alert('Sélectionnez une personne'); return; }
        
        var type = document.getElementById('absenceType').value;
        var dateVal = document.getElementById('absenceDate').value;
        var data = {
            user_id: parseInt(uid),
            user_type: document.getElementById('absenceUserType').value,
            type: type,
            date: dateVal,
            heure_arrivee: null,
            motif: document.getElementById('absenceMotif').value.trim(),
            commentaire: document.getElementById('absenceCommentaire').value.trim(),
            status: document.getElementById('absenceJustified').value
        };
        if (type === 'retard') data.heure_arrivee = document.getElementById('absenceHeure').value;

        console.log('📤 Envoi:', JSON.stringify(data));

        var xhr = new XMLHttpRequest();
        xhr.open('POST', '/api/absences');
        xhr.setRequestHeader('Content-Type', 'application/json');
        xhr.onload = function() {
            console.log('📥 Réponse:', xhr.status, xhr.responseText);
            if (xhr.status >= 200 && xhr.status < 300) {
                try {
                    var result = JSON.parse(xhr.responseText);
                    if (result.success) {
                        bootstrap.Modal.getInstance(document.getElementById('absenceModal')).hide();
                        showSuccess(type === 'absence' ? 'Absence enregistrée' : 'Retard enregistré');
                        
                        // Mettre à jour les filtres pour voir l'entrée
                        document.getElementById('filterDateDebut').value = dateVal;
                        document.getElementById('filterDateFin').value = '';
                        document.getElementById('filterStatus').value = '';
                        
                        loadAbsences();
                    } else {
                        alert('Erreur: ' + (result.error || 'Inconnue'));
                    }
                } catch(e) {
                    bootstrap.Modal.getInstance(document.getElementById('absenceModal')).hide();
                    showSuccess('Enregistré');
                    document.getElementById('filterDateDebut').value = dateVal;
                    loadAbsences();
                }
            } else {
                alert('Erreur serveur (code ' + xhr.status + ')');
            }
        };
        xhr.onerror = function() { alert('Erreur réseau'); };
        xhr.send(JSON.stringify(data));
    });

    // Supprimer
    function deleteAbsence(id) {
        if (!confirm('Supprimer cette entrée ?')) return;
        var xhr = new XMLHttpRequest();
        xhr.open('DELETE', '/api/absences/' + id);
        xhr.onload = function() { showSuccess('Entrée supprimée'); loadAbsences(); };
        xhr.send();
    }

    // Charger au démarrage
    function loadAbsences() {
    var type = document.getElementById('filterType').value;
    var cls = document.getElementById('filterClass').value;
    var st = document.getElementById('filterStatus').value;
    var d1 = document.getElementById('filterDateDebut').value;
    var d2 = document.getElementById('filterDateFin').value;
    
    var url = '/api/absences?user_type=' + type;
    if (cls && cls !== '') url += '&class_name=' + encodeURIComponent(cls);
    if (st && st !== '') url += '&status=' + st;
    if (d1 && d1 !== '') url += '&date_debut=' + d1;
    if (d2 && d2 !== '') url += '&date_fin=' + d2;

    console.log('🔍 Filtrage:', url);

    var xhr = new XMLHttpRequest();
    xhr.open('GET', url);
    xhr.onload = function() {
        var tbody = document.getElementById('absencesBody');
        if (xhr.status === 200) {
            try {
                var data = JSON.parse(xhr.responseText);
                console.log('📊 Résultats:', Array.isArray(data) ? data.length : 0);
                tbody.innerHTML = '';

                if (!data || !Array.isArray(data) || data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4">Aucun résultat</td></tr>';
                    return;
                }

                for (var i = 0; i < data.length; i++) {
                    var a = data[i];
                    var typeLabel = (a.type === 'absence') ? 'Absence' : 'Retard';
                    var typeColor = (a.type === 'absence') ? '#dc3545' : '#fd7e14';
                    var heureArrivee = (a.type === 'retard' && a.heure_arrivee) ? a.heure_arrivee.substring(0, 5) : '-';
                    var justifiedChecked = (a.status === 'justifiee') ? 'checked' : '';
                    var statusLabel = (a.status === 'justifiee') ? 'Justifiée' : 'Non justifiée';
                    var displayDate = a.date ? a.date.split('T')[0].split('-').reverse().join('/') : '-';

                    var tr = document.createElement('tr');
                    tr.innerHTML =
                        '<td>' + displayDate + '</td>' +
                        '<td>' + (a.user_name || '-') + '</td>' +
                        '<td>' + (a.student_class || '-') + '</td>' +
                        '<td><span class="badge" style="background:' + typeColor + '">' + typeLabel + '</span></td>' +
                        '<td>' + heureArrivee + '</td>' +
                        '<td><label style="cursor:pointer;"><input type="checkbox" ' + justifiedChecked + ' onchange="toggleJustify(' + a.id + ', this.checked)"> ' + statusLabel + '</label></td>' +
                        '<td>' + (a.motif || '-') + '</td>' +
                        '<td><button class="btn btn-sm btn-outline-danger" onclick="deleteAbsence(' + a.id + ')">Supprimer</button></td>';
                    tbody.appendChild(tr);
                }
            } catch(e) {
                console.error('Erreur parsing:', e);
                tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-danger">Erreur</td></tr>';
            }
        } else {
            tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-danger">Erreur ' + xhr.status + '</td></tr>';
        }
    };
    xhr.onerror = function() {
        document.getElementById('absencesBody').innerHTML = '<tr><td colspan="8" class="text-center py-4 text-danger">Erreur réseau</td></tr>';
    };
    xhr.send();
};
</script>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
    }
    [data-theme="dark"] .glass-card {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }
    #absencesTable { color: inherit; }
    #absencesTable td { border-color: rgba(128,128,128,0.15); vertical-align: middle; }
    #absencesTable tr:hover { background: rgba(128,128,128,0.05); }
    #absencesTable th { border-color: rgba(128,128,128,0.2); font-weight: 600; }
    .modal-content {
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid rgba(0, 0, 0, 0.1);
    }
    [data-theme="dark"] .modal-content {
        background: rgba(30, 30, 50, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #e4e4e4;
    }
    [data-theme="dark"] .modal-header { border-bottom-color: rgba(255,255,255,0.1); }
    [data-theme="dark"] .modal-footer { border-top-color: rgba(255,255,255,0.1); }
    [data-theme="dark"] .btn-close { filter: invert(1); }
    .form-select, .form-control { background: rgba(128,128,128,0.08); border: 1px solid rgba(128,128,128,0.2); color: inherit; }
    [data-theme="dark"] .form-select, [data-theme="dark"] .form-control { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15); color: #e4e4e4; }
    [data-theme="dark"] .form-select option, [data-theme="dark"] .form-control option { background: #1a1a2e; color: #e4e4e4; }
</style>

<%- include('../partials/footer') %>