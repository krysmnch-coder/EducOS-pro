<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container-fluid page-shell py-4">
    <div class="themed-container" style="max-width: 100%; padding: 0 20px;">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i data-feather="user-x"></i> Gestion des Absences & Retards</h2>
            <button class="btn btn-primary" id="btnAddAbsence">
                <i data-feather="plus"></i> Signaler une absence/retard
            </button>
        </div>

        <%- include('../partials/messages') %>

        <!-- Message de succès -->
        <div id="successMessage" class="alert alert-success" style="display:none; position:fixed; top:80px; right:20px; z-index:9999; min-width:300px; border-radius:10px; box-shadow:0 8px 25px rgba(0,0,0,0.3);">
            <span id="successText"></span>
        </div>

        <!-- Filtres -->
        <div class="card glass-card mb-4" style="border-radius: 16px; padding: 20px;">
            <div class="row align-items-end">
                <div class="col-md-2">
                    <label class="form-label" style="color:#fff;">Type</label>
                    <select class="form-select" id="filterType" style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);">
                        <option value="student">👨‍🎓 Élèves</option>
                        <option value="professor">👨‍🏫 Professeurs</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" style="color:#fff;">Classe</label>
                    <select class="form-select" id="filterClass" style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);">
                        <option value="">Toutes</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" style="color:#fff;">Statut</label>
                    <select class="form-select" id="filterStatus" style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);">
                        <option value="">Tous</option>
                        <option value="non_justifiee">Non justifiée</option>
                        <option value="justifiee">Justifiée</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" style="color:#fff;">Date début</label>
                    <input type="date" class="form-control" id="filterDateDebut" style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);">
                </div>
                <div class="col-md-2">
                    <label class="form-label" style="color:#fff;">Date fin</label>
                    <input type="date" class="form-control" id="filterDateFin" style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);">
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" id="btnFilter" style="height:42px;">
                        <i data-feather="search"></i> Filtrer
                    </button>
                </div>
            </div>
        </div>

        <!-- Tableau -->
        <div class="card glass-card" style="border-radius: 16px; padding: 20px;">
            <div class="table-responsive">
                <table class="table table-hover" id="absencesTable">
                    <thead>
                        <tr style="background:rgba(13,110,253,0.1);">
                            <th style="color:#fff;">Date</th>
                            <th style="color:#fff;">Nom</th>
                            <th style="color:#fff;">Classe</th>
                            <th style="color:#fff;">Type</th>
                            <th style="color:#fff;">Heure arrivée</th>
                            <th style="color:#fff;">Justifié</th>
                            <th style="color:#fff;">Motif</th>
                            <th style="color:#fff;width:100px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="absencesBody">
                        <tr><td colspan="8" class="text-center text-muted py-4">Cliquez sur Filtrer pour afficher</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<!-- Modal Ajouter -->
<div class="modal fade" id="absenceModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background:rgba(30,30,50,0.95);color:white;border-radius:16px;border:1px solid rgba(255,255,255,0.1);">
            <div class="modal-header" style="border-bottom:1px solid rgba(255,255,255,0.1);">
                <h5 class="modal-title">Signaler une absence/retard</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Type de personne</label>
                    <select class="form-select" id="absenceUserType" style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);">
                        <option value="student">👨‍🎓 Élève</option>
                        <option value="professor">👨‍🏫 Professeur</option>
                    </select>
                </div>
                <div id="classSelectDiv">
                    <label class="form-label">Classe</label>
                    <div class="row mb-3">
                        <div class="col-5">
                            <select class="form-select" id="modalClassLevel" style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);">
                                <option value="">-- Niveau --</option>
                                <option value="Terminale">Terminale</option><option value="Première">Première</option><option value="Seconde">Seconde</option>
                                <option value="3ème">3ème</option><option value="4ème">4ème</option><option value="5ème">5ème</option><option value="6ème">6ème</option>
                                <option value="CM2">CM2</option><option value="CM1">CM1</option><option value="CE2">CE2</option><option value="CE1">CE1</option><option value="CP">CP</option>
                                <option value="Grande Section">Grande Section</option><option value="Moyenne Section">Moyenne Section</option><option value="Petite Section">Petite Section</option><option value="Toute Petite Section">Toute Petite Section</option>
                            </select>
                        </div>
                        <div class="col-2">
                            <select class="form-select" id="modalClassLetter" style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);"><option value="">-</option></select>
                        </div>
                        <div class="col-2">
                            <select class="form-select" id="modalClassNumber" style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);"><option value="">-</option></select>
                        </div>
                        <div class="col-3">
                            <button class="btn btn-outline-light w-100" id="btnLoadStudents">Charger</button>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Personne *</label>
                    <select class="form-select" id="absenceUser" required style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);">
                        <option value="">-- Sélectionnez --</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Type *</label>
                    <select class="form-select" id="absenceType" style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);">
                        <option value="absence">❌ Absence</option>
                        <option value="retard">⏰ Retard</option>
                    </select>
                </div>
                <div class="mb-3" id="heureArriveeDiv" style="display:none;">
                    <label class="form-label">Heure d'arrivée</label>
                    <input type="time" class="form-control" id="absenceHeure" style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);">
                </div>
                <div class="mb-3">
                    <label class="form-label">Date *</label>
                    <input type="date" class="form-control" id="absenceDate" required style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);">
                </div>
                <div class="mb-3">
                    <label class="form-label">Motif</label>
                    <input type="text" class="form-control" id="absenceMotif" placeholder="Maladie, rendez-vous..." style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);">
                </div>
                <div class="mb-3">
                    <label class="form-label">Commentaire</label>
                    <textarea class="form-control" id="absenceCommentaire" rows="2" style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Justifié</label>
                    <select class="form-select" id="absenceJustified" style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);">
                        <option value="non_justifiee">❌ Non justifiée</option>
                        <option value="justifiee">✅ Justifiée</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer" style="border-top:1px solid rgba(255,255,255,0.1);">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary" id="btnSaveAbsence">Enregistrer</button>
            </div>
        </div>
    </div>
</div>

<script>
    if (typeof feather !== 'undefined') feather.replace();

    var today = new Date().toISOString().split('T')[0];
    document.getElementById('absenceDate').value = today;
    document.getElementById('filterDateDebut').value = today;

    // Initialiser lettres et N°
    var letterSel = document.getElementById('modalClassLetter');
    var numberSel = document.getElementById('modalClassNumber');
    for (var i = 0; i < 26; i++) {
        var opt = document.createElement('option');
        opt.value = String.fromCharCode(65 + i); opt.textContent = String.fromCharCode(65 + i); letterSel.appendChild(opt);
    }
    for (var j = 1; j <= 20; j++) {
        var opt2 = document.createElement('option');
        opt2.value = j; opt2.textContent = j; numberSel.appendChild(opt2);
    }

    // Gestion des modals
    function hideModal(id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.classList.remove('show'); el.style.display = 'none';
        document.body.classList.remove('modal-open');
        var bd = document.querySelector('.modal-backdrop'); if (bd) bd.remove();
        document.body.style.overflow = ''; document.body.style.paddingRight = '';
    }
    function showModal(id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.classList.add('show'); el.style.display = 'block';
        document.body.classList.add('modal-open');
        var bd = document.createElement('div'); bd.className = 'modal-backdrop fade show'; document.body.appendChild(bd);
    }
    document.querySelectorAll('[data-bs-dismiss="modal"]').forEach(function(btn) {
        btn.addEventListener('click', function() { var m = this.closest('.modal'); if (m) hideModal(m.id); });
    });
    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('modal-backdrop')) {
            document.querySelectorAll('.modal.show').forEach(function(m) { hideModal(m.id); });
        }
    });

    // Message de succès
    function showSuccess(msg) {
        var el = document.getElementById('successMessage');
        var txt = document.getElementById('successText');
        if (!el || !txt) return;
        txt.textContent = msg;
        el.style.display = 'block';
        setTimeout(function() { el.style.display = 'none'; }, 3000);
    }

    // Charger classes filtre
    var xhrC = new XMLHttpRequest();
    xhrC.open('GET', '/api/all-classes');
    xhrC.onload = function() {
        if (xhrC.status === 200) {
            var data = JSON.parse(xhrC.responseText);
            var sel = document.getElementById('filterClass');
            if (data) for (var i = 0; i < data.length; i++) {
                var opt = document.createElement('option'); opt.value = data[i]; opt.textContent = data[i]; sel.appendChild(opt);
            }
        }
    };
    xhrC.send();

    // Type personne
    document.getElementById('absenceUserType').addEventListener('change', function() {
        document.getElementById('classSelectDiv').style.display = (this.value === 'student') ? 'block' : 'none';
        if (this.value === 'professor') {
            var xhr = new XMLHttpRequest();
            xhr.open('GET', '/api/professors-list');
            xhr.onload = function() {
                if (xhr.status === 200) {
                    var data = JSON.parse(xhr.responseText);
                    var sel = document.getElementById('absenceUser');
                    sel.innerHTML = '<option value="">-- Choisir --</option>';
                    for (var i = 0; i < data.length; i++) {
                        var opt = document.createElement('option'); opt.value = data[i].id; opt.textContent = data[i].name; sel.appendChild(opt);
                    }
                }
            };
            xhr.send();
        }
    });

    // Type absence/retard
    document.getElementById('absenceType').addEventListener('change', function() {
        document.getElementById('heureArriveeDiv').style.display = (this.value === 'retard') ? 'block' : 'none';
    });

    // Charger élèves
    document.getElementById('btnLoadStudents').addEventListener('click', function() {
        var level = document.getElementById('modalClassLevel').value;
        if (!level) { alert('Sélectionnez un niveau'); return; }
        var letter = document.getElementById('modalClassLetter').value;
        var number = document.getElementById('modalClassNumber').value;
        var cn = level + (letter ? ' ' + letter : '') + (number ? ' ' + number : '');
        var xhr = new XMLHttpRequest();
        xhr.open('GET', '/api/students-by-class/' + encodeURIComponent(cn.trim()));
        xhr.onload = function() {
            if (xhr.status === 200) {
                var data = JSON.parse(xhr.responseText);
                var sel = document.getElementById('absenceUser');
                sel.innerHTML = '<option value="">-- Choisir --</option>';
                if (data) for (var i = 0; i < data.length; i++) {
                    var opt = document.createElement('option');
                    opt.value = data[i].id; opt.textContent = data[i].name + ' (' + (data[i].matricule || 'N/A') + ')'; sel.appendChild(opt);
                }
            }
        };
        xhr.send();
    });

    // FILTRER
    document.getElementById('btnFilter').addEventListener('click', loadAbsences);
    function loadAbsences() {
        var url = '/api/absences?user_type=' + document.getElementById('filterType').value;
        var cls = document.getElementById('filterClass').value;
        var st = document.getElementById('filterStatus').value;
        var d1 = document.getElementById('filterDateDebut').value;
        var d2 = document.getElementById('filterDateFin').value;
        if (cls) url += '&class_name=' + encodeURIComponent(cls);
        if (st) url += '&status=' + encodeURIComponent(st);
        if (d1) url += '&date_debut=' + d1;
        if (d2) url += '&date_fin=' + d2;

        var xhr = new XMLHttpRequest();
        xhr.open('GET', url);
        xhr.onload = function() {
            if (xhr.status === 200) {
                var data = JSON.parse(xhr.responseText);
                var tbody = document.getElementById('absencesBody');
                tbody.innerHTML = '';
                if (!data || data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">Aucun résultat</td></tr>';
                    return;
                }
                for (var i = 0; i < data.length; i++) {
                    var a = data[i];
                    var typeLabel = (a.type === 'absence') ? '❌ Absence' : '⏰ Retard';
                    var typeColor = (a.type === 'absence') ? '#dc3545' : '#fd7e14';
                    var heureArrivee = (a.type === 'retard' && a.heure_arrivee) ? a.heure_arrivee.substring(0, 5) : '-';
                    var justifiedChecked = (a.status === 'justifiee') ? 'checked' : '';
                    var statusLabel = (a.status === 'justifiee') ? '✅ Justifiée' : '❌ Non justifiée';

                    var tr = document.createElement('tr');
                    tr.innerHTML = 
                        '<td style="color:#fff;">' + (a.date ? new Date(a.date).toLocaleDateString('fr-FR') : '-') + '</td>' +
                        '<td style="color:#fff;">' + (a.user_name || '-') + '</td>' +
                        '<td style="color:#fff;">' + (a.student_class || '-') + '</td>' +
                        '<td><span class="badge" style="background:' + typeColor + '">' + typeLabel + '</span></td>' +
                        '<td style="color:#fff;">' + heureArrivee + '</td>' +
                        '<td><label style="cursor:pointer;display:flex;align-items:center;gap:6px;"><input type="checkbox" ' + justifiedChecked + ' onchange="toggleJustify(' + a.id + ', this.checked)" style="accent-color:#198754;width:18px;height:18px;cursor:pointer;"><span style="font-size:0.75rem;color:#ccc;">' + statusLabel + '</span></label></td>' +
                        '<td style="color:#ccc;">' + (a.motif || '-') + '</td>' +
                        '<td><a href="#" onclick="event.preventDefault(); deleteAbsence(' + a.id + ')" class="btn btn-sm btn-outline-danger">🗑️</a></td>';
                    tbody.appendChild(tr);
                }
            }
        };
        xhr.send();
    }

    // Cocher justifié
    function toggleJustify(id, checked) {
        var xhr = new XMLHttpRequest();
        xhr.open('PUT', '/api/absences/' + id);
        xhr.setRequestHeader('Content-Type', 'application/json');
        xhr.onload = function() {
            if (xhr.status === 200) {
                var result = JSON.parse(xhr.responseText);
                if (result.success) {
                    var msg = checked ? '✅ Absence/retard marqué(e) comme justifié(e)' : '❌ Absence/retard marqué(e) comme non justifié(e)';
                    showSuccess(msg);
                    loadAbsences(); // Recharger seulement en cas de succès
                }
            }
        };
        xhr.send(JSON.stringify({ status: checked ? 'justifiee' : 'non_justifiee', motif: '', commentaire: '' }));
    }

    // Ajouter
    document.getElementById('btnAddAbsence').addEventListener('click', function() {
        document.getElementById('absenceUserType').value = 'student';
        document.getElementById('classSelectDiv').style.display = 'block';
        document.getElementById('absenceUser').innerHTML = '<option value="">-- Sélectionnez --</option>';
        document.getElementById('absenceType').value = 'absence';
        document.getElementById('heureArriveeDiv').style.display = 'none';
        document.getElementById('absenceMotif').value = '';
        document.getElementById('absenceCommentaire').value = '';
        document.getElementById('absenceJustified').value = 'non_justifiee';
        showModal('absenceModal');
    });

    // Enregistrer
document.getElementById('btnSaveAbsence').addEventListener('click', function() {
    var uid = document.getElementById('absenceUser').value;
    if (!uid) { alert('Sélectionnez une personne'); return; }
    var type = document.getElementById('absenceType').value;
    var data = {
        user_id: parseInt(uid),
        user_type: document.getElementById('absenceUserType').value,
        type: type,
        date: document.getElementById('absenceDate').value,
        heure_arrivee: null,
        motif: document.getElementById('absenceMotif').value.trim(),
        commentaire: document.getElementById('absenceCommentaire').value.trim(),
        status: document.getElementById('absenceJustified').value
    };
    if (type === 'retard') data.heure_arrivee = document.getElementById('absenceHeure').value;

    var xhr = new XMLHttpRequest();
    xhr.open('POST', '/api/absences');
    xhr.setRequestHeader('Content-Type', 'application/json');
    xhr.onload = function() {
        // Accepter tous les codes 2xx
        if (xhr.status >= 200 && xhr.status < 300) {
            try {
                var result = JSON.parse(xhr.responseText);
                if (result.success) {
                    hideModal('absenceModal');
                    var msg = (type === 'absence') ? '✅ Absence enregistrée avec succès' : '⏰ Retard enregistré avec succès';
                    showSuccess(msg);
                    loadAbsences();
                } else {
                    alert('Erreur: ' + (result.error || 'Inconnue'));
                }
            } catch(e) {
                // Si la réponse n'est pas du JSON, considérer comme succès
                hideModal('absenceModal');
                var msg = (type === 'absence') ? '✅ Absence enregistrée avec succès' : '⏰ Retard enregistré avec succès';
                showSuccess(msg);
                loadAbsences();
            }
        } else {
            alert('Erreur serveur (code ' + xhr.status + ')');
        }
    };
    xhr.onerror = function() {
        alert('Erreur réseau');
    };
    xhr.send(JSON.stringify(data));
});

    // Supprimer
    function deleteAbsence(id) {
        if (!confirm('Supprimer cette entrée ?')) return;
        var xhr = new XMLHttpRequest();
        xhr.open('DELETE', '/api/absences/' + id);
        xhr.onload = function() { showSuccess('🗑️ Entrée supprimée'); loadAbsences(); };
        xhr.send();
    }

    // TEST - Afficher un message après 2 secondes
setTimeout(function() {
    showSuccess('Test message succès');
}, 2000);
</script>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.05) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3) !important;
    }
    #absencesTable { color: #e4e4e4; }
    #absencesTable td { border-color: rgba(255,255,255,0.06); vertical-align: middle; }
    #absencesTable tr:hover { background: rgba(255,255,255,0.03); }
</style>

<%- include('../partials/footer') %>