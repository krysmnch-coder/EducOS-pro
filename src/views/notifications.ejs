<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('partials/head') %>
  <style>
    /* ==========================================================================
       Page Notifications - Style Glassmorphism
       ========================================================================== */
    
    .page-shell {
      padding-top: 1rem;
      padding-bottom: 2rem;
    }
    
    /* Titre de page */
    .page-title {
      color: var(--text-color, #212529);
      font-weight: 700;
      animation: title-slide 0.6s ease forwards !important;
      opacity: 0;
      transform: translateX(-10px);
    }
    
    @keyframes title-slide {
      from {
        opacity: 0;
        transform: translateX(-10px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }
    
    [data-theme="dark"] .page-title {
      color: #ffffff;
    }
    
    /* Carte principale Glassmorphism */
    .glass-notif-card {
      background: rgba(255, 255, 255, 0.06) !important;
      backdrop-filter: blur(12px) !important;
      -webkit-backdrop-filter: blur(12px) !important;
      border: 1px solid rgba(255, 255, 255, 0.12) !important;
      border-radius: 1.25rem !important;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06) !important;
      overflow: hidden;
      animation: card-fade-in 0.6s ease forwards !important;
      opacity: 0;
      transform: translateY(20px);
    }
    
    @keyframes card-fade-in {
      from {
        opacity: 0;
        transform: translateY(20px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
    
    [data-theme="dark"] .glass-notif-card {
      background: rgba(255, 255, 255, 0.02) !important;
      border: 1px solid rgba(255, 255, 255, 0.06) !important;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3) !important;
    }
    
    .glass-notif-card .card-body {
      padding: 2rem !important;
    }
    
    /* Texte d'information */
    .text-muted {
      color: var(--text-muted, #6c757d) !important;
    }
    
    [data-theme="dark"] .text-muted {
      color: rgba(255, 255, 255, 0.6) !important;
    }
    
    /* État vide stylisé */
    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
      animation: empty-fade 0.8s ease forwards !important;
      opacity: 0;
      transform: scale(0.95);
    }
    
    @keyframes empty-fade {
      from {
        opacity: 0;
        transform: scale(0.95) translateY(10px);
      }
      to {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }
    
    .empty-state .empty-icon {
      width: 80px;
      height: 80px;
      margin: 0 auto 1.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(13, 110, 253, 0.06);
      border-radius: 50%;
      border: 2px solid rgba(13, 110, 253, 0.08);
      transition: all 0.3s ease;
    }
    
    .empty-state .empty-icon svg {
      opacity: 0.4;
      transition: all 0.3s ease;
    }
    
    .empty-state:hover .empty-icon {
      transform: scale(1.05);
      background: rgba(13, 110, 253, 0.08);
    }
    
    .empty-state:hover .empty-icon svg {
      opacity: 0.6;
    }
    
    [data-theme="dark"] .empty-state .empty-icon {
      background: rgba(255, 255, 255, 0.03);
      border-color: rgba(255, 255, 255, 0.04);
    }
    
    .empty-state h5 {
      color: var(--text-color, #212529);
      font-weight: 600;
    }
    
    [data-theme="dark"] .empty-state h5 {
      color: #ffffff;
    }
    
    .empty-state p {
      color: var(--text-muted, #6c757d);
      max-width: 400px;
      margin: 0 auto;
    }
    
    [data-theme="dark"] .empty-state p {
      color: rgba(255, 255, 255, 0.5);
    }
    
    /* Liste des notifications */
    .notification-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .notification-item {
      display: flex;
      align-items: center;
      padding: 1rem 0.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      text-decoration: none;
      color: inherit;
      transition: background-color 0.2s ease;
      border-radius: 0.75rem;
      margin: 0 -0.5rem;
    }

    .notification-link {
      display: flex;
      align-items: center;
      flex: 1;
      min-width: 0;
      color: inherit;
      text-decoration: none;
    }

    .notification-controls {
      display: flex;
      align-items: center;
      gap: 0.2rem;
      margin-left: 0.75rem;
    }

    .notification-control-btn {
      width: 34px;
      height: 34px;
      display: inline-grid;
      place-items: center;
      border: 1px solid transparent;
      border-radius: 0.55rem;
      background: transparent;
      color: var(--text-muted, #6c757d);
      transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
    }

    .notification-control-btn:hover {
      background: rgba(13, 110, 253, 0.1);
      color: var(--bs-primary, #0d6efd);
      transform: translateY(-1px);
    }

    .notification-control-btn.delete:hover {
      background: rgba(220, 53, 69, 0.1);
      color: #dc3545;
    }

    .notification-item.is-deleting {
      opacity: 0;
      transform: translateX(1rem);
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    #delete-all-notifications {
      color: #dc3545;
      border-color: rgba(220, 53, 69, 0.35);
    }

    .notification-item.unread {
      background: rgba(13, 110, 253, 0.06);
      box-shadow: inset 3px 0 0 var(--bs-primary, #0d6efd);
    }

    .notification-item.is-updating {
      opacity: 0.55;
      pointer-events: none;
    }

    .notification-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-bottom: 1.25rem;
    }

    .notification-filter {
      display: inline-flex;
      gap: 0.25rem;
      padding: 0.25rem;
      border: 1px solid var(--surface-border, #dee2e6);
      border-radius: 0.75rem;
      background: var(--surface-subtle-bg, #f8f9fa);
    }

    .notification-filter button {
      border: 0;
      border-radius: 0.55rem;
      padding: 0.45rem 0.75rem;
      background: transparent;
      color: var(--body-color, #212529);
      font-size: 0.8rem;
    }

    .notification-filter button.active {
      background: var(--bs-primary, #0d6efd);
      color: #fff;
    }

    .mark-read-btn {
      border: 0;
      background: transparent;
      color: var(--bs-primary, #0d6efd);
      font-size: 0.75rem;
      padding: 0.35rem;
      white-space: nowrap;
    }

    .notification-item:last-child {
      border-bottom: none;
    }

    .notification-item:hover {
      background-color: rgba(255, 255, 255, 0.05);
    }

    [data-theme="dark"] .notification-item {
      border-bottom-color: rgba(255, 255, 255, 0.08);
    }

    [data-theme="dark"] .notification-item:hover {
      background-color: rgba(255, 255, 255, 0.05);
    }

    [data-theme="dark"] .notification-item.unread {
      background: rgba(77, 171, 247, 0.12);
    }

    [data-theme="light"] .notification-item {
      border-bottom-color: rgba(0, 0, 0, 0.08);
      color: #212529;
    }

    [data-theme="light"] .notification-item:hover {
      background-color: rgba(0, 0, 0, 0.03);
    }

    .notification-icon {
      flex-shrink: 0;
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      margin-right: 1rem;
      background-color: rgba(13, 110, 253, 0.1);
    }

    .notification-icon i {
      color: #0d6efd;
    }

    [data-theme="dark"] .notification-icon {
      background-color: rgba(13, 110, 253, 0.15);
    }
    [data-theme="dark"] .notification-icon i {
      color: #4dabf7;
    }

    .notification-content {
      flex-grow: 1;
    }

    .notification-text {
      margin: 0;
      font-weight: 500;
      line-height: 1.4;
    }

    .notification-time {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: 0.2rem;
    }

    .notification-dot {
      width: 8px;
      height: 8px;
      background-color: #0d6efd;
      border-radius: 50%;
      flex-shrink: 0;
      margin-left: 1rem;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.7); }
      70% { box-shadow: 0 0 0 10px rgba(13, 110, 253, 0); }
      100% { box-shadow: 0 0 0 0 rgba(13, 110, 253, 0); }
    }

    /* Badge de statut */
    .badge {
      padding: 0.35rem 0.75rem;
      border-radius: 0.5rem;
      font-weight: 500;
      transition: all 0.3s ease;
    }
    
    .badge:hover {
      transform: scale(1.05);
    }
    
    /* Adaptation mobile */
    @media (max-width: 768px) {
      .page-title {
        font-size: 1.4rem;
      }
      
      .glass-notif-card .card-body {
        padding: 1.25rem !important;
      }
      
      .notification-item {
        padding: 0.75rem 0.25rem;
        margin: 0 -0.25rem;
      }
      .notification-icon {
        width: 40px;
        height: 40px;
        margin-right: 0.75rem;
      }
      .notification-text {
        font-size: 0.9rem;
      }

      .notification-controls { margin-left: 0.35rem; }
      .notification-control-btn { width: 30px; height: 30px; }

      .glass-notif-card {
        border-radius: 1rem !important;
      }
      
      .empty-state {
        padding: 2rem 0.5rem;
      }
      
      .empty-state .empty-icon {
        width: 60px;
        height: 60px;
      }
      
      .empty-state h5 {
        font-size: 1.1rem;
      }
    }
    
    @media (max-width: 576px) {
      .page-title {
        font-size: 1.2rem;
      }
      
      .glass-notif-card .card-body {
        padding: 1rem !important;
      }
      
      .empty-state .empty-icon {
        width: 50px;
        height: 50px;
      }
      
      .empty-state .empty-icon svg {
        width: 28px;
        height: 28px;
      }
    }
  </style>
</head>
<body data-theme="light">
  <div class="page-shell container-xl py-4">
    <%- include('partials/header') %>

    <main class="page-main">
      <div class="glass-notif-card">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
              <h1 class="h4 mb-1 page-title">
                <i data-feather="bell" class="me-2" style="width: 24px; height: 24px;"></i>
                <%= title %>
              </h1>
              <p class="text-muted mb-0">Consultez vos dernières notifications.</p>
            </div>
            <span class="badge bg-primary">
              <i data-feather="bell" class="me-1" style="width: 12px; height: 12px;"></i>
              <span data-unread-count><%= typeof unreadCount !== 'undefined' ? unreadCount : 0 %></span>
            </span>
          </div>

          <div class="notification-actions">
            <div class="notification-filter" role="tablist" aria-label="Filtrer les notifications">
              <button type="button" class="active" data-filter="all">Toutes</button>
              <button type="button" data-filter="unread">Non lues</button>
            </div>
            <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
              <button type="button" class="btn btn-sm btn-outline-primary ms-auto" id="mark-all-read">
                <i data-feather="check-circle" class="me-1" style="width: 14px; height: 14px;"></i>
                Tout marquer comme lu
              </button>
            <% } %>
            <% if (typeof notifications !== 'undefined' && notifications.length > 0) { %>
              <button type="button" class="btn btn-sm btn-outline-danger" id="delete-all-notifications">
                <i data-feather="trash-2" class="me-1" style="width: 14px; height: 14px;"></i>
                Tout supprimer
              </button>
            <% } %>
          </div>

          <% if (typeof notifications !== 'undefined' && notifications.length > 0) { %>
            <!-- Liste des notifications -->
            <div class="notification-list">
              <% notifications.forEach(notification => { %>
                <% 
                  let icon = 'bell';
                  switch(notification.type) {
                    case 'message': icon = 'message-square'; break;
                    case 'user_approval': icon = 'user-check'; break;
                    case 'new_user': icon = 'user-plus'; break;
                    case 'payment': icon = 'dollar-sign'; break;
                    case 'communication': icon = 'send'; break;
                  }
                %>
                <div class="notification-item <%= notification.is_read ? '' : 'unread' %>" data-notification-id="<%= notification.id %>" data-read="<%= notification.is_read ? 'true' : 'false' %>">
                  <a href="<%= notification.link || '#' %>" class="notification-link">
                    <div class="notification-icon">
                      <i data-feather="<%= icon %>"></i>
                    </div>
                    <div class="notification-content">
                      <p class="notification-text"><%= notification.title %></p>
                      <% if (notification.timeAgo) { %>
                        <span class="notification-time"><%= notification.timeAgo %></span>
                      <% } %>
                    </div>
                    <% if (!notification.is_read) { %>
                      <span class="notification-dot"></span>
                    <% } %>
                  </a>
                  <div class="notification-controls">
                    <% if (!notification.is_read) { %>
                      <button type="button" class="notification-control-btn" data-mark-read aria-label="Marquer comme lue" title="Marquer comme lue">
                        <i data-feather="check" style="width: 15px; height: 15px;"></i>
                      </button>
                    <% } %>
                    <button type="button" class="notification-control-btn delete" data-delete-notification aria-label="Supprimer" title="Supprimer">
                      <i data-feather="trash-2" style="width: 15px; height: 15px;"></i>
                    </button>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <!-- État vide stylisé -->
            <div class="empty-state">
              <div class="empty-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                  <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
              </div>
              <h5>Aucune notification</h5>
              <p>Vous n'avez pas encore de notifications. Revenez plus tard pour voir les mises à jour.</p>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      if (typeof feather !== 'undefined') {
        feather.replace();
      }

      const notificationItems = Array.from(document.querySelectorAll('[data-notification-id]'));
      const filterButtons = Array.from(document.querySelectorAll('[data-filter]'));
      const counter = document.querySelector('.glass-notif-card .badge');
      const markAllButton = document.getElementById('mark-all-read');
      const deleteAllButton = document.getElementById('delete-all-notifications');

      function updateCounter() {
        const unreadCount = notificationItems.filter(item => item.dataset.read !== 'true').length;
        if (counter) counter.querySelector('[data-unread-count]').textContent = unreadCount;
        if (markAllButton && unreadCount === 0) markAllButton.remove();
      }

      function applyFilter(filter) {
        notificationItems.forEach(item => {
          item.hidden = filter === 'unread' && item.dataset.read === 'true';
        });
        filterButtons.forEach(button => button.classList.toggle('active', button.dataset.filter === filter));
      }

      filterButtons.forEach(button => {
        button.addEventListener('click', () => applyFilter(button.dataset.filter));
      });

      notificationItems.forEach(item => {
        const markReadButton = item.querySelector('[data-mark-read]');
        const deleteButton = item.querySelector('[data-delete-notification]');

        if (markReadButton) markReadButton.addEventListener('click', async event => {
          event.preventDefault();
          event.stopPropagation();
          item.classList.add('is-updating');
          try {
            const response = await fetch(`/notifications/api/${item.dataset.notificationId}/read`, { method: 'POST' });
            if (!response.ok) throw new Error('Impossible de marquer la notification.');
            item.dataset.read = 'true';
            item.classList.remove('unread', 'is-updating');
            markReadButton.remove();
            item.querySelector('.notification-dot')?.remove();
            updateCounter();
          } catch (error) {
            item.classList.remove('is-updating');
            console.error(error);
          }
        });

        if (deleteButton) deleteButton.addEventListener('click', async event => {
          event.preventDefault();
          event.stopPropagation();
          if (!window.confirm('Supprimer cette notification ?')) return;
          try {
            const response = await fetch(`/notifications/api/${item.dataset.notificationId}`, { method: 'DELETE' });
            if (!response.ok) throw new Error('Impossible de supprimer la notification.');
            item.dataset.read = 'true';
            item.classList.add('is-deleting');
            window.setTimeout(() => {
              item.remove();
              updateCounter();
            }, 220);
          } catch (error) {
            console.error(error);
          }
        });
      });

      if (markAllButton) {
        markAllButton.addEventListener('click', async () => {
          markAllButton.disabled = true;
          try {
            const response = await fetch('/notifications/api/read-all', { method: 'POST' });
            if (!response.ok) throw new Error('Impossible de marquer les notifications.');
            notificationItems.forEach(item => {
              item.dataset.read = 'true';
              item.classList.remove('unread');
              item.querySelector('[data-mark-read]')?.remove();
              item.querySelector('.notification-dot')?.remove();
            });
            updateCounter();
          } catch (error) {
            markAllButton.disabled = false;
            console.error(error);
          }
        });
      }

      if (deleteAllButton) deleteAllButton.addEventListener('click', async () => {
        if (!window.confirm('Supprimer définitivement toutes les notifications ?')) return;
        deleteAllButton.disabled = true;
        try {
          const response = await fetch('/notifications/api', { method: 'DELETE' });
          if (!response.ok) throw new Error('Impossible de supprimer les notifications.');
          notificationItems.forEach(item => {
            item.dataset.read = 'true';
            item.remove();
          });
          deleteAllButton.remove();
          markAllButton?.remove();
          document.querySelector('.notification-list')?.insertAdjacentHTML('afterend', '<div class="empty-state"><div class="empty-icon"><i data-feather="bell-off"></i></div><h5>Aucune notification</h5><p>Votre espace est à jour.</p></div>');
          if (typeof feather !== 'undefined') feather.replace();
          updateCounter();
        } catch (error) {
          deleteAllButton.disabled = false;
          console.error(error);
        }
      });
    });
  </script>

  <%- include('partials/footer') %>
</body>
</html>