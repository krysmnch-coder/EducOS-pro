<%- include('partials/head') %>
<%- include('partials/header') %>

<div class="container page-shell py-4">
    <div class="themed-container">

        <%- include('partials/messages') %>

        <%# --- Section de bienvenue --- %>
        <div class="d-flex align-items-center mb-5 welcome-section">
            <div class="avatar-circle me-4">
                <% if (user.avatar_url && user.avatar_url !== '/img/user.png') { %>
                    <img src="<%= user.avatar_url %>" alt="Avatar" class="avatar-img">
                <% } else { %>
                    <span class="avatar-text"><%= user.name.charAt(0).toUpperCase() %></span>
                <% } %>
                <div class="avatar-status online"></div>
            </div>
            <div>
                <h1 class="h2 mb-1">Bonjour, <%= user.name %> !</h1>
                <p class="lead text-muted mb-0">Bienvenue sur votre tableau de bord.</p>
                <small class="text-muted">
                    <i data-feather="calendar" class="me-1" style="width: 14px; height: 14px;"></i>
                    <%= new Date().toLocaleDateString('fr-FR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                </small>
            </div>
        </div>

        <%# --- Widgets --- %>
        <div class="section-header mb-4">
            <h2 class="mb-0">Raccourcis de gestion</h2>
            <div class="section-line"></div>
        </div>
        
        <div class="row g-4">
            <% if (typeof widgets !== 'undefined' && widgets.length > 0) { %>
                <% widgets.forEach(function(widget, index) { %>
                <div class="col-xl-3 col-md-6">
                    <a href="<%= widget.link || '#' %>" class="shortcut-link" data-shortcut-key="<%= widget.key || 'widget-' + index %>">
                        <div class="widget-card glass-card" data-delay="<%= (index + 1) * 100 %>">
                            <div class="glass-shine"></div>
                            <div class="card-content">
                                <div class="widget-icon-wrapper">
                                    <i data-feather="<%= widget.icon || 'box' %>"></i>
                                </div>
                                <h5 class="widget-title"><%= widget.title %></h5>
                                <p class="widget-description"><%= widget.description %></p>
                                <div class="widget-arrow">
                                    <i data-feather="arrow-right"></i>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <% }); %>
            <% } %>
        </div>
    </div>
</div>

<style>
:root {
    --glass-bg: rgba(255, 255, 255, 0.08);
    --glass-border: rgba(255, 255, 255, 0.15);
    --glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
    --glass-blur: blur(12px);
    --glass-shine: rgba(255, 255, 255, 0.4);
    --primary-color: #0d6efd;
    --primary-glow: rgba(13, 110, 253, 0.2);
}

[data-theme="dark"] {
    --glass-bg: rgba(255, 255, 255, 0.03);
    --glass-border: rgba(255, 255, 255, 0.06);
    --glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    --glass-shine: rgba(255, 255, 255, 0.08);
}

.section-header { position: relative; display: flex; align-items: center; gap: 1rem; }
.section-line { flex: 1; height: 1px; background: linear-gradient(90deg, var(--primary-color), transparent); opacity: 0.3; }
.welcome-section { animation: fadeInDown 0.8s ease; }
.avatar-circle { width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-color), #0a58ca); display: flex; align-items: center; justify-content: center; position: relative; box-shadow: 0 8px 25px var(--primary-glow); }
.avatar-text { color: white; font-size: 2.5rem; font-weight: 600; }
.avatar-img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
.avatar-status { position: absolute; bottom: 5px; right: 5px; width: 16px; height: 16px; border-radius: 50%; border: 2px solid white; background: #22c55e; }

.glass-card {
    background: var(--glass-bg); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border); border-radius: 20px; box-shadow: var(--glass-shadow);
    transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94); overflow: hidden;
    opacity: 1; transform: none;
}
.glass-shine {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), var(--glass-shine) 0%, transparent 60%);
    opacity: 0; transition: opacity 0.3s ease; pointer-events: none; z-index: 2; border-radius: 20px;
}
.glass-card:hover .glass-shine { opacity: 1; }

.widget-card { min-height: 200px; cursor: pointer; }
.widget-card:hover { transform: translateY(-12px) scale(1.03); box-shadow: 0 20px 40px rgba(0,0,0,0.12), 0 0 40px var(--primary-glow); }
.card-content { position: relative; z-index: 3; padding: 2rem 1.5rem; text-align: center; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.widget-icon-wrapper { width: 70px; height: 70px; border-radius: 50%; background: rgba(13,110,253,0.1); display: flex; align-items: center; justify-content: center; margin-bottom: 1.2rem; transition: all 0.6s cubic-bezier(0.68,-0.55,0.265,1.55); }
.widget-icon-wrapper svg { width: 36px; height: 36px; stroke-width: 1.5; color: var(--primary-color); transition: all 0.6s cubic-bezier(0.68,-0.55,0.265,1.55); }
.widget-card:hover .widget-icon-wrapper { transform: scale(1.1) rotate(-5deg); background: rgba(13,110,253,0.15); box-shadow: 0 0 30px var(--primary-glow); }
.widget-card:hover .widget-icon-wrapper svg { transform: scale(1.15); filter: drop-shadow(0 0 12px var(--primary-glow)); }
.widget-title { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.5rem; transition: all 0.4s ease; }
.widget-title::after { content: ''; position: absolute; bottom: -4px; left: 50%; width: 0; height: 2px; background: linear-gradient(90deg, var(--primary-color), #0dcaf0); transition: all 0.5s ease; transform: translateX(-50%); border-radius: 2px; }
.widget-card:hover .widget-title { color: var(--primary-color); transform: translateY(-2px); }
.widget-card:hover .widget-title::after { width: 80%; }
.widget-description { color: #6c757d; font-size: 0.85rem; margin-bottom: 1rem; transition: all 0.4s ease; }
.widget-card:hover .widget-description { color: #495057; transform: translateY(-1px); }
.widget-arrow { opacity: 0; transform: translateX(-10px); transition: all 0.4s ease; }
.widget-card:hover .widget-arrow { opacity: 1; transform: translateX(0); }
.widget-arrow svg { width: 20px; height: 20px; color: var(--primary-color); }
.shortcut-link { text-decoration: none !important; display: block; }

@media (max-width: 768px) {
    .widget-card { min-height: 160px; }
    .widget-icon-wrapper { width: 55px; height: 55px; }
    .widget-icon-wrapper svg { width: 28px; height: 28px; }
    .glass-shine { display: none; }
}
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof feather !== 'undefined') feather.replace();
        if (window.innerWidth > 768) {
            document.querySelectorAll('.glass-card').forEach(function(card) {
                card.addEventListener('mousemove', function(e) {
                    var r = card.getBoundingClientRect();
                    card.style.setProperty('--mouse-x', ((e.clientX - r.left) / r.width) * 100 + '%');
                    card.style.setProperty('--mouse-y', ((e.clientY - r.top) / r.height) * 100 + '%');
                });
            });
        }
    });
</script>

<%- include('partials/footer') %>