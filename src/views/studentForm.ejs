<!DOCTYPE html>
<html lang="fr" data-theme="dark" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modifier le dossier de Tiana RABENJA</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    
    <style>
        /* VOTRE CSS EXISTANT - NE PAS MODIFIER */
        /* ... tout votre CSS ... */
        
        /* Styles additionnels pour l'édition inline du téléphone */
        .phone-editable {
            cursor: pointer;
            border-bottom: 1px dashed #6c757d;
            transition: all 0.3s ease;
        }
        
        .phone-editable:hover {
            color: var(--bs-primary, #0d6efd);
            border-bottom-color: var(--bs-primary, #0d6efd);
        }
        
        .phone-edit-input {
            width: 150px;
            display: inline-block;
            padding: 2px 8px;
            border-radius: 4px;
            border: 1px solid var(--bs-primary, #0d6efd);
            background: rgba(255, 255, 255, 0.1);
            color: var(--text-color, #212529);
            font-size: 0.875rem;
        }
        
        .phone-edit-input:focus {
            outline: none;
            box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.2);
        }
        
        .btn-save-phone {
            padding: 2px 8px;
            font-size: 0.75rem;
            margin-left: 5px;
        }
        
        .linked-parent-item {
            animation: fadeInUp 0.3s ease;
        }
        
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>
    <!-- HEADER EXISTANT - NE PAS MODIFIER -->
    <!-- ... votre header ... -->

    <main class="main-content">
        <div class="container mt-4 page-shell">
            <div class="themed-container">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="mb-0 page-title">
                        <i data-feather="user-plus" class="me-2" style="width: 24px; height: 24px;"></i>
                        Modifier le dossier de Tiana RABENJA
                    </h2>
                    <a href="/students" class="btn glass-btn-back">
                        <i data-feather="arrow-left" class="me-1" style="width: 16px; height: 16px;"></i>
                        Retour à la liste
                    </a>
                </div>

                <div class="card glass-form-card border-0">
                    <div class="card-body">
                        <form action="/students/5/edit" method="POST" id="student-form">
                            
                            <div class="row">
                                <div class="col-md-6 mb-3 form-group-animated">
                                    <label for="name" class="form-label">
                                        <i data-feather="user" class="me-1" style="width: 14px; height: 14px;"></i>
                                        Nom complet de l'élève
                                    </label>
                                    <input type="text" class="form-control" id="name" name="name" value="Tiana RABENJA" required>
                                </div>
                                <div class="col-md-6 mb-3 form-group-animated">
                                    <label for="matricule" class="form-label">
                                        <i data-feather="hash" class="me-1" style="width: 14px; height: 14px;"></i>
                                        Matricule
                                    </label>
                                    <input type="text" class="form-control" id="matricule" name="matricule" value="0002" required>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3 form-group-animated">
                                    <label for="student_class" class="form-label">
                                        <i data-feather="grid" class="me-1" style="width: 14px; height: 14px;"></i>
                                        Classe
                                    </label>
                                    <input type="text" class="form-control" id="student_class" name="student_class" value="4ème" required>
                                </div>
                            </div>

                            <hr class="my-4">
                            <h5 class="mb-3 section-title">
                                <i data-feather="info" class="me-2" style="width: 18px; height: 18px;"></i>
                                Informations personnelles
                            </h5>

                            <div class="row">
                                <div class="col-md-6 mb-3 form-group-animated">
                                    <label for="date_of_birth" class="form-label">
                                        <i data-feather="calendar" class="me-1" style="width: 14px; height: 14px;"></i>
                                        Date de naissance
                                    </label>
                                    <input type="date" class="form-control" id="date_of_birth" name="date_of_birth" value="2013-07-23">
                                </div>
                                <div class="col-md-6 mb-3 form-group-animated">
                                    <label for="place_of_birth" class="form-label">
                                        <i data-feather="map-pin" class="me-1" style="width: 14px; height: 14px;"></i>
                                        Lieu de naissance
                                    </label>
                                    <input type="text" class="form-control" id="place_of_birth" name="place_of_birth" value="Befelatanana">
                                </div>
                            </div>

                            <div class="mb-3 form-group-animated">
                                <label for="address" class="form-label">
                                    <i data-feather="home" class="me-1" style="width: 14px; height: 14px;"></i>
                                    Adresse
                                </label>
                                <textarea class="form-control" id="address" name="address" rows="2">IbI 8 Isoraka</textarea>
                            </div>

                            <hr class="my-4">
                            <h5 class="mb-3 section-title">
                                <i data-feather="users" class="me-2" style="width: 18px; height: 18px;"></i>
                                Liaison Parent
                            </h5>

                            <!-- Parents actuellement liés - AVEC ÉDITION DU TÉLÉPHONE -->
                            <div class="mb-3 form-group-animated">
                                <label class="form-label">
                                    <i data-feather="users" class="me-1" style="width: 14px; height: 14px;"></i>
                                    Parent(s) actuellement lié(s)
                                </label>
                                <div class="list-group glass-list-group" id="linked-parents-list">
                                    <!-- Les parents liés seront affichés ici dynamiquement -->
                                </div>
                            </div>

                            <!-- Select pour lier des parents existants -->
                            <div class="mb-3 form-group-animated">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label for="parent_ids-ts-control" class="form-label mb-0" id="parent_ids-ts-label">
                                        <i data-feather="user-plus" class="me-1" style="width: 14px; height: 14px;"></i>
                                        Ajouter un parent existant
                                    </label>
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addParentModal">
                                        <i data-feather="plus" class="me-1" style="width: 14px; height: 14px;"></i>
                                        Nouveau Parent
                                    </button>
                                </div>
                                <select name="parent_ids" id="parent_ids" class="form-select" multiple>
                                    <!-- Options chargées dynamiquement -->
                                </select>
                                <div class="form-text">
                                    <i data-feather="info" class="me-1" style="width: 12px; height: 12px;"></i>
                                    Sélectionnez des parents existants à lier. Utilisez "Nouveau Parent" pour ajouter un parent sans compte.
                                </div>
                            </div>

                            <!-- Champ caché pour stocker les parents ajoutés manuellement -->
                            <input type="hidden" name="manual_parents" id="manual-parents-data" value="[]">

                            <div class="d-flex justify-content-end mt-4">
                                <a href="/students" class="btn glass-btn-secondary me-2">Annuler</a>
                                <button type="submit" class="btn glass-btn-primary">
                                    <i data-feather="save" class="me-2" style="width: 16px; height: 16px;"></i>
                                    Mettre à jour le dossier
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Modal pour ajouter un parent SANS CRÉER DE COMPTE -->
    <div class="modal fade modal-glass" id="addParentModal" tabindex="-1" aria-labelledby="addParentModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addParentModalLabel">
                        <i data-feather="user-plus" class="me-2" style="width: 18px; height: 18px;"></i>
                        Ajouter un parent
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="add-parent-alert" class="alert alert-danger" style="display: none;"></div>
                    <form id="add-parent-form">
                        <div class="mb-3">
                            <label for="new-parent-name" class="form-label">
                                <i data-feather="user" class="me-1" style="width: 14px; height: 14px;"></i>
                                Nom complet du parent
                            </label>
                            <input type="text" class="form-control" id="new-parent-name" required placeholder="Ex: RAKOTO Jean">
                        </div>
                        <div class="mb-3">
                            <label for="new-parent-phone" class="form-label">
                                <i data-feather="phone" class="me-1" style="width: 14px; height: 14px;"></i>
                                Numéro de téléphone
                            </label>
                            <input type="tel" class="form-control" id="new-parent-phone" required placeholder="Ex: 0341234567">
                        </div>
                        <div class="alert alert-info">
                            <i data-feather="info" class="me-1" style="width: 14px; height: 14px;"></i>
                            <small>Ce parent sera ajouté directement au dossier de l'élève sans créer de compte utilisateur.</small>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn glass-btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="button" class="btn glass-btn-primary" id="save-new-parent-btn">
                        <i data-feather="save" class="me-1" style="width: 16px; height: 16px;"></i>
                        Ajouter le parent
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/theme.js"></script>
    <script src="/js/main.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof feather !== 'undefined') {
                feather.replace();
            }

            // ========================================================================
            // DONNÉES INITIALES
            // ========================================================================
            
            // Parents déjà liés avec leurs infos
            let linkedParents = [
                { id: 3, name: 'RABENJA Albert', phone: '', isNew: false }
            ];
            
            // Parents disponibles dans le select (ceux qui ont un compte)
            const availableParents = [
                { id: 36, name: 'Anthony RAKOTOBE' },
                { id: 24, name: 'Krystofer Manach' },
                { id: 32, name: 'Lia keishalk' },
                { id: 21, name: 'Maps andri' },
                { id: 13, name: 'RABE Nasolo' },
                { id: 16, name: 'RABENJA Lova' },
                { id: 18, name: 'RABENJA Niaina' },
                { id: 19, name: 'Rajoutons nivo' },
                { id: 20, name: 'Rakoto nivo' },
                { id: 25, name: 'RAKOTO Olivier' },
                { id: 17, name: 'RAKOTOSON Fitia' },
                { id: 15, name: 'RANAIVO marc' },
                { id: 23, name: 'RANDRIA Thierry' },
                { id: 30, name: 'RANORO Sendra' }
            ];
            
            // Compteur pour générer des IDs uniques pour les nouveaux parents
            let newParentCounter = 1000;

            // ========================================================================
            // TOM SELECT
            // ========================================================================
            let tomSelectInstance;
            const parentSelect = document.getElementById('parent_ids');
            
            if (parentSelect) {
                // Filtrer les parents déjà liés
                const linkedIds = linkedParents.filter(p => !p.isNew).map(p => p.id);
                const availableOptions = availableParents.filter(p => !linkedIds.includes(p.id));
                
                // Remplir le select
                availableOptions.forEach(parent => {
                    const option = document.createElement('option');
                    option.value = parent.id;
                    option.textContent = parent.name;
                    parentSelect.appendChild(option);
                });
                
                tomSelectInstance = new TomSelect(parentSelect, {
                    plugins: ['remove_button'],
                    create: false,
                    placeholder: 'Rechercher et sélectionner un parent existant...',
                    onChange: function(values) {
                        // Ajouter les parents sélectionnés à la liste des liés
                        values.forEach(value => {
                            const parentId = parseInt(value);
                            if (!linkedParents.find(p => p.id === parentId)) {
                                const parent = availableParents.find(p => p.id === parentId);
                                if (parent) {
                                    linkedParents.push({
                                        id: parent.id,
                                        name: parent.name,
                                        phone: '',
                                        isNew: false
                                    });
                                }
                            }
                        });
                        renderLinkedParents();
                        updateManualParentsData();
                    },
                    onItemRemove: function(value) {
                        // Retirer de la liste des liés
                        const parentId = parseInt(value);
                        linkedParents = linkedParents.filter(p => p.id !== parentId);
                        renderLinkedParents();
                        updateManualParentsData();
                    }
                });
            }

            // ========================================================================
            // RENDU DE LA LISTE DES PARENTS LIÉS
            // ========================================================================
            function renderLinkedParents() {
                const listContainer = document.getElementById('linked-parents-list');
                if (!listContainer) return;
                
                if (linkedParents.length === 0) {
                    listContainer.innerHTML = `
                        <div class="list-group-item text-muted text-center py-3">
                            <i data-feather="users" style="width: 20px; height: 20px;"></i>
                            <p class="mb-0 mt-1">Aucun parent lié</p>
                        </div>
                    `;
                } else {
                    listContainer.innerHTML = linkedParents.map((parent, index) => `
                        <div class="list-group-item linked-parent-item" data-parent-index="${index}">
                            <div class="d-flex w-100 justify-content-between align-items-start">
                                <div>
                                    <h6 class="mb-1">
                                        ${escapeHtml(parent.name)}
                                        ${parent.isNew ? '<span class="badge bg-info ms-2" style="font-size: 0.65rem;">Nouveau</span>' : ''}
                                    </h6>
                                    <p class="mb-1">
                                        <small>
                                            <i data-feather="phone" class="me-1" style="width: 12px; height: 12px;"></i>
                                            <strong>Téléphone :</strong>
                                            <span class="phone-display" id="phone-display-${index}">
                                                ${parent.phone ? escapeHtml(parent.phone) : '<span class="phone-editable" onclick="editPhone(' + index + ')" title="Cliquez pour ajouter un numéro">Non renseigné</span>'}
                                            </span>
                                            <span class="phone-edit-area" id="phone-edit-${index}" style="display: none;">
                                                <input type="tel" class="phone-edit-input" id="phone-input-${index}" value="${escapeHtml(parent.phone)}" placeholder="Numéro de téléphone">
                                                <button class="btn btn-sm btn-success btn-save-phone" onclick="savePhone(${index})">
                                                    <i data-feather="check" style="width: 12px; height: 12px;"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary btn-save-phone" onclick="cancelEditPhone(${index})">
                                                    <i data-feather="x" style="width: 12px; height: 12px;"></i>
                                                </button>
                                            </span>
                                        </small>
                                    </p>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeLinkedParent(${index})" title="Retirer ce parent">
                                    <i data-feather="trash-2" style="width: 14px; height: 14px;"></i>
                                </button>
                            </div>
                        </div>
                    `).join('');
                }
                
                if (typeof feather !== 'undefined') {
                    feather.replace();
                }
            }

            // ========================================================================
            // FONCTIONS D'ÉDITION DU TÉLÉPHONE
            // ========================================================================
            window.editPhone = function(index) {
                const displayEl = document.getElementById('phone-display-' + index);
                const editEl = document.getElementById('phone-edit-' + index);
                const inputEl = document.getElementById('phone-input-' + index);
                
                if (displayEl && editEl) {
                    displayEl.style.display = 'none';
                    editEl.style.display = 'inline';
                    inputEl.focus();
                }
            };

            window.savePhone = function(index) {
                const inputEl = document.getElementById('phone-input-' + index);
                const phone = inputEl.value.trim();
                
                if (linkedParents[index]) {
                    linkedParents[index].phone = phone;
                }
                
                renderLinkedParents();
                updateManualParentsData();
            };

            window.cancelEditPhone = function(index) {
                renderLinkedParents();
            };

            window.removeLinkedParent = function(index) {
                const parent = linkedParents[index];
                
                if (confirm('Voulez-vous retirer "' + parent.name + '" de la liste des parents liés ?')) {
                    linkedParents.splice(index, 1);
                    
                    // Retirer aussi du TomSelect si c'est un parent existant
                    if (!parent.isNew && tomSelectInstance) {
                        tomSelectInstance.removeItem(parent.id);
                    }
                    
                    renderLinkedParents();
                    updateManualParentsData();
                }
            };

            // ========================================================================
            // MISE À JOUR DES DONNÉES CACHÉES POUR LE FORMULAIRE
            // ========================================================================
            function updateManualParentsData() {
                const manualParents = linkedParents
                    .filter(p => p.isNew)
                    .map(p => ({ name: p.name, phone: p.phone }));
                
                document.getElementById('manual-parents-data').value = JSON.stringify(manualParents);
            }

            // ========================================================================
            // MODAL AJOUT DE PARENT (SANS CRÉER DE COMPTE)
            // ========================================================================
            const addParentModalEl = document.getElementById('addParentModal');
            if (addParentModalEl) {
                const addParentModal = new bootstrap.Modal(addParentModalEl);
                const saveParentBtn = document.getElementById('save-new-parent-btn');
                const addParentForm = document.getElementById('add-parent-form');
                const alertEl = document.getElementById('add-parent-alert');
                const nameInput = document.getElementById('new-parent-name');
                const phoneInput = document.getElementById('new-parent-phone');

                // Réinitialiser le bouton au cas où
                saveParentBtn.onclick = null;

                saveParentBtn.addEventListener('click', function() {
                    const name = nameInput.value.trim();
                    const phone = phoneInput.value.trim();

                    if (!name) {
                        showAlert('Veuillez entrer le nom du parent.');
                        return;
                    }

                    if (!phone) {
                        showAlert('Veuillez entrer le numéro de téléphone.');
                        return;
                    }

                    // Créer un nouveau parent local (sans compte)
                    const newParent = {
                        id: newParentCounter++,
                        name: name,
                        phone: phone,
                        isNew: true
                    };

                    // Ajouter à la liste des parents liés
                    linkedParents.push(newParent);
                    
                    // Mettre à jour l'affichage
                    renderLinkedParents();
                    updateManualParentsData();
                    
                    // Fermer le modal et réinitialiser
                    addParentModal.hide();
                    addParentForm.reset();
                    alertEl.style.display = 'none';

                    // Notification de succès
                    showToast('Parent "' + name + '" ajouté avec succès !');
                });

                addParentModalEl.addEventListener('hidden.bs.modal', function() {
                    addParentForm.reset();
                    alertEl.style.display = 'none';
                    if (typeof feather !== 'undefined') {
                        feather.replace();
                    }
                });

                function showAlert(message) {
                    alertEl.innerHTML = '<i data-feather="alert-circle" class="me-2" style="width: 16px; height: 16px;"></i> ' + message;
                    alertEl.style.display = 'block';
                    if (typeof feather !== 'undefined') {
                        feather.replace();
                    }
                }
            }

            // ========================================================================
            // TOAST NOTIFICATION
            // ========================================================================
            function showToast(message) {
                // Créer un toast simple
                const toastEl = document.createElement('div');
                toastEl.className = 'alert alert-success position-fixed bottom-0 end-0 m-3';
                toastEl.style.zIndex = '9999';
                toastEl.style.animation = 'fadeInUp 0.3s ease';
                toastEl.innerHTML = `
                    <i data-feather="check-circle" class="me-2" style="width: 16px; height: 16px;"></i>
                    ${message}
                `;
                document.body.appendChild(toastEl);
                
                if (typeof feather !== 'undefined') {
                    feather.replace();
                }
                
                setTimeout(function() {
                    toastEl.style.animation = 'fadeOutDown 0.3s ease';
                    setTimeout(function() {
                        toastEl.remove();
                    }, 300);
                }, 3000);
            }

            // ========================================================================
            // SOUMISSION DU FORMULAIRE
            // ========================================================================
            document.getElementById('student-form').addEventListener('submit', function(e) {
                // Mettre à jour les données avant soumission
                updateManualParentsData();
                
                // Ajouter les IDs des parents existants comme champs cachés
                linkedParents.filter(p => !p.isNew).forEach(parent => {
                    let input = document.querySelector(`input[name="parent_ids[]"][value="${parent.id}"]`);
                    if (!input) {
                        input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'parent_ids[]';
                        input.value = parent.id;
                        this.appendChild(input);
                    }
                });
                
                console.log('Parents liés soumis:', linkedParents);
                console.log('Parents manuels:', document.getElementById('manual-parents-data').value);
            });

            // ========================================================================
            // UTILITAIRES
            // ========================================================================
            function escapeHtml(text) {
                if (!text) return '';
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            // ========================================================================
            // INITIALISATION
            // ========================================================================
            renderLinkedParents();
            updateManualParentsData();
        });
    </script>
</body>
</html>