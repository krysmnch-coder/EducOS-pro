<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('partials/head') %>
    <style>
        .student-row { cursor: pointer; }
        
        /* ==========================================================================
           Page Étudiants - Style Glassmorphism
           ========================================================================== */
        
        .glass-card-container {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 1rem;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
            overflow: hidden;
        }
        
        [data-theme="dark"] .glass-card-container {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }
        
        .glass-class-header {
            background: rgba(13, 110, 253, 0.06);
            border-radius: 0.75rem;
            padding: 0.75rem 1.25rem;
            border-left: 4px solid var(--bs-primary, #0d6efd);
            transition: all 0.3s ease;
        }
        
        .glass-class-header:hover {
            background: rgba(13, 110, 253, 0.1);
            transform: translateX(5px);
        }
        
        [data-theme="dark"] .glass-class-header {
            background: rgba(255, 255, 255, 0.04);
            border-left-color: rgba(255, 255, 255, 0.2);
        }
        
        .glass-table {
            border-radius: 0.75rem;
            overflow: hidden;
        }
        
        .glass-table thead th {
            background: rgba(13, 110, 253, 0.06);
            color: var(--text-color, #212529);
            font-weight: 600;
            border-bottom: 2px solid rgba(13, 110, 253, 0.12);
            padding: 0.85rem 0.75rem;
            text-transform: uppercase;
            font-size: 0.7rem;
            letter-spacing: 0.05em;
        }
        
        [data-theme="dark"] .glass-table thead th {
            background: rgba(255, 255, 255, 0.04);
            border-bottom: 2px solid rgba(255, 255, 255, 0.06);
        }
        
        .glass-row {
            background: transparent;
            transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            animation: row-fade-in 0.5s ease forwards;
            opacity: 0;
            transform: translateX(-10px);
        }
        
        @keyframes row-fade-in {
            from { opacity: 0; transform: translateX(-15px) scale(0.98); }
            to { opacity: 1; transform: translateX(0) scale(1); }
        }
        
        .glass-row:hover {
            background: rgba(13, 110, 253, 0.04);
            transform: scale(1.002);
        }
        
        [data-theme="dark"] .glass-row:hover {
            background: rgba(255, 255, 255, 0.04);
        }
        
        .glass-row td {
            padding: 0.75rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.04);
            vertical-align: middle;
        }
        
        [data-theme="dark"] .glass-row td {
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        }
        
        .glass-avatar-table {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(13, 110, 253, 0.15);
            transition: all 0.3s ease;
        }
        
        .glass-avatar-table:hover {
            transform: scale(1.1);
            border-color: var(--bs-primary, #0d6efd);
            box-shadow: 0 0 20px rgba(13, 110, 253, 0.15);
        }
        
        .glass-badge {
            padding: 0.3rem 0.7rem;
            border-radius: 0.5rem;
            font-weight: 500;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .glass-badge:hover {
            transform: scale(1.05);
        }
        
        .glass-btn-primary {
            background: rgba(13, 110, 253, 0.1);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(13, 110, 253, 0.2);
            border-radius: 0.75rem;
            transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            color: var(--bs-primary, #0d6efd);
            padding: 0.5rem 1.25rem;
            font-weight: 500;
        }
        
        .glass-btn-primary:hover {
            background: rgba(13, 110, 253, 0.2);
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 8px 25px rgba(13, 110, 253, 0.15);
            border-color: var(--bs-primary, #0d6efd);
            color: var(--bs-primary, #0d6efd);
        }
        
        [data-theme="dark"] .glass-btn-primary {
            color: #ffffff;
            border-color: rgba(255, 255, 255, 0.15);
        }
        
        /* Modal Glassmorphism */
        .modal-glass .modal-content {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 1.25rem;
            box-shadow: 0 25px 80px rgba(0, 0, 0, 0.2);
        }
        
        [data-theme="dark"] .modal-glass .modal-content {
            background: rgba(25, 25, 45, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5);
        }
        
        .modal-glass .modal-header {
            border-bottom: 1px solid rgba(13, 110, 253, 0.1);
            padding: 1.25rem 1.5rem;
        }
        
        [data-theme="dark"] .modal-glass .modal-header {
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }
        
        .modal-glass .modal-body {
            padding: 1.5rem;
        }
        
        .modal-glass .modal-footer {
            border-top: 1px solid rgba(13, 110, 253, 0.1);
            padding: 1.25rem 1.5rem;
        }
        
        [data-theme="dark"] .modal-glass .modal-footer {
            border-top: 1px solid rgba(255, 255, 255, 0.06);
        }
        
        .glass-avatar-modal {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid rgba(13, 110, 253, 0.15);
            transition: all 0.3s ease;
            box-shadow: 0 8px 30px rgba(13, 110, 253, 0.1);
        }
        
        .glass-avatar-modal:hover {
            transform: scale(1.05);
            border-color: var(--bs-primary, #0d6efd);
            box-shadow: 0 8px 40px rgba(13, 110, 253, 0.2);
        }
        
        .glass-list-group {
            background: transparent;
            border-radius: 0.75rem;
            overflow: hidden;
        }
        
        .glass-list-group .list-group-item {
            background: rgba(255, 255, 255, 0.04);
            border: none;
            border-bottom: 1px solid rgba(0, 0, 0, 0.04);
            padding: 0.7rem 1rem;
            transition: all 0.3s ease;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        
        .glass-list-group .list-group-item:hover {
            background: rgba(13, 110, 253, 0.04);
            padding-left: 1.2rem;
        }
        
        [data-theme="dark"] .glass-list-group .list-group-item {
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        }
        
        [data-theme="dark"] .glass-list-group .list-group-item:hover {
            background: rgba(255, 255, 255, 0.04);
        }
        
        /* Style pour les parents sans téléphone */
        .parent-phone-missing {
            color: #dc3545;
            font-style: italic;
            font-size: 0.85rem;
            cursor: pointer;
            border-bottom: 1px dashed #dc3545;
            transition: all 0.3s ease;
        }
        
        .parent-phone-missing:hover {
            color: #ff6b6b;
            border-bottom-color: #ff6b6b;
        }
        
        .parent-phone-ok {
            color: #198754;
            font-weight: 500;
        }
        
        .parent-badge-new {
            background: linear-gradient(135deg, #0dcaf0, #0d6efd);
            color: white;
            font-size: 0.65rem;
            padding: 0.15rem 0.5rem;
            border-radius: 1rem;
            animation: badgePulse 2s ease-in-out infinite;
        }
        
        @keyframes badgePulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(13, 202, 240, 0.4); }
            50% { box-shadow: 0 0 0 6px rgba(13, 202, 240, 0); }
        }
        
        .glass-class-section {
            animation: section-fade-in 0.6s ease forwards;
            opacity: 0;
            transform: translateY(15px);
        }
        
        @keyframes section-fade-in {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        @media (max-width: 768px) {
            .glass-avatar-table {
                width: 32px;
                height: 32px;
            }
            .glass-avatar-modal {
                width: 80px;
                height: 80px;
            }
            .glass-table thead th {
                font-size: 0.6rem;
                padding: 0.5rem 0.4rem;
            }
            .glass-row td {
                padding: 0.5rem 0.4rem;
                font-size: 0.8rem;
            }
        }
    </style>
</head>
<body data-theme="light" data-user-id="<%= user ? user.id : '' %>">
    <div class="page-shell container-xl py-4">
        <%- include('partials/header') %>

        <main class="page-main">
            <div class="glass-card-container">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h1 class="h4 mb-1"><%= title %></h1>
                            <p class="text-muted mb-0">Consultez les informations des élèves inscrits.</p>
                        </div>
                        <% if (user.role === ROLES.SECRETARY || user.role === ROLES.SCHOOL_LIFE_MANAGER) { %>
                            <a href="/students/new" class="btn glass-btn-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-1" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"/></svg>
                                Ajouter un élève
                            </a>
                        <% } %>
                    </div>

                    <%- include('partials/messages') %>

                    <% if (Object.keys(studentsByClass).length > 0) { %>
                        <% 
                            let classIndex = 0;
                            Object.keys(studentsByClass).sort().forEach(className => { 
                                let canViewClass = false;
                                if (user.role === ROLES.STUDENT) {
                                    canViewClass = user.student_class === className;
                                } else if (user.role === ROLES.PARENT) {
                                    canViewClass = parentChildrenClasses.includes(className);
                                } else {
                                    canViewClass = true;
                                }
                        %>
                        <% if (canViewClass) { %>
                            <div class="glass-class-section" data-delay="<%= classIndex * 0.08 %>">
                                <h5 class="mt-4 mb-3 glass-class-header">
                                    <i data-feather="users" class="me-2" style="width: 18px; height: 18px;"></i>
                                    Classe : <%= className %>
                                    <span class="badge bg-primary rounded-pill glass-badge ms-2"><%= studentsByClass[className].length %></span>
                                </h5>
                                <div class="table-responsive">
                                    <table class="table table-hover glass-table">
                                        <thead>
                                            <tr>
                                                <th style="width: 50px;"></th>
                                                <th>Nom de l'élève</th>
                                                <th>Matricule</th>
                                                <% if (user.role === ROLES.ADMINISTRATOR || user.role === ROLES.SECRETARY || user.role === ROLES.SCHOOL_LIFE_MANAGER) { %>
                                                    <th>Parents Liés</th>
                                                    <th>Identifiant de connexion</th>
                                                    <th>Mot de passe (défaut)</th>
                                                <% } %>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% studentsByClass[className].forEach((student, index) => { %>
                                                <% const isPlaceholder = !!student.is_placeholder; %>
                                                <% const canSeeDetails = (user.role === ROLES.ADMINISTRATOR || user.role === ROLES.SECRETARY || user.role === ROLES.SCHOOL_LIFE_MANAGER || user.role === ROLES.PROFESSOR); %>

                                                <% if (canSeeDetails) { %>
                                                    <tr class="student-row glass-row" 
                                                        data-delay="<%= index * 0.03 %>"
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#studentDetailModal"
                                                        data-id="<%= student.id %>"
                                                        data-is-placeholder="<%= isPlaceholder %>"
                                                        data-created-by="<%= student.created_by || '' %>"
                                                        data-name="<%= student.name %>"
                                                        data-matricule="<%= student.matricule || 'N/A' %>"
                                                        data-class="<%= student.student_class || 'N/A' %>"
                                                        data-avatar="<%= student.avatar_url || '/img/user.png' %>"
                                                        data-linked-parents='<%- JSON.stringify(student.linkedParents || []) %>'
                                                        data-manual-parents='<%- JSON.stringify(student.manualParents || []) %>'
                                                        <% if (isPlaceholder) { %>
                                                            data-parent-name="<%= student.parent_name %>"
                                                            data-parent-id="<%= student.parent_id %>"
                                                        <% } else { %>
                                                            data-birthdate="<%= student.date_of_birth ? new Date(student.date_of_birth).toLocaleDateString('fr-FR') : 'Non renseignée' %>"
                                                            data-birthplace="<%= student.place_of_birth || 'Non renseigné' %>"
                                                            data-address="<%= student.address || 'Non renseignée' %>"
                                                        <% } %>
                                                    >
                                                <% } else { %>
                                                    <tr class="glass-row" data-delay="<%= index * 0.03 %>">
                                                <% } %>
                                                    <td><img src="<%= student.avatar_url || '/img/user.png' %>" class="rounded-circle glass-avatar-table" alt="Avatar"></td>
                                                    <td>
                                                        <%= student.name %>
                                                        <% if (isPlaceholder && canSeeDetails) { %>
                                                            <span class="badge bg-info-subtle text-info-emphasis rounded-pill ms-2 glass-badge">À compléter</span>
                                                        <% } %>
                                                    </td>
                                                    <td><%= student.matricule %></td>
                                                    <% if (user.role === ROLES.ADMINISTRATOR || user.role === ROLES.SECRETARY || user.role === ROLES.SCHOOL_LIFE_MANAGER) { %>
                                                        <td>
                                                            <% 
                                                            // Afficher TOUS les parents (liés + manuels)
                                                            const allParents = [];
                                                            if (student.linkedParents) allParents.push(...student.linkedParents);
                                                            if (student.manualParents) allParents.push(...student.manualParents);
                                                            %>
                                                            <% if (allParents.length > 0) { %>
                                                                <% allParents.forEach(parent => { %>
                                                                    <span class="badge bg-secondary glass-badge me-1">
                                                                        <i data-feather="user" class="me-1" style="width: 14px; height: 14px;"></i>
                                                                        <%= parent.name %>
                                                                        <% if (parent.isNew || parent.isManual) { %>
                                                                            <span class="parent-badge-new ms-1">+</span>
                                                                        <% } %>
                                                                    </span>
                                                                <% }); %>
                                                            <% } else { %>
                                                                <em class="text-muted small">Aucun</em>
                                                            <% } %>
                                                        </td>
                                                    <% } %>
                                                    <% if (user.role === ROLES.ADMINISTRATOR || user.role === ROLES.SECRETARY || user.role === ROLES.SCHOOL_LIFE_MANAGER) { %>
                                                        <% if (isPlaceholder) { %>
                                                            <td><em class="text-muted small">Non créé</em></td>
                                                            <td><em class="text-muted small">Non créé</em></td>
                                                        <% } else { %>
                                                            <td><small><%= student.email %></small></td>
                                                            <td><span class="badge bg-secondary glass-badge"><%= student.matricule %></span></td>
                                                        <% } %>
                                                    <% } %>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        <% 
                            classIndex++;
                            } 
                        }); 
                        %>
                    <% } else { %>
                        <div class="text-center text-muted py-5">
                            <i data-feather="users" style="width: 48px; height: 48px; stroke-width: 1;"></i>
                            <p class="mt-3">Aucun élève n'est enregistré pour le moment.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal pour les détails de l'élève - Version Glassmorphism -->
    <div class="modal fade modal-glass" id="studentDetailModal" tabindex="-1" aria-labelledby="studentDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="studentDetailModalLabel">
                        <i data-feather="user" class="me-2" style="width: 20px; height: 20px;"></i>
                        Détails de l'élève
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-4 text-center">
                            <img id="modal-avatar" src="/img/user.png" class="rounded-circle mb-3 glass-avatar-modal" alt="Avatar">
                            <h5 id="modal-name" class="fw-bold"></h5>
                            <p class="text-muted">Matricule: <span id="modal-matricule" class="fw-semibold"></span></p>
                        </div>
                        <div class="col-md-8">
                            <h6 class="fw-bold mb-3">
                                <i data-feather="info" class="me-1" style="width: 16px; height: 16px;"></i>
                                Informations personnelles
                            </h6>
                            <ul class="list-group list-group-flush glass-list-group">
                                <li class="list-group-item"><strong>Classe :</strong> <span id="modal-class"></span></li>
                                <li class="list-group-item"><strong>Date de naissance :</strong> <span id="modal-birthdate"></span></li>
                                <li class="list-group-item"><strong>Lieu de naissance :</strong> <span id="modal-birthplace"></span></li>
                                <li class="list-group-item"><strong>Adresse :</strong> <span id="modal-address"></span></li>
                            </ul>
                            <h6 class="mt-4 fw-bold">
                                <i data-feather="users" class="me-1" style="width: 16px; height: 16px;"></i>
                                Informations des parents
                            </h6>
                            <div id="modal-parent-info" class="mt-2">
                                <!-- Les informations des parents seront injectées ici par JS -->
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary glass-btn-small" data-bs-dismiss="modal">
                        <i data-feather="x" class="me-1" style="width: 16px; height: 16px;"></i>
                        Fermer
                    </button>
                    <a href="#" id="modal-edit-btn" class="btn btn-primary glass-btn-primary" style="display: none;">
                        <i data-feather="edit-2" class="me-1" style="width: 16px; height: 16px;"></i>
                        Modifier
                    </a>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Appliquer les délais d'animation
            document.querySelectorAll('.glass-row, .glass-class-section').forEach(function(el) {
                var delay = el.getAttribute('data-delay');
                if (delay) {
                    el.style.animationDelay = delay + 's';
                }
            });

            // Remplacer les icônes Feather
            if (typeof feather !== 'undefined') {
                feather.replace();
            }

            // ==========================================================================
            // MODAL LOGIC - AFFICHAGE DES PARENTS (LIÉS + MANUELS)
            // ==========================================================================
            const studentDetailModal = document.getElementById('studentDetailModal');
            
            studentDetailModal.addEventListener('show.bs.modal', function (event) {
                const row = event.relatedTarget;

                const isPlaceholder = row.dataset.isPlaceholder === 'true';
                const editBtn = document.getElementById('modal-edit-btn');
                const studentId = row.dataset.id;
                const currentUserId = '<%= user.id %>';
                const currentUserRole = '<%= user.role %>';

                // Réinitialiser l'affichage
                document.getElementById('modal-birthdate').closest('.list-group-item').style.display = '';
                document.getElementById('modal-birthplace').closest('.list-group-item').style.display = '';
                document.getElementById('modal-address').closest('.list-group-item').style.display = '';
                document.getElementById('modal-parent-info').innerHTML = '';

                // ========================================================================
                // RÉCUPÉRATION DE TOUS LES PARENTS (LIÉS + MANUELS)
                // ========================================================================
                let linkedParents = [];
                let manualParents = [];
                
                try {
                    linkedParents = JSON.parse(row.dataset.linkedParents || '[]');
                } catch(e) {
                    console.error('Erreur parsing linkedParents:', e);
                    linkedParents = [];
                }
                
                try {
                    manualParents = JSON.parse(row.dataset.manualParents || '[]');
                } catch(e) {
                    console.error('Erreur parsing manualParents:', e);
                    manualParents = [];
                }

                // Fusionner tous les parents
                const allParents = [
                    ...linkedParents.map(p => ({ ...p, type: 'linked' })),
                    ...manualParents.map(p => ({ ...p, type: 'manual', isNew: true }))
                ];

                console.log('👥 Tous les parents:', allParents);

                if (isPlaceholder) {
                    // --- Vue pour un dossier à compléter ---
                    const canComplete = (currentUserRole === '<%= ROLES.ADMINISTRATOR %>' || 
                                        currentUserRole === '<%= ROLES.SECRETARY %>' || 
                                        currentUserRole === '<%= ROLES.SCHOOL_LIFE_MANAGER %>');

                    if (canComplete) {
                        const query = new URLSearchParams({
                            matricule: row.dataset.matricule,
                            name: row.dataset.name,
                            class: row.dataset.class,
                            parent_id: row.dataset.parentId,
                            parent_name: row.dataset.parentName
                        });
                        editBtn.href = `/students/complete/form?${query.toString()}`;
                        editBtn.style.display = 'inline-flex';
                        editBtn.innerHTML = '<i data-feather="edit-2" class="me-1" style="width: 16px; height: 16px;"></i> Compléter le dossier';
                    } else {
                        editBtn.style.display = 'none';
                    }

                    document.getElementById('modal-avatar').src = row.dataset.avatar;
                    document.getElementById('modal-name').textContent = row.dataset.name;
                    document.getElementById('modal-matricule').textContent = row.dataset.matricule;
                    document.getElementById('modal-class').textContent = row.dataset.class;
                    
                    // Afficher le parent qui a créé le dossier
                    const parentInfoContainer = document.getElementById('modal-parent-info');
                    parentInfoContainer.innerHTML = `
                        <div class="alert alert-info">
                            <i data-feather="info" class="me-2" style="width: 16px; height: 16px;"></i>
                            Dossier initié par le parent : <strong>${row.dataset.parentName || 'N/A'}</strong>.
                        </div>
                    `;

                    // Cacher les champs non pertinents
                    document.getElementById('modal-birthdate').closest('.list-group-item').style.display = 'none';
                    document.getElementById('modal-birthplace').closest('.list-group-item').style.display = 'none';
                    document.getElementById('modal-address').closest('.list-group-item').style.display = 'none';

                } else {
                    // --- Vue pour un élève complet ---
                    const canEdit = (currentUserRole === '<%= ROLES.ADMINISTRATOR %>' || 
                                    currentUserRole === '<%= ROLES.SECRETARY %>' || 
                                    currentUserRole === '<%= ROLES.SCHOOL_LIFE_MANAGER %>');

                    if (canEdit) {
                        editBtn.href = `/students/${studentId}/edit`;
                        editBtn.style.display = 'inline-flex';
                        editBtn.innerHTML = '<i data-feather="edit-2" class="me-1" style="width: 16px; height: 16px;"></i> Modifier';
                    } else {
                        editBtn.style.display = 'none';
                    }

                    document.getElementById('modal-avatar').src = row.dataset.avatar;
                    document.getElementById('modal-name').textContent = row.dataset.name;
                    document.getElementById('modal-matricule').textContent = row.dataset.matricule;
                    document.getElementById('modal-class').textContent = row.dataset.class;
                    document.getElementById('modal-birthdate').textContent = row.dataset.birthdate;
                    document.getElementById('modal-birthplace').textContent = row.dataset.birthplace;
                    document.getElementById('modal-address').textContent = row.dataset.address;

                    // ========================================================================
                    // AFFICHAGE DE TOUS LES PARENTS DANS LE MODAL
                    // ========================================================================
                    const parentInfoContainer = document.getElementById('modal-parent-info');
                    
                    if (allParents.length > 0) {
                        const list = document.createElement('ul');
                        list.className = 'list-group list-group-flush glass-list-group';
                        
                        allParents.forEach(function(parent) {
                            const item = document.createElement('li');
                            item.className = 'list-group-item';
                            
                            const hasPhone = parent.phone || parent.phone_number;
                            const phoneDisplay = hasPhone 
                                ? `<span class="parent-phone-ok">
                                    <i data-feather="phone" style="width: 12px; height: 12px;"></i> 
                                    ${escapeHtml(hasPhone)}
                                  </span>`
                                : `<span class="parent-phone-missing" title="Numéro non renseigné">
                                    <i data-feather="alert-circle" style="width: 12px; height: 12px;"></i> 
                                    Téléphone non renseigné
                                  </span>`;
                            
                            const typeBadge = parent.isNew 
                                ? '<span class="parent-badge-new ms-2">Ajouté manuellement</span>'
                                : (parent.type === 'manual' 
                                    ? '<span class="parent-badge-new ms-2">Manuel</span>' 
                                    : '');
                            
                            item.innerHTML = `
                                <div>
                                    <strong>
                                        <i data-feather="user" style="width: 14px; height: 14px;"></i>
                                        ${escapeHtml(parent.name || 'N/A')}
                                    </strong>
                                    ${typeBadge}
                                </div>
                                <div>
                                    ${phoneDisplay}
                                </div>
                            `;
                            
                            list.appendChild(item);
                        });
                        
                        parentInfoContainer.innerHTML = '';
                        parentInfoContainer.appendChild(list);
                        
                    } else {
                        parentInfoContainer.innerHTML = `
                            <div class="text-muted text-center py-3">
                                <i data-feather="users" style="width: 24px; height: 24px;"></i>
                                <p class="mb-0 mt-1">Aucun parent lié</p>
                            </div>
                        `;
                    }
                }

                // Réinitialiser les icônes Feather
                if (typeof feather !== 'undefined') {
                    feather.replace();
                }
            });

            // ==========================================================================
            // FONCTION UTILITAIRE
            // ==========================================================================
            function escapeHtml(text) {
                if (!text) return '';
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
        });
    </script>
</body>
</html>