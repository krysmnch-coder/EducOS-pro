// src/models/gradeModel.js
const db = require('./db');

const GradeModel = {
  // Récupérer les notes pour un utilisateur (élève, parent, professeur)
  getGradesForUser: (user) => {
    const query = db('grades as g')
      .select('g.*', 'u.name as student_name')
      .join('users as u', 'g.student_id', 'u.id');
    
    if (user.role === 'eleve' || user.role === 'student' || user.role === 'STUDENT') {
      query.where('g.student_id', user.id);
    } else if (user.role === 'parent') {
      const children = JSON.parse(user.children || '[]');
      const matricules = children.map(c => c.matricule).filter(Boolean);
      if (matricules.length === 0) {
        return Promise.resolve([]);
      }
      query.whereIn('u.matricule', matricules);
    } else if (user.role === 'professeur' || user.role === 'teacher') {
      query.where('g.professor_id', user.id);
    }
    
    return query.orderBy('g.created_at', 'desc');
  },

  // Créer une note
  createGrade: ({ student_id, professor_id, subject, grade, comment, class_name, period, nj1, nj2, examen }) => {
    return db('grades')
      .insert({
        student_id,
        professor_id: professor_id || null,
        subject,
        grade: grade || null,
        comment: comment || '',
        class_name: class_name || null,
        period: period || 1,
        nj1: nj1 || null,
        nj2: nj2 || null,
        examen: examen || null,
        created_at: new Date(),
        updated_at: new Date()
      })
      .returning('id');
  },

  // Récupérer une note par ID
  getGradeById: (id) => {
    return db('grades').where({ id }).first();
  },

  // Mettre à jour une note
  updateGrade: (id, data) => {
    const { student_id, subject, grade, comment, nj1, nj2, examen, class_name, period } = data;
    return db('grades')
      .where({ id })
      .update({
        student_id: student_id || undefined,
        subject: subject || undefined,
        grade: grade || null,
        comment: comment || '',
        nj1: nj1 || null,
        nj2: nj2 || null,
        examen: examen || null,
        class_name: class_name || undefined,
        period: period || undefined,
        updated_at: new Date()
      });
  },

  // Supprimer une note
  deleteGrade: (id) => {
    return db('grades').where({ id }).del();
  },

  // Récupérer les notes d'un étudiant
  getGradesByStudent: (studentId, subject = null) => {
    let query = db('grades')
      .where({ student_id: studentId })
      .select('*');
    
    if (subject) {
      query = query.where({ subject });
    }
    
    return query.orderBy('period', 'asc');
  },

  // Récupérer les notes pour une classe/matière/période
  getGradesByClass: async (className, subject, period = 1, establishmentId = 1) => {
    return db('grades')
      .where({
        establishment_id: establishmentId,
        class_name: className,
        subject: subject,
        period: period
      })
      .select('*');
  },

  // Récupérer une note spécifique d'un étudiant
  getGradeByStudentAndClass: async (studentId, className, subject, period = 1, establishmentId = 1) => {
    return db('grades')
      .where({
        establishment_id: establishmentId,
        student_id: studentId,
        class_name: className,
        subject: subject,
        period: period
      })
      .first();
  },

  // Créer ou mettre à jour une note (upsert)
  upsertGrade: async (data) => {
    const { 
      student_id, 
      class_name, 
      subject, 
      period, 
      nj1, 
      nj2, 
      examen, 
      comment, 
      professor_id,
      establishment_id = 1 
    } = data;
    
    const existing = await db('grades')
      .where({
        establishment_id: establishment_id,
        student_id: student_id,
        class_name: class_name,
        subject: subject,
        period: period
      })
      .first();
    
    if (existing) {
      // Mettre à jour
      await db('grades')
        .where({ id: existing.id })
        .update({
          nj1: nj1 !== undefined ? nj1 : null,
          nj2: nj2 !== undefined ? nj2 : null,
          examen: examen !== undefined ? examen : null,
          comment: comment || '',
          updated_at: new Date()
        });
      return existing.id;
    } else {
      // Insérer
      const [id] = await db('grades').insert({
        establishment_id: establishment_id,
        student_id: student_id,
        class_name: class_name,
        subject: subject,
        period: period || 1,
        nj1: nj1 || null,
        nj2: nj2 || null,
        examen: examen || null,
        comment: comment || '',
        professor_id: professor_id || null,
        created_at: new Date(),
        updated_at: new Date()
      });
      return id;
    }
  },

  // Supprimer les notes d'une classe pour une matière
  deleteByClassAndSubject: async (className, subject, period = 1, establishmentId = 1) => {
    return db('grades')
      .where({
        establishment_id: establishmentId,
        class_name: className,
        subject: subject,
        period: period
      })
      .del();
  },

  // Récupérer toutes les matières pour une classe
  getSubjectsByClass: async (className, establishmentId = 1) => {
    return db('grades')
      .where({
        establishment_id: establishmentId,
        class_name: className
      })
      .distinct('subject')
      .whereNotNull('subject')
      .orderBy('subject')
      .pluck('subject');
  },

  // Récupérer les statistiques d'une classe
  getStatsByClass: async (className, subject, period = 1, establishmentId = 1) => {
    const result = await db('grades')
      .where({
        establishment_id: establishmentId,
        class_name: className,
        subject: subject,
        period: period
      })
      .avg('nj1 as avg_nj1')
      .avg('nj2 as avg_nj2')
      .avg('examen as avg_examen')
      .count('* as total')
      .first();
    
    return result;
  },

  // Récupérer les notes d'un professeur
  getGradesByProfessor: (professorId) => {
    return db('grades')
      .where({ professor_id: professorId })
      .select('*')
      .orderBy('created_at', 'desc');
  }
};

module.exports = GradeModel;